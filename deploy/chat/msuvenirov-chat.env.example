# Copy to /etc/msuvenirov-chat.env (chmod 600, owner root) and fill in. Never commit the real file.
# Token of the CHAT bot from @BotFather (a separate bot: the order/review bot keeps its own webhook on Supabase).
TG_BOT_TOKEN=
# Where messages arrive: your Telegram user id or a group id (group ids start with -100…).
TG_CHAT_ID=
# Random string (latin letters, digits, _ and -), the same as secret_token in setWebhook.
TG_WEBHOOK_SECRET=
CHAT_PORT=8787
CHAT_DATA_DIR=/var/lib/msuvenirov-chat

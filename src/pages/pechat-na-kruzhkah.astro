---
// «Печать на кружках» — own page (like the calendars and t-shirt pages): first screen, calculator, ready options,
// four models on one shelf in one scale, coatings of the 330 ml mug, what can be printed, technology and care,
// audience, how to order, works, reviews, FAQ, SEO text.
// Content — src/data/mugsPage.ts; every price — src/data/pricing.ts; sizes — src/components/mug/mug-geometry.ts.
// The services.ts entry stays for menus/sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import TeeHead from '@/components/tee/TeeHead.astro';
import PpHero from '@/components/product-page/PpHero.astro';
import PpSteps from '@/components/product-page/PpSteps.astro';
import PpAudience from '@/components/product-page/PpAudience.astro';
import PpHow from '@/components/product-page/PpHow.astro';
import PpSeo from '@/components/product-page/PpSeo.astro';
import FoldScript from '@/components/product-page/FoldScript.astro';
import '@/components/product-page/pp.css';
import MugArt from '@/components/mug/MugArt.astro';
import MugPackages from '@/components/mug/MugPackages.astro';
import { MODELS } from '@/components/mug/mug-geometry';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { mugsPage as page, buildMugFaq } from '@/data/mugsPage';
import { services } from '@/data/services';
import { defaultSelection, findCategory, findProduct, rub, type Product, type Selection } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Печать на кружках', href: page.slug },
];

// ---- prices, all from pricing.ts
const cat = findCategory('mugs')!;
const mug = findProduct('mugs', 'mug')!;
const selOf = (p: Product, options: Selection['options'] = {}, qty = p.qty.min): Selection => {
  const b = defaultSelection(p);
  return { ...b, qty, options: { ...b.options, ...options } };
};
const ladderMin = (p: Product, options: Selection['options'] = {}) => Math.min(...(p.ladder ? p.ladder(selOf(p, options)).map((t) => t.price) : [p.fromPrice]));
const oneUnit = (p: Product, options: Selection['options'] = {}) => p.quote(selOf(p, options, 1)).unit;

const models = page.models.map((m) => {
  const p = findProduct('mugs', m.product)!;
  const g = MODELS[m.art];
  return { ...m, vol: g.vol, d: g.d, h: g.h, from: ladderMin(p), one: oneUnit(p) };
});
const finishes = page.finishes.map((f) => ({ ...f, from: ladderMin(mug, { variant: f.id }), one: oneUnit(mug, { variant: f.id }) }));
const faq = buildMugFaq({ one330: rub(oneUnit(mug, { variant: 'white' })), oneChameleon: rub(oneUnit(mug, { variant: 'chameleon' })) });
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];

// ---- «Какие кружки печатаем»: one scale for all four drawings (px per mm); 5 cm grid behind them
const SSCALE = 1.5;
const tallest = Math.max(...models.map((m) => m.h));

// three facts under the buttons of the first screen (same row as on the t-shirt page)
const heroFacts = [{ big: '1 шт', small: 'можно заказать одну кружку' },{ big: '4 вида', small: '330 и 425 мл, кофейный набор, пивная' },{ big: '0 ₽', small: 'простой макет соберём сами' }];
const splitTail = (t: string): [string, string] => {
  const i = t.lastIndexOf(' ');
  return [t.slice(0, i + 1), t.slice(i + 1)];
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/portfolio/portfolio-30.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: Math.min(...cat.products.map((p) => p.fromPrice)), offerCount: cat.products.length }),
    faqPage(faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <PpHero eyebrow={page.eyebrow} h1={page.h1} lead={page.lead} crumbs={crumbs} mark="кружках" heroAlt={page.heroAlt} facts={heroFacts} price={{ pre: 'от', value: rub(mug.fromPrice), note: 'кружка 330 мл' }}>
    <MugArt type="beer600" print="logo" scale={1.5} class="mhero-mug mhero-beer" />
    <MugArt type="mug330" finish="chameleon" print="photo" scale={1.5} class="mhero-mug mhero-cham" />
    <MugArt type="mug330" print="photo" scale={1.5} class="mhero-mug mhero-main" />
    <MugArt type="coffee" print="text" scale={1.5} class="mhero-mug mhero-coffee" />
  </PpHero>

  <!-- ============ calculator (light grey) ============ -->
  <div class="band band-tint">
    <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
      <div class="wrap">
        <TeeHead icon="calc" eyebrow="Калькулятор" id="calc-h" title="Посчитайте свои кружки" mark="кружки">
          <p class="calc-sub">Выберите кружку, покрытие и количество — цена за штуку и за весь заказ пересчитается сразу. Кружка, печать и макет уже в цене.</p>
        </TeeHead>
        <Calculator client:visible category="mugs" product="mug" hideCategories />
      </div>
      <AlsoOrder slugs={page.alsoOrder} />
    </section>
  </div>

  <!-- ============ ready options (white) ============ -->
  <div class="band">
    <MugPackages />
  </div>

  <!-- ============ four models on one shelf, one scale (light grey) ============ -->
  <div class="band band-tint">
    <section class="section kinds pp-sec" aria-labelledby="kinds-h">
      <div class="wrap">
        <TeeHead icon="ruler" eyebrow="Какие кружки печатаем" id="kinds-h" title="Кружки 330 и 425 мл, кофейный набор и пивная кружка" mark="кружка">
          <p class="pp-sub">Все четыре нарисованы в одном масштабе — видно, какая больше. Одна клетка на фоне — 5 × 5 см.</p>
        </TeeHead>
        <div class="kinds-shelf" style={`--cell:${50 * SSCALE}px;--wall:${Math.round(tallest * SSCALE) + 24}px`}>
          <ol class="kinds-row">
            {
              models.map((m, i) => (
                <li class="kinds-item">
                  <a class="kinds-art" href={`#kind-${m.art}`} aria-label={m.name}>
                    <MugArt type={m.art} print={i === 3 ? 'text' : i === 2 ? 'logo' : 'photo'} scale={SSCALE} title={`${m.name}, диаметр ${m.d} мм`} />
                  </a>
                  <span class="kinds-vol">{m.vol} мл</span>
                </li>
              ))
            }
          </ol>
          <span class="kinds-legend" aria-hidden="true"><i></i> 5 см</span>
        </div>
        <ul class="kinds-cards">
          {
            models.map((m) => (
              <li id={`kind-${m.art}`} class="kcard pp-card">
                <span class="pp-tag">{m.tag}</span>
                <h3>{m.name}</h3>
                <dl class="kcard-specs">
                  <div><dt>Объём</dt><dd>{m.vol} мл</dd></div>
                  <div><dt>Диаметр</dt><dd>{m.d} мм</dd></div>
                  <div><dt>Высота</dt><dd>≈ {m.h} мм</dd></div>
                  <div><dt>1 шт</dt><dd>{rub(m.one)}</dd></div>
                </dl>
                <p class="kcard-text">{m.text}</p>
                <div class="kcard-foot">
                  <span class="kcard-price">от {rub(m.from)}<small>/шт</small></span>
                  <a class="btn btn-sm btn-ghost" href={`${page.slug}?calc=mugs:${m.product}#calc`}>Рассчитать</a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <!-- ============ coatings of the 330 ml mug (navy panel) ============ -->
  <div class="band band-ink">
    <section class="section fin pp-sec" aria-labelledby="fin-h">
      <div class="wrap">
        <TeeHead icon="layers" eyebrow="Покрытия" id="fin-h" title="Покрытия кружки 330 мл" mark="мл" dark>
          <p class="pp-sub">Одна и та же кружка 330 мл в шести вариантах. Цена «от» — для тиража, ниже — за одну кружку с печатью.</p>
        </TeeHead>
        <ul class="fin-grid">
          {
            finishes.map((f) => (
              <li class={`fin-card pp-card fin-${f.id}`}>
                <div class="fin-art pp-art" aria-hidden="true">
                  {f.id === 'chameleon' ? (
                    <span class="cham">
                      <MugArt type="mug330" finish="chameleon" print="none" scale={1.25} class="cham-cold" />
                      <MugArt type="mug330" finish="chameleon" print="photo" scale={1.25} class="cham-hot" />
                      <span class="cham-label"><b class="cham-l-cold">холодная</b><b class="cham-l-hot">горячая</b></span>
                    </span>
                  ) : (
                    <MugArt type="mug330" finish={f.id} print={f.print} tint={f.id === 'glitter' ? 'turquoise' : f.id === 'marble' ? 'pink' : undefined} scale={1.25} />
                  )}
                </div>
                <div class="fin-body">
                  <h3>{f.title}</h3>
                  <p class="fin-text">{f.text}</p>
                  {(f.id === 'color' || f.id === 'glitter' || f.id === 'marble') && (
                    <ul class="fin-colors" aria-label="Цвета">
                      {(f.id === 'color' ? page.innerColors : f.id === 'glitter' ? page.glitterColors : page.marbleColors).map((c) => (
                        <li title={c.name} style={`--sw:${c.hex}`}>
                          <span class="sr-only">{c.name}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="fin-meta">
                    <span class="fin-price">от {rub(f.from)}</span>
                    <span class="fin-one">1 шт — <b>{rub(f.one)}</b></span>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <!-- ============ what can be printed (white) ============ -->
  <div class="band">
    <section class="section prn pp-sec" aria-labelledby="prn-h">
      <div class="wrap">
        <TeeHead icon="bulb" eyebrow="Идеи" id="prn-h" title="Что можно напечатать на кружке" mark="кружке" />
        <ul class="prn-grid">
          {
            page.prints.map((p) => (
              <li class="prn-card pp-card">
                <div class="prn-art pp-art" aria-hidden={p.photo ? undefined : 'true'}>
                  {p.photo ? (
                    <img src={p.photo} alt={p.photoAlt} width="480" height="480" loading="lazy" decoding="async" />
                  ) : (
                    <MugArt type="mug330" finish={p.finish} print={p.print} scale={1.1} />
                  )}
                  {p.photo && <span class="prn-real">наша работа</span>}
                </div>
                <div class="prn-body">
                  <span class="pp-tag">{p.tag}</span>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <!-- ============ technology and care (light grey) ============ -->
  <div class="band band-tint">
    <section class="section tech pp-sec" aria-labelledby="tech-h">
      <div class="wrap tech-grid">
        <div>
          <TeeHead icon="layers" eyebrow="Технология" id="tech-h" title={page.tech.title} mark={splitTail(page.tech.title)[1]} />
          <PpSteps items={page.tech.steps} />
          <ul class="pp-ticks tech-facts">
            {page.tech.facts.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <details class="care pp-card" open data-fold>
          <summary><h3>Как ухаживать за кружкой</h3></summary>
          <ul class="care-list">
            {
              page.care.map((c) => (
                <li class={c.ok ? 'care-ok' : 'care-no'}>
                  <span class="care-ico" aria-hidden="true">{c.ok ? '✓' : '✕'}</span>
                  <span>{c.text}</span>
                </li>
              ))
            }
          </ul>
          <p class="care-note">Сомневаетесь, подойдёт ли кружка для вашего случая, — спросите у мастера при заказе.</p>
        </details>
      </div>
    </section>
  </div>

  <!-- ============ for whom (white) ============ -->
  <div class="band">
    <PpAudience title="Кому дарят и заказывают кружки с печатью" mark="кружки" items={page.audience} />
  </div>

  <!-- ============ how to order (light grey) ============ -->
  <div class="band band-tint">
    <PpHow title="Как заказать печать на кружке" mark="кружке" steps={page.steps} layout={page.layout} b2b={page.b2b} b2bOrder="Кружки с логотипом для компании — рассчитать тираж" />
  </div>

  <FoldScript />

  <div class="band band-ink">
    <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: кружки и кофейные наборы" />
  </div>

  <div class="band">
    <Reviews keywords={page.reviewKeywords} title="Отзывы о кружках" />
  </div>

  <div class="band band-tint">
    <FaqSection items={faq} title="Вопросы о печати на кружках" />
  </div>

  <!-- ============ SEO text (white; folded on phones) ============ -->
  <div class="band">
    <PpSeo title={page.seo.title} sections={page.seo.sections}>
      <a href="/fotopodarki">фотоподарки</a> · <a href="/pechat-na-futbolkah">печать на футболках</a> · <a href="/magnity">магниты с фото</a> ·
      <a href="/korporativnym-klientam">корпоративным клиентам</a> · <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
    </PpSeo>
  </div>

  <div class="band band-tint">
    {related.length > 0 && <TshirtRelated items={related} />}
  </div>

  <CtaBand title="Хотите кружку со своим фото?" text="Пришлите снимок, надпись или логотип — соберём макет, покажем, как он ляжет на кружку, и посчитаем цену." />
</BaseLayout>

<style>
  .calc-sub {
    max-width: 52ch;
  }

  /* ---- first screen: mugs on the stage (440 × 440, zoomed with the panel) */
  .ph-stage :global(.mhero-mug) {
    position: absolute;
    filter: drop-shadow(0 16px 18px rgba(20, 33, 61, 0.2));
  }
  .ph-stage :global(.mhero-beer) {
    left: 22px;
    bottom: 150px;
  }
  .ph-stage :global(.mhero-cham) {
    right: 26px;
    bottom: 168px;
  }
  .ph-stage :global(.mhero-main) {
    left: 92px;
    bottom: 48px;
    z-index: 2;
  }
  .ph-stage :global(.mhero-coffee) {
    right: -6px;
    bottom: 34px;
    z-index: 3;
  }

  /* ---- four mugs on one shelf */
  .kinds-shelf {
    --kz: 1;
    --cz: calc(var(--cell) * var(--kz));
    --gy: calc(100% - 73px);
    position: relative;
    padding: 44px 0 22px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.95);
    background:
      linear-gradient(0deg, rgba(20, 33, 61, 0.07) 1px, transparent 1px) 0 var(--gy) / 100% var(--cz),
      linear-gradient(90deg, rgba(20, 33, 61, 0.07) 1px, transparent 1px) 50% 0 / var(--cz) 100%,
      radial-gradient(80% 70% at 50% 35%, #ffffff 0%, #eef0f4 100%);
    box-shadow: 0 30px 60px -40px rgba(20, 33, 61, 0.45);
    overflow: clip;
  }
  .kinds-row {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: end;
  }
  .kinds-item {
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .kinds-art {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    height: calc(var(--wall) * var(--kz));
    border-bottom: 12px solid var(--navy, #14213d);
    color: inherit;
  }
  .kinds-art :global(svg) {
    flex: none;
    zoom: var(--kz);
    filter: drop-shadow(0 12px 12px rgba(20, 33, 61, 0.18));
    transition: transform 0.2s ease;
  }
  .kinds-art:hover :global(svg) {
    transform: translateY(-4px);
  }
  .kinds-vol {
    position: relative;
    z-index: 2;
    padding: 5px 14px;
    border-radius: 999px;
    background: var(--navy, #14213d);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .kinds-legend {
    position: absolute;
    right: 18px;
    top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--navy, #14213d);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .kinds-legend i {
    width: var(--cz);
    height: 6px;
    border: 1.5px solid var(--navy, #14213d);
    border-top: 0;
  }
  .kinds-cards {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .kcard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 20px;
    scroll-margin-top: 90px;
  }
  .kcard:target {
    box-shadow: 0 0 0 2px var(--navy, #14213d);
  }
  .kcard-specs {
    width: 100%;
    margin: 0;
    display: grid;
    gap: 3px;
    font-size: 0.86rem;
  }
  .kcard-specs div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1px dashed rgba(20, 33, 61, 0.2);
  }
  .kcard-specs dt {
    color: var(--muted);
  }
  .kcard-specs dd {
    margin: 0;
    font-weight: 700;
    white-space: nowrap;
  }
  .kcard-text {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .kcard-foot {
    width: 100%;
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .kcard-price {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--navy, #14213d);
  }
  .kcard-price small {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0;
  }

  /* ---- coatings */
  .fin-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .fin-card {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 4px;
    padding: 8px;
  }
  .fin-art {
    min-height: 170px;
  }
  .fin-art :global(svg) {
    max-width: 150px;
    filter: drop-shadow(0 12px 14px rgba(0, 0, 0, 0.4));
  }
  .fin-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 12px 12px 10px 10px;
  }
  .fin-text {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .fin-colors {
    list-style: none;
    margin: 4px 0 4px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .fin-colors li {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.6);
  }
  .fin-meta {
    margin-top: auto !important;
    padding-top: 8px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }
  .fin-price {
    padding: 4px 12px;
    border-radius: 999px;
    background: #fff;
    color: var(--navy, #14213d);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .fin-one {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .fin-one b {
    color: #fff;
  }
  /* chameleon: cold (dark) and hot (print shows) states fade into each other */
  .cham {
    position: relative;
    display: grid;
  }
  .cham > :global(svg) {
    grid-area: 1 / 1;
  }
  .cham :global(.cham-hot) {
    animation: cham-hot 5s ease-in-out infinite;
  }
  .cham-label {
    position: absolute;
    left: 50%;
    bottom: -20px;
    transform: translateX(-50%);
    display: grid;
    font-size: 0.75rem;
  }
  .cham-label b {
    grid-area: 1 / 1;
    padding: 2px 10px;
    border-radius: 999px;
    text-align: center;
    white-space: nowrap;
  }
  .cham-l-cold {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    animation: cham-cold 5s ease-in-out infinite;
  }
  .cham-l-hot {
    background: #fff;
    color: var(--navy, #14213d);
    animation: cham-hot 5s ease-in-out infinite;
  }
  @keyframes cham-hot {
    0%, 30% { opacity: 0; }
    50%, 80% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes cham-cold {
    0%, 30% { opacity: 1; }
    50%, 80% { opacity: 0; }
    100% { opacity: 1; }
  }

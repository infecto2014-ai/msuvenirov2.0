---
// «Печать на кружках» — own page (like the calendars and t-shirt pages): first screen, calculator, ready options,
// four models on one shelf in one scale, coatings of the 330 ml mug, what can be printed, technology and care,
// audience, how to order, works, reviews, FAQ, SEO text.
// Content — src/data/mugsPage.ts; every price — src/data/pricing.ts; sizes — src/components/mug/mug-geometry.ts.
// The services.ts entry stays for menus/sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import MugArt from '@/components/mug/MugArt.astro';
import MugPackages from '@/components/mug/MugPackages.astro';
import { MODELS } from '@/components/mug/mug-geometry';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import HeroFacts from '@/components/tshirt/HeroFacts.astro';
import { mugsPage as page, buildMugFaq } from '@/data/mugsPage';
import { services } from '@/data/services';
import { defaultSelection, findCategory, findProduct, rub, type Product, type Selection } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Печать на кружках', href: page.slug },
];

// ---- prices, all from pricing.ts
const cat = findCategory('mugs')!;
const mug = findProduct('mugs', 'mug')!;
const selOf = (p: Product, options: Selection['options'] = {}, qty = p.qty.min): Selection => {
  const b = defaultSelection(p);
  return { ...b, qty, options: { ...b.options, ...options } };
};
const ladderMin = (p: Product, options: Selection['options'] = {}) => Math.min(...(p.ladder ? p.ladder(selOf(p, options)).map((t) => t.price) : [p.fromPrice]));
const oneUnit = (p: Product, options: Selection['options'] = {}) => p.quote(selOf(p, options, 1)).unit;

const models = page.models.map((m) => {
  const p = findProduct('mugs', m.product)!;
  const g = MODELS[m.art];
  return { ...m, vol: g.vol, d: g.d, h: g.h, from: ladderMin(p), one: oneUnit(p) };
});
const finishes = page.finishes.map((f) => ({ ...f, from: ladderMin(mug, { variant: f.id }), one: oneUnit(mug, { variant: f.id }) }));
const faq = buildMugFaq({ one330: rub(oneUnit(mug, { variant: 'white' })), oneChameleon: rub(oneUnit(mug, { variant: 'chameleon' })) });
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];

// ---- «Какие кружки печатаем»: one scale for all four drawings (px per mm); 5 cm grid behind them
const SSCALE = 1.5;
const tallest = Math.max(...models.map((m) => m.h));
const tones = ['c', 'm', 'y'];

// three facts under the buttons of the first screen (same row as on the t-shirt page)
const heroFacts = [{ big: '1 шт', small: 'можно заказать одну кружку' },{ big: '4 вида', small: '330 и 425 мл, кофейный набор, пивная' },{ big: '0 ₽', small: 'простой макет соберём сами' }];
const splitTail = (t: string): [string, string] => {
  const i = t.lastIndexOf(' ');
  return [t.slice(0, i + 1), t.slice(i + 1)];
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/portfolio/portfolio-30.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: Math.min(...cat.products.map((p) => p.fromPrice)), offerCount: cat.products.length }),
    faqPage(faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <section class="mhero">
    <div class="wrap mhero-grid">
      <div class="mhero-text">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow mhero-eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.lead}</p>
        <div class="mhero-actions">
          <a class="btn btn-magenta" href="#calc"><Icon name="calc" size={20} /> <span>Рассчитать<span class="long"> стоимость</span></span></a>
          <button type="button" class="btn btn-ghost" data-order><Icon name="upload" size={20} /> <span>Отправить макет</span></button>
        </div>
        <HeroFacts facts={heroFacts} />
      </div>
      <div class="mhero-media" role="img" aria-label={page.heroAlt}>
        <span class="mhero-dot mhero-dot-c" aria-hidden="true"></span>
        <span class="mhero-dot mhero-dot-m" aria-hidden="true"></span>
        <span class="mhero-dot mhero-dot-y" aria-hidden="true"></span>
        <div class="mhero-table halftone" aria-hidden="true">
          <div class="mhero-stage">
            <MugArt type="beer600" print="logo" scale={1.5} class="mhero-mug mhero-beer" />
            <MugArt type="mug330" finish="chameleon" print="photo" scale={1.5} class="mhero-mug mhero-cham" />
            <MugArt type="mug330" print="photo" scale={1.5} class="mhero-mug mhero-main" />
            <MugArt type="coffee" print="text" scale={1.5} class="mhero-mug mhero-coffee" />
          </div>
        </div>
        <span class="sticker mhero-price">
          от <span class="mono">{rub(mug.fromPrice)}</span><small>кружка 330 мл</small>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ calculator ============ -->
  <div class="band band-tint">
  <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">01</span>
          <p class="eyebrow">Калькулятор</p>
          <h2 id="calc-h">Посчитайте свои <span class="mark sec-mark">кружки</span></h2>
        </div>
        <p class="calc-sub">Выберите кружку, покрытие и количество — цена за штуку и за весь заказ пересчитается сразу. Кружка, печать и макет уже в цене.</p>
      </div>
      <Calculator client:visible category="mugs" product="mug" hideCategories />
    </div>
    <AlsoOrder slugs={page.alsoOrder} />
  </section>
  </div>

  <div class="band">
  <MugPackages />
  </div>

  <!-- ============ four models on one shelf, one scale ============ -->
  <div class="band band-tint">
  <section class="section kinds" aria-labelledby="kinds-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-m">
          <span class="sec-num mono" aria-hidden="true">03</span>
          <p class="eyebrow">Какие кружки печатаем</p>
          <h2 id="kinds-h">Кружки 330 и 425 мл, кофейный набор и пивная <span class="mark sec-mark">кружка</span></h2>
        </div>
        <p class="kinds-sub">Все четыре нарисованы в одном масштабе — видно, какая больше. Одна клетка на фоне — 5 × 5 см.</p>
      </div>
      <div class="kinds-shelf" style={`--cell:${50 * SSCALE}px;--wall:${Math.round(tallest * SSCALE) + 24}px`}>
        <ol class="kinds-row">
          {
            models.map((m, i) => (
              <li class={`kinds-item kinds-${tones[i % 3]}`}>
                <a class="kinds-art" href={`#kind-${m.art}`} aria-label={m.name}>
                  <MugArt type={m.art} print={i === 3 ? 'text' : i === 2 ? 'logo' : 'photo'} scale={SSCALE} title={`${m.name}, диаметр ${m.d} мм`} />
                </a>
                <span class="kinds-vol mono">{m.vol} мл</span>
              </li>
            ))
          }
        </ol>
        <span class="kinds-legend mono" aria-hidden="true"><i></i> 5 см</span>
      </div>
      <ul class="kinds-cards">
        {
          models.map((m, i) => (
            <li id={`kind-${m.art}`} class={`kcard kinds-${tones[i % 3]}`}>
              <div class="kcard-top">
                <span class="kinds-num mono" aria-hidden="true">{i + 1}</span>
                <span class="kcard-tag">{m.tag}</span>
              </div>
              <h3>{m.name}</h3>
              <dl class="kcard-specs">
                <div><dt>Объём</dt><dd class="mono">{m.vol} мл</dd></div>
                <div><dt>Диаметр</dt><dd class="mono">{m.d} мм</dd></div>
                <div><dt>Высота</dt><dd class="mono">≈ {m.h} мм</dd></div>
                <div><dt>1 шт</dt><dd class="mono">{rub(m.one)}</dd></div>
              </dl>
              <p>{m.text}</p>
              <div class="kcard-foot">
                <span class="kcard-price mono">от {rub(m.from)}<small>/шт</small></span>
                <a class="btn btn-sm btn-ghost" href={`${page.slug}?calc=mugs:${m.product}#calc`}>Рассчитать</a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ coatings of the 330 ml mug ============ -->
  <div class="band">
  <section class="section fin" aria-labelledby="fin-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-c">
          <span class="sec-num mono" aria-hidden="true">04</span>
          <p class="eyebrow">Покрытия</p>
          <h2 id="fin-h">Покрытия кружки 330 <span class="mark sec-mark">мл</span></h2>
        </div>
        <p>Одна и та же кружка 330 мл в шести вариантах. Цена «от» — для тиража, ниже — за одну кружку с печатью.</p>
      </div>
      <ul class="fin-grid">
        {
          finishes.map((f) => (
            <li class={`fin-card fin-${f.id}`}>
              <div class="fin-art" aria-hidden="true">
                {f.id === 'chameleon' ? (
                  <span class="cham">
                    <MugArt type="mug330" finish="chameleon" print="none" scale={1.25} class="cham-cold" />
                    <MugArt type="mug330" finish="chameleon" print="photo" scale={1.25} class="cham-hot" />
                    <span class="cham-label mono"><b class="cham-l-cold">холодная</b><b class="cham-l-hot">горячая</b></span>
                  </span>
                ) : (
                  <MugArt type="mug330" finish={f.id} print={f.print} tint={f.id === 'glitter' ? 'turquoise' : f.id === 'marble' ? 'pink' : undefined} scale={1.25} />
                )}
              </div>
              <div class="fin-body">
                <h3>{f.title}</h3>
                <p>{f.text}</p>
                {(f.id === 'color' || f.id === 'glitter' || f.id === 'marble') && (
                  <ul class="fin-colors" aria-label="Цвета">
                    {(f.id === 'color' ? page.innerColors : f.id === 'glitter' ? page.glitterColors : page.marbleColors).map((c) => (
                      <li title={c.name} style={`--sw:${c.hex}`}>
                        <span class="sr-only">{c.name}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="fin-meta">
                  <span class="fin-price mono">от {rub(f.from)}</span>
                  <span class="fin-one">1 шт — <b class="mono">{rub(f.one)}</b></span>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ what can be printed ============ -->
  <div class="band">
  <section class="section prn" aria-labelledby="prn-h">
    <div class="wrap">
      <div class="sec-titled sec-y">
        <span class="sec-num mono" aria-hidden="true">05</span>
        <p class="eyebrow">Идеи</p>
        <h2 id="prn-h" class="prn-title">Что можно напечатать на <span class="mark sec-mark">кружке</span></h2>
      </div>
      <ul class="prn-grid">
        {
          page.prints.map((p, i) => (
            <li class={`prn-card kinds-${tones[i % 3]}`}>
              <div class="prn-art" aria-hidden={p.photo ? undefined : 'true'}>
                {p.photo ? (
                  <img src={p.photo} alt={p.photoAlt} width="480" height="480" loading="lazy" decoding="async" />
                ) : (
                  <MugArt type="mug330" finish={p.finish} print={p.print} scale={1.1} />
                )}
                {p.photo && <span class="prn-real mono">наша работа</span>}
              </div>
              <div class="prn-body">
                <span class="prn-tag mono">{p.tag}</span>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ technology and care ============ -->
  <div class="band">
  <section class="section tech" aria-labelledby="tech-h">
    <div class="wrap tech-grid">
      <div>
        <div class="sec-titled sec-c">
          <span class="sec-num mono" aria-hidden="true">06</span>
          <p class="eyebrow">Технология</p>
          <h2 id="tech-h">{splitTail(page.tech.title)[0]}<span class="mark sec-mark">{splitTail(page.tech.title)[1]}</span></h2>
        </div>
        <ol class="tech-steps">
          {
            page.tech.steps.map((s, i) => (
              <li class={`tech-${tones[i % 3]}`}>
                <span class="tech-num mono">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <ul class="tech-facts">
          {page.tech.facts.map((t) => <li><Icon name="check" size={16} /> {t}</li>)}
        </ul>
      </div>
      <details class="care" open data-fold>
        <summary><h3>Как ухаживать за кружкой</h3></summary>
        <ul class="care-list">
          {
            page.care.map((c) => (
              <li class={c.ok ? 'care-ok' : 'care-no'}>
                <span class="care-ico mono" aria-hidden="true">{c.ok ? '✓' : '✕'}</span>
                <span>{c.text}</span>
              </li>
            ))
          }
        </ul>
        <p class="care-note">Сомневаетесь, подойдёт ли кружка для вашего случая, — спросите у мастера при заказе.</p>
      </details>
    </div>
  </section>
  </div>

  <!-- ============ for whom ============ -->
  <div class="band band-tint">
  <section class="section aud" aria-labelledby="aud-h">
    <div class="wrap">
      <p class="eyebrow">Для кого</p>
      <h2 id="aud-h" class="aud-title">Кому дарят и заказывают кружки с печатью</h2>
      <ul class="aud-grid">
        {
          page.audience.map((a, i) => (
            <li class={`aud-card kinds-${tones[i % 3]}`}>
              <span class="aud-tag mono">{a.tag}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="aud-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ how to order ============ -->
  <div class="band">
  <section class="section how" aria-labelledby="how-h">
    <div class="wrap how-grid">
      <div>
        <p class="eyebrow">Заказ</p>
        <h2 id="how-h">Как заказать печать на <span class="mark">кружке</span></h2>
        <ol class="how-steps">
          {
            page.steps.map((s, i) => (
              <li>
                <span class="how-dot mono">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <aside class="how-side">
        <details class="how-card" open data-fold>
          <summary><h3>{page.layout.title}</h3></summary>
          <ul class="how-list">
            {page.layout.items.map((t) => <li>{t}</li>)}
          </ul>
          <a class="how-more" href="/trebovaniya-k-maketam">Требования к макетам →</a>
        </details>
        <div class="how-b2b">
          <h3>{page.b2b.title}</h3>
          <ul class="how-chips">
            {page.b2b.items.map((t) => <li><Icon name="check" size={16} /> {t}</li>)}
          </ul>
          <button type="button" class="btn btn-sm how-b2b-btn" data-order="Кружки с логотипом для компании — рассчитать тираж">Рассчитать тираж</button>
          <a class="how-more" href="/korporativnym-klientam">Корпоративным клиентам →</a>
        </div>
      </aside>
    </div>
  </section>
  </div>

  <script is:inline>
    // folding cards are always open on a computer; on a phone they start folded (tap to open), as on the t-shirt page
    (function () {
      var m = matchMedia('(max-width: 760px)');
      document.querySelectorAll('.tech [data-fold], .how [data-fold]').forEach(function (d) {
        if (m.matches) d.open = false;
        d.querySelector('summary').addEventListener('click', function (e) {
          if (!m.matches) e.preventDefault();
        });
        m.addEventListener('change', function (e) {
          d.open = !e.matches;
        });
      });
    })();
  </script>

  <div class="band band-tint">
  <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: кружки и кофейные наборы" />
  </div>

  <div class="band">
  <Reviews keywords={page.reviewKeywords} title="Отзывы о кружках" />
  </div>

  <div class="band band-tint">
  <FaqSection items={faq} title="Вопросы о печати на кружках" />
  </div>

  <!-- ============ SEO text (folded on phones) ============ -->
  <div class="band">
  <section class="section seo-text" aria-labelledby="seo-h">
    <div class="wrap">
      <h2 id="seo-h">{page.seo.title}</h2>
      <input type="checkbox" id="seo-more" class="seo-toggle" />
      <div class="seo-cols">
        {
          page.seo.sections.map((s) => (
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          ))
        }
        <div>
          <h3>Смотрите также</h3>
          <p>
            <a href="/fotopodarki">фотоподарки</a> · <a href="/pechat-na-futbolkah">печать на футболках</a> · <a href="/magnity">магниты с фото</a> ·
            <a href="/korporativnym-klientam">корпоративным клиентам</a> · <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
          </p>
        </div>
      </div>
      <label for="seo-more" class="seo-more-btn">Читать полностью</label>
    </div>
  </section>
  </div>

  <div class="band band-tint">
  {related.length > 0 && <TshirtRelated items={related} />}
  </div>

  <CtaBand title="Хотите кружку со своим фото?" text="Пришлите снимок, надпись или логотип — соберём макет, покажем, как он ляжет на кружку, и посчитаем цену." />
</BaseLayout>

<style>
  /* data-restyled: bands, numbered headings, hangers — like /pechat-na-futbolkah (owner, 07.11.2026) */
  /* ================= first screen ================= */
  .mhero {
    padding-block: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 40px);
    overflow: clip;
  }
  .mhero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .mhero-text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .mhero-eyebrow {
    margin: 0 0 -8px;
  }
  .mhero-text h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }
  .mhero-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .mhero-chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .mhero-chips :global(svg) {
    color: var(--m-ink);
  }
  .mhero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .mhero-media {
    position: relative;
    padding: 24px;
  }
  /* a table top with four mugs; the stage is drawn at a fixed size and zoomed with the column */
  .mhero-table {
    position: relative;
    z-index: 1;
    aspect-ratio: 1;
    border-radius: 40px 40px 40px 120px;
    background-color: var(--paper-2);
    --dot: rgba(22, 20, 27, 0.1);
    overflow: clip;
  }
  .mhero-table::after {
    content: '';
    position: absolute;
    inset: 66% 0 0;
    background: linear-gradient(rgba(22, 20, 27, 0.07), rgba(22, 20, 27, 0.02));
    border-top: 2px solid rgba(22, 20, 27, 0.08);
  }
  .mhero-stage {
    --hz: 1;
    zoom: var(--hz);
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 440px;
    margin: -220px 0 0 -220px;
    z-index: 1;
  }
  .mhero-stage :global(.mhero-mug) {
    position: absolute;
    filter: drop-shadow(0 16px 18px rgba(22, 20, 27, 0.2));
  }
  .mhero-stage :global(.mhero-beer) {
    left: 22px;
    bottom: 150px;
  }
  .mhero-stage :global(.mhero-cham) {
    right: 26px;
    bottom: 168px;
  }
  .mhero-stage :global(.mhero-main) {
    left: 92px;
    bottom: 48px;
    z-index: 2;
  }
  .mhero-stage :global(.mhero-coffee) {
    right: -6px;
    bottom: 34px;
    z-index: 3;
  }
  .mhero-price {
    position: absolute;
    right: 0;
    bottom: 40px;
    z-index: 3;
    display: grid;
    font-size: 1.25rem;
    text-align: center;
  }
  .mhero-price small {
    font-size: 0.75rem;
    font-weight: 700;
  }
  .mhero-dot {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: multiply;
    z-index: 0;
  }
  .mhero-dot-c {
    width: 120px;
    height: 120px;
    background: var(--c);
    top: -6px;
    right: -10px;
  }
  .mhero-dot-m {
    width: 80px;
    height: 80px;
    background: var(--m);
    top: 40px;
    right: 60px;
    opacity: 0.8;
  }
  .mhero-dot-y {
    width: 110px;
    height: 110px;
    background: var(--y);
    bottom: 0;
    left: 0;
  }
  .calc-sec {
    background: var(--paper-2);
    border-radius: 48px;
    margin-inline: clamp(0px, 1.5vw, 20px);
  }

  /* ================= kinds: four mugs on one shelf ================= */
  /* --kz: zoom of the drawings on smaller screens; the 5 cm grid and the legend follow it, so the scale stays true */
  .kinds-shelf {
    --kz: 1;
    --cz: calc(var(--cell) * var(--kz));
    --gy: calc(100% - 73px); /* the grid starts at the top of the shelf board */
    position: relative;
    padding: 44px 0 22px;
    border-radius: var(--radius-l);
    background:
      linear-gradient(0deg, rgba(22, 20, 27, 0.07) 1px, transparent 1px) 0 var(--gy) / 100% var(--cz),
      linear-gradient(90deg, rgba(22, 20, 27, 0.07) 1px, transparent 1px) 50% 0 / var(--cz) 100%,
      var(--paper-2);
    overflow: clip;
  }
  .kinds-row {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    align-items: end;
  }
  .kinds-item {
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .kinds-c { --tone: var(--c); --soft: var(--c-soft); }
  .kinds-m { --tone: var(--m); --soft: var(--m-soft); }
  .kinds-y { --tone: var(--y); --soft: var(--y-soft); }
  /* each mug stands on its piece of the shelf board; the pieces join into one board across the row */
  .kinds-art {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    height: calc(var(--wall) * var(--kz));
    border-bottom: 12px solid var(--ink);
    color: inherit;
  }
  .kinds-art :global(svg) {
    zoom: var(--kz);
    transition: transform 0.2s ease;
  }
  .kinds-art:hover :global(svg) {
    transform: translateY(-4px);
  }
  .kinds-art :global(svg) {
    flex: none;
    filter: drop-shadow(0 12px 12px rgba(22, 20, 27, 0.18));
  }
  .kinds-vol {
    position: relative;
    z-index: 2;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tone);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .kinds-m .kinds-vol {
    color: #fff;
  }
  .kinds-num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--tone);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.82rem;
  }
  .kinds-m .kinds-num {
    color: #fff;
  }
  .kinds-legend {
    position: absolute;
    right: 18px;
    top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .kinds-legend i {
    width: var(--cz);
    height: 6px;
    border: 1.5px solid var(--ink);
    border-top: 0;
  }
  .kinds-cards {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .kcard {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    border-radius: 24px 24px 24px 8px;
    background: var(--card);
    border: 1.5px solid var(--line);
    border-top: 5px solid var(--tone);
    scroll-margin-top: 90px;
  }
  .kcard:target {
    box-shadow: 5px 5px 0 var(--tone);
  }
  .kcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .kcard-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--soft);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .kcard h3 {
    font-size: 1.1rem;
  }
  .kcard-specs {
    margin: 0;
    display: grid;
    gap: 3px;
    font-size: 0.84rem;
  }
  .kcard-specs div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1px dashed var(--line);
  }
  .kcard-specs dt {
    color: var(--muted);
  }
  .kcard-specs dd {
    margin: 0;
    font-weight: 700;
    white-space: nowrap;
  }
  .kcard p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .kcard-foot {
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .kcard-price {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .kcard-price small {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0;
  }

  /* colour dots on the «цветная ручка и внутри» card */
  .fin-colors {
    list-style: none;
    margin: 4px 0 8px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .fin-colors li {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: 0 0 0 1.5px rgba(255, 252, 245, 0.55);
  }
  /* ================= coatings (dark band) ================= */
  .fin {
    background: var(--ink);
    color: var(--paper);
    border-radius: 48px;
    margin-inline: clamp(0px, 1.5vw, 20px);
  }
  .fin h2,
  .fin .eyebrow {
    color: var(--paper);
  }
  .fin .section-head p {
    color: rgba(255, 252, 245, 0.72);
  }
  .fin-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .fin-card {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    border-radius: var(--radius-l);
    background: rgba(255, 252, 245, 0.06);
    border: 1.5px solid rgba(255, 252, 245, 0.14);
    overflow: clip;
  }
  .fin-art {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 170px;
    background: radial-gradient(circle at 50% 45%, rgba(255, 252, 245, 0.2), transparent 68%);
  }
  .fin-art :global(svg) {
    flex: none;
    max-width: 150px;
    height: auto;
    filter: drop-shadow(0 12px 14px rgba(0, 0, 0, 0.45));
  }
  .fin-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 18px 18px 18px 4px;
  }
  .fin-body h3 {
    color: var(--paper);
    font-size: 1.08rem;
  }
  .fin-body > p:not(.fin-meta) {
    margin: 0;
    color: rgba(255, 252, 245, 0.78);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .fin-meta {
    margin: auto 0 0;
    padding-top: 8px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }
  .fin-price {
    padding: 3px 11px;
    border-radius: 999px;
    background: var(--y);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .fin-chameleon .fin-price { background: var(--m); color: #fff; }
  .fin-glitter .fin-price { background: #f4b6dc; }
  .fin-marble .fin-price,
  .fin-gold .fin-price { background: #e9d08a; }
  .fin-white .fin-price { background: var(--paper); }
  .fin-color .fin-price { background: var(--c); }
  .fin-one {
    font-size: 0.82rem;
    color: rgba(255, 252, 245, 0.7);
  }
  .fin-one b {
    color: var(--paper);
  }
  .fin-chameleon {
    border-color: rgba(229, 0, 125, 0.6);
    box-shadow: 0 0 0 1px rgba(229, 0, 125, 0.3) inset;
  }
  /* chameleon: cold (dark) and hot (print shows) states fade into each other, with steam */
  .cham {
    position: relative;
    display: grid;
  }
  .cham > :global(svg) {
    grid-area: 1 / 1;
  }
  .cham :global(.cham-hot) {
    animation: cham-hot 5s ease-in-out infinite;
  }
  .cham-label {
    position: absolute;
    left: 50%;
    bottom: -18px;
    transform: translateX(-50%);
    display: grid;
    font-size: 0.75rem;
  }
  .cham-label b {
    grid-area: 1 / 1;
    padding: 2px 8px;
    border-radius: 999px;
    text-align: center;
    white-space: nowrap;
  }
  .cham-l-cold {
    background: rgba(255, 252, 245, 0.16);
    color: var(--paper);
    animation: cham-cold 5s ease-in-out infinite;
  }
  .cham-l-hot {
    background: var(--m);
    color: #fff;
    animation: cham-hot 5s ease-in-out infinite;
  }
  @keyframes cham-hot {
    0%, 30% { opacity: 0; }
    50%, 80% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes cham-cold {
    0%, 30% { opacity: 1; }
    50%, 80% { opacity: 0; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cham :global(.cham-hot),
    .cham-l-hot {
      animation: none;
      opacity: 1;
    }
    .cham-l-cold {
      animation: none;
      opacity: 0;
    }
  }

  /* ================= what can be printed ================= */
  .prn-title {
    margin-bottom: 28px;
    max-width: 820px;
  }
  .prn-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }
  .prn-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 26px 26px 26px 8px;
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
  }
  .prn-art {
    position: relative;
    height: 180px;
    display: grid;
    place-items: center;
    background: var(--soft);
  }
  .prn-art {
    overflow: clip;
  }
  .prn-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prn-art :global(svg) {
    filter: drop-shadow(0 10px 12px rgba(22, 20, 27, 0.16));
  }
  .prn-real {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .prn-body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 6px;
    padding: 14px 16px 18px;
  }
  .prn-tag {
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--soft);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .prn-body h3 {
    font-size: 1.08rem;
  }
  .prn-body p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.45;
  }

  /* ================= technology and care ================= */
  .tech {
    background: var(--paper-2);
    border-radius: 48px;
    margin-inline: clamp(0px, 1.5vw, 20px);
  }
  .tech-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .tech-grid h2 {
    margin-bottom: 22px;
  }
  .tech-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .tech-steps li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 16px;
    border-radius: 22px 22px 22px 6px;
    background: var(--card);
    border: 1.5px solid var(--line);
  }
  .tech-c { --tone: var(--c); }
  .tech-m { --tone: var(--m); }
  .tech-y { --tone: var(--y); }
  .tech-num {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    box-shadow: 3px 3px 0 var(--tone);
  }
  .tech-steps h3 {
    margin: 0 0 4px;
    font-size: 1.02rem;
  }
  .tech-steps p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .tech-facts {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .tech-facts li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 0.93rem;
  }
  .tech-facts :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--m-ink);
  }
  .care {
    display: grid;
    gap: 12px;
    padding: 24px;
    border-radius: 30px 30px 30px 8px;
    background: var(--card);
    border: 2px solid var(--ink);
    box-shadow: 6px 6px 0 var(--c);
  }
  .care summary {
    list-style: none;
    cursor: default;
  }
  .care summary::-webkit-details-marker {
    display: none;
  }
  .care h3 {
    font-size: 1.25rem;
  }
  .care-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .care-list li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 10px;
    align-items: start;
    font-size: 0.93rem;
    line-height: 1.4;
  }
  .care-ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-weight: 700;
  }
  .care-ok .care-ico {
    background: var(--c-soft);
    color: var(--ink);
  }
  .care-no .care-ico {
    background: var(--m-soft);
    color: var(--m-ink);
  }
  .care-note {
    margin: 12px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* ================= audience ================= */
  .aud-title {
    margin-bottom: 28px;
    max-width: 820px;
  }
  .aud-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .aud-card {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 8px;
    padding: 22px 22px 56px;
    border-radius: 26px 26px 26px 8px;
    background: var(--soft);
    overflow: clip;
  }
  .aud-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .aud-card h3 {
    font-size: 1.2rem;
  }
  .aud-card p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .aud-num {
    position: absolute;
    right: 16px;
    bottom: -14px;
    font-size: 4rem;
    font-weight: 800;
    color: var(--tone);
    opacity: 0.5;
    line-height: 1;
  }

  /* ================= how to order ================= */
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .how-grid h2 {
    margin-bottom: 26px;
  }
  .how-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .how-steps li {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding-bottom: 22px;
  }
  .how-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 48px;
    bottom: 4px;
    border-left: 2px dashed var(--line-strong);
  }
  .how-dot {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--card);
    font-weight: 700;
  }
  .how-steps li:nth-child(3n + 1) .how-dot { box-shadow: 3px 3px 0 var(--c); }
  .how-steps li:nth-child(3n + 2) .how-dot { box-shadow: 3px 3px 0 var(--m); }
  .how-steps li:nth-child(3n + 3) .how-dot { box-shadow: 3px 3px 0 var(--y); }
  .how-steps h3 {
    margin: 10px 0 4px;
    font-size: 1.1rem;
  }
  .how-steps p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .how-side {
    display: grid;
    gap: 14px;
  }
  .how-card,
  .how-b2b {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 22px;
    border-radius: var(--radius-l);
  }
  .how-card li {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .how-card {
    background: var(--y-soft);
  }
  .how-card summary {
    list-style: none;
    cursor: default;
  }
  .how-card summary::-webkit-details-marker {
    display: none;
  }
  .how-list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .how-list li::marker {
    color: var(--m);
  }
  .how-more {
    font-weight: 700;
    color: var(--m-ink);
  }
  .how-b2b {
    background: var(--ink);
    color: var(--paper);
  }
  .how-b2b h3 {
    color: var(--paper);
  }
  .how-b2b .how-more {
    color: var(--y);
  }
  .how-b2b-btn {
    background: var(--y);
    color: var(--ink);
    border-color: var(--y);
  }
  .how-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .how-chips li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 252, 245, 0.25);
    font-size: 0.84rem;
    font-weight: 600;
  }
  .how-chips :global(svg) {
    color: var(--y);
  }

  /* ================= seo text ================= */
  .seo-text h2 {
    margin-bottom: 24px;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .seo-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 48px;
  }
  .seo-cols h3 {
    margin-bottom: 8px;
    font-size: 1.1rem;
  }
  .seo-cols p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.96rem;
    line-height: 1.6;
  }
  .seo-toggle,
  .seo-more-btn {
    display: none;
  }

  /* ================= related ================= */
  .related-h {
    margin-bottom: 24px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .related-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 18px 10px 10px;
    border-radius: 24px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .related-card img {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    object-fit: cover;
  }
  .related-card span {
    flex: 1;
  }
  .related-card:hover {
    border-color: var(--ink);
    box-shadow: 4px 4px 0 var(--y);
    color: var(--ink);
  }

  /* ================= tablets ================= */
  @media (max-width: 1180px) {
    .fin-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .prn-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .aud-grid,
    .kinds-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));

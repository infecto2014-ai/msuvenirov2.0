  /* ================= tablets ================= */
  @media (max-width: 1180px) {
    .aud-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shero-stage {
      --hz: 0.85;
    }
    .plc-card {
      grid-template-columns: 1fr;
    }
    .knd-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 960px) {
    .how-grid,
    .ways-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .shero-grid {
      grid-template-columns: 1fr;
    }
    .shero-media {
      max-width: 400px;
      justify-self: center;
      padding: 12px;
    }
    .shero-stage {
      --hz: 0.82;
    }
  }

  /* ================= phones (≤ 760px): compact, desktop untouched ================= */
  @media (max-width: 760px) {
    .shero {
      padding-block: 14px 22px;
    }
    .shero-grid {
      grid-template-columns: minmax(0, 1fr) 118px;
      gap: 12px 14px;
      align-items: start;
    }
    .shero-text {
      display: contents;
    }
    .shero-text > :global(.crumbs),
    .shero-text h1,
    .shero-chips,
    .shero-actions {
      grid-column: 1 / -1;
    }
    .shero-eyebrow {
      display: none;
    }
    .shero-text > :global(.crumbs) {
      order: 1;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .shero-text > :global(.crumbs) :global(ol) {
      flex-wrap: nowrap;
      white-space: nowrap;
      font-size: 0.78rem;
    }
    .shero-text h1 {
      order: 2;
      font-size: clamp(1.7rem, 7.6vw, 2.1rem);
    }
    .lead {
      order: 3;
      grid-column: 1;
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.45;
    }
    .shero-media {
      order: 4;
      grid-column: 2;
      grid-row: 3;
      max-width: none;
      justify-self: stretch;
      padding: 0 0 12px;
    }
    .shero-wall {
      aspect-ratio: 3 / 4.6;
      border-radius: 20px 20px 48px 20px;
    }
    /* phone: only the black cap and the colour row */
    .shero-stage {
      --hz: 1;
      zoom: 1;
      inset: 0;
      width: auto;
      height: auto;
      margin: 0;
    }
    .shero-stage :global(.shero-sub),
    .shero-stage :global(.shero-logos) {
      display: none;
    }
    .shero-stage :global(.shero-main) {
      left: -8%;
      top: 4%;
      width: 116%;
      height: auto;
      filter: drop-shadow(0 6px 8px rgba(22, 20, 27, 0.2));
    }
    .shero-swatches {
      bottom: 34px;
      gap: 3px;
      padding: 4px 5px;
    }
    .shero-swatches li {
      width: 9px;
      height: 9px;
      border-radius: 3px;
    }
    .shero-dot {
      display: none;
    }
    .shero-price {
      right: -4px;
      bottom: 0;
      padding: 4px 8px;
      border-radius: 10px;
      font-size: 0.76rem;
      line-height: 1.15;
    }
    .shero-price small {
      font-size: 0.75rem;
    }
    .shero-price::before {
      display: none;
    }
    .shero-chips {
      order: 5;
      flex-wrap: nowrap;

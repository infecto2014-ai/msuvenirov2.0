  /* ================= where we print ================= */
  .plc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .plc-c { --tone: var(--c); --soft: var(--c-soft); }
  .plc-m { --tone: var(--m); --soft: var(--m-soft); }
  .plc-y { --tone: var(--y); --soft: var(--y-soft); }
  /* three places: picture on top, text below */
  .plc-card {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
    align-items: start;
    border-radius: 34px 34px 34px 10px;
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
  }
  .plc-art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 18px 10px;
    background:
      radial-gradient(circle, rgba(22, 20, 27, 0.08) 1.3px, transparent 1.5px) 0 0 / 14px 14px,
      var(--soft);
  }
  .plc-art :global(svg) {
    filter: drop-shadow(0 12px 12px rgba(22, 20, 27, 0.18));
  }
  .plc-num {
    position: absolute;
    left: 14px;
    top: 14px;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-weight: 800;
    font-size: 1.1rem;
    box-shadow: 3px 3px 0 var(--tone);
  }
  .plc-body {
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 20px 22px;
  }
  .plc-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--tone);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .plc-y .plc-tag {
    background: var(--y);
    color: var(--ink);
  }
  .plc-m .plc-tag {
    color: #fff;
  }
  .plc-body h3 {
    font-size: 1.4rem;
  }
  .plc-size {
    margin: 0;
    display: flex;
    gap: 6px;
    align-items: flex-start;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .plc-size :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--m-ink);
  }
  .plc-body p:not(.plc-size) {
    margin: 0;
    font-size: 0.92rem;

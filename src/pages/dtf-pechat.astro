  /* ================= applied by us ================= */
  .apl-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .apl-c { --tone: var(--c); --soft: var(--c-soft); }
  .apl-m { --tone: var(--m); --soft: var(--m-soft); }
  .apl-y { --tone: var(--y); --soft: var(--y-soft); }
  .apl-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border-radius: 24px 24px 24px 8px;
    background: var(--soft);
    color: var(--ink);

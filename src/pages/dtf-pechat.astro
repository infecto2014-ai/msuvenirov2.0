---
// «DTF-печать и сублимационные листы» — own page (like the workwear page): first screen, calculator (category
// 'transfers'), ready options, what fits on a sheet, DTF or sublimation, audience, how to order, works, reviews, FAQ, SEO.
// Content — src/data/transfersPage.ts; prices — pricing.ts ('dtf-sheet', 'sub-sheet'); drawings —
// src/components/sheet/SheetArt.astro. Listed in the «Одежда» menu and in the sitemap's static pages.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import SheetArt from '@/components/sheet/SheetArt.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import HeroFacts from '@/components/tshirt/HeroFacts.astro';
import { transfersPage as page, buildTransfersFaq } from '@/data/transfersPage';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { SHEET_MAX, defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Печать на одежде', href: '/pechat-na-odezhde' },
  { name: 'DTF и сублимация без нанесения', href: page.slug },
];

// ---- prices, all from pricing.ts
const quoteOf = (productId: string, qty: number, options: Selection['options'] = {}) => {
  const p = findProduct('transfers', productId)!;
  const b = defaultSelection(p);
  return p.quote({ ...b, qty, options: { ...b.options, ...options } });
};
const dtf1 = quoteOf('dtf-sheet', 1).unit;
const dtf30 = quoteOf('dtf-sheet', 30).unit;
const faq = buildTransfersFaq({
  dtf1: rub(dtf1),
  dtf30: rub(dtf30),
  subA3: rub(quoteOf('sub-sheet', 1, { variant: 'a3' }).unit),
  subA4: rub(quoteOf('sub-sheet', 1, { variant: 'a4' }).unit),
  max: SHEET_MAX,
});
const dtfLadder = findProduct('transfers', 'dtf-sheet')!.ladder!(defaultSelection(findProduct('transfers', 'dtf-sheet')!));
const packages = page.packages.map((pk, i) => {
  const q = quoteOf(pk.product, pk.qty, pk.options);
  return { ...pk, unit: q.unit, total: q.total, tone: ['c', 'm', 'y'][i % 3] };
});
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
const hasReviews = reviews.some((r) => page.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));
const tones = ['c', 'm', 'y'];
// «Нужно нанести?»: «от» prices of the applied services, from pricing.ts
const applyLinks = page.applyLinks.map((l) => ({ ...l, from: findProduct('textile', l.product)!.fromPrice }));

// three facts under the buttons of the first screen (same row as on the t-shirt page)
const heroFacts = [{ big: '28×38 см', small: 'поле DTF-листа' },{ big: 'от 1 листа', small: 'минимальный заказ' },{ big: 'А3 и А4', small: 'сублимационные листы' }];
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/portfolio/portfolio-20.webp"
  schema={[breadcrumbs(crumbs), serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: quoteOf('sub-sheet', 30, { variant: 'a4' }).unit, offerCount: 3 }), faqPage(faq)]}
>
  <!-- ============ first screen ============ -->
  <section class="shero">
    <div class="wrap shero-grid">
      <div class="shero-text">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow shero-eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.lead}</p>
        <div class="shero-actions">
          <a class="btn btn-magenta" href="#calc"><Icon name="calc" size={20} /> <span>Рассчитать<span class="long"> листы</span></span></a>
          <button type="button" class="btn btn-ghost" data-order="DTF-печать листами — отправить макет"><Icon name="upload" size={20} /> <span>Отправить макет</span></button>
        </div>
        <HeroFacts facts={heroFacts} />
      </div>
      <div class="shero-media" role="img" aria-label={page.heroAlt}>
        <span class="shero-dot shero-dot-c" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-m" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-y" aria-hidden="true"></span>
        <div class="shero-wall halftone" aria-hidden="true">
          <div class="shero-stage">
            <SheetArt kind="sub" format="a4" layout="four" scale={0.62} class="shero-sh shero-sub" />
            <SheetArt kind="dtf" layout="logos" scale={0.62} class="shero-sh shero-logos" />
            <SheetArt kind="dtf" layout="mix" scale={0.95} class="shero-sh shero-main" />
          </div>
        </div>
        <span class="sticker shero-price">
          от <span class="mono">{rub(dtf30)}</span><small>за лист DTF</small>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ calculator ============ -->
  <div class="band band-tint">
  <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">01</span>
          <p class="eyebrow">Калькулятор</p>
          <h2 id="calc-h">Посчитайте <span class="mark sec-mark">листы</span></h2>
        </div>
        <p class="calc-sub">DTF-листы 28 × 38 см или сублимационные А3 и А4 — выберите и укажите количество листов. Больше {SHEET_MAX} листов — индивидуально.</p>
      </div>
      <Calculator client:visible category="transfers" product="dtf-sheet" hideCategories />
    </div>
    <AlsoOrder slugs={page.alsoOrder} />
  </section>
  </div>

  <!-- ============ ready options ============ -->
  <div class="band">
  <section class="section spk" aria-labelledby="spk-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-m">
          <span class="sec-num mono" aria-hidden="true">02</span>
          <p class="eyebrow">Популярное</p>
          <h2 id="spk-h">Готовые варианты с <span class="mark sec-mark">ценой</span></h2>
        </div>
        <p class="spk-sub">Цена за листы с вашими принтами, без нанесения.</p>
      </div>
      <ul class="spk-grid">
        {
          packages.map((it) => (
            <li class={`spk-card spk-${it.tone}`}>
              <div class="spk-art" aria-hidden="true">
                <SheetArt kind={it.kind} format={it.format} layout={it.layout} scale={it.kind === 'sub' && it.format === 'a3' ? 0.48 : 0.54} />
                <span class="spk-qty mono">{it.qty} {it.qty === 1 ? 'лист' : it.qty < 5 ? 'листа' : 'листов'}</span>
                <span class="spk-tech mono">{it.kind === 'dtf' ? 'DTF' : `сублимация ${it.format === 'a4' ? 'А4' : 'А3'}`}</span>
              </div>
              <div class="spk-body">
                <h3>{it.title}</h3>
                <p class="spk-note">{it.note}</p>
                <p class="spk-price mono">
                  {rub(it.total)}
                  {it.qty > 1 && <small>{rub(it.unit)} / лист</small>}
                </p>
                <button type="button" class="btn btn-sm btn-magenta" data-order={`${it.title} — ${rub(it.total)}`}>
                  Заказать
                </button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ what fits on a sheet ============ -->
  <div class="band band-tint">
  <section class="section knd" aria-labelledby="knd-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-c">
          <span class="sec-num mono" aria-hidden="true">03</span>
          <p class="eyebrow">Раскладка</p>
          <h2 id="knd-h">Что поместится на лист 28 × 38 <span class="mark sec-mark">см</span></h2>
        </div>
        <p>Платите за лист, а не за картинку: разложите на нём сколько угодно принтов разного размера.</p>
      </div>
      <ul class="knd-grid knd-grid-4">
        {
          page.layouts.map((k, i) => (
            <li class={`knd-card knd-${tones[i % 3]}`}>
              <div class="knd-art" aria-hidden="true">
                <SheetArt kind="dtf" layout={k.layout} scale={0.4} />
              </div>
              <div>
                <h3>{k.title}</h3>
                <p>{k.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <ul class="tr-tiers" aria-label="Цена листа DTF по количеству">
        {dtfLadder.map((t, i) => (
          <li>
            <small>{i < dtfLadder.length - 1 ? `${t.from}–${dtfLadder[i + 1].from - 1} листов` : `${t.from}–${SHEET_MAX} листов`}</small>
            <b class="mono">{rub(t.price)}</b>
            <small>за лист DTF</small>
          </li>
        ))}
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ DTF or sublimation ============ -->
  <div class="band">
  <section class="section ways" aria-labelledby="ways-h">
    <div class="wrap">
      <div class="sec-titled sec-c">
        <span class="sec-num mono" aria-hidden="true">04</span>
        <p class="eyebrow">Технология</p>
        <h2 id="ways-h" class="ways-title">DTF-трансферы или сублимационные <span class="mark sec-mark">листы</span></h2>
      </div>
      <div class="ways-grid">
        {
          page.tech.map((w, i) => (
            <article class={`ways-card ways-${i ? 'ink' : 'y'}`}>
              <div class="tr-art" aria-hidden="true">
                <SheetArt kind={i ? 'sub' : 'dtf'} layout="mix" scale={0.34} />
              </div>
              <span class="ways-tag mono">{w.tag}</span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
              <ul>
                {w.points.map((x) => <li><Icon name="check" size={16} /> {x}</li>)}
              </ul>
              <a class={`btn btn-sm ${i ? 'ways-btn' : 'btn-magenta'}`} href={`${page.slug}?calc=transfers:${i ? 'sub-sheet' : 'dtf-sheet'}#calc`}>
                Рассчитать {i ? 'сублимацию' : 'DTF'}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  </div>

  <!-- ============ applied by us ============ -->
  <div class="band band-tint">
  <section class="section apl" aria-labelledby="apl-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">05</span>
          <p class="eyebrow">С нанесением</p>
          <h2 id="apl-h">Нужно нанести? Сделаем <span class="mark sec-mark">сами</span></h2>
        </div>
        <p>Нет пресса или не хочется возиться — перенесём принт на одежду и изделия в мастерской. Цена уже с нанесением.</p>
      </div>
      <ul class="apl-grid">
        {
          applyLinks.map((l, i) => (
            <li>
              <a class={`apl-card apl-${tones[i % 3]}`} href={l.href}>
                <span class="apl-title">{l.title}</span>
                <span class="apl-text">{l.text}</span>
                <span class="apl-foot">
                  <span class="apl-price mono">от {rub(l.from)}</span>
                  <Icon name="arrow" size={18} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ for whom ============ -->
  <div class="band">
  <section class="section aud" aria-labelledby="aud-h">
    <div class="wrap">
      <p class="eyebrow">Для кого</p>
      <h2 id="aud-h" class="aud-title">Кому подходят принты без нанесения</h2>
      <ul class="aud-grid">
        {
          page.audience.map((a, i) => (
            <li class={`aud-card kinds-${tones[i % 3]}`}>
              <span class="aud-tag mono">{a.tag}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="aud-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ how to order ============ -->
  <div class="band band-tint">
  <section class="section how" aria-labelledby="how-h">
    <div class="wrap how-grid">
      <div>
        <p class="eyebrow">Заказ</p>
        <h2 id="how-h">Как заказать <span class="mark">DTF-печать</span></h2>
        <ol class="how-steps">
          {
            page.steps.map((s, i) => (
              <li>
                <span class="how-dot mono">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <aside class="how-side">
        <details class="how-card" open data-fold>
          <summary><h3>{page.layout.title}</h3></summary>
          <ul class="how-list">
            {page.layout.items.map((t) => <li>{t}</li>)}
          </ul>
          <a class="how-more" href="/trebovaniya-k-maketam">Требования к макетам →</a>
        </details>
        <div class="how-b2b">
          <h3>{page.b2b.title}</h3>
          <ul class="how-chips">
            {page.b2b.items.map((t) => <li><Icon name="check" size={16} /> {t}</li>)}
          </ul>
          <button type="button" class="btn btn-sm how-b2b-btn" data-order="DTF-печать листами — регулярные заказы">Обсудить условия</button>
          <a class="how-more" href="/korporativnym-klientam">Корпоративным клиентам →</a>
        </div>
      </aside>
    </div>
  </section>
  </div>

  <script is:inline>
    // folding cards are always open on a computer; on a phone they start folded (tap to open), as on the shoppers page
    (function () {
      var m = matchMedia('(max-width: 760px)');
      document.querySelectorAll('[data-fold]').forEach(function (d) {
        if (m.matches) d.open = false;
        d.querySelector('summary').addEventListener('click', function (e) {
          if (!m.matches) e.preventDefault();
        });
        m.addEventListener('change', function (e) {
          d.open = !e.matches;
        });
      });
    })();
  </script>

  <div class="band">
  <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: принты на одежде" />
  </div>

  <div class="band band-tint">
  <Reviews keywords={hasReviews ? page.reviewKeywords : undefined} title={hasReviews ? 'Отзывы о печати' : 'Что говорят клиенты'} />
  </div>

  <div class="band">
  <FaqSection items={faq} title="Вопросы о DTF-печати" />
  </div>

  <!-- ============ SEO text (folded on phones) ============ -->
  <div class="band band-tint">
  <section class="section seo-text" aria-labelledby="seo-h">
    <div class="wrap">
      <h2 id="seo-h">{page.seo.title}</h2>
      <input type="checkbox" id="seo-more" class="seo-toggle" />
      <div class="seo-cols">
        {
          page.seo.sections.map((s) => (
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          ))
        }
        <div>
          <h3>Смотрите также</h3>
          <p>
            <a href="/pechat-na-odezhde">печать на одежде</a> · <a href="/pechat-na-futbolkah">печать на футболках</a> · <a href="/pechat-na-hudi">худи</a> ·
            <a href="/sublimacionnaya-pechat">сублимационная печать</a> · <a href="/pechat-na-sportivnoy-forme">спортивная форма</a> ·
            <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
          </p>
        </div>
      </div>
      <label for="seo-more" class="seo-more-btn">Читать полностью</label>
    </div>
  </section>
  </div>

  <div class="band">
  {related.length > 0 && <TshirtRelated items={related} />}
  </div>



  <CtaBand title="Нужны принты, чтобы перенести самим?" text="Пришлите макет или картинки с размерами — проверим файлы, поможем разложить на лист и посчитаем заказ." />
</BaseLayout>

<style>
  /* data-restyled: bands, numbered headings, hangers — like /pechat-na-futbolkah (owner, 07.11.2026) */
  /* ================= first screen ================= */
  .shero {
    padding-block: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 40px);
    overflow: clip;
  }
  .shero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .shero-text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .shero-eyebrow {
    margin: 0 0 -8px;
  }
  .shero-text h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }
  .shero-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .shero-chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .shero-chips :global(svg) {
    color: var(--m-ink);
  }
  .shero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .shero-media {
    position: relative;
    padding: 24px;
  }
  /* a wall: three caps on it; the stage is drawn at a fixed size and zoomed with the column */
  .shero-wall {
    position: relative;
    z-index: 1;
    aspect-ratio: 1;
    border-radius: 40px 40px 120px 40px;
    background-color: var(--paper-2);
    --dot: rgba(22, 20, 27, 0.1);
    overflow: clip;
  }
  .shero-stage {
    --hz: 1;
    zoom: var(--hz);
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 440px;
    margin: -220px 0 0 -220px;
    z-index: 1;
  }
  .shero-price {
    position: absolute;
    right: 0;
    bottom: 40px;
    z-index: 3;
    display: grid;
    font-size: 1.25rem;
    text-align: center;
  }
  .shero-price small {
    font-size: 0.75rem;
    font-weight: 700;
  }
  .shero-dot {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: multiply;
    z-index: 0;
  }
  .shero-dot-c {
    width: 120px;
    height: 120px;
    background: var(--c);
    top: -6px;
    right: -10px;
  }
  .shero-dot-m {
    width: 80px;
    height: 80px;
    background: var(--m);
    bottom: 10px;
    left: 70px;
    opacity: 0.8;
  }
  .shero-dot-y {
    width: 110px;
    height: 110px;
    background: var(--y);
    top: 40%;
    left: 0;
  }
  .calc-sec {
    background: var(--paper-2);
    border-radius: 48px;
    margin-inline: clamp(0px, 1.5vw, 20px);
  }



  /* workwear on the wall */
  .shero-stage :global(.shero-sh) {
    position: absolute;
    filter: drop-shadow(0 14px 16px rgba(22, 20, 27, 0.18));
  }
  .shero-stage :global(.shero-sub) {
    left: -6px;
    top: 10px;
    transform: rotate(-7deg);
  }
  .shero-stage :global(.shero-logos) {
    right: -10px;
    top: 30px;
    transform: rotate(6deg);
  }
  .shero-stage :global(.shero-main) {
    left: 92px;
    top: 66px;
    z-index: 2;
    transform: rotate(-3deg);
  }
  .shero-swatches {
    display: none;
  }

  .spk-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }
  .spk-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .spk-card:hover {
    transform: translateY(-3px);
    box-shadow: 5px 5px 0 var(--tone);
  }
  .spk-c { --tone: var(--c); --soft: var(--c-soft); }
  .spk-m { --tone: var(--m); --soft: var(--m-soft); }
  .spk-y { --tone: var(--y); --soft: var(--y-soft); }
  /* the cap sits in a coloured frame with halftone dots */
  .spk-art {
    position: relative;
    height: 250px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: clip;
    background:
      radial-gradient(circle, rgba(22, 20, 27, 0.09) 1.3px, transparent 1.5px) 0 0 / 14px 14px,
      var(--soft);
  }
  .spk-art :global(svg) {
    flex: none;
    max-width: 78%;
    height: auto;
    filter: drop-shadow(0 10px 12px rgba(22, 20, 27, 0.16));
  }
  .spk-qty,
  .spk-tech {
    position: absolute;
    z-index: 1;
    top: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .spk-qty {
    right: 12px;

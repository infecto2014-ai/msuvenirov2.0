  .kinds-c { --tone: var(--c); --soft: var(--c-soft); }
  .kinds-m { --tone: var(--m); --soft: var(--m-soft); }
  .kinds-y { --tone: var(--y); --soft: var(--y-soft); }
  /* ================= what we print on ================= */
  .knd-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .knd-c { --tone: var(--c); --soft: var(--c-soft); }
  .knd-m { --tone: var(--m); --soft: var(--m-soft); }
  .knd-y { --tone: var(--y); --soft: var(--y-soft); }
  .knd-grid-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .tr-tiers {
    list-style: none;

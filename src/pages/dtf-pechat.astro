  .tr-tiers li:nth-child(2) { box-shadow: inset 0 -4px 0 var(--m); }
  .tr-tiers li:nth-child(3) { box-shadow: inset 0 -4px 0 var(--y); }
  .tr-tiers li:nth-child(4) { box-shadow: inset 0 -4px 0 #fff; }
  .tr-tiers small {

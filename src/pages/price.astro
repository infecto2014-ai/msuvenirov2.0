---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InkHero from '@/components/ink/InkHero.astro';
import InkHead from '@/components/ink/InkHead.astro';
import Icon from '@/components/Icon.astro';
import Calculator from '@/components/islands/Calculator';
import PriceTables from '@/components/PriceTables.astro';
import CtaBand from '@/components/CtaBand.astro';
import { categories } from '@/data/pricing';
import { breadcrumbs } from '@/lib/schema';
import { site } from '@/data/site';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Цены и калькулятор', href: '/price' },
];

const catalogLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Прайс-лист Мастерской сувениров',
  url: `${site.url}/price`,
  itemListElement: categories.map((c) => ({
    '@type': 'OfferCatalog',
    name: c.name,
    itemListElement: c.products.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      priceCurrency: 'RUB',
      priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: p.fromPrice, priceCurrency: 'RUB', unitText: p.fromUnit ?? 'шт' },
      seller: { '@id': `${site.url}/#business` },
    })),
  })),
};
---

<BaseLayout
  title="Цены и калькулятор печати в Калининграде | Мастерская сувениров"
  description="Прайс-лист и онлайн-калькулятор: печать на футболках, кружки, значки, визитки, календари, наклейки. Цена за штуку и за тираж сразу. Калининград, от 1 шт."
  path="/price"
  schema={[breadcrumbs(crumbs), catalogLd]}
>
  <InkHero
    crumbs={crumbs}
    h1="Цены и калькулятор"
    mark="калькулятор"
    lead="Посчитайте стоимость любого изделия: выберите параметры и количество — цена за штуку и за тираж пересчитается сразу. Чем больше тираж, тем дешевле штука."
    cols={3}
    facts={[
      { big: '0 ₽', small: 'наценка за срочность' },
      { big: '0 ₽', small: 'макет в большинстве случаев' },
      { big: '50%', small: 'предоплата для частных лиц' },
    ]}
  >
    <a class="ib ib-main" href="#calc">Рассчитать стоимость <span class="ib-go" aria-hidden="true"><Icon name="arrow" size={16} /></span></a>
    <button type="button" class="ib ib-glass" data-order><span class="ib-ico" aria-hidden="true"><Icon name="upload" size={16} /></span> Отправить макет</button>
  </InkHero>

  <div class="band band-tint">
    <section id="calc" class="section calc-wrap" aria-labelledby="calc-h">
      <div class="wrap">
        <InkHead icon="calc" eyebrow="Калькулятор" id="calc-h" title="Посчитайте свой заказ" mark="свой заказ" />
        <Calculator client:load />
      </div>
    </section>
  </div>

  <div class="band">
    <section class="section pl-sec" aria-labelledby="pl-h">
      <div class="wrap">
        <InkHead icon="tag" eyebrow="Прайс-лист" id="pl-h" title="Все цены" mark="цены">
          <p class="pl-sub">Цены указаны в рублях за штуку, если не сказано иное. Точную стоимость подтверждает менеджер после просмотра макета.</p>
        </InkHead>

        <nav class="pl-toc" aria-label="Разделы прайса">
          {categories.map((c) => <a href={`#cat-${c.id}`}>{c.name}</a>)}
        </nav>

        <div class="pl-list">
          {
            categories.map((c) => (
              <section id={`cat-${c.id}`} class="pl-cat" aria-labelledby={`cat-${c.id}-h`}>
                <div class="pl-cat-head">
                  <h2 id={`cat-${c.id}-h`}>{c.name}</h2>
                  <div class="pl-cat-links">
                    <a class="pl-btn pl-btn-main" href={`/price?calc=${c.id}#calc`}>Посчитать</a>
                    {c.page && (
                      <a class="pl-btn pl-btn-glass" href={c.page}>
                        Подробнее
                      </a>
                    )}
                  </div>
                </div>
                <PriceTables categoryId={c.id} />
              </section>
            ))
          }
        </div>
      </div>
    </section>
    <CtaBand title="Нужен расчёт под вашу задачу?" text="Пришлите макет или опишите, что нужно, — посчитаем тираж, подскажем материалы и сроки." />
  </div>
</BaseLayout>

<style>
  .calc-wrap {
    padding-block: clamp(36px, 5vw, 64px);
  }
  .pl-sec {
    padding-block: clamp(40px, 5.5vw, 76px);
  }
  .pl-sub {
    max-width: 60ch;
    color: var(--muted);
    font-size: 1.05rem;
  }
  /* category tabs: a glass track, links wrap on desktop and scroll sideways on phones */
  .pl-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 44px;
    padding: 5px;
    border-radius: 28px;
    border: 1px solid #e5e5e5;
    background: rgba(242, 242, 242, 0.8);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .pl-toc a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    color: var(--ink-2);
    font-weight: 600;
    font-size: 0.94rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .pl-toc a:hover {
    background: #fff;
    color: var(--navy, #14213d);
  }
  .pl-list {
    display: grid;
    gap: 64px;
  }
  .pl-cat {
    scroll-margin-top: 90px;
  }
  .pl-cat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e5e5e5;
  }
  .pl-cat-head h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.1rem) !important;
  }
  .pl-cat-links {
    display: flex;
    gap: 8px;
  }
  .pl-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.94rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .pl-btn-main {
    background: var(--navy, #14213d);
    color: #fff;
  }
  .pl-btn-main:hover {
    background: #000;
    color: #fff;
  }
  .pl-btn-glass {
    border: 1px solid rgba(20, 33, 61, 0.18);
    background: rgba(255, 255, 255, 0.7);
    color: var(--navy, #14213d);
  }
  .pl-btn-glass:hover {
    background: #fff;
    color: var(--navy, #14213d);
  }
  @media (max-width: 760px) {
    .pl-toc {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-bottom: 32px;
    }
    .pl-toc a {
      flex: none;
      white-space: nowrap;
    }
    .pl-list {
      gap: 44px;
    }
  }
</style>

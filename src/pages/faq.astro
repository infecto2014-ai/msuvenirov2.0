---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import InkHero from '@/components/ink/InkHero.astro';
import InkHead from '@/components/ink/InkHead.astro';
import { ink } from '@/components/ink/icons';
import { generalFaq } from '@/data/faq';
import { breadcrumbs, faqPage } from '@/lib/schema';
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Вопросы и ответы', href: '/faq' },
];
const all = generalFaq.flatMap((g) => g.items);
const icons: Record<string, string> = {
  'Заказ и оплата': 'card',
  'Сроки': 'clock',
  'Макеты и дизайн': 'pencil',
  'Технологии печати': 'layers',
  'Компаниям': 'building',
};
---

<BaseLayout
  title="Вопросы и ответы о печати — сроки, макеты, оплата | Мастерская сувениров"
  description="Ответы на частые вопросы: сроки печати, требования к макетам, технологии DTF и сублимации, оплата и заказы для компаний. Мастерская сувениров, Калининград."
  path="/faq"
  schema={[breadcrumbs(crumbs), faqPage(all)]}
>
  <InkHero crumbs={crumbs} h1="Вопросы и ответы" mark="ответы" lead="Сроки, макеты, технологии печати и оплата — то, о чём спрашивают чаще всего.">
    <nav slot="aside" class="ftoc" aria-label="Темы">
      {
        generalFaq.map((g, i) => (
          <a href={`#g${i}`}>
            <span class="ftoc-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={ink[icons[g.group] ?? 'help']} />
              </svg>
            </span>
            {g.group}
          </a>
        ))
      }
    </nav>
  </InkHero>

  {
    generalFaq.map((g, i) => (
      <div class={i % 2 === 0 ? 'band band-tint' : 'band'}>
        <section id={`g${i}`} class="section fgroup" aria-labelledby={`g${i}-h`}>
          <div class="wrap fgrid">
            <InkHead icon={icons[g.group] ?? 'help'} eyebrow="Вопросы и ответы" id={`g${i}-h`} title={g.group} />
            <div class="faq-list">
              {g.items.map((f) => (
                <details class="faq-item">
                  <summary>{f.q}</summary>
                  <div class="faq-answer">
                    <p>{f.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </section>
      </div>
    ))
  }

  <div class={generalFaq.length % 2 === 1 ? 'band' : 'band band-tint'}>
    <CtaBand title="Остался вопрос?" text="Напишите нам в Telegram или оставьте заявку — ответим и посчитаем ваш заказ." />
  </div>
</BaseLayout>

<style>
  .ftoc {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .ftoc a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 10px 16px 10px 12px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.4);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.2s ease;
  }
  .ftoc a:hover {
    background: #fff;
    color: var(--ink);
  }
  .ftoc-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--navy, #14213d);
    color: #fff;
  }
  .fgroup {
    padding-block: clamp(36px, 5vw, 64px);
    scroll-margin-top: 90px;
  }
  .fgrid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }
  .fgrid > :global(.ih) {
    position: sticky;
    top: 100px;
    margin-bottom: 0;
  }
  @media (max-width: 860px) {
    .fgrid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .fgrid > :global(.ih) {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .ftoc {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>

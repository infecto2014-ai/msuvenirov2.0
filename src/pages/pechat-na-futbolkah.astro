---
// 14.11.2026 (owner: «в соответствии с наработками главной переделываем полностью страницу с футболками»):
// the page now uses the home look «Ink» (theme="lux": navy / black / white, glass, Rubik, icons instead of numbers),
// new components in src/components/tee/. The old tshirt/* components stay — [slug].astro still uses them.
// Rollback point: branch backup/before-tshirt-ink.
// Earlier: «Печать на футболках» — own page (owner, 06.11.2026: «блоки выглядят однородно скучно»), built in the spirit of
// the home page and the gift article: bands of different grounds with waves, big outlined section numbers,
// marker words, photo cards and polaroids.
// Order of the top part is the owner's garment-page order (02.11.2026): first screen → calculator of this product →
// «С этим заказывают» → ready options → the blank («Изделие») → the rest.
// Texts — services.ts + garments.ts entries for '/pechat-na-futbolkah' (they stay for menus/sitemap);
// every price — src/data/pricing.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Calculator from '@/components/islands/Calculator';
import ServiceBlocks from '@/components/ServiceBlocks.astro';
import TeeAlso from '@/components/tee/TeeAlso.astro';
import TeeCompare from '@/components/tee/TeeCompare.astro';
import TeeIdeas from '@/components/tee/TeeIdeas.astro';
import TeeRelated from '@/components/tee/TeeRelated.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import TeeHero from '@/components/tee/TeeHero.astro';
import TeeHead from '@/components/tee/TeeHead.astro';
import TeePackages from '@/components/tee/TeePackages.astro';
import TeeDetails from '@/components/tee/TeeDetails.astro';
import '@/styles/lux.css';
import '@/styles/lux-calc.css';
import '@/styles/lux-tee.css';
import { garmentBySlug } from '@/data/garments';
import { reviews as allReviews } from '@/data/reviews';
import { services } from '@/data/services';
import { findCategory, findProduct } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const SLUG = '/pechat-na-futbolkah';
const page = services.find((s) => s.slug === SLUG)!;
const garment = garmentBySlug(SLUG)!;
const product = findProduct('textile', garment.productId)!;
const cat = findCategory(page.calcCategory)!;

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: page.name, href: page.slug },
];
// same schema numbers as the generic service template
const allPrices = cat.products.map((p) => p.fromPrice);
const hasReviews = allReviews.some((r) => garment.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];

const compare = page.blocks.find((b) => b.kind === 'compare');
const ideas = page.blocks.find((b) => b.kind === 'ideas');
const otherBlocks = page.blocks.filter((b) => b.kind !== 'compare' && b.kind !== 'ideas');

// short captions for the first screen — all from the garments.ts specs
const facts = [
  { big: 'А6–А3', small: 'размер принта' },
  { big: 'XS–3XL', small: 'и детские <b>98–164</b>' },
  { big: '50+', small: 'стирок выдерживает принт' },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image={page.image}
  theme="lux"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: Math.min(...allPrices), offerCount: cat.products.length }),
    faqPage(page.faq),
  ]}
>
  <script is:inline slot="head">
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion-ready');
  </script>

  <TeeHero page={page} crumbs={crumbs} from={product.fromPrice} facts={facts} />

  <!-- calculator (light grey band) -->
  <div class="band band-tint">
    <section id="calc" class="section tcalc" aria-labelledby="calc-h">
      <div class="wrap">
        <TeeHead icon="calc" eyebrow="Калькулятор" id="calc-h" title="Посчитайте свой вариант" mark="свой">
          <p class="tcalc-sub">Выберите цвет, размеры принтов и количество — цена пересчитается сразу. Несколько принтов: самый дорогой по полной цене, следующий −30%, остальные −50%.</p>
        </TeeHead>
        <div class="tcalc-box">
          <Calculator client:visible category="textile" product={garment.productId} hideCategories lockProduct />
        </div>
      </div>
      {garment.alsoOrder && <TeeAlso slugs={garment.alsoOrder} />}
    </section>
  </div>

  <!-- ready options (white) -->
  <div class="band">
    <TeePackages info={garment} />
  </div>

  <!-- the blank (navy panel) -->
  <div class="band band-ink">
    <TeeDetails info={garment} productName={product.name} />
  </div>

  {
    compare && (
      <div class="band">
        <TeeCompare block={compare} />
      </div>
    )
  }

  {
    ideas && (
      <div class="band band-tint">
        <TeeIdeas block={ideas} />
      </div>
    )
  }

  {otherBlocks.length > 0 && <div class="band"><ServiceBlocks blocks={otherBlocks} /></div>}

  <div class="band band-ink">
    <PortfolioGrid tags={page.portfolioTags} title="Примеры: печать на футболках" />
  </div>

  {
    hasReviews && (
      <div class="band">
        <Reviews keywords={garment.reviewKeywords} title="Отзывы: печать на футболках" />
      </div>
    )
  }

  <div class="band band-tint">
    <FaqSection items={page.faq} title="Вопросы: печать на футболках" />
  </div>

  {
    related.length > 0 && (
      <div class="band">
        <TeeRelated items={related} />
      </div>
    )
  }

  <CtaBand />
</BaseLayout>

<script>
  import '@/scripts/home-motion';
</script>

<style>
  .tcalc-sub {
    max-width: 52ch;
  }
  @media (max-width: 760px) {
    .tcalc {
      padding-block: 28px 32px;
    }
    .tcalc-sub {
      display: none;
    }
  }
</style>

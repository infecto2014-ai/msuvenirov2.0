---
// «Печать на бейсболках» — own page (like the shoppers and mugs pages): first screen, calculator of the cap only,
// ready options, the cap itself (specs + 7 colours), where we print, audience, how to order, works, reviews, FAQ, SEO text.
// Content — src/data/capsPage.ts; every price — src/data/pricing.ts ('cap', category 'textile');
// drawings — src/components/cap/CapArt.astro + cap-geometry.ts. The services.ts entry stays for menus/sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import TeeHead from '@/components/tee/TeeHead.astro';
import PpHero from '@/components/product-page/PpHero.astro';
import PpAudience from '@/components/product-page/PpAudience.astro';
import PpHow from '@/components/product-page/PpHow.astro';
import PpSeo from '@/components/product-page/PpSeo.astro';
import FoldScript from '@/components/product-page/FoldScript.astro';
import '@/components/product-page/pp.css';
import CapArt from '@/components/cap/CapArt.astro';
import CapPackages from '@/components/cap/CapPackages.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import { capsPage as page, buildCapFaq } from '@/data/capsPage';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { defaultSelection, extraPrintFactor, findProduct, rub, type Selection } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { CapColor } from '@/components/cap/cap-geometry';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Печать на бейсболках', href: page.slug },
];

// ---- prices, all from pricing.ts
const cap = findProduct('textile', 'cap')!;
const unitAt = (qty: number, options: Selection['options'] = {}) => {
  const b = defaultSelection(cap);
  return cap.quote({ ...b, qty, options: { ...b.options, ...options } }).unit;
};
const colorGroup = cap.options!.find((g) => g.id === 'color')!;
const colors = colorGroup.choices.map((c) => ({ id: c.id as CapColor, name: c.label, hex: c.swatch ?? '#ccc' }));
const blankTiers = [1, 10, 30];
const extraOff = Math.round((1 - extraPrintFactor[1]) * 100);
const faq = buildCapFaq({
  one: rub(unitAt(1)),
  ten: rub(unitAt(10)),
  thirty: rub(unitAt(30)),
  max: cap.qty.max,
  extraOff,
  colors: colors.map((c, i) => (i === 0 ? c.name : c.name.toLowerCase())).join(', '),
});
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
// reviews about caps, if there are any; otherwise the general reviews
const hasCapReviews = reviews.some((r) => page.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));

// three facts under the buttons of the first screen (same row as on the t-shirt page)
const heroFacts = [{ big: '1 шт', small: 'можно заказать одну кепку' },{ big: '7', small: 'цветов бейсболок' },{ big: '3 места', small: 'спереди, сбоку и сзади' }];
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/portfolio/branded-caps.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: cap.fromPrice, offerCount: colors.length }),
    faqPage(faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <PpHero eyebrow={page.eyebrow} h1={page.h1} lead={page.lead} crumbs={crumbs} mark="бейсболках" heroAlt={page.heroAlt} facts={heroFacts} price={{ pre: 'от', value: rub(cap.fromPrice), note: 'кепка с печатью' }}>
    <CapArt view="side" color="red" print="logo" place="side" scale={0.92} class="shero-cap shero-red" />
    <CapArt view="front" color="white" print="text" scale={0.86} class="shero-cap shero-white" />
    <CapArt view="three-quarter" color="black" print="logo" scale={1.32} class="shero-cap shero-black" />
    <ul class="shero-swatches">
      {colors.map((c) => <li style={`--sw:${c.hex}`} title={c.name}></li>)}
    </ul>
  </PpHero>

  <!-- ============ calculator (light grey) ============ -->
  <div class="band band-tint">
    <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
      <div class="wrap">
        <TeeHead icon="calc" eyebrow="Калькулятор" id="calc-h" title="Посчитайте свои кепки" mark="кепки">
          <p class="calc-sub">Выберите цвет, от одного до трёх мест печати и количество — цена за штуку и за весь заказ пересчитается сразу. Кепка, печать и макет уже в цене.</p>
        </TeeHead>
        <Calculator client:visible category="textile" product="cap" products={['cap']} hideCategories />
      </div>
      <AlsoOrder slugs={page.alsoOrder} />
    </section>
  </div>

  <!-- ============ ready options (white) ============ -->
  <div class="band">
    <CapPackages />
  </div>

  <!-- ============ the cap itself (navy panel) ============ -->
  <div class="band band-ink">
    <section class="section our pp-sec" aria-labelledby="our-h">
      <div class="wrap our-grid">
        <div class="our-art">
          {colors.map((c, i) => <input type="radio" name="cap-color" id={`capc-${c.id}`} class={`our-in our-in-${c.id}`} checked={i === 0} />)}
          <div class="our-stage pp-art">
            {colors.map((c) => (
              <div class={`our-v our-v-${c.id}`}>
                <CapArt view="three-quarter" color={c.id} print="logo" markers scale={2} title={`Бейсболка TEXTILLER, ${c.name.toLowerCase()}`} />
              </div>
            ))}
            <ol class="our-marks">
              {page.cap.marks.map((m) => <li>{m}</li>)}
            </ol>
          </div>
          <fieldset class="our-pal">
            <legend>Цвета бейсболок — нажмите, чтобы примерить</legend>
            <ul>
              {colors.map((c) => (
                <li>
                  <label for={`capc-${c.id}`} class={`our-sw our-sw-${c.id}`}>
                    <i style={`--sw:${c.hex}`}></i>
                    <span>{c.name}</span>
                  </label>
                </li>
              ))}
            </ul>
          </fieldset>
        </div>
        <div class="our-info">
          <TeeHead icon="layers" eyebrow="Наша бейсболка" id="our-h" title={`${page.cap.name}: хлопок, саржа, 5 панелей`} mark="панелей" dark />
          <p class="our-text">{page.cap.text}</p>
          <dl class="our-specs pp-card">
            {page.cap.specs.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
            <div>
              <dt>Цвета</dt>
              <dd>{colors.map((c) => c.name.toLowerCase()).join(', ')}</dd>
            </div>
          </dl>
          <p class="our-price">
            <span>Кепка с печатью спереди</span>
            {blankTiers.map((q) => (
              <span class="our-tier">
                <small>от {q} шт</small>
                <b>{rub(unitAt(q))}</b>
              </span>
            ))}
          </p>
          <details class="our-care pp-card" open data-fold>
            <summary><h3>Уход за кепкой</h3></summary>
            <ul class="pp-ticks">
              {page.cap.care.map((t) => <li>{t}</li>)}
            </ul>
          </details>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ where we print (white) ============ -->
  <div class="band">
    <section class="section plc pp-sec" aria-labelledby="plc-h">
      <div class="wrap">
        <TeeHead icon="ruler" eyebrow="Места печати" id="plc-h" title="Где печатаем на кепке" mark="кепке">
          <p class="pp-sub">До трёх принтов на одной кепке. Второй принт стоит на {extraOff}% дешевле первого, третий — вдвое дешевле.</p>
        </TeeHead>
        <ul class="plc-grid">
          {page.places.map((p) => (
            <li class="plc-card pp-card">
              <div class="plc-art pp-art" aria-hidden="true">
                {'back' in p && p.back ? (
                  <CapArt view="side" color={p.color} print="none" scale={1.35} />
                ) : (
                  <CapArt view={p.view} color={p.color} print="logo" place={p.id} dims scale={1.35} />
                )}
              </div>
              <div class="plc-body">
                <span class="pp-tag">{p.tag}</span>
                <h3>{p.title}</h3>
                <p class="plc-size">{p.size}</p>
                <p class="plc-text">{p.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <!-- ============ for whom (light grey) ============ -->
  <div class="band band-tint">
    <PpAudience title="Кому заказывают кепки с логотипом" mark="кепки" items={page.audience} />
  </div>

  <!-- ============ how to order (white) ============ -->
  <div class="band">
    <PpHow title="Как заказать печать на кепке" mark="кепке" steps={page.steps} layout={page.layout} b2b={page.b2b} b2bOrder="Кепки с логотипом для компании — рассчитать тираж" />
  </div>

  <FoldScript />

  <div class="band band-ink">
    <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: кепки и одежда" />
  </div>

  <div class="band">
    <Reviews keywords={hasCapReviews ? page.reviewKeywords : undefined} title={hasCapReviews ? 'Отзывы о кепках' : 'Что говорят клиенты'} />
  </div>

  <div class="band band-tint">
    <FaqSection items={faq} title="Вопросы о печати на кепках" />
  </div>

  <div class="band">
    <PpSeo title={page.seo.title} sections={page.seo.sections}>
      <a href="/pechat-na-odezhde">печать на одежде</a> · <a href="/pechat-na-futbolkah">печать на футболках</a> · <a href="/pechat-na-hudi">худи</a> ·
      <a href="/pechat-na-shopperah">шопперы</a> · <a href="/korporativnym-klientam">корпоративным клиентам</a> ·
      <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
    </PpSeo>
  </div>

  <div class="band band-tint">
    {related.length > 0 && <TshirtRelated items={related} />}
  </div>

  <CtaBand title="Хотите кепку со своим логотипом?" text="Пришлите логотип, надпись или идею — соберём макет, покажем, как он ляжет на кепку, и посчитаем цену." />
</BaseLayout>

<style>
  .calc-sub {
    max-width: 52ch;
  }

  /* ---- first screen: caps on the stage */
  :global(.ph-stage .shero-cap) {
    position: absolute;
    filter: drop-shadow(0 14px 16px rgba(20, 33, 61, 0.2));
  }
  :global(.ph-stage .shero-red) {
    left: -8px;
    top: 34px;
    transform: rotate(-7deg);
  }
  :global(.ph-stage .shero-white) {
    right: -14px;
    top: 118px;
    transform: rotate(6deg);
  }
  :global(.ph-stage .shero-black) {
    left: 40px;
    top: 178px;
    z-index: 2;
  }
  .shero-swatches {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    list-style: none;
    margin: 0;
    padding: 8px 12px;
    display: flex;
    gap: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 8px 18px -10px rgba(20, 33, 61, 0.4);
  }
  .shero-swatches li {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: inset 0 0 0 1px rgba(20, 33, 61, 0.2);
  }

  /* ---- the cap: picture with colour picker + specs */
  .our-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .our-in {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .our-stage {
    display: grid;
    place-items: center;
    min-height: 420px;
    padding: 28px 18px 18px;
    border-radius: 28px;
  }
  .our-v {
    display: none;
  }
  .our-v :global(svg) {
    width: min(100%, 470px);
    filter: drop-shadow(0 18px 18px rgba(20, 33, 61, 0.22));
  }
  .our-in-black:checked ~ .our-stage .our-v-black,
  .our-in-white:checked ~ .our-stage .our-v-white,
  .our-in-red:checked ~ .our-stage .our-v-red,
  .our-in-blue:checked ~ .our-stage .our-v-blue,
  .our-in-yellow:checked ~ .our-stage .our-v-yellow,
  .our-in-green:checked ~ .our-stage .our-v-green,
  .our-in-khaki:checked ~ .our-stage .our-v-khaki {
    display: block;
  }
  .our-marks {
    list-style: none;
    counter-reset: mk;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 14px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--navy, #14213d);
  }
  .our-marks li {
    counter-increment: mk;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .our-marks li::before {
    content: counter(mk);
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--navy, #14213d);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .our-pal {
    margin: 16px 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .our-pal legend {
    margin-bottom: 10px;
    padding: 0;
    font-weight: 700;
    font-size: 0.92rem;
    color: #fff;
  }
  .our-pal ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .our-sw {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 6px 14px 6px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .our-sw i {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: inset 0 0 0 1px rgba(20, 33, 61, 0.25);
  }
  .our-in-black:checked ~ .our-pal .our-sw-black,
  .our-in-white:checked ~ .our-pal .our-sw-white,
  .our-in-red:checked ~ .our-pal .our-sw-red,
  .our-in-blue:checked ~ .our-pal .our-sw-blue,
  .our-in-yellow:checked ~ .our-pal .our-sw-yellow,
  .our-in-green:checked ~ .our-pal .our-sw-green,
  .our-in-khaki:checked ~ .our-pal .our-sw-khaki {
    background: #fff;
    border-color: #fff;
    color: var(--navy, #14213d);
  }
  .our-in:focus-visible ~ .our-pal .our-sw {
    outline-offset: 2px;
  }
  .our-info {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .our-info :global(.teh) {
    margin-bottom: 0;
  }
  .our-text {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.55;
  }
  .our-specs {
    margin: 0;
    padding: 6px 20px;
    display: grid;
  }
  .our-specs div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .our-specs div:last-child {
    border-bottom: 0;
  }
  .our-specs dt {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
  }
  .our-specs dd {
    margin: 0;
    text-align: right;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .our-price {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .our-tier {
    display: grid;
    padding: 8px 16px;
    border-radius: 18px;
    background: #fff;
    color: var(--navy, #14213d);
  }
  .our-tier small {
    font-size: 0.75rem;
    color: var(--muted-on-white, #4b5568);
  }
  .our-tier b {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .our-care {
    padding: 16px 20px;
    display: grid;
    gap: 10px;
  }
  .our-care summary {
    list-style: none;
    cursor: default;
  }
  .our-care summary::-webkit-details-marker {
    display: none;
  }
  .our-care .pp-ticks li {
    color: rgba(255, 255, 255, 0.82);
  }

  /* ---- where we print */
  .plc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 14px;
  }
  .plc-card {
    display: flex;
    flex-direction: column;
    padding: 8px;
  }
  .plc-art {
    height: 210px;
  }
  .plc-art :global(svg) {
    filter: drop-shadow(0 10px 12px rgba(20, 33, 61, 0.18));
  }
  .plc-body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 8px;
    padding: 14px 10px 12px;
  }
  .plc-size {
    color: var(--navy, #14213d);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .plc-text {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  @media (max-width: 1180px) {
    .plc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 960px) {
    .our-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .calc-sub {
      display: none;
    }
    .calc-sec {
      padding-block: 28px 32px;
    }
    .our-stage {
      min-height: 280px;
      padding: 18px 10px 12px;
    }
    .plc-grid {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 10px;
      scrollbar-width: none;
    }
    .plc-grid::-webkit-scrollbar {
      display: none;
    }
    .plc-card {
      flex: 0 0 min(250px, 74%);
      scroll-snap-align: start;
    }
    .our-care {
      padding: 4px 18px;
    }
    .our-care summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 44px;
      cursor: pointer;
    }
    .our-care summary::after {
      content: '';
      width: 10px;
      height: 10px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg);
    }
    .our-care[open] summary::after {
      transform: rotate(-135deg);
    }
    .our-care[open] {
      padding-bottom: 16px;
    }
  }
</style>

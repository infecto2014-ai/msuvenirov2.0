---
import '@fontsource/caveat/600.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import Icon from '@/components/Icon.astro';
import { categoryFrom, defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import { generalFaq } from '@/data/faq';
import { site } from '@/data/site';
import { faqPage } from '@/lib/schema';

const tiles = [
  { href: '/pechat-na-futbolkah', group: 'wear', title: 'Печать на футболках и худи', text: 'от 1 шт, на нашей футболке или на вашей', img: '/img/showcase/tshirt.webp', alt: 'Футболки с печатью логотипа', cat: 'textile', size: 'xl', from: findProduct('textile', 'tshirt-unisex')!.fromPrice },
  { href: '/pechat-na-kruzhkah', group: 'souv', title: 'Печать на кружках', text: 'белые, хамелеон, золото', img: '/img/showcase/colored-mugs.webp', alt: 'Цветные кружки с печатью', cat: 'mugs', size: 'tall' },
  { href: '/znachki', group: 'souv', title: 'Значки', text: 'закатные и на цанге', img: '/img/showcase/keychains.webp', alt: 'Значки и брелоки с логотипом', cat: 'badges' },
  { href: '/vizitki', group: 'print', title: 'Визитки', text: 'одно- и двусторонние', img: '/img/showcase/business-cards.webp', alt: 'Визитки', cat: 'cards' },
  { href: '/pechat-na-kepkah', group: 'wear', title: 'Бейсболки и шопперы', text: 'печать логотипа', img: '/img/showcase/cap.webp', alt: 'Бейсболка с логотипом', cat: 'textile', from: findProduct('textile', 'shopper')!.fromPrice },
  { href: '/kalendari', group: 'print', title: 'Календари', text: 'квартальные, настенные, домики', img: '/img/showcase/stationery.webp', alt: 'Календари и полиграфия', cat: 'calendars' },
  { href: '/nakleyki', group: 'souv', title: 'Стикеры', text: '3D из смолы и виниловые', img: '/img/showcase/stickers-3d.webp', alt: 'Объёмные 3D-стикеры', cat: 'stickers' },
  { href: '/fotopodarki', group: 'gifts', title: 'Фотоподарки', text: 'подушки, пазлы, магниты', img: '/img/showcase/pillow.webp', alt: 'Подушка с фото', cat: 'gifts' },
];

/** Popular orders with a ready "turnkey" price — always computed from pricing.ts, never typed by hand. */
const quoteOf = (cat: string, id: string, qty?: number, options: Selection['options'] = {}) => {
  const p = findProduct(cat, id)!;
  const base = defaultSelection(p);
  const sel: Selection = { ...base, qty: qty ?? base.qty, options: { ...base.options, ...options } };
  return { qty: sel.qty, ...p.quote(sel) };
};
const popular = [
  { title: 'Футболка с вашим принтом', note: 'белая или чёрная, принт А4', img: '/portfolio/portfolio-21.webp', calc: 'textile:tshirt-unisex', q: quoteOf('textile', 'tshirt-unisex', 1) },
  { title: 'Кружка с фото', note: 'белая, 330 мл', img: '/portfolio/portfolio-2.webp', calc: 'mugs:mug', q: quoteOf('mugs', 'mug', 1) },
  { title: 'Ёлочный шар с фото', note: 'к Новому году, 70 мм', img: '/portfolio/portfolio-6.webp', calc: 'gifts:ball', q: quoteOf('gifts', 'ball', 1) },
  { title: 'Визитки', note: '90×50 мм, бумага 300 г', img: '/img/showcase/business-cards.webp', calc: 'cards:business-cards', q: quoteOf('cards', 'business-cards', 96) },
  { title: 'Значки с логотипом', note: 'закатные, 38 мм', img: '/img/showcase/keychains.webp', calc: 'badges:badge-roll', q: quoteOf('badges', 'badge-roll', 25) },
  { title: 'Футболки для команды', note: 'с логотипом А4', img: '/portfolio/portfolio-20.webp', calc: 'textile:tshirt-unisex', q: quoteOf('textile', 'tshirt-unisex', 20) },
];

const occasions = [
  { when: '31 декабря', title: 'Новый год', text: 'Ёлочные шары с фото, календари, подарки коллегам и клиентам', href: '/fotopodarki', img: '/portfolio/portfolio-6.webp' },
  { when: '23 февраля', title: 'День защитника', text: 'Футболки и худи с надписью, кружки, значки', href: '/pechat-na-futbolkah', img: '/portfolio/portfolio-25.webp' },
  { when: '8 марта', title: 'Женский день', text: 'Кружки с фото, подушки, пазлы, шопперы', href: '/pechat-na-kruzhkah', img: '/portfolio/portfolio-19.webp' },
  { when: 'в любой день', title: 'День рождения', text: 'Футболка или худи с фото именинника, фотоподарки', href: '/pechat-na-hudi', img: '/portfolio/portfolio-22.webp' },
  { when: 'май–июнь', title: 'Выпускной', text: 'Футболки для класса, значки, медали и вымпелы', href: '/znachki', img: '/portfolio/portfolio-20.webp' },
  { when: 'круглый год', title: 'Для компании', text: 'Мерч для сотрудников, форма, подарки партнёрам', href: '/korporativnym-klientam', img: '/portfolio/branded-caps.webp' },
];

const groups = [
  { id: 'all', label: 'Всё' },
  { id: 'wear', label: 'Одежда' },
  { id: 'souv', label: 'Сувениры' },
  { id: 'gifts', label: 'Фотоподарки' },
  { id: 'print', label: 'Полиграфия' },
];

const values = [
  { icon: 'calc', label: 'Цена сразу онлайн' },
  { icon: 'clock', label: 'Срочно — без наценки' },
  { icon: 'upload', label: 'Простой макет — бесплатно' },
  { icon: 'check', label: 'Брак по нашей вине — переделаем' },
] as const;

const terms = [
  { icon: 'clock', title: 'Сроки', text: 'Обычно 1–3 рабочих дня. Срочные заказы — без наценки, успеем к нужной дате.' },
  { icon: 'calc', title: 'Оплата', text: 'Наличными, картой или по QR-коду. Частным лицам — предоплата 50%, остаток при получении. Организациям — счёт без НДС.' },
  { icon: 'upload', title: 'Макет', text: 'Перед печатью присылаем макет на согласование. Простой макет соберём бесплатно.' },
  { icon: 'check', title: 'Гарантия', text: 'Если брак по нашей вине — переделаем бесплатно.' },
] as const;

const clients = [
  { src: '/img/clients/client-1.webp', alt: 'Россети' },
  { src: '/img/clients/client-6.webp', alt: 'БФУ имени И. Канта' },
  { src: '/img/clients/client-2.webp', alt: 'Арле Парк' },
  { src: '/img/clients/client-4.webp', alt: 'Папаша Беппе' },
  { src: '/img/clients/client-5.webp', alt: 'Бойцовский клуб «Неудержимые»' },
  { src: '/img/clients/client-7.webp', alt: 'Systech' },
  { src: '/img/clients/client-8.webp', alt: 'Музей мороженого' },
];

const homeFaq = generalFaq.flatMap((g) => g.items).slice(0, 6);
---

<BaseLayout
  title="Печать на футболках, кружках и сувенирах в Калининграде — Мастерская сувениров"
  description="Печать на одежде, кружках, значках, визитках и календарях в Калининграде от 1 шт. Онлайн-калькулятор цен, срочно без наценки. ТЦ «Экватор», с 2019 года."
  path="/"
  schema={[faqPage(homeFaq)]}
>
  <!-- HERO: full-bleed photo card with a wave edge -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-card">
        <img class="hero-photo" src="/img/hero-kaliningrad-1600.webp" srcset="/img/hero-kaliningrad-900.webp 900w, /img/hero-kaliningrad-1600.webp 1600w" sizes="(max-width: 560px) 100vw, 64vw" alt="" width="1600" height="1074" fetchpriority="high" decoding="async" />
        <div class="hero-text">
          <p class="hero-eyebrow mono">ТЦ «Экватор» · с {site.founded} года</p>
          <h1 class="hero-title">Печать на&nbsp;одежде и&nbsp;сувенирах <span class="serif">в&nbsp;Калининграде</span></h1>
          <p class="hero-lead">
            Футболки, худи, кружки, значки, визитки и календари с вашим дизайном — от 1 штуки. Своё производство и больше 10 лет опыта в печати.
          </p>
          <div class="hero-actions">
            <a class="btn btn-magenta" href="/price"><Icon name="calc" size={20} /> <span>Рассчитать<span class="hide-sm"> стоимость</span></span></a>
            <button type="button" class="btn hero-ghost" data-order><Icon name="upload" size={20} /> <span class="hide-sm">Отправить макет</span><span class="show-sm">Макет</span></button>
          </div>
          <div class="hero-proof">
            <span class="hero-faces" aria-hidden="true">
              <img src="/portfolio/dtf-bestdad.webp" alt="" width="40" height="40" />
              <img src="/portfolio/portfolio-2.webp" alt="" width="40" height="40" />
              <img src="/portfolio/branded-caps.webp" alt="" width="40" height="40" />
            </span>
            <span>Печатаем сами, в своей мастерской —<br class="hide-sm" /> от одной футболки до тиража для компании</span>
          </div>
        </div>
        <span class="hand hero-hand" aria-hidden="true">
          <svg viewBox="0 0 70 46" width="70" height="46"><path d="M64 6C46 4 22 14 10 38m0 0 1-11m-1 11 10-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          сделано<br />в Калининграде
        </span>
        <svg class="hero-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V44c160-30 320-40 520-14s360 44 560 22 260-44 360-46v74z" /></svg>
      </div>
    </div>
  </section>

  <!-- ABOUT: photo collage + values -->
  <section class="section about" aria-labelledby="about-h">
    <div class="wrap about-grid">
      <div class="about-collage" aria-hidden="true">
        <span class="ab-blob"></span>
        <div class="ab ab-1"><img src="/portfolio/wedding-tshirts.webp" alt="" width="745" height="800" loading="lazy" decoding="async" /></div>
        <div class="ab ab-2"><img src="/portfolio/corporate-polo.webp" alt="" width="745" height="800" loading="lazy" decoding="async" /></div>
        <div class="ab ab-3"><img src="/portfolio/portfolio-2.webp" alt="" width="378" height="374" loading="lazy" decoding="async" /></div>
        <span class="hand ab-hand">наши работы
          <svg viewBox="0 0 60 48" width="60" height="48"><path d="M8 6c26 2 42 16 40 36m0 0-7-9m7 9 6-10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </div>
      <div class="about-text">
        <p class="eyebrow">Своя мастерская</p>
        <h2 id="about-h">Печатаем то, что <span class="serif">хочется дарить</span></h2>
        <p class="lead">
          Свадебные футболки, поло для ресторана, кружки с видами города — каждый заказ делаем сами, в мастерской в ТЦ «Экватор». Перед печатью присылаем
          макет на согласование, а простой соберём бесплатно.
        </p>
        <ul class="values">
          {
            values.map((v) => (
              <li>
                <span class="values-icon"><Icon name={v.icon} size={22} /></span>
                <span>{v.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <div class="band band-tint">
  <!-- POPULAR -->
  <section class="section popular" aria-labelledby="pop-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Популярное</p>
          <h2 id="pop-h">Что чаще всего заказывают</h2>
        </div>
        <p>Цена указана за готовое изделие с печатью. Другой тираж или размер — в калькуляторе.</p>
      </div>
      <ul class="pop-grid">
        {
          popular.map((it) => {
            const label = `${it.title}, ${it.q.qty} шт — ${rub(it.q.total)}`;
            return (
              <li class="pop">
                <img src={it.img} alt={it.title} width="320" height="320" loading="lazy" decoding="async" />
                <div class="pop-body">
                  <h3>{it.title}</h3>
                  <p class="pop-note">
                    {it.note} · {it.q.qty} шт
                  </p>
                  <p class="pop-price mono">
                    {rub(it.q.total)}
                    {it.q.qty > 1 && <small>{rub(it.q.unit)} / шт</small>}
                  </p>
                  <div class="pop-actions">
                    <button type="button" class="btn btn-sm btn-magenta" data-order={label}>
                      Заказать
                    </button>
                    <a class="pop-edit" href={`/price?calc=${it.calc}#calc`}>
                      Другой тираж →
                    </a>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
  </div>

  <div class="band">
  <!-- CATEGORIES: text + filter chips on the left, photo cards on the right -->
  <section class="section cats" aria-labelledby="cats-h">
    <div class="wrap">
      <div class="cats-grid">
        <div class="cats-side">
          <p class="eyebrow">Что печатаем</p>
          <h2 id="cats-h">Изделия <span class="serif">и цены</span></h2>
          <p>Цена «от» — за готовое изделие с печатью. Точную сумму покажет калькулятор на странице изделия.</p>
          <div class="chips" role="group" aria-label="Показать группу">
            {groups.map((g, i) => (<button type="button" class="chip" data-filter={g.id} aria-pressed={i === 0 ? 'true' : 'false'}>{g.label}</button>))}
          </div>
          <a class="cats-all" href="/uslugi"><span class="cats-all-go"><Icon name="arrow" size={18} /></span> Все услуги</a>
          <span class="hand cats-hand" aria-hidden="true">нажмите, чтобы<br />посчитать</span>
        </div>
        <div class="pcards">
          {
            tiles.map((t) => {
              const f = t.from ?? categoryFrom(t.cat).price;
              return (
                <a class={`pc ${t.size ? `pc-${t.size}` : ''}`} href={t.href} data-group={t.group}>
                  <img src={t.img} alt={t.alt} width="320" height="320" loading="lazy" decoding="async" />
                  <span class="pc-body">
                    <span class="pc-price mono">от {rub(f)}</span>
                    <h3>{t.title}</h3>
                    <span class="pc-text">{t.text}</span>
                  </span>
                  <span class="pc-go"><Icon name="arrow" size={18} /></span>
                </a>
              );
            })
          }
        </div>
      </div>
      <p class="cats-more">
        А ещё: <a href="/breloki">брелоки</a>, <a href="/magnity">магниты</a>, <a href="/poligrafiya">листовки и блокноты</a>,
        <a href="/shirokoformatnaya-pechat">широкоформатная печать</a>, <a href="/pechat-na-hudi">худи</a>, <a href="/pechat-na-shopperah">шопперы</a>.
      </p>
    </div>
  </section>
  </div>

  <div class="band band-ink">
  <PortfolioGrid />
  </div>

  <div class="band">
  <!-- OCCASIONS -->
  <section class="section occasions" aria-labelledby="occ-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Идеи подарков</p>
          <h2 id="occ-h">Подарки <span class="serif">к празднику</span></h2>
        </div>
        <span class="hand occ-hand" aria-hidden="true">лучше написать заранее!</span>
        <p>Подскажем, что подарить, и сделаем к нужной дате. Перед праздниками лучше написать заранее.</p>
      </div>
      <ul class="occ-grid">
        {
          occasions.map((o) => (
            <li>
              <a class="occ" href={o.href}>
                <img src={o.img} alt="" width="378" height="378" loading="lazy" decoding="async" />
                <span class="occ-when mono">{o.when}</span>
                <span class="occ-body">
                  <h3>{o.title}</h3>
                  <p>{o.text}</p>
                </span>
                <span class="occ-go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <div class="band band-tint">
  <Reviews />
  </div>

  <div class="band">
  <!-- B2B -->
  <section class="section" aria-labelledby="b2b-h">
    <div class="wrap">
      <div class="b2b">
        <div class="b2b-cmyk" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="b2b-text">
          <p class="eyebrow b2b-eyebrow">Компаниям</p>
          <h2 id="b2b-h">Мерч и подарки с логотипом для компаний</h2>
          <p>
            Футболки для команды, подарки партнёрам, календари к Новому году, значки и брелоки для мероприятий. Работаем по счёту без НДС, с закрывающими документами. Соберём смету
            на весь набор и подготовим макеты.
          </p>
          <div class="b2b-actions">
            <a class="btn btn-yellow" href="/korporativnym-klientam">Условия для компаний</a>
            <button type="button" class="btn b2b-ghost" data-order="Запрос расчёта для компании">Запросить расчёт</button>
          </div>
        </div>
        <ul class="b2b-list">
          <li><span class="mono">01</span> Счёт без НДС и закрывающие документы</li>
          <li><span class="mono">02</span> Одна смета на футболки, кружки, значки и полиграфию</li>
          <li><span class="mono">03</span> Макет по вашему брендбуку — согласуем до печати</li>
          <li><span class="mono">04</span> Образец перед тиражом</li>
        </ul>
        <div class="clients">
          <p class="clients-title mono">Нам доверяют</p>
          <ul class="clients-row">
            {
              clients.map((c) => (
                <li>
                  <img src={c.src} alt={c.alt} title={c.alt} width="140" height="70" loading="lazy" decoding="async" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
  </div>

  <div class="band band-tint">
  <HowItWorks />

  <!-- TERMS -->
  <section class="terms-band" aria-labelledby="terms-h">
    <div class="wrap">
      <h2 id="terms-h" class="sr-only">Сроки, оплата и гарантия</h2>
      <ul class="terms">
        {
          terms.map((t) => (
            <li>
              <span class="terms-icon"><Icon name={t.icon} size={22} /></span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <div class="band">
  <!-- SEO TEXT -->
  <section class="section seo-text" aria-labelledby="seo-h">
    <div class="wrap">
      <h2 id="seo-h">Печать на заказ в Калининграде</h2>
      <input type="checkbox" id="seo-more" class="seo-toggle" />
      <div class="seo-cols">
        <div>
          <h3>Печать на футболках и худи</h3>
          <p>
            Печатаем на <a href="/pechat-na-futbolkah">футболках</a>, <a href="/pechat-na-hudi">худи</a>, свитшотах, поло и
            <a href="/pechat-na-shopperah">шопперах</a> от одной штуки. Основная технология — DTF: яркий принт на ткани любого цвета, который выдерживает больше 50 стирок. Можно
            принести свою вещь или выбрать нашу — белые и чёрные футболки всегда в наличии.
          </p>
        </div>
        <div>
          <h3>Печать на кружках и фотоподарки</h3>
          <p>
            Делаем <a href="/pechat-na-kruzhkah">кружки с фото</a> и надписью: белые, цветные, хамелеон. Из фотографий получаются
            <a href="/fotopodarki">подушки, пазлы, ёлочные шары</a> и <a href="/magnity">магниты</a> — подарок, который можно забрать в тот же день или к нужной дате.
          </p>
        </div>
        <div>
          <h3>Мерч и сувениры с логотипом для компаний</h3>
          <p>
            Для компаний Калининграда делаем корпоративный мерч: футболки и поло с логотипом, <a href="/pechat-na-kepkah">бейсболки</a>,
            <a href="/znachki">значки</a>, <a href="/breloki">брелоки</a>, подарки сотрудникам и партнёрам. Работаем по счёту без НДС, перед тиражом согласуем макет и
            показываем образец. Подробнее — в разделе <a href="/korporativnym-klientam">для компаний</a>.
          </p>
        </div>
        <div>
          <h3>Полиграфия и широкоформатная печать</h3>
          <p>

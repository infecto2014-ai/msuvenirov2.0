---
import '@fontsource/caveat/600.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@/styles/lux.css';
import { portfolio } from '@/data/portfolio';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import Icon from '@/components/Icon.astro';
import NewYearBlock from '@/components/NewYearBlock.astro';
import HomeB2B from '@/components/home/HomeB2B.astro';
import HomeSeo from '@/components/home/HomeSeo.astro';
import { categoryFrom, findProduct, rub } from '@/data/pricing';
import { generalFaq } from '@/data/faq';
import { site } from '@/data/site';
import { faqPage } from '@/lib/schema';

const tiles = [
  { href: '/pechat-na-futbolkah', title: 'Печать на футболках и худи', text: 'от 1 шт, на нашей футболке или на вашей', img: '/img/products/tshirts', alt: 'Футболки разных цветов на вешалках', cat: 'textile', size: 'xl', from: findProduct('textile', 'tshirt-unisex')!.fromPrice },
  { href: '/pechat-na-kruzhkah', title: 'Печать на кружках', text: 'белые, хамелеон, золото', img: '/img/products/mugs', alt: 'Кружки для сублимационной печати', cat: 'mugs', size: 'tall' },
  { href: '/znachki', title: 'Значки', text: 'закатные и на цанге', img: '/img/products/badges', alt: 'Закатные значки и значки на цанге с логотипом', cat: 'badges' },
  { href: '/vizitki', title: 'Визитки', text: 'одно- и двусторонние', img: '/img/products/business-cards', alt: 'Визитки', cat: 'cards' },
  { href: '/pechat-na-kepkah', title: 'Бейсболки и шопперы', text: 'печать логотипа', img: '/img/products/caps', alt: 'Бейсболки разных цветов', cat: 'textile', from: findProduct('textile', 'shopper')!.fromPrice },
  { href: '/kalendari', title: 'Календари', text: 'квартальные, настенные, домики', img: '/img/products/calendar', alt: 'Настенный календарь', cat: 'calendars' },
  { href: '/nakleyki', title: 'Стикеры', text: '3D из смолы и виниловые', img: '/img/products/stickers', alt: 'Объёмные 3D-стикеры из эпоксидной смолы с логотипом', cat: 'stickers' },
  { href: '/fotopodarki', title: 'Фотоподарки', text: 'подушки, пазлы, магниты', img: '/img/products/pillow', alt: 'Белая подушка для печати фото', cat: 'gifts' },
];

const occasions = [
  { when: '31 декабря', title: 'Новый год', text: 'Ёлочные шары с фото, календари, подарки коллегам и клиентам', href: '/stati/novogodnie-podarki', img: '/portfolio/portfolio-6.webp' },
  { when: '23 февраля', title: 'День защитника', text: 'Футболки и худи с надписью, кружки, значки', href: '/pechat-na-futbolkah', img: '/portfolio/portfolio-25.webp' },
  { when: '8 марта', title: 'Женский день', text: 'Кружки с фото, подушки, пазлы, шопперы', href: '/pechat-na-kruzhkah', img: '/portfolio/portfolio-19.webp' },
  { when: 'в любой день', title: 'День рождения', text: 'Футболка или худи с фото именинника, фотоподарки', href: '/pechat-na-hudi', img: '/portfolio/portfolio-22.webp' },
  { when: 'май–июнь', title: 'Выпускной', text: 'Футболки для класса, значки, медали и вымпелы', href: '/znachki', img: '/portfolio/portfolio-20.webp' },
  { when: 'круглый год', title: 'Для компании', text: 'Мерч для сотрудников, форма, подарки партнёрам', href: '/korporativnym-klientam', img: '/portfolio/branded-caps.webp' },
];




// white: white logo (made dark on the light first screen); square: round/square logo, shown larger so it
// looks the same size as the wide ones; onLight: version with dark text for the light first screen
type Client = { src: string; alt: string; white?: boolean; square?: boolean; onLight?: string };
const clients: Client[] = [
  { src: '/img/clients/client-1.webp', alt: 'Россети', white: true },
  { src: '/img/clients/client-6.webp', alt: 'БФУ имени И. Канта', white: true },
  { src: '/img/clients/client-2.webp', alt: 'Арле Парк' },
  { src: '/img/clients/client-4.webp', alt: 'Папаша Беппе', square: true },
  { src: '/img/clients/client-5.webp', alt: 'Бойцовский клуб «Неудержимые»', square: true },
  { src: '/img/clients/client-7.webp', alt: 'Systech', white: true },
  { src: '/img/clients/client-8.webp', alt: 'Музей мороженого', square: true, onLight: '/img/clients/client-8-dark.webp' },
];

// works shown one by one in the glass card at the bottom of the first screen
const featured = ['/portfolio/portfolio-20.webp', '/portfolio/portfolio-2.webp', '/portfolio/portfolio-23.webp', '/portfolio/portfolio-7.webp', '/portfolio/portfolio-6.webp', '/portfolio/portfolio-30.webp']
  .map((src) => portfolio.find((p) => p.src === src)!)
  .filter(Boolean);

const homeFaq = generalFaq.flatMap((g) => g.items).slice(0, 6);
---

<BaseLayout
  title="Печать на футболках, кружках и сувенирах в Калининграде — Мастерская сувениров"
  description="Печать на одежде, кружках, значках, визитках и календарях в Калининграде от 1 шт. Онлайн-калькулятор цен, срочно без наценки. ТЦ «Экватор», с 2019 года."
  path="/"
  schema={[faqPage(homeFaq)]}
  theme="lux"
>
  <!-- HERO (owner, 14.11.2026, by a reference): photo in a rounded frame, glass header over it, floating glass cards
       at the bottom. Photo — the man at the cathedral, colours — CMYK 2.0 (owner: «прошлое изображение и прошлую гамму»). -->
  <section class="lx-hero" aria-labelledby="hero-h">
    <div class="lx-frame">
      <picture class="lx-photo">
        <img src="/img/hero-kaliningrad-1600.webp" srcset="/img/hero-kaliningrad-900.webp 900w, /img/hero-kaliningrad-1600.webp 1600w" sizes="100vw" alt="" width="1600" height="1074" fetchpriority="high" decoding="async" />
      </picture>
      <div class="lx-inner">
        <div class="lx-copy">
          <p class="lx-kicker">Футболки <span aria-hidden="true">—</span> кружки <span aria-hidden="true">—</span> полиграфия</p>
          <h1 id="hero-h" class="lx-title">Печать на&nbsp;одежде и&nbsp;сувенирах <span class="serif">в&nbsp;Калининграде</span></h1>
          <p class="lx-lead">Печатаем ваш дизайн от&nbsp;1&nbsp;штуки в&nbsp;своей мастерской в&nbsp;ТЦ «Экватор».</p>
          <div class="lx-actions">
            <a class="lx-btn lx-btn-main" href="/price">Рассчитать стоимость <span class="lx-btn-go" aria-hidden="true"><Icon name="arrow" size={16} /></span></a>
            <button type="button" class="lx-btn lx-btn-glass" data-order><span class="lx-btn-ico" aria-hidden="true"><Icon name="upload" size={16} /></span> Отправить макет</button>
          </div>
        </div>
        <ul class="lx-side" aria-label="Коротко о мастерской">
          <li>С&nbsp;{site.founded} года</li>
          <li>От&nbsp;1&nbsp;штуки</li>
          <li>Своя мастерская</li>
          <li>{site.hours}</li>
        </ul>

        <div class="lx-cards">
          <article class="lx-card lx-work" data-works={JSON.stringify(featured.map((w) => ({ title: w.title, tech: w.tech })))}>
            <div class="lx-work-photo">
              {featured.map((w, i) => <img src={w.src} alt="" width="320" height="320" loading="lazy" decoding="async" hidden={i > 0} data-work={i} />)}
            </div>
            <div class="lx-work-text">
              <p class="lx-label">Наши работы <span class="lx-count"><span data-work-n>01</span> / {String(featured.length).padStart(2, '0')}</span></p>
              <h2 class="lx-work-title" data-work-title>{featured[0].title}</h2>
              <p class="lx-work-tech" data-work-tech>{featured[0].tech}</p>
              <div class="lx-work-nav">
                <a class="lx-link" href="/portfolio">Все работы <Icon name="arrow" size={14} /></a>
                <span class="lx-arrows">
                  <button type="button" class="lx-round" data-work-prev aria-label="Предыдущая работа"><Icon name="arrow" size={16} /></button>
                  <button type="button" class="lx-round lx-round-dark" data-work-next aria-label="Следующая работа"><Icon name="arrow" size={16} /></button>
                </span>
              </div>
            </div>
          </article>

          <ul class="lx-card lx-stats">
            <li><b>10&nbsp;000+</b><span>заказов выполнено</span></li>
            <li><b>10+</b><span>лет опыта в&nbsp;печати</span></li>
            <li><b>1&nbsp;шт</b><span>минимальный заказ</span></li>
          </ul>

          <a class="lx-card lx-cta" href="/price">
            <span class="lx-cta-top">
              <img src="/img/products/tshirts-640.webp" alt="" width="64" height="64" loading="lazy" decoding="async" />
              <span class="lx-round lx-round-light" aria-hidden="true"><Icon name="arrow" size={16} /></span>
            </span>
            <b>Цена за минуту</b>
            <span>Калькулятор сразу покажет цену за&nbsp;штуку и&nbsp;за&nbsp;тираж</span>
          </a>
        </div>
      </div>
    </div>

    <div class="wrap lx-clients">
      <p>Нам доверяют</p>
      <ul>
        {
          clients.map((c) => (
            <li class:list={{ 'is-white': c.white, 'is-square': c.square }}>
              <img src={c.onLight ?? c.src} alt={c.alt} title={c.alt} width="140" height="70" loading="lazy" decoding="async" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <NewYearBlock link="/stati/novogodnie-podarki" />

  <div class="band">
  <!-- CATEGORIES: text on the left, photo cards on the right (filter chips removed by the owner, 14.11.2026) -->
  <section class="section cats" aria-labelledby="cats-h">
    <div class="wrap">
      <div class="cats-grid">
        <div class="cats-side">
          <p class="eyebrow">Что печатаем</p>
          <h2 id="cats-h">Изделия</h2>
          <p>Цена «от» — за готовое изделие с печатью. Точную сумму покажет калькулятор на странице изделия.</p>
          <a class="cats-all" href="/uslugi">Все услуги <span class="cats-all-go" aria-hidden="true"><Icon name="arrow" size={16} /></span></a>
        </div>
        <div class="pcards">
          {
            tiles.map((t) => {
              const f = t.from ?? categoryFrom(t.cat).price;
              return (
                <a class={`pc ${t.size ? `pc-${t.size}` : ''}`} href={t.href}>
                  <img src={`${t.img}-640.webp`} srcset={`${t.img}-640.webp 640w, ${t.img}-1200.webp 1200w`} sizes={t.size ? '(max-width: 760px) 100vw, 600px' : '(max-width: 760px) 50vw, 300px'} alt={t.alt} width="640" height="478" loading="lazy" decoding="async" />
                  <span class="pc-body">
                    <span class="pc-price mono">от {rub(f)}</span>
                    <h3>{t.title}</h3>
                    <span class="pc-text">{t.text}</span>
                  </span>
                  <span class="pc-go"><Icon name="arrow" size={18} /></span>
                </a>
              );
            })
          }
        </div>
      </div>
      <p class="cats-more">
        А ещё: <a href="/breloki">брелоки</a>, <a href="/magnity">магниты</a>, <a href="/poligrafiya">листовки и блокноты</a>,
        <a href="/shirokoformatnaya-pechat">широкоформатная печать</a>, <a href="/pechat-na-hudi">худи</a>, <a href="/pechat-na-shopperah">шопперы</a>.
      </p>
    </div>
  </section>
  </div>

  <div class="band band-tint">
  <!-- OCCASIONS -->
  <section class="section occasions" aria-labelledby="occ-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Идеи подарков</p>
          <h2 id="occ-h">Подарки <span class="serif">к празднику</span></h2>
        </div>
        <p>Подскажем, что подарить, и сделаем к нужной дате. Перед праздниками лучше написать заранее.</p>
      </div>
      <ul class="occ-grid">
        {
          occasions.map((o) => (
            <li>
              <a class="occ" href={o.href}>
                <span class="occ-media"><img src={o.img} alt="" width="378" height="378" loading="lazy" decoding="async" /></span>
                <span class="occ-when">{o.when}</span>
                <span class="occ-title">
                  <h3>{o.title}</h3>
                  <span class="occ-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                </span>
                <p>{o.text}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <div class="band band-ink">
  <PortfolioGrid />
  </div>

  <div class="band band-tint">
  <!-- ABOUT: photo collage + values -->
  <section class="section about" aria-labelledby="about-h">
    <div class="wrap about-grid">
      <div class="about-collage" aria-hidden="true">
        <span class="ab-blob"></span>
        <div class="ab ab-1"><img src="/portfolio/wedding-tshirts.webp" alt="" width="745" height="800" loading="lazy" decoding="async" /></div>
        <div class="ab ab-2"><img src="/portfolio/corporate-polo.webp" alt="" width="745" height="800" loading="lazy" decoding="async" /></div>
        <div class="ab ab-3"><img src="/portfolio/portfolio-2.webp" alt="" width="378" height="374" loading="lazy" decoding="async" /></div>
      </div>
      <div class="about-text">
        <p class="eyebrow">Своя мастерская</p>
        <h2 id="about-h">Печатаем то, что <span class="serif">хочется дарить</span></h2>
        <p class="lead">
          Свадебные футболки, поло для ресторана, кружки с видами города — каждый заказ делаем сами, в мастерской в ТЦ «Экватор». Перед печатью присылаем
          макет на согласование, а простой соберём бесплатно.
        </p>
      </div>
    </div>
  </section>
  </div>

  <div class="band">
  <Reviews />
  </div>

  <div class="band">
  <HomeB2B />
  </div>

  <div class="band band-tint">
  <HowItWorks />
  </div>

  <div class="band">
  <FaqSection items={homeFaq} />
  </div>

  <div class="band band-tint">
  <HomeSeo />
  </div>

  <div class="band">
  <ContactBlock />
  </div>
</BaseLayout>

<script>
  // «Наши работы» card on the first screen: arrows flip through a few works (without JS the first one stays)
  const box = document.querySelector<HTMLElement>('[data-works]');
  if (box) {
    const imgs = [...box.querySelectorAll<HTMLImageElement>('[data-work]')];
    const data = JSON.parse(box.dataset.works || '[]') as { title: string; tech: string }[];
    let i = 0;
    const show = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      imgs.forEach((im, k) => (im.hidden = k !== i));
      box.querySelector('[data-work-n]')!.textContent = String(i + 1).padStart(2, '0');
      box.querySelector('[data-work-title]')!.textContent = data[i]?.title ?? '';
      box.querySelector('[data-work-tech]')!.textContent = data[i]?.tech ?? '';
    };
    box.querySelector('[data-work-prev]')?.addEventListener('click', () => show(i - 1));
    box.querySelector('[data-work-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>

<style>
  /* ---------------- shared accents (home only): serif italic word, handwritten notes */
  .serif {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.12em;
    letter-spacing: 0;
    line-height: 0.9;
  }
  .hand {
    font-family: 'Caveat', 'Segoe Print', cursive;
    font-weight: 600;
    font-size: 1.45rem;
    line-height: 1.05;
    color: var(--c-ink);
    pointer-events: none;
  }

  /* ---------------- first screen (owner, 14.11.2026): warm photo in a rounded frame, glass header and cards over it */
  .lx-hero {
    margin-top: -88px; /* slide under the floating glass header */
    padding-inline: 12px;
  }
  .lx-frame {
    position: relative;
    isolation: isolate;
    min-height: min(100svh, 900px);
    border-radius: 32px;
    overflow: clip;
    background: var(--paper-2);
  }
  .lx-photo img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% 28%;
  }
  /* keeps the headline readable where the photo gets busy */
  .lx-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(255, 252, 245, 0.94) 0%, rgba(255, 252, 245, 0.78) 30%, rgba(255, 252, 245, 0) 56%),
      linear-gradient(0deg, rgba(22, 20, 27, 0.22) 0%, rgba(22, 20, 27, 0) 32%);
  }
  .lx-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: 1fr auto;
    gap: 40px;
    min-height: inherit;
    max-width: 1400px;
    margin-inline: auto;
    padding: 128px clamp(20px, 4vw, 56px) clamp(16px, 2.4vw, 28px);
  }
  .lx-copy {
    align-self: center;
    max-width: 760px;
  }
  .lx-kicker {
    margin: 0 0 22px;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .lx-kicker span {
    margin-inline: 0.5em;
    color: var(--muted);
  }
  .lx-title {
    margin: 0;
    font-size: clamp(2.6rem, 4.8vw, 4.3rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .lx-title .serif {
    display: block;
    font-size: 1.08em;
    line-height: 1;
  }
  .lx-lead {
    margin: 24px 0 0;
    max-width: 30em;
    font-size: 1.08rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .lx-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .lx-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 54px;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .lx-btn-main {
    padding: 7px 7px 7px 24px;
    border: 0;
    background: var(--red);
    color: #fff;
  }
  .lx-btn-main:hover {
    background: var(--red-dark);
    color: #fff;
  }
  .lx-btn-go,
  .lx-btn-ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex: none;
    transition: transform 0.2s ease;
  }
  .lx-btn-go {
    background: #fff;
    color: var(--red);
  }
  .lx-btn-main:hover .lx-btn-go {
    transform: translateX(3px);
  }
  .lx-btn-glass {
    padding: 7px 24px 7px 7px;
    border: 1px solid var(--glass-line);
    background: var(--glass);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    color: var(--ink);
  }
  .lx-btn-glass:hover {
    background: var(--glass-strong);
  }
  .lx-btn-ico {
    border: 1px solid var(--line-strong);
  }
  .lx-side {
    align-self: start;
    margin: 0;
    padding: 4px 0 4px 16px;
    list-style: none;
    display: grid;
    gap: 8px;
    padding: 12px 16px 12px 18px;
    border: 1px solid var(--glass-line);
    border-radius: 20px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  /* floating glass cards */
  .lx-cards {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1.05fr) minmax(0, 0.7fr);
    gap: 16px;
    align-items: stretch;
  }
  .lx-card {
    margin: 0;
    border-radius: 28px;
    border: 1px solid var(--glass-line);
    background: var(--glass);
    -webkit-backdrop-filter: saturate(1.3) blur(18px);
    backdrop-filter: saturate(1.3) blur(18px);
    box-shadow: var(--glass-shadow);
  }
  .lx-work {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 18px;
    padding: 12px 18px 12px 12px;
  }
  .lx-work-photo {
    border-radius: 20px;
    overflow: clip;
    aspect-ratio: 1;
  }
  .lx-work-photo img[hidden] {
    display: none;
  }
  .lx-work-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lx-work-text {
    display: grid;
    align-content: start;
    gap: 4px;
    min-width: 0;
    padding-top: 6px;
  }
  .lx-label {
    display: flex;
    justify-content: space-between;

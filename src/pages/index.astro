<script>
  // «Изделия и цены»: chips show one group; without JS every card stays visible
  const grid = document.querySelector<HTMLElement>('.pcards');
  document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]').forEach((chip, _, all) => {
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      all.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      grid?.classList.toggle('is-filtered', f !== 'all');
      grid?.querySelectorAll<HTMLElement>('.pc').forEach((card) => {
        card.hidden = f !== 'all' && card.dataset.group !== f;
      });
    });
  });
</script>


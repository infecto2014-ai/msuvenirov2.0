---
import '@fontsource/caveat/600.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import Icon from '@/components/Icon.astro';
import NewYearBlock from '@/components/NewYearBlock.astro';
import HomeB2B from '@/components/home/HomeB2B.astro';
import HomeSeo from '@/components/home/HomeSeo.astro';
import { categoryFrom, findProduct, rub } from '@/data/pricing';
import { generalFaq } from '@/data/faq';
import { site } from '@/data/site';
import { faqPage } from '@/lib/schema';

const tiles = [
  { href: '/pechat-na-futbolkah', title: 'Печать на футболках и худи', text: 'от 1 шт, на нашей футболке или на вашей', img: '/img/products/tshirts', alt: 'Футболки разных цветов на вешалках', cat: 'textile', size: 'xl', from: findProduct('textile', 'tshirt-unisex')!.fromPrice },
  { href: '/pechat-na-kruzhkah', title: 'Печать на кружках', text: 'белые, хамелеон, золото', img: '/img/products/mugs', alt: 'Кружки для сублимационной печати', cat: 'mugs', size: 'tall' },
  { href: '/znachki', title: 'Значки', text: 'закатные и на цанге', img: '/img/products/badges', alt: 'Закатные значки и значки на цанге с логотипом', cat: 'badges' },
  { href: '/vizitki', title: 'Визитки', text: 'одно- и двусторонние', img: '/img/products/business-cards', alt: 'Визитки', cat: 'cards' },
  { href: '/pechat-na-kepkah', title: 'Бейсболки и шопперы', text: 'печать логотипа', img: '/img/products/caps', alt: 'Бейсболки разных цветов', cat: 'textile', from: findProduct('textile', 'shopper')!.fromPrice },
  { href: '/kalendari', title: 'Календари', text: 'квартальные, настенные, домики', img: '/img/products/calendar', alt: 'Настенный календарь', cat: 'calendars' },
  { href: '/nakleyki', title: 'Стикеры', text: '3D из смолы и виниловые', img: '/img/products/stickers', alt: 'Объёмные 3D-стикеры из эпоксидной смолы с логотипом', cat: 'stickers' },
  { href: '/fotopodarki', title: 'Фотоподарки', text: 'подушки, пазлы, магниты', img: '/img/products/pillow', alt: 'Белая подушка для печати фото', cat: 'gifts' },
];

const occasions = [
  { when: '31 декабря', title: 'Новый год', text: 'Ёлочные шары с фото, календари, подарки коллегам и клиентам', href: '/stati/novogodnie-podarki', img: '/portfolio/portfolio-6.webp' },
  { when: '23 февраля', title: 'День защитника', text: 'Футболки и худи с надписью, кружки, значки', href: '/pechat-na-futbolkah', img: '/portfolio/portfolio-25.webp' },
  { when: '8 марта', title: 'Женский день', text: 'Кружки с фото, подушки, пазлы, шопперы', href: '/pechat-na-kruzhkah', img: '/portfolio/portfolio-19.webp' },
  { when: 'в любой день', title: 'День рождения', text: 'Футболка или худи с фото именинника, фотоподарки', href: '/pechat-na-hudi', img: '/portfolio/portfolio-22.webp' },
  { when: 'май–июнь', title: 'Выпускной', text: 'Футболки для класса, значки, медали и вымпелы', href: '/znachki', img: '/portfolio/portfolio-20.webp' },
  { when: 'круглый год', title: 'Для компании', text: 'Мерч для сотрудников, форма, подарки партнёрам', href: '/korporativnym-klientam', img: '/portfolio/branded-caps.webp' },
];




// white: white logo (made dark on the light first screen); square: round/square logo, shown larger so it
// looks the same size as the wide ones; onLight: version with dark text for the light first screen
type Client = { src: string; alt: string; white?: boolean; square?: boolean; onLight?: string };
const clients: Client[] = [
  { src: '/img/clients/client-1.webp', alt: 'Россети', white: true },
  { src: '/img/clients/client-6.webp', alt: 'БФУ имени И. Канта', white: true },
  { src: '/img/clients/client-2.webp', alt: 'Арле Парк' },
  { src: '/img/clients/client-4.webp', alt: 'Папаша Беппе', square: true },
  { src: '/img/clients/client-5.webp', alt: 'Бойцовский клуб «Неудержимые»', square: true },
  { src: '/img/clients/client-7.webp', alt: 'Systech', white: true },
  { src: '/img/clients/client-8.webp', alt: 'Музей мороженого', square: true, onLight: '/img/clients/client-8-dark.webp' },
];

const homeFaq = generalFaq.flatMap((g) => g.items).slice(0, 6);
---

<BaseLayout
  title="Печать на футболках, кружках и сувенирах в Калининграде — Мастерская сувениров"
  description="Печать на одежде, кружках, значках, визитках и календарях в Калининграде от 1 шт. Онлайн-калькулятор цен, срочно без наценки. ТЦ «Экватор», с 2019 года."
  path="/"
  schema={[faqPage(homeFaq)]}
>
  <!-- HERO: full-width photo right under the header, text aligned with the page column, wave at the bottom -->
  <section class="hero hero-light">
    <div class="wrap">
      <div class="hero-card">
        <div class="hero-media">
          <img class="hero-photo" src="/img/hero-kaliningrad-1600.webp" srcset="/img/hero-kaliningrad-900.webp 900w, /img/hero-kaliningrad-1600.webp 1600w" sizes="(max-width: 560px) 100vw, 70vw" alt="" width="1600" height="1074" fetchpriority="high" decoding="async" />
        </div>
        <div class="hero-text">
          <h1 class="hero-title">Печать на&nbsp;одежде и&nbsp;сувенирах <span class="serif">в&nbsp;Калининграде</span></h1>
          <p class="hero-lead">Футболки, кружки, значки и полиграфия с&nbsp;вашим дизайном&nbsp;— от&nbsp;1&nbsp;штуки.</p>
          <div class="hero-actions">
            <a class="btn btn-magenta" href="/price"><Icon name="calc" size={20} /> <span>Рассчитать<span class="hide-sm"> стоимость</span></span></a>
            <button type="button" class="btn hero-ghost" data-order><Icon name="upload" size={20} /> <span class="hide-sm">Отправить макет</span><span class="show-sm">Макет</span></button>
          </div>
          <ul class="hero-facts">
            <li><b>10&nbsp;000+</b><span>заказов с&nbsp;{site.founded} года<br />и&nbsp;10+ лет опыта в&nbsp;печати</span></li>
            <li><Icon name="clock" size={22} /><span>{site.hours}<br />ТЦ «Экватор»</span></li>
          </ul>
        </div>
        <div class="hero-clients">
          <p class="mono">Нам доверяют</p>
          <ul>
            {
              clients.map((c) => (
                <li class:list={{ 'is-white': c.white, 'is-square': c.square }}>
                  <img src={c.onLight ?? c.src} alt={c.alt} title={c.alt} width="140" height="70" decoding="async" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80V44c160-30 320-40 520-14s360 44 560 22 260-44 360-46v74z" /></svg>
  </section>

  <NewYearBlock link="/stati/novogodnie-podarki" />

  <div class="band">
  <!-- CATEGORIES: text on the left, photo cards on the right (filter chips removed by the owner, 14.11.2026) -->
  <section class="section cats" aria-labelledby="cats-h">
    <div class="wrap">
      <div class="cats-grid">
        <div class="cats-side">
          <p class="eyebrow">Что печатаем</p>
          <h2 id="cats-h">Изделия</h2>
          <p>Цена «от» — за готовое изделие с печатью. Точную сумму покажет калькулятор на странице изделия.</p>
          <a class="cats-all" href="/uslugi">Все услуги <span class="cats-all-go" aria-hidden="true"><Icon name="arrow" size={16} /></span></a>
        </div>
        <div class="pcards">
          {
            tiles.map((t) => {
              const f = t.from ?? categoryFrom(t.cat).price;
              return (
                <a class={`pc ${t.size ? `pc-${t.size}` : ''}`} href={t.href}>
                  <img src={`${t.img}-640.webp`} srcset={`${t.img}-640.webp 640w, ${t.img}-1200.webp 1200w`} sizes={t.size ? '(max-width: 760px) 100vw, 600px' : '(max-width: 760px) 50vw, 300px'} alt={t.alt} width="640" height="478" loading="lazy" decoding="async" />
                  <span class="pc-body">
                    <span class="pc-price mono">от {rub(f)}</span>
                    <h3>{t.title}</h3>
                    <span class="pc-text">{t.text}</span>
                  </span>
                  <span class="pc-go"><Icon name="arrow" size={18} /></span>
                </a>
              );
            })
          }
        </div>
      </div>
      <p class="cats-more">
        А ещё: <a href="/breloki">брелоки</a>, <a href="/magnity">магниты</a>, <a href="/poligrafiya">листовки и блокноты</a>,
        <a href="/shirokoformatnaya-pechat">широкоформатная печать</a>, <a href="/pechat-na-hudi">худи</a>, <a href="/pechat-na-shopperah">шопперы</a>.
      </p>
    </div>
  </section>
  </div>

  <div class="band band-tint">
  <!-- OCCASIONS -->
  <section class="section occasions" aria-labelledby="occ-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Идеи подарков</p>
          <h2 id="occ-h">Подарки <span class="serif">к празднику</span></h2>
        </div>
        <p>Подскажем, что подарить, и сделаем к нужной дате. Перед праздниками лучше написать заранее.</p>
      </div>
      <ul class="occ-grid">
        {
          occasions.map((o) => (
            <li>
              <a class="occ" href={o.href}>
                <span class="occ-media"><img src={o.img} alt="" width="378" height="378" loading="lazy" decoding="async" /></span>
                <span class="occ-when">{o.when}</span>
                <span class="occ-title">
                  <h3>{o.title}</h3>
                  <span class="occ-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                </span>
                <p>{o.text}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <div class="band band-ink">
  <PortfolioGrid />
  </div>

  <div class="band band-tint">
  <!-- ABOUT: photo collage + values -->
  <section class="section about" aria-labelledby="about-h">
    <div class="wrap about-grid">
      <div class="about-collage" aria-hidden="true">
        <span class="ab-blob"></span>
        <div class="ab ab-1"><img src="/portfolio/wedding-tshirts.webp" alt="" width="745" height="800" loading="lazy" decoding="async" /></div>
        <div class="ab ab-2"><img src="/portfolio/corporate-polo.webp" alt="" width="745" height="800" loading="lazy" decoding="async" /></div>
        <div class="ab ab-3"><img src="/portfolio/portfolio-2.webp" alt="" width="378" height="374" loading="lazy" decoding="async" /></div>
      </div>
      <div class="about-text">
        <p class="eyebrow">Своя мастерская</p>
        <h2 id="about-h">Печатаем то, что <span class="serif">хочется дарить</span></h2>
        <p class="lead">
          Свадебные футболки, поло для ресторана, кружки с видами города — каждый заказ делаем сами, в мастерской в ТЦ «Экватор». Перед печатью присылаем
          макет на согласование, а простой соберём бесплатно.
        </p>
      </div>
    </div>
  </section>
  </div>

  <div class="band">
  <Reviews />
  </div>

  <div class="band">
  <HomeB2B />
  </div>

  <div class="band band-tint">
  <HowItWorks />
  </div>

  <div class="band">
  <FaqSection items={homeFaq} />
  </div>

  <div class="band band-tint">
  <HomeSeo />
  </div>

  <div class="band">
  <ContactBlock />
  </div>
</BaseLayout>

<style>
  /* ---------------- shared accents (home only): serif italic word, handwritten notes */
  .serif {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.12em;
    letter-spacing: 0;
    line-height: 0.9;
  }
  .hand {
    font-family: 'Caveat', 'Segoe Print', cursive;
    font-weight: 600;
    font-size: 1.45rem;
    line-height: 1.05;
    color: var(--c-ink);
    pointer-events: none;
  }

  /* ---------------- hero: photo card with a wave edge */
  /* full width under the header (owner, 06.11.2026); text stays in the page column (.wrap),
     the photo runs from the column to the right edge of the screen */
  .hero {
    --hero-bg: #0f1d27;
    position: relative;
    background:
      radial-gradient(40% 80% at 0% 100%, rgba(0, 160, 220, 0.24), transparent 70%),
      var(--hero-bg);
    color: #fffcf5;
    overflow: clip;
    isolation: isolate;
  }
  .hero-card {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    gap: clamp(24px, 3vw, 40px);
    min-height: clamp(560px, 48vw, 700px);
    padding: clamp(32px, 4.5vw, 64px) 0 clamp(64px, 7vw, 100px);
  }
  /* photo box: from the text column to the right edge of the screen */
  .hero-media {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 36%;
    right: calc((100% - 100vw) / 2);
    container-type: size;
    z-index: 0;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 100% 25%;
  }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(15, 29, 39, 0.92) 0, rgba(15, 29, 39, 0.55) 22%, rgba(15, 29, 39, 0) 40%),
      linear-gradient(90deg, var(--hero-bg) 0%, rgba(15, 29, 39, 0.8) 10%, rgba(15, 29, 39, 0.15) 26%, rgba(15, 29, 39, 0) 38%);
    pointer-events: none;
  }
  /* client logos right under the first screen text (owner, 06.11.2026); dark background — some logos are white */
  .hero-clients {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 14px clamp(20px, 3vw, 40px);
    padding-top: 20px;
    border-top: 1px solid rgba(255, 252, 245, 0.16);
  }
  .hero-clients p {
    flex: none;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 252, 245, 0.6);
  }
  .hero-clients ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-clients img {
    display: block;
    width: auto;
    height: 44px;
    max-width: 130px;
    object-fit: contain;
    opacity: 0.9;
  }
  .hero-text {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 18px;
    justify-items: start;
    max-width: 560px;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.1rem, 4.2vw, 3.7rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .hero-title .serif {
    color: #9fe0f6;
  }
  .hero-lead {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: rgba(255, 252, 245, 0.82);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }
  .hero-ghost {
    background: rgba(255, 252, 245, 0.1);
    color: #fffcf5;
    border: 1.5px solid rgba(255, 252, 245, 0.45);
  }
  .hero-ghost:hover {
    background: #fffcf5;
    color: var(--ink);
  }
  /* two facts instead of the tiny photo circles: orders count + hours */
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin: 8px 0 0;
    padding: 18px 0 0;
    list-style: none;
    border-top: 1px solid rgba(255, 252, 245, 0.18);
  }
  .hero-facts li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.88rem;
    line-height: 1.3;
    color: rgba(255, 252, 245, 0.78);
  }
  .hero-facts b {
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fffcf5;
  }
  .hero-facts :global(svg) {
    flex: none;
    color: #9fe0f6;
  }
  .hero-wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(40px, 6vw, 80px);
    fill: var(--paper);
  }

  /* ---------------- light first screen (owner, 06.11.2026: try white instead of dark navy, no burgundy ribbon) */
  .hero-light {
    --hero-bg: var(--paper);
    background: var(--paper);
    color: var(--ink);
  }
  .hero-light .hero-media::after {
    background:
      linear-gradient(0deg, rgba(255, 252, 245, 0.92) 0, rgba(255, 252, 245, 0.45) 18%, rgba(255, 252, 245, 0) 32%),
      linear-gradient(90deg, var(--paper) 0%, rgba(255, 252, 245, 0.85) 10%, rgba(255, 252, 245, 0.2) 26%, rgba(255, 252, 245, 0) 38%);
  }
  .hero-light .hero-title .serif {
    color: var(--c-ink);
  }
  .hero-light .hero-lead {
    color: var(--ink-2);
  }
  .hero-light .hero-ghost {
    background: transparent;
    color: var(--ink);
    border-color: rgba(23, 21, 28, 0.35);
  }
  .hero-light .hero-ghost:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .hero-light .hero-facts,
  .hero-light .hero-clients {
    border-top-color: rgba(23, 21, 28, 0.14);
  }
  .hero-light .hero-facts li {
    color: var(--ink-2);
  }
  .hero-light .hero-facts b {
    color: var(--ink);
  }
  .hero-light .hero-facts :global(svg) {
    color: var(--c-ink);
  }
  .hero-light .hero-clients p {
    color: var(--ink-2);
  }
  /* «Нам доверяют» (owner, 07.11.2026): logos in colour with a soft white glow so they read over the photo too;
     white logos are darkened (white on paper is invisible); round/square logos are shown larger */
  .hero-light .hero-clients ul {
    gap: 16px clamp(24px, 3.4vw, 48px);
  }
  .hero-light .hero-clients img {
    height: 38px;
    max-width: 150px;
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 6px rgba(255, 255, 255, 0.95));
    transition: transform 0.2s ease;
  }
  .hero-light .hero-clients .is-square img {
    height: 56px;
  }
  .hero-light .hero-clients .is-white img {
    filter: brightness(0) drop-shadow(0 0 1px #fff) drop-shadow(0 0 6px rgba(255, 255, 255, 0.95));
    opacity: 0.85;
  }
  @media (hover: hover) {
    .hero-light .hero-clients li:hover img {
      transform: translateY(-2px);
    }
  }
  :global(.hero-light + .nyb)::before {
    display: none;
  }

  /* ---------------- about: collage + values */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .about-collage {
    position: relative;
    aspect-ratio: 1 / 0.92;
    max-width: 100%;
  }
  .ab {
    position: absolute;
    overflow: clip;
    box-shadow: 0 24px 40px -26px rgba(22, 20, 27, 0.5);
    background: var(--paper-2);
  }
  .ab img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ab-1 {
    left: 0;
    top: 0;
    width: 52%;
    height: 58%;
    border-radius: 34px 60px 34px 34px;
    transform: rotate(-2deg);
  }
  .ab-2 {
    right: 2%;
    top: 6%;
    width: 42%;
    height: 50%;
    border-radius: 60px 34px 34px 34px;
    transform: rotate(2deg);
  }
  .ab-3 {
    left: 14%;
    bottom: 0;
    width: 74%;
    height: 40%;
    border-radius: 34px 34px 80px 34px;
  }
  .ab-3 img {
    object-position: 50% 40%;
  }
  .ab-blob {
    position: absolute;
    left: -4%;
    bottom: -4%;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 58% 42% 50% 50% / 50% 56% 44% 50%;
    background: var(--c-soft);
    z-index: -1;
  }
  .about-text {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .about-text h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 1.06;
    text-wrap: balance;
  }
  .about-text h2 .serif,
  .cats-side h2 .serif,
  .occasions h2 .serif {
    color: var(--c-ink);
  }

  /* ---------------- categories: text, photo cards */
  .cats-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2.2fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;

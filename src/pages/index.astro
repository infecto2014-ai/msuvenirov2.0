---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import Icon from '@/components/Icon.astro';
import { categoryFrom, defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import { generalFaq } from '@/data/faq';
import { site } from '@/data/site';
import { faqPage } from '@/lib/schema';

const tiles = [
  { href: '/pechat-na-futbolkah', title: 'Печать на футболках и худи', text: 'от 1 шт, на нашей футболке или на вашей', img: '/img/showcase/tshirt.webp', alt: 'Футболки с печатью логотипа', cat: 'textile', tone: 'c', size: 'xl', from: findProduct('textile', 'tshirt-unisex')!.fromPrice },
  { href: '/pechat-na-kruzhkah', title: 'Печать на кружках', text: 'белые, хамелеон, золото', img: '/img/showcase/colored-mugs.webp', alt: 'Цветные кружки с печатью', cat: 'mugs', tone: 'm', size: 'tall' },
  { href: '/znachki', title: 'Значки', text: 'закатные и на цанге', img: '/img/showcase/keychains.webp', alt: 'Значки и брелоки с логотипом', cat: 'badges', tone: 'y' },
  { href: '/vizitki', title: 'Визитки', text: 'одно- и двусторонние', img: '/img/showcase/business-cards.webp', alt: 'Визитки', cat: 'cards', tone: 'c' },
  { href: '/pechat-na-kepkah', title: 'Бейсболки и шопперы', text: 'печать логотипа', img: '/img/showcase/cap.webp', alt: 'Бейсболка с логотипом', cat: 'textile', tone: 'y', from: findProduct('textile', 'shopper')!.fromPrice },
  { href: '/kalendari', title: 'Календари', text: 'квартальные, настенные, домики', img: '/img/showcase/stationery.webp', alt: 'Календари и полиграфия', cat: 'calendars', tone: 'm' },
  { href: '/nakleyki', title: 'Стикеры', text: '3D из смолы и виниловые', img: '/img/showcase/stickers-3d.webp', alt: 'Объёмные 3D-стикеры', cat: 'stickers', tone: 'c' },
  { href: '/fotopodarki', title: 'Фотоподарки', text: 'подушки, пазлы, магниты', img: '/img/showcase/pillow.webp', alt: 'Подушка с фото', cat: 'gifts', tone: 'y' },
];

/** Popular orders with a ready "turnkey" price — always computed from pricing.ts, never typed by hand. */
const quoteOf = (cat: string, id: string, qty?: number, options: Selection['options'] = {}) => {
  const p = findProduct(cat, id)!;
  const base = defaultSelection(p);
  const sel: Selection = { ...base, qty: qty ?? base.qty, options: { ...base.options, ...options } };
  return { qty: sel.qty, ...p.quote(sel) };
};
const popular = [
  { title: 'Футболка с вашим принтом', note: 'белая или чёрная, принт А4', img: '/portfolio/portfolio-21.webp', calc: 'textile:tshirt-unisex', q: quoteOf('textile', 'tshirt-unisex', 1) },
  { title: 'Кружка с фото', note: 'белая, 330 мл', img: '/portfolio/portfolio-2.webp', calc: 'mugs:mug', q: quoteOf('mugs', 'mug', 1) },
  { title: 'Ёлочный шар с фото', note: 'к Новому году, 70 мм', img: '/portfolio/portfolio-6.webp', calc: 'gifts:ball', q: quoteOf('gifts', 'ball', 1) },
  { title: 'Визитки', note: '90×50 мм, бумага 300 г', img: '/img/showcase/business-cards.webp', calc: 'cards:business-cards', q: quoteOf('cards', 'business-cards', 96) },
  { title: 'Значки с логотипом', note: 'закатные, 38 мм', img: '/img/showcase/keychains.webp', calc: 'badges:badge-roll', q: quoteOf('badges', 'badge-roll', 25) },
  { title: 'Футболки для команды', note: 'с логотипом А4', img: '/portfolio/portfolio-20.webp', calc: 'textile:tshirt-unisex', q: quoteOf('textile', 'tshirt-unisex', 20) },
];

const occasions = [
  { when: '31 декабря', title: 'Новый год', text: 'Ёлочные шары с фото, календари, подарки коллегам и клиентам', href: '/fotopodarki', tone: 'c' },
  { when: '23 февраля', title: 'День защитника', text: 'Футболки и худи с надписью, кружки, значки', href: '/pechat-na-futbolkah', tone: 'y' },
  { when: '8 марта', title: 'Женский день', text: 'Кружки с фото, подушки, пазлы, шопперы', href: '/pechat-na-kruzhkah', tone: 'm' },
  { when: 'в любой день', title: 'День рождения', text: 'Футболка или худи с фото именинника, фотоподарки', href: '/pechat-na-hudi', tone: 'c' },
  { when: 'май–июнь', title: 'Выпускной', text: 'Футболки для класса, значки, медали и вымпелы', href: '/znachki', tone: 'y' },
  { when: 'круглый год', title: 'Для компании', text: 'Мерч для сотрудников, форма, подарки партнёрам', href: '/korporativnym-klientam', tone: 'm' },
];

const terms = [
  { icon: 'clock', title: 'Сроки', text: 'Обычно 1–3 рабочих дня. Срочные заказы — без наценки, успеем к нужной дате.' },
  { icon: 'calc', title: 'Оплата', text: 'Наличными, картой или по QR-коду. Частным лицам — предоплата 50%, остаток при получении. Организациям — счёт без НДС.' },
  { icon: 'upload', title: 'Макет', text: 'Перед печатью присылаем макет на согласование. Простой макет соберём бесплатно.' },
  { icon: 'check', title: 'Гарантия', text: 'Если брак по нашей вине — переделаем бесплатно.' },
] as const;

const clients = [
  { src: '/img/clients/client-1.webp', alt: 'Россети' },
  { src: '/img/clients/client-6.webp', alt: 'БФУ имени И. Канта' },
  { src: '/img/clients/client-2.webp', alt: 'Арле Парк' },
  { src: '/img/clients/client-4.webp', alt: 'Папаша Беппе' },
  { src: '/img/clients/client-5.webp', alt: 'Бойцовский клуб «Неудержимые»' },
  { src: '/img/clients/client-7.webp', alt: 'Systech' },
  { src: '/img/clients/client-8.webp', alt: 'Музей мороженого' },
];

const homeFaq = generalFaq.flatMap((g) => g.items).slice(0, 6);
---

<BaseLayout
  title="Печать на футболках, кружках и сувенирах в Калининграде — Мастерская сувениров"
  description="Печать на одежде, кружках, значках, визитках и календарях в Калининграде от 1 шт. Онлайн-калькулятор цен, срочно без наценки. ТЦ «Экватор», с 2019 года."
  path="/"
  schema={[faqPage(homeFaq)]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">ТЦ «Экватор» · с {site.founded} года</p>
        <h1 class="hero-title">
          Печать на&nbsp;одежде и&nbsp;сувенирах <span class="mark">в&nbsp;Калининграде</span>
        </h1>
        <p class="lead">
          Футболки, худи, кружки, значки, визитки и календари с вашим дизайном — от 1 штуки. Своё производство и больше 10 лет опыта в печати.
        </p>
        <div class="hero-actions">
          <a class="btn btn-magenta" href="/price"><Icon name="calc" size={20} /> <span>Рассчитать<span class="hide-sm"> стоимость</span></span></a>
          <button type="button" class="btn btn-ghost" data-order><Icon name="upload" size={20} /> <span class="hide-sm">Отправить макет</span><span class="show-sm">Макет</span></button>
        </div>
        <ul class="hero-facts">
          <li><b>от 1 шт</b><span>без минимального тиража</span></li>
          <li><b>0 ₽</b><span>наценка за срочность</span></li>
          <li><b>50+</b><span>стирок выдерживает DTF</span></li>
        </ul>
      </div>

      <div class="hero-collage" aria-hidden="true">
        <div class="hc hc-1"><img src="/img/showcase/tshirt.webp" alt="" width="360" height="360" fetchpriority="high" /></div>
        <div class="hc hc-2"><img src="/img/showcase/mug.webp" alt="" width="260" height="260" /></div>
        <div class="hc hc-3"><img src="/img/showcase/keychains.webp" alt="" width="220" height="220" /></div>
        <div class="hc hc-4"><img src="/img/showcase/cap.webp" alt="" width="200" height="200" /></div>
        <span class="sticker hc-sticker">Срочные заказы</span>
        <span class="reg hc-reg-1"></span>
        <span class="reg hc-reg-2"></span>
        <div class="hc-dots halftone"></div>
      </div>
    </div>
  </section>

  <!-- POPULAR -->
  <section class="section popular" aria-labelledby="pop-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Популярное</p>
          <h2 id="pop-h">Что чаще всего заказывают</h2>
        </div>
        <p>Цена указана за готовое изделие с печатью. Другой тираж или размер — в калькуляторе.</p>
      </div>
      <ul class="pop-grid">
        {
          popular.map((it) => {
            const label = `${it.title}, ${it.q.qty} шт — ${rub(it.q.total)}`;
            return (
              <li class="pop">
                <img src={it.img} alt={it.title} width="320" height="320" loading="lazy" decoding="async" />
                <div class="pop-body">
                  <h3>{it.title}</h3>
                  <p class="pop-note">
                    {it.note} · {it.q.qty} шт
                  </p>
                  <p class="pop-price mono">
                    {rub(it.q.total)}
                    {it.q.qty > 1 && <small>{rub(it.q.unit)} / шт</small>}
                  </p>
                  <div class="pop-actions">
                    <button type="button" class="btn btn-sm btn-magenta" data-order={label}>
                      Заказать
                    </button>
                    <a class="pop-edit" href={`/price?calc=${it.calc}#calc`}>
                      Другой тираж →
                    </a>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="section cats" aria-labelledby="cats-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Что печатаем</p>
          <h2 id="cats-h">Изделия и цены</h2>
        </div>
        <a class="btn btn-ghost btn-sm" href="/uslugi">Все услуги →</a>
      </div>
      <div class="bento">
        {
          tiles.map((t) => {
            const f = t.from ?? categoryFrom(t.cat).price;
            return (
              <a class={`tile tile-${t.tone} ${t.size ? `tile-${t.size}` : ''}`} href={t.href}>
                <span class="tile-img">
                  <img src={t.img} alt={t.alt} width="320" height="320" loading="lazy" decoding="async" />
                </span>
                <span class="tile-body">
                  <h3 class="tile-title">{t.title}</h3>
                  <span class="tile-text">{t.text}</span>
                  <span class="tile-price mono">от {rub(f)}</span>
                </span>
                <span class="tile-arrow"><Icon name="arrow" /></span>
              </a>
            );
          })
        }
      </div>
      <p class="cats-more">
        А ещё: <a href="/breloki">брелоки</a>, <a href="/magnity">магниты</a>, <a href="/poligrafiya">листовки и блокноты</a>,
        <a href="/shirokoformatnaya-pechat">широкоформатная печать</a>, <a href="/pechat-na-hudi">худи</a>, <a href="/pechat-na-shopperah">шопперы</a>.
      </p>
    </div>
  </section>

  <PortfolioGrid />

  <!-- OCCASIONS -->
  <section class="section occasions" aria-labelledby="occ-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Идеи подарков</p>
          <h2 id="occ-h">Подарки к празднику</h2>
        </div>
        <p>Подскажем, что подарить, и сделаем к нужной дате. Перед праздниками лучше написать заранее.</p>
      </div>
      <ul class="occ-grid">
        {
          occasions.map((o) => (
            <li>
              <a class={`occ occ-${o.tone}`} href={o.href}>
                <span class="occ-when mono">{o.when}</span>
                <h3>{o.title}</h3>
                <p>{o.text}</p>
                <span class="occ-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Reviews />

  <!-- B2B -->
  <section class="section" aria-labelledby="b2b-h">
    <div class="wrap">
      <div class="b2b">
        <div class="b2b-cmyk" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="b2b-text">
          <p class="eyebrow b2b-eyebrow">Компаниям</p>
          <h2 id="b2b-h">Мерч и подарки с логотипом для компаний</h2>
          <p>
            Футболки для команды, подарки партнёрам, календари к Новому году, значки и брелоки для мероприятий. Работаем по счёту без НДС, с закрывающими документами. Соберём смету
            на весь набор и подготовим макеты.
          </p>
          <div class="b2b-actions">
            <a class="btn btn-yellow" href="/korporativnym-klientam">Условия для компаний</a>
            <button type="button" class="btn b2b-ghost" data-order="Запрос расчёта для компании">Запросить расчёт</button>
          </div>
        </div>
        <ul class="b2b-list">
          <li><span class="mono">01</span> Счёт без НДС и закрывающие документы</li>
          <li><span class="mono">02</span> Одна смета на футболки, кружки, значки и полиграфию</li>
          <li><span class="mono">03</span> Макет по вашему брендбуку — согласуем до печати</li>
          <li><span class="mono">04</span> Образец перед тиражом</li>
        </ul>
        <div class="clients">
          <p class="clients-title mono">Нам доверяют</p>
          <ul class="clients-row">
            {
              clients.map((c) => (
                <li>
                  <img src={c.src} alt={c.alt} title={c.alt} width="140" height="70" loading="lazy" decoding="async" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <HowItWorks />

  <!-- TERMS -->
  <section class="terms-band" aria-labelledby="terms-h">
    <div class="wrap">
      <h2 id="terms-h" class="sr-only">Сроки, оплата и гарантия</h2>
      <ul class="terms">
        {
          terms.map((t) => (
            <li>
              <span class="terms-icon"><Icon name={t.icon} size={22} /></span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- SEO TEXT -->
  <section class="section seo-text" aria-labelledby="seo-h">
    <div class="wrap">
      <h2 id="seo-h">Печать на заказ в Калининграде</h2>
      <input type="checkbox" id="seo-more" class="seo-toggle" />
      <div class="seo-cols">
        <div>
          <h3>Печать на футболках и худи</h3>
          <p>
            Печатаем на <a href="/pechat-na-futbolkah">футболках</a>, <a href="/pechat-na-hudi">худи</a>, свитшотах, поло и
            <a href="/pechat-na-shopperah">шопперах</a> от одной штуки. Основная технология — DTF: яркий принт на ткани любого цвета, который выдерживает больше 50 стирок. Можно
            принести свою вещь или выбрать нашу — белые и чёрные футболки всегда в наличии.
          </p>
        </div>
        <div>
          <h3>Печать на кружках и фотоподарки</h3>
          <p>
            Делаем <a href="/pechat-na-kruzhkah">кружки с фото</a> и надписью: белые, цветные, хамелеон. Из фотографий получаются
            <a href="/fotopodarki">подушки, пазлы, ёлочные шары</a> и <a href="/magnity">магниты</a> — подарок, который можно забрать в тот же день или к нужной дате.
          </p>
        </div>
        <div>
          <h3>Мерч и сувениры с логотипом для компаний</h3>
          <p>
            Для компаний Калининграда делаем корпоративный мерч: футболки и поло с логотипом, <a href="/pechat-na-kepkah">бейсболки</a>,
            <a href="/znachki">значки</a>, <a href="/breloki">брелоки</a>, подарки сотрудникам и партнёрам. Работаем по счёту без НДС, перед тиражом согласуем макет и
            показываем образец. Подробнее — в разделе <a href="/korporativnym-klientam">для компаний</a>.
          </p>
        </div>
        <div>
          <h3>Полиграфия и широкоформатная печать</h3>
          <p>
            Печатаем <a href="/vizitki">визитки</a>, <a href="/poligrafiya">листовки и блокноты</a>, <a href="/kalendari">календари</a> — квартальные, настенные и
            карманные. Для вывесок и витрин — <a href="/shirokoformatnaya-pechat">широкоформатная печать</a> на плёнке и баннере. Нет макета — поможем его сделать.
          </p>
        </div>
      </div>
      <label for="seo-more" class="seo-more-btn">Читать полностью</label>
    </div>
  </section>

  <FaqSection items={homeFaq} />

  <ContactBlock />
</BaseLayout>

<style>
  /* ---------------- hero */
  .hero {
    padding-block: clamp(20px, 3vw, 40px) clamp(24px, 4vw, 48px);
    overflow: clip;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .hero-text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .hero-title {
    font-size: clamp(2rem, 3.6vw, 3.3rem);
    line-height: 1.06;
    font-weight: 800;
    max-width: 15ch;
  }
  .hero-text .lead {
    max-width: 52ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-facts {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-facts li {
    display: grid;
    gap: 2px;
    padding: 12px 16px;
    border-radius: 18px;
    background: var(--card);
    border: 1.5px solid var(--line);
    min-width: 150px;
  }
  .hero-facts b {
    font-family: var(--mono);
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }
  .hero-facts span {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .hero-collage {
    position: relative;
    aspect-ratio: 1 / 1.02;
    max-width: 540px;
    width: min(100%, calc((100svh - 190px) / 1.02));
    justify-self: end;
  }
  .hc {
    position: absolute;
    overflow: clip;
    box-shadow: 0 24px 40px -24px rgba(22, 20, 27, 0.45);
  }
  .hc img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    transform: scale(var(--zoom, 1)) translate(var(--dx, 0), var(--dy, 0));
    mix-blend-mode: multiply;
  }
  /* The photos are portrait and the shapes are irregular: these values put each product
     in the visual middle of its shape (zoom leaves room for the small shift). */
  .hc-1 img { --pos: 50% 0%; --zoom: 1.08; --dx: 3%; }
  .hc-2 img { --pos: 50% 0%; --zoom: 1.1; --dy: 3%; }
  .hc-3 img { --pos: 50% 10%; --zoom: 1.08; --dx: 2%; }
  .hc-4 img { --pos: 50% 0%; --zoom: 1.12; --dx: 4%; --dy: 2%; }
  .hc-1 {
    left: 0;
    top: 6%;
    width: 60%;
    aspect-ratio: 1;
    background: var(--c-soft);
    border-radius: 48% 52% 46% 54% / 55% 45% 55% 45%;
  }
  .hc-2 {
    right: 2%;
    top: 0;
    width: 40%;
    aspect-ratio: 1;
    background: var(--m-soft);
    border-radius: 50%;
  }
  .hc-3 {
    right: 0;
    bottom: 6%;
    width: 46%;
    aspect-ratio: 1;
    background: var(--y-soft);
    border-radius: 36px 36px 120px 36px;
  }
  .hc-4 {
    left: 14%;
    bottom: 0;
    width: 34%;
    aspect-ratio: 1;
    background: var(--paper-2);
    border-radius: 120px 36px 36px 36px;
  }
  .hc-sticker {
    position: absolute;
    left: 38%;
    top: 46%;
    z-index: 3;
    transform: rotate(-6deg);
    font-size: 0.95rem;
    max-width: 200px;
    text-align: center;
    line-height: 1.2;
  }
  .hc-reg-1 {
    position: absolute;
    left: -4px;

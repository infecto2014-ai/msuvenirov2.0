---
// «Печать календарей» — own page (like the t-shirt page): first screen, calculator, ready options, five quarterly models
// drawn in one scale, options, anatomy, other calendars, audience, how to order, works, reviews, FAQ, SEO text.
// Content — src/data/calendarsPage.ts; every price — src/data/pricing.ts. The services.ts entry stays for menus/sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import TeeHead from '@/components/tee/TeeHead.astro';
import PpHero from '@/components/product-page/PpHero.astro';
import PpSteps from '@/components/product-page/PpSteps.astro';
import PpAudience from '@/components/product-page/PpAudience.astro';
import PpHow from '@/components/product-page/PpHow.astro';
import PpSeo from '@/components/product-page/PpSeo.astro';
import FoldScript from '@/components/product-page/FoldScript.astro';
import '@/components/product-page/pp.css';
import CalendarArt from '@/components/calendar/CalendarArt.astro';
import CalendarPackages from '@/components/calendar/CalendarPackages.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { calendarsPage as page } from '@/data/calendarsPage';
import { services } from '@/data/services';
import { defaultSelection, findCategory, findProduct, rub, type Product, type Selection } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Календари', href: page.slug },
];

// ---- prices, all from pricing.ts
const cat = findCategory('calendars')!;
const quarterly = findProduct('calendars', 'cal-quarterly')!;
const selOf = (p: Product, options: Selection['options'] = {}, qty = p.qty.min): Selection => {
  const b = defaultSelection(p);
  return { ...b, qty, options: { ...b.options, ...options } };
};
const ladderMin = (p: Product, options: Selection['options'] = {}) => Math.min(...(p.ladder ? p.ladder(selOf(p, options)).map((t) => t.price) : [p.fromPrice]));
const modelFrom = Object.fromEntries(page.models.map((m) => [m.id, ladderMin(quarterly, { model: m.id })]));
const extra = (options: Selection['options']) => quarterly.quote(selOf(quarterly, options)).unit - quarterly.quote(selOf(quarterly)).unit;
const extraPrice = { silver: extra({ strip: 'silver' }), gold: extra({ strip: 'gold' }), fold: extra({ fold: ['fold'] }) };
const others = page.others.map((o) => {
  const p = findProduct('calendars', o.product)!;
  if (p.qty.presets) {
    const q = p.quote(selOf(p));
    return { ...o, price: `от ${rub(q.total)}`, per: `за ${p.qty.min} шт` };
  }
  return { ...o, price: `от ${rub(o.variant ? ladderMin(p, { variant: o.variant }) : p.fromPrice)}`, per: '/ шт' };
});
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];

// ---- «Виды календарей»: one scale for all five drawings (px per mm); 10 cm grid on the wall behind them
const KSCALE = 0.42;
const tallest = Math.max(...page.models.map((m) => m.height));

// ---- anatomy: markers over the drawing, in mm of the calendar (MIDI, 3 fields).
// Margins of the drawing with dimension lines — the same formulas as in CalendarArt.astro (dims, no strip).
const ASCALE = 0.52;
const ART = { w: 325, h: 900, padL: 4, padR: 64 / ASCALE, padT: 4 + 26 / ASCALE, padB: 8 };
const pos = (x: number, y: number) => ({
  left: ((ART.padL + x) / (ART.w + ART.padL + ART.padR)) * 100,
  top: ((ART.padT + y) / (ART.h + ART.padT + ART.padB)) * 100,
});
const marks = [
  { n: 1, x: 262, y: 120 },
  { n: 2, x: 22, y: 330 },
  { n: 3, x: 250, y: 430 },
  { n: 4, x: 200, y: 240 },
  { n: 5, x: 168, y: 551 },
].map((m) => ({ n: m.n, ...pos(m.x, m.y) }));
// the cursor (a sliding window over today's date) is not part of the drawing — a frame on top of it, on 13 January
const cursor = { ...pos(106, 541), w: (39 / (ART.w + ART.padL + ART.padR)) * 100, h: (20 / (ART.h + ART.padT + ART.padB)) * 100 };

// three facts under the buttons of the first screen (same row as on the t-shirt page)
const heroFacts = [{ big: `${quarterly.qty.min} шт`, small: 'минимальный тираж' },{ big: `${page.models.length}`, small: 'моделей квартальных календарей' },{ big: '2027', small: 'макет и сетка на год' }];
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/portfolio/portfolio-29.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: Math.min(...cat.products.map((p) => p.fromPrice)), offerCount: cat.products.length }),
    faqPage(page.faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <PpHero eyebrow={page.eyebrow} h1={page.h1} lead={page.lead} crumbs={crumbs} mark="календарей" heroAlt={page.heroAlt} facts={heroFacts} price={{ pre: 'от', value: rub(quarterly.fromPrice), note: 'квартальный' }} stage="free">
    <span class="khero-nail khero-nail-1"></span>
    <span class="khero-nail khero-nail-2"></span>
    <CalendarArt type="midi3" strip="gold" scale={0.5} class="khero-cal khero-cal-1" />
    <CalendarArt type="trio" strip="silver" scale={0.5} class="khero-cal khero-cal-2" />
  </PpHero>

  <!-- ============ calculator (light grey) ============ -->
  <div class="band band-tint">
    <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
      <div class="wrap">
        <TeeHead icon="calc" eyebrow="Калькулятор" id="calc-h" title="Посчитайте свои календари" mark="календари">
          <p class="calc-sub">Выберите модель, планку и тираж — цена за штуку и за весь тираж пересчитается сразу. Настенные, домики и карманные — переключите вид календаря.</p>
        </TeeHead>
        <Calculator client:visible category="calendars" product="cal-quarterly" hideCategories />
      </div>
      <AlsoOrder slugs={page.alsoOrder} />
    </section>
  </div>

  <!-- ============ ready options (white) ============ -->
  <div class="band">
    <CalendarPackages />
  </div>

  <!-- ============ five quarterly models in one scale (light grey) ============ -->
  <div class="band band-tint">
    <section class="section kinds pp-sec" aria-labelledby="kinds-h">
      <div class="wrap">
        <TeeHead icon="ruler" eyebrow="Виды календарей" id="kinds-h" title="Квартальные календари МИДИ, МИНИ и «3 в 1»" mark="«3 в 1»">
          <p class="pp-sub">Все пять моделей нарисованы в одном масштабе — видно, какой календарь крупнее. Одна клетка на фоне — 10 × 10 см.</p>
        </TeeHead>
        <div class="kinds-wall" style={`--cell:${100 * KSCALE}px;--wall:${Math.round(tallest * KSCALE) + 44}px`}>
          <ol class="kinds-row">
            {
              page.models.map((m) => (
                <li class="kinds-item">
                  <a class="kinds-art" href={`#kind-${m.id}`} aria-label={m.name}>
                    <span class="kinds-nail" aria-hidden="true" />
                    <CalendarArt type={m.id} scale={KSCALE} title={`Квартальный календарь ${m.name}, ширина ${m.width} мм`} />
                  </a>
                  <span class="kinds-h">≈ {Math.round(m.height / 10)} см</span>
                </li>
              ))
            }
          </ol>
          <span class="kinds-legend" aria-hidden="true"><i></i> 10 см</span>
        </div>
        <ul class="kinds-cards">
          {
            page.models.map((m) => (
              <li id={`kind-${m.id}`} class="kcard pp-card">
                <span class="pp-tag">{m.tag}</span>
                <h3>{m.name}</h3>
                <dl class="kcard-specs">
                  <div><dt>Ширина</dt><dd>{m.width} мм</dd></div>
                  <div><dt>Высота</dt><dd>≈ {m.height} мм</dd></div>
                  <div><dt>Постер</dt><dd>{m.poster}</dd></div>
                  <div><dt>Рекламных полей</dt><dd>{m.fields}</dd></div>
                </dl>
                <p class="kcard-text">{m.text}</p>
                <div class="kcard-foot">
                  <span class="kcard-price">от {rub(modelFrom[m.id])}<small>/шт</small></span>
                  <button type="button" class="btn btn-sm btn-ghost" data-order={`Квартальный календарь ${m.name} — рассчитать тираж`}>Заказать</button>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <!-- ============ options (white) ============ -->
  <div class="band">
    <section class="section opts pp-sec" aria-labelledby="opts-h">
      <div class="wrap">
        <TeeHead icon="layers" eyebrow="Опции" id="opts-h" title="Металлическая планка и подгиб постера" mark="постера">
          <p class="pp-sub">Добавляются к любой квартальной модели. Доплата — за один календарь, в калькуляторе она учитывается сразу.</p>
        </TeeHead>
        <ul class="opts-grid">
          {
            page.options.map((o) => (
              <li class="opt pp-card">
                <div class="opt-art pp-art" aria-hidden="true">
                  <CalendarArt type="midi1" strip={o.id === 'fold' ? 'none' : o.id} fold={o.id === 'fold'} scale={0.62} />
                  <span class="opt-lens" />
                </div>
                <div class="opt-body">
                  <span class="opt-price">+{rub(extraPrice[o.id])} / шт</span>
                  <h3>{o.title}</h3>
                  <p>{o.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <!-- ============ anatomy (navy panel) ============ -->
  <div class="band band-ink">
    <section class="section anat pp-sec" aria-labelledby="anat-h">
      <div class="wrap anat-grid">
        <figure class="anat-art pp-art">
          <div class="anat-pic">
            <CalendarArt type="midi3" dims scale={ASCALE} title="Схема квартального календаря МИДИ с тремя рекламными полями и размерами" />
            <span class="anat-cursor" style={`left:${cursor.left}%;top:${cursor.top}%;width:${cursor.w}%;height:${cursor.h}%`} aria-hidden="true"></span>
            {marks.map((m) => <span class="anat-mark" style={`left:${m.left}%;top:${m.top}%`} aria-hidden="true">{m.n}</span>)}
          </div>
          <figcaption>МИДИ, 3 рекламных поля · размеры в мм</figcaption>
        </figure>
        <div class="anat-text">
          <TeeHead icon="layers" eyebrow="Устройство" id="anat-h" title="Из чего состоит квартальный календарь" mark="календарь" dark />
          <PpSteps items={page.anatomy} />
        </div>
      </div>
    </section>
  </div>

  <!-- ============ other calendars (light grey) ============ -->
  <div class="band band-tint">
    <section class="section oth pp-sec" aria-labelledby="oth-h">
      <div class="wrap">
        <TeeHead icon="gift" eyebrow="Ещё календари" id="oth-h" title="Настенные, настольные и карманные календари на заказ" mark="заказ">
          <p class="pp-sub">Их можно заказать даже в одном экземпляре — например, перекидной календарь с семейными фото в подарок.</p>
        </TeeHead>
        <ul class="oth-grid">
          {
            others.map((o) => (
              <li class="oth-card pp-card">
                <span class="oth-art pp-art" aria-hidden="true">
                  {o.art === 'poster' && (
                    <svg viewBox="0 0 80 100" width="80" height="100">
                      <rect x="8" y="4" width="64" height="92" rx="3" fill="#fff" stroke="currentColor" stroke-width="2" />
                      <rect x="14" y="10" width="52" height="16" rx="2" fill="var(--tone)" />
                      {Array.from({ length: 12 }, (_, k) => (
                        <rect x={14 + (k % 3) * 18} y={32 + Math.floor(k / 3) * 15} width="15" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.55" />
                      ))}
                    </svg>
                  )}
                  {o.art === 'flip' && (
                    <svg viewBox="0 0 80 100" width="80" height="100">
                      <rect x="12" y="10" width="60" height="86" rx="3" fill="#fff" stroke="currentColor" stroke-width="2" opacity="0.5" />
                      <rect x="8" y="8" width="60" height="86" rx="3" fill="#fff" stroke="currentColor" stroke-width="2" />
                      <rect x="14" y="16" width="48" height="38" rx="2" fill="var(--tone)" />
                      <circle cx="26" cy="30" r="5" fill="#fff" opacity="0.8" />
                      <path d="M14 54 30 38l10 10 8-6 14 12z" fill="#fff" opacity="0.55" />
                      {Array.from({ length: 20 }, (_, k) => (
                        <rect x={15 + (k % 7) * 7} y={60 + Math.floor(k / 7) * 9} width="5" height="5" rx="1" fill="currentColor" opacity="0.4" />
                      ))}
                      {Array.from({ length: 7 }, (_, k) => (
                        <circle cx={16 + k * 7.5} cy="8" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6" />
                      ))}
                    </svg>
                  )}
                  {o.art === 'desk' && (
                    <svg viewBox="0 0 100 100" width="100" height="100">
                      <path d="M14 86 36 18h28l22 68z" fill="var(--tone)" opacity="0.35" />
                      <path d="M14 86 36 18h28l22 68z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                      <path d="M22 80 40 26h20l18 54z" fill="#fff" />
                      {Array.from({ length: 21 }, (_, k) => (
                        <rect x={38 + (k % 7) * 4} y={46 + Math.floor(k / 7) * 8} width="2.6" height="2.6" fill="currentColor" opacity="0.45" />
                      ))}
                      <rect x="38" y="32" width="26" height="6" rx="1.5" fill="var(--tone)" />
                      <path d="M8 88h84" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  )}
                  {o.art === 'pocket' && (
                    <svg viewBox="0 0 100 100" width="100" height="100">
                      <rect x="34" y="14" width="46" height="72" rx="5" fill="#fff" stroke="currentColor" stroke-width="2" transform="rotate(10 57 50)" opacity="0.5" />
                      <rect x="22" y="14" width="46" height="72" rx="5" fill="#fff" stroke="currentColor" stroke-width="2" />
                      {Array.from({ length: 12 }, (_, k) => (
                        <rect x={27 + (k % 3) * 12.5} y={20 + Math.floor(k / 3) * 13} width="11" height="10" rx="1" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5" />
                      ))}
                      <rect x="27" y="74" width="36" height="7" rx="2" fill="var(--tone)" />
                    </svg>
                  )}
                </span>
                <div class="oth-body">
                  <h3>{o.title}</h3>
                  <p class="oth-text">{o.text}</p>
                  <p class="oth-meta">
                    <span class="oth-price">
                      {o.price} <small>{o.per}</small>
                    </span>
                    <span class="oth-min">{o.min}</span>
                  </p>
                  <a class="oth-link" href={`/kalendari?calc=calendars:${o.product}#calc`}>
                    Рассчитать <Icon name="arrow" size={16} />
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <!-- ============ for whom (white) ============ -->
  <div class="band">
    <PpAudience title="Кому и зачем заказывают календари" mark="календари" items={page.audience} />
  </div>

  <!-- ============ how to order (light grey) ============ -->
  <div class="band band-tint">
    <PpHow title="Как заказать корпоративные календари с логотипом" mark="логотипом" steps={page.steps} layout={page.layout} b2b={page.b2b}>
      <div slot="before" class="how-season pp-card">
        <span class="how-season-cal" aria-hidden="true"><b>XI–XII</b>сезон</span>
        <h3>{page.season.title}</h3>
        <p>{page.season.text}</p>
        <button type="button" class="pk-btn" data-order="Корпоративные календари на 2027 год — хочу заказать заранее">
          Оставить заявку <span class="pk-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
        </button>
      </div>
    </PpHow>
  </div>

  <FoldScript />

  <div class="band band-ink">
    <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: календари и магниты" />
  </div>

  <div class="band">
    <Reviews />
  </div>

  <div class="band band-tint">
    <FaqSection items={page.faq} title="Вопросы о календарях" />
  </div>

  <div class="band">
    <PpSeo title={page.seo.title} sections={page.seo.sections}>
      <a href="/korporativnym-klientam">Корпоративным клиентам</a> · <a href="/magnity">магниты-календари</a> · <a href="/vizitki">визитки</a> ·
      <a href="/poligrafiya">листовки и блокноты</a> · <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
    </PpSeo>
  </div>

  <div class="band band-tint">
    {related.length > 0 && <TshirtRelated items={related} />}
  </div>

  <CtaBand title="Нужны календари к Новому году?" text="Пришлите логотип и пожелания — подберём модель, посчитаем тираж и соберём макет с сеткой на 2027 год." />
</BaseLayout>

<style>
  .calc-sub {
    max-width: 52ch;
  }

  /* ---- first screen: two calendars on nails (laid out in % of the square panel) */
  :global(.ph-panel .khero-cal) {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 16px 22px rgba(20, 33, 61, 0.24));
  }
  :global(.ph-panel .khero-cal-1) {
    left: 15%;
    top: 8%;
    width: 31%;
    transform: rotate(-1.5deg);
    transform-origin: 50% 1%;
  }
  :global(.ph-panel .khero-cal-2) {
    left: 53%;
    top: 15%;
    width: 34%;
    transform: rotate(2deg);
    transform-origin: 50% 1%;
  }
  .khero-nail {
    position: absolute;
    z-index: 2;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--navy, #14213d);
    box-shadow: 0 2px 0 rgba(255, 255, 255, 0.5) inset;
  }
  .khero-nail-1 {
    left: calc(15% + 15.5% - 5px);
    top: calc(8% - 1px);
  }
  .khero-nail-2 {
    left: calc(53% + 17% - 5px);
    top: calc(15% - 1px);
  }

  /* ---- five models on a wall */
  .kinds-wall {
    --kz: 1;
    --cz: calc(var(--cell) * var(--kz));
    position: relative;
    padding: 34px 24px 52px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.95);
    background:
      linear-gradient(rgba(20, 33, 61, 0.07) 1px, transparent 1px) 0 34px / 100% var(--cz),
      linear-gradient(90deg, rgba(20, 33, 61, 0.07) 1px, transparent 1px) 0 0 / var(--cz) 100%,
      radial-gradient(80% 70% at 50% 35%, #ffffff 0%, #eef0f4 100%);
    box-shadow: 0 30px 60px -40px rgba(20, 33, 61, 0.45);
    overflow: clip;
  }
  .kinds-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
  }
  .kinds-item {
    display: grid;
    justify-items: center;
    gap: 8px;
  }
  .kinds-art {
    zoom: var(--kz);
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    height: var(--wall);
    padding-top: 10px;
    color: inherit;
    transition: transform 0.2s ease;
  }
  .kinds-art:hover {
    transform: translateY(-4px);
  }
  .kinds-art :global(svg) {
    flex: none;
    filter: drop-shadow(0 14px 18px rgba(20, 33, 61, 0.22));
  }
  .kinds-nail {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 50%;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border-radius: 50%;
    background: var(--navy, #14213d);
  }
  .kinds-h {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--navy, #14213d);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .kinds-legend {
    position: absolute;
    right: 18px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--navy, #14213d);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .kinds-legend i {
    width: var(--cz);
    height: 6px;
    border: 1.5px solid var(--navy, #14213d);
    border-top: 0;
  }
  .kinds-cards {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }
  .kcard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 18px;
    scroll-margin-top: 90px;
  }
  .kcard:target {
    box-shadow: 0 0 0 2px var(--navy, #14213d);
  }
  .kcard-specs {
    width: 100%;
    margin: 0;
    display: grid;
    gap: 3px;
    font-size: 0.84rem;
  }
  .kcard-specs div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1px dashed rgba(20, 33, 61, 0.2);
  }
  .kcard-specs dt {
    color: var(--muted);

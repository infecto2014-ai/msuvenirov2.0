---
// Service landing pages, generated from src/data/services.ts
import BaseLayout from '@/layouts/BaseLayout.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import Reviews from '@/components/Reviews.astro';
import { garmentBySlug } from '@/data/garments';
import { reviews as allReviews } from '@/data/reviews';
import PriceTables from '@/components/PriceTables.astro';
import ServiceBlocks from '@/components/ServiceBlocks.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import TshirtHero from '@/components/tshirt/TshirtHero.astro';
import TshirtHead from '@/components/tshirt/TshirtHead.astro';
import TshirtPackages from '@/components/tshirt/TshirtPackages.astro';
import TshirtDetails from '@/components/tshirt/TshirtDetails.astro';
import TshirtCompare from '@/components/tshirt/TshirtCompare.astro';
import TshirtIdeas from '@/components/tshirt/TshirtIdeas.astro';
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import { portfolio } from '@/data/portfolio';
import { services } from '@/data/services';
import { categoryFrom, findCategory, findProduct } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

export function getStaticPaths() {
  // these have their own pages (src/pages/korporativnym-klientam.astro, kalendari.astro, pechat-na-kruzhkah.astro, pechat-na-shopperah.astro, pechat-na-kepkah.astro, znachki.astro, nakleyki.astro, pechat-na-futbolkah.astro); the services.ts entries stay for menus and sitemap
  const own = ['/korporativnym-klientam', '/kalendari', '/pechat-na-kruzhkah', '/pechat-na-shopperah', '/pechat-na-kepkah', '/znachki', '/nakleyki', '/pechat-na-futbolkah'];
  return services.filter((s) => !own.includes(s.slug)).map((s) => ({ params: { slug: s.slug.replace(/^\//, '') }, props: { page: s } }));
}

interface Props {
  page: ServicePage;
}
const { page } = Astro.props;
const isCorporate = page.slug === '/korporativnym-klientam';
const cat = findCategory(page.calcCategory)!;
const product = findProduct(page.calcCategory, page.calcProduct);
const from = page.calcProduct && product && !product.fromUnit ? { price: product.fromPrice, unit: 'шт' } : categoryFrom(page.calcCategory);
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: page.name, href: page.slug },
];
const allPrices = cat.products.flatMap((p) => [p.fromPrice]);
// Garment pages (футболки, худи, шопперы, кепки) get their own layout: ready options, print-zone scheme,
// prices of this product only, details of the blank, reviews about it.
const garment = garmentBySlug(page.slug);
const garmentProduct = garment ? findProduct('textile', garment.productId) : undefined;
const garmentReviews = garment?.reviewKeywords.length
  ? allReviews.filter((r) => garment.reviewKeywords.some((k) => r.text.toLowerCase().includes(k))).length
  : 0;
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
// ---- look of /pechat-na-futbolkah for every page of this template (owner, 07.11.2026)
const h1Words = page.h1.replace(' в Калининграде', '').split(' ');
const afterNa = h1Words[h1Words.indexOf('на') + 1];
// marker word of the h1: «на худи» → худи, «Печать визиток» → визиток, «Брелоки на заказ» → Брелоки
const markWord = h1Words.includes('на') && afterNa !== 'заказ' ? afterNa : h1Words[0] === 'Печать' ? h1Words[1] : h1Words[0];
// facts that are true for the whole workshop (CLAUDE.md)
const facts = [
  { big: '10 000+', small: 'заказов с 2019 года' },
  { big: '10–20', small: 'ежедневно, без выходных' },
  { big: '0 ₽', small: 'простой макет соберём сами' },
];
const works = portfolio.filter((w) => w.tags.some((t) => page.portfolioTags.includes(t)) && !w.src.includes('portfolio-14'));
const notes = ['наша работа', 'на заказ'];
const polaroids = works.slice(0, 2).map((w, i) => ({ src: w.src, alt: w.title, note: notes[i] }));
const compare = page.blocks.find((b) => b.kind === 'compare');
const ideas = page.blocks.find((b) => b.kind === 'ideas');
const otherBlocks = page.blocks.filter((b) => b.kind !== 'compare' && b.kind !== 'ideas');
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image={page.image}
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: Math.min(...allPrices), offerCount: cat.products.length }),
    faqPage(page.faq),
  ]}
>
  <TshirtHero
    page={page}
    crumbs={crumbs}
    from={from.price}
    unit={from.unit !== 'шт' ? from.unit : undefined}
    priceNote={garment ? `${page.name.replace('Печать на ', '').toLowerCase()} с печатью` : 'с печатью и макетом'}
    kicker={`${page.name} · Калининград`}
    mark={markWord}
    facts={facts}
    polaroids={polaroids}
  />

  <div class="band band-tint">
    <section id="calc" class="section scalc" aria-labelledby="calc-h">
      <div class="wrap">
        <TshirtHead num="01" eyebrow="Калькулятор" id="calc-h" title={garment ? 'Посчитайте свой вариант' : 'Сколько стоит — посчитайте сами'} mark={garment ? 'свой' : 'посчитайте'} tone="y">
          <p class="scalc-sub">
            {garment
              ? 'Выберите цвет, размеры принтов и количество — цена пересчитается сразу. Несколько принтов: самый дорогой по полной цене, следующий −30%, остальные −50%.'
              : 'Цена меняется сразу. Добавьте позицию в смету или отправьте заявку — менеджер подтвердит стоимость и сроки.'}
          </p>
        </TshirtHead>
        {
          garment ? (
            <Calculator client:visible category="textile" product={garment.productId} hideCategories lockProduct />
          ) : (
            <Calculator client:visible category={page.calcCategory} product={page.calcProduct} hideCategories={!isCorporate} />
          )
        }
      </div>
      {garment?.alsoOrder && <AlsoOrder slugs={garment.alsoOrder} />}
    </section>
  </div>

  {
    garment && garmentProduct ? (
      <>
        <TshirtPackages info={garment} num="02" />
        <div class="band band-ink">
          <TshirtDetails info={garment} productName={garmentProduct.name} num="03" />
        </div>
      </>
    ) : (
      <section class="section" aria-labelledby="prices-h">
        <div class="wrap">
          <TshirtHead num="02" eyebrow="Прайс" id="prices-h" title={`Цены: ${cat.name.toLowerCase()}`} mark={cat.name.toLowerCase()} tone="m">
            <a class="btn btn-ghost btn-sm" href="/price">Весь прайс-лист →</a>
          </TshirtHead>
          <PriceTables categoryId={page.calcCategory} />
        </div>
      </section>
    )
  }

  {compare && <div class="band band-tint"><TshirtCompare block={compare} /></div>}

  {ideas && <div class="band"><TshirtIdeas block={ideas} /></div>}

  {otherBlocks.length > 0 && <div class="band band-tint"><ServiceBlocks blocks={otherBlocks} /></div>}

  <div class="band">
    <PortfolioGrid tags={page.portfolioTags} title={`Примеры: ${page.name.toLowerCase()}`} />
  </div>

  {
    garment && garmentReviews > 0 && (
      <div class="band band-tint">
        <Reviews keywords={garment.reviewKeywords} title={`Отзывы: ${page.name.toLowerCase()}`} />
      </div>
    )
  }

  <div class="band">
    <FaqSection items={page.faq} title={`Вопросы: ${page.name.toLowerCase()}`} />
  </div>

  {related.length > 0 && <div class="band band-tint"><TshirtRelated items={related} /></div>}

  <CtaBand />
</BaseLayout>

<style>
  .scalc-sub {
    max-width: 52ch;
  }
  @media (max-width: 760px) {
    .scalc {
      padding-block: 28px 32px;
    }
    .scalc-sub {
      display: none;
    }
  }
</style>

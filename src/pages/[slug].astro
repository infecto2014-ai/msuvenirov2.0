---
// Service landing pages, generated from src/data/services.ts
import BaseLayout from '@/layouts/BaseLayout.astro';
import Calculator from '@/components/islands/Calculator';
import Reviews from '@/components/Reviews.astro';
import { garmentBySlug } from '@/data/garments';
import { reviews as allReviews } from '@/data/reviews';
import PriceTables from '@/components/PriceTables.astro';
import ServiceBlocks from '@/components/ServiceBlocks.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import TeeHero from '@/components/tee/TeeHero.astro';
import TeeHead from '@/components/tee/TeeHead.astro';
import TeeAlso from '@/components/tee/TeeAlso.astro';
import TeePackages from '@/components/tee/TeePackages.astro';
import TeeDetails from '@/components/tee/TeeDetails.astro';
import TeeCompare from '@/components/tee/TeeCompare.astro';
import TeeRelated from '@/components/tee/TeeRelated.astro';
import { services } from '@/data/services';
import { categoryFrom, findCategory, findProduct } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

export function getStaticPaths() {
  // these have their own pages (src/pages/korporativnym-klientam.astro, kalendari.astro, pechat-na-kruzhkah.astro, pechat-na-shopperah.astro, pechat-na-kepkah.astro, znachki.astro, nakleyki.astro, pechat-na-futbolkah.astro); the services.ts entries stay for menus and sitemap
  const own = ['/korporativnym-klientam', '/kalendari', '/pechat-na-kruzhkah', '/pechat-na-shopperah', '/pechat-na-kepkah', '/znachki', '/nakleyki', '/pechat-na-futbolkah'];
  return services.filter((s) => !own.includes(s.slug)).map((s) => ({ params: { slug: s.slug.replace(/^\//, '') }, props: { page: s } }));
}

interface Props {
  page: ServicePage;
}
const { page } = Astro.props;
const isCorporate = page.slug === '/korporativnym-klientam';
const cat = findCategory(page.calcCategory)!;
const product = findProduct(page.calcCategory, page.calcProduct);
const from = page.calcProduct && product && !product.fromUnit ? { price: product.fromPrice, unit: 'шт' } : categoryFrom(page.calcCategory);
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: page.name, href: page.slug },
];
const allPrices = cat.products.flatMap((p) => [p.fromPrice]);
// Garment pages (футболки, худи, шопперы, кепки) get their own layout: ready options, print-zone scheme,
// prices of this product only, details of the blank, reviews about it.
const garment = garmentBySlug(page.slug);
const garmentProduct = garment ? findProduct('textile', garment.productId) : undefined;
const garmentReviews = garment?.reviewKeywords.length
  ? allReviews.filter((r) => garment.reviewKeywords.some((k) => r.text.toLowerCase().includes(k))).length
  : 0;
// the neon «showcase» photos of the ready options are swapped for a real work (the old hoodie shots are pink/purple)
const packInfo = garment && {
  ...garment,
  packages: garment.packages.map((pk) => ({ ...pk, img: pk.img.startsWith('/img/showcase/') ? '/portfolio/portfolio-5.webp' : pk.img })),
};
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
// ---- look of /pechat-na-futbolkah for every page of this template (owner, 07.11.2026)
const h1Words = page.h1.replace(' в Калининграде', '').split(' ');
const afterNa = h1Words[h1Words.indexOf('на') + 1];
// marker word of the h1: «на худи» → худи, «Печать визиток» → визиток, «Брелоки на заказ» → Брелоки
const markWord = h1Words.includes('на') && afterNa !== 'заказ' ? afterNa : h1Words[0] === 'Печать' ? h1Words[1] : h1Words[0];
// facts that are true for the whole workshop (CLAUDE.md)
const facts = [
  { big: '10 000+', small: 'заказов с 2019 года' },
  { big: '10–20', small: 'ежедневно, без выходных' },
  { big: '0 ₽', small: 'простой макет соберём сами' },
];
// First-screen photo: calm product photos from public/img/products (the neon «showcase» ones are not used)
const heroPhotos: Record<string, { photo: string; alt: string; pos?: string }> = {
  '/pechat-na-odezhde': { photo: 'tshirts', alt: 'Футболки разных цветов на вешалке — заготовки для печати' },
  '/pechat-na-hudi': { photo: 'tshirts', alt: 'Одежда на вешалке — заготовки для печати', pos: '62% 40%' },
  '/breloki': { photo: 'badges', alt: 'Значки и металлические заготовки на светлом фоне', pos: '60% 50%' },
  '/magnity': { photo: 'stickers', alt: 'Прозрачные акриловые заготовки с логотипом', pos: '60% 50%' },
  '/vizitki': { photo: 'business-cards', alt: 'Стопка визиток и листы плотной бумаги на камне', pos: '40% 55%' },
  '/poligrafiya': { photo: 'business-cards', alt: 'Листы плотной бумаги на светлом камне', pos: '70% 60%' },
  '/shirokoformatnaya-pechat': { photo: 'calendar', alt: 'Настенный календарь с пейзажем на светлом фоне', pos: '50% 40%' },
  '/fotopodarki': { photo: 'pillow', alt: 'Белая подушка — заготовка для печати фотографии', pos: '60% 50%' },
};
const hero = heroPhotos[page.slug] ?? { photo: 'tshirts', alt: page.imageAlt };

// Bands alternate white / light grey, navy panels sit in fixed places; two equal bands never touch.
// The calculator is grey, so the next light band is white.
let cur = 'tint';
const band = (ink = false) => {
  cur = ink ? 'ink' : cur === 'white' ? 'tint' : 'white';
  return cur === 'white' ? 'band' : `band band-${cur}`;
};
// hoodie page: glossy cards «Где печатать» (TeeCompare); everywhere else the blocks are glass cards / tables (ServiceBlocks)
const compare = garment ? page.blocks.find((b) => b.kind === 'compare') : undefined;
const restBlocks = page.blocks.filter((b) => b !== compare);
const cPack = garment ? band() : '';
const cDet = garment ? band(true) : '';
const cPrice = !garment ? band(true) : '';
const cCompare = compare ? band() : '';
const cBlocks = restBlocks.map(() => band());
const cWorks = band(true);
const cReviews = garment && garmentReviews > 0 ? band() : '';
const cFaq = band();
const cRelated = related.length > 0 ? band() : '';
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image={page.image}
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: Math.min(...allPrices), offerCount: cat.products.length }),
    faqPage(page.faq),
  ]}
>
  <TeeHero
    page={page}
    crumbs={crumbs}
    from={from.price}
    unit={from.unit !== 'шт' ? from.unit : undefined}
    priceNote={garment ? `${page.name.replace('Печать на ', '').toLowerCase()} с печатью` : 'с печатью и макетом'}
    mark={markWord}
    facts={facts}
    photo={hero.photo}
    photoAlt={hero.alt}
    photoPos={hero.pos}
  />

  <div class="band band-tint">
    <section id="calc" class="section scalc" aria-labelledby="calc-h">
      <div class="wrap">
        <TeeHead icon="calc" eyebrow="Калькулятор" id="calc-h" title={garment ? 'Посчитайте свой вариант' : 'Сколько стоит — посчитайте сами'} mark={garment ? 'свой' : 'посчитайте'}>
          <p class="scalc-sub">
            {garment
              ? 'Выберите цвет, размеры принтов и количество — цена пересчитается сразу. Несколько принтов: самый дорогой по полной цене, следующий −30%, остальные −50%.'
              : 'Цена меняется сразу. Добавьте позицию в смету или отправьте заявку — менеджер подтвердит стоимость и сроки.'}
          </p>
        </TeeHead>
        {
          garment ? (
            <Calculator client:visible category="textile" product={garment.productId} hideCategories lockProduct />
          ) : (
            <Calculator client:visible category={page.calcCategory} product={page.calcProduct} hideCategories={!isCorporate} />
          )
        }
      </div>
      {garment?.alsoOrder && <TeeAlso slugs={garment.alsoOrder} />}
    </section>
  </div>

  {
    garment && garmentProduct ? (
      <>
        <div class={cPack}>
          <TeePackages info={packInfo!} />
        </div>
        <div class={cDet}>
          <TeeDetails info={garment} productName={garmentProduct.name} />
        </div>
      </>
    ) : (
      <div class={cPrice}>
        <section class="section" aria-labelledby="prices-h">
          <div class="wrap">
            <TeeHead dark icon="tag" eyebrow="Прайс" id="prices-h" title={`Цены: ${cat.name.toLowerCase()}`} mark={cat.name.toLowerCase()}>
              <a class="btn btn-ghost btn-sm" href="/price">Весь прайс-лист →</a>
            </TeeHead>
            <PriceTables categoryId={page.calcCategory} />
          </div>
        </section>
      </div>
    )
  }

  {compare && <div class={cCompare}><TeeCompare block={compare} /></div>}

  {restBlocks.map((b, i) => <div class={cBlocks[i]}><ServiceBlocks blocks={[b]} /></div>)}

  <div class={cWorks}>
    <PortfolioGrid tags={page.portfolioTags} title={`Примеры: ${page.name.toLowerCase()}`} />
  </div>

  {
    garment && garmentReviews > 0 && (
      <div class={cReviews}>
        <Reviews keywords={garment.reviewKeywords} title={`Отзывы: ${page.name.toLowerCase()}`} />
      </div>
    )
  }

  <div class={cFaq}>
    <FaqSection items={page.faq} title={`Вопросы: ${page.name.toLowerCase()}`} />
  </div>

  {related.length > 0 && <div class={cRelated}><TeeRelated items={related} /></div>}

  <CtaBand />
</BaseLayout>

<style>
  .scalc-sub {
    max-width: 52ch;
  }
  @media (max-width: 760px) {
    .scalc {
      padding-block: 28px 32px;
    }
    .scalc-sub {
      display: none;
    }
  }
</style>

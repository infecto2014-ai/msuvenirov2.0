---
// «Сублимационная печать» — own page (like the mugs and calendars pages): first screen with a process drawing,
// calculator (print on the client's item + the linen shopper for sublimation), price table A6–A3 × print runs,
// how it works, what we print on, what fits / does not fit, sublimation vs DTF, how to order, works, FAQ, SEO text.
// Content — src/data/sublimationPage.ts; every price — src/data/pricing.ts (subPrint and products).
// Not in services.ts (src/pages/[slug].astro would build the same address); menu — site.ts, sitemap — sitemap.xml.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Calculator from '@/components/islands/Calculator';
import MugArt from '@/components/mug/MugArt.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { sublimationPage as page, buildSublimationFaq } from '@/data/sublimationPage';
import { findProduct, rangeLabels, rub, subPrint } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Сублимационная печать', href: page.slug },
];

// ---- prices, all from pricing.ts
const formats = (Object.keys(subPrint) as (keyof typeof subPrint)[]).map((id) => ({ id, ...subPrint[id] }));
const tierFrom = formats[0].tiers.map((t) => t.from);
const columns = rangeLabels(tierFrom);
const subMin = Math.min(...formats.flatMap((f) => f.tiers.map((t) => t.price)));
const subMax = Math.max(...formats.flatMap((f) => f.tiers.map((t) => t.price)));
const saving = (f: (typeof formats)[number]) => Math.round((1 - f.tiers[f.tiers.length - 1].price / f.tiers[0].price) * 100);
const faq = buildSublimationFaq({ a6: rub(subPrint.a6.tiers[0].price), a4: rub(subPrint.a4.tiers[0].price) });

const items = page.items.map((it) => {
  let from: number | undefined;
  if (it.price) from = findProduct(it.price.category, it.price.product)?.fromPrice;
  if (it.gifts) {
    const ps = it.gifts.map((g) => findProduct('gifts', g)).filter((p) => !!p);
    if (ps.length) from = Math.min(...ps.map((p) => p!.fromPrice));
  }
  return { ...it, from };
});
const tones = ['c', 'm', 'y'];
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/portfolio/sublimation-anime.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: subMin, highPrice: subMax, offerCount: formats.length }),
    faqPage(faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <section class="shero">
    <div class="wrap shero-grid">
      <div class="shero-text">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow shero-eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.lead}</p>
        <ul class="shero-chips">
          {page.highlights.map((h) => <li><Icon name="check" size={18} /> {h}</li>)}
        </ul>
        <div class="shero-actions">
          <a class="btn btn-magenta" href="#calc"><Icon name="calc" size={20} /> <span>Рассчитать<span class="long"> стоимость</span></span></a>
          <a class="btn btn-ghost" href="#prices">Цены<span class="long"> А6–А3</span></a>
        </div>
      </div>
      <div class="shero-media" role="img" aria-label={page.heroAlt}>
        <span class="shero-dot shero-dot-c" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-y" aria-hidden="true"></span>
        <div class="shero-table halftone" aria-hidden="true">
          <svg class="shero-svg" viewBox="0 0 520 520" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- the same picture: mirrored and pale on the paper, bright on the shirt -->
              <g id="sp-art">
                <circle cx="80" cy="42" r="25" fill="#ffd21f" />
                <path d="M0 112 L38 52 L66 88 L86 66 L120 112 Z" fill="#e5007d" />
                <path d="M0 100 Q15 90 30 100 T60 100 T90 100 T120 100 L120 122 L0 122 Z" fill="#00a0dc" />
                <text x="60" y="150" text-anchor="middle" font-family="Rubik Variable, system-ui, sans-serif" font-weight="800" font-size="27" fill="#16141b">ЛЕТО</text>
              </g>
              <radialGradient id="sp-glow" cx="50%" cy="0%" r="70%">
                <stop offset="0" stop-color="#e5007d" stop-opacity="0.55" />
                <stop offset="1" stop-color="#e5007d" stop-opacity="0" />
              </radialGradient>
            </defs>

            <!-- 1 · sheet with the mirrored print -->
            <g transform="translate(40 62) rotate(-7)">
              <rect x="0" y="0" width="180" height="228" rx="8" fill="#fff" stroke="#e7dfcf" stroke-width="2" />
              <path d="M10 22 V10 H22 M158 10 H170 V22 M170 206 V218 H158 M22 218 H10 V206" fill="none" stroke="#16141b" stroke-width="2" />
              <g transform="translate(150 34) scale(-1 1)" opacity="0.45"><use href="#sp-art" /></g>
              <text x="90" y="210" text-anchor="middle" font-family="JetBrains Mono Variable, monospace" font-size="13" font-weight="700" fill="#5d5866">зеркально</text>
            </g>

            <!-- 2 · heat press head -->
            <g transform="translate(262 40)">
              <rect x="66" y="0" width="110" height="16" rx="8" fill="#16141b" />
              <rect x="114" y="14" width="14" height="28" fill="#16141b" />
              <rect x="0" y="40" width="236" height="58" rx="16" fill="#16141b" />
              <rect x="12" y="84" width="212" height="8" rx="4" fill="#e5007d" />
              <text x="118" y="75" text-anchor="middle" font-family="JetBrains Mono Variable, monospace" font-weight="800" font-size="22" fill="#ffd21f">≈ 200 °C</text>
              <rect x="0" y="98" width="236" height="64" fill="url(#sp-glow)" />
              <g fill="none" stroke-width="4" stroke-linecap="round">
                <path class="shero-wave" d="M44 110 q8 8 0 16 q-8 8 0 16" stroke="#ffd21f" />
                <path class="shero-wave" d="M118 110 q8 8 0 16 q-8 8 0 16" stroke="#e5007d" />
                <path class="shero-wave" d="M192 110 q8 8 0 16 q-8 8 0 16" stroke="#ffd21f" />
              </g>
            </g>

            <!-- 3 · ink turns into gas and flies into the fabric -->
            <g class="shero-gas">
              <circle cx="228" cy="214" r="5" fill="#00a0dc" />
              <circle cx="246" cy="200" r="7" fill="#e5007d" />
              <circle cx="268" cy="206" r="4" fill="#ffd21f" />
              <circle cx="282" cy="224" r="8" fill="#00a0dc" />
              <circle cx="300" cy="212" r="5" fill="#ffd21f" />
              <circle cx="306" cy="240" r="6" fill="#e5007d" />
              <circle cx="326" cy="228" r="4" fill="#00a0dc" />
              <circle cx="330" cy="258" r="5" fill="#ffd21f" />
              <circle cx="348" cy="246" r="3" fill="#e5007d" />
            </g>

            <!-- 4 · bright print on the shirt -->
            <g transform="translate(260 266)">
              <path d="M80 10 Q120 34 160 10 L222 36 L240 92 L200 104 L196 232 Q120 242 44 232 L40 104 L0 92 L18 36 Z" fill="#fff" stroke="#16141b" stroke-width="3" stroke-linejoin="round" />
              <path d="M80 10 Q120 44 160 10" fill="none" stroke="#16141b" stroke-width="3" />
              <g transform="translate(66 64) scale(0.9)"><use href="#sp-art" /></g>
            </g>

            <!-- step numbers -->
            <g font-family="JetBrains Mono Variable, monospace" font-weight="800" font-size="16" text-anchor="middle">
              <circle cx="40" cy="54" r="17" fill="#00a0dc" /><circle cx="37" cy="51" r="17" fill="#16141b" /><text x="37" y="57" fill="#fffcf5">1</text>
              <circle cx="254" cy="44" r="17" fill="#e5007d" /><circle cx="251" cy="41" r="17" fill="#fffcf5" stroke="#16141b" stroke-width="2" /><text x="251" y="47" fill="#16141b">2</text>
              <circle cx="472" cy="292" r="17" fill="#ffd21f" /><circle cx="469" cy="289" r="17" fill="#16141b" /><text x="469" y="295" fill="#fffcf5">3</text>
            </g>
          </svg>
          <MugArt type="mug330" print="photo" scale={1.25} class="shero-mug" />
        </div>
        <span class="sticker shero-price">
          от <span class="mono">{rub(subMin)}</span><small>за отпечаток А6</small>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ calculator ============ -->
  <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Калькулятор</p>
          <h2 id="calc-h">Посчитайте сублимационную печать</h2>
        </div>
        <p class="calc-sub">Печать на вашем изделии или наш шоппер для сублимации: выберите формат и количество — цена за штуку и за весь заказ пересчитается сразу.</p>
      </div>
      <Calculator client:visible category="textile" product="sub-print" products={['sub-print', 'shopper-sub']} hideCategories />
    </div>
  </section>

  <!-- ============ price table ============ -->
  <section id="prices" class="section prices" aria-labelledby="prices-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Цены</p>
          <h2 id="prices-h">Цены на сублимационную печать</h2>
        </div>
        <p>Цена за один отпечаток на вашем изделии. Чем больше тираж, тем дешевле каждый отпечаток.</p>
      </div>
      <div class="prices-grid">
        <figure class="sizes" aria-hidden="true">
          <svg viewBox="-6 -6 309 432" class="sizes-svg">
            <rect x="0" y="0" width="297" height="420" rx="10" fill="#e2f4fb" stroke="#00a0dc" stroke-width="3" />
            <rect x="0" y="210" width="297" height="210" rx="10" fill="#fde7f2" stroke="#e5007d" stroke-width="3" />
            <rect x="0" y="210" width="148.5" height="210" rx="10" fill="#fff5c9" stroke="#e0b400" stroke-width="3" />
            <rect x="0" y="315" width="148.5" height="105" rx="10" fill="#16141b" />
            <g font-family="JetBrains Mono Variable, monospace" font-weight="800" text-anchor="middle">
              <text x="148" y="112" font-size="40" fill="#006f99">А3</text>
              <text x="222" y="322" font-size="34" fill="#b30062">А4</text>
              <text x="74" y="272" font-size="30" fill="#16141b">А5</text>
              <text x="74" y="376" font-size="26" fill="#fffcf5">А6</text>
            </g>
          </svg>
          <figcaption>Форматы в одном масштабе: А4 — половина А3, А5 — половина А4</figcaption>
        </figure>
        <div class="ptable-box">
          <div class="table-wrap ptable-wrap">
            <table class="price-table ptable">
              <thead>
                <tr>
                  <th scope="col">Формат</th>
                  {columns.map((c, i) => <th scope="col" class={i === columns.length - 1 ? 'pt-best' : undefined}>{c}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  formats.map((f, fi) => (
                    <tr class={`pt-${tones[fi % 3]}`}>
                      <th scope="row">
                        <span class="pt-row">
                          <span class="pt-fmt mono">{f.label}</span>
                          <span class="pt-size">{f.size}</span>
                        </span>
                      </th>
                      {f.tiers.map((t, i) => <td class={i === f.tiers.length - 1 ? 'pt-best' : undefined}>{rub(t.price)}</td>)}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <!-- phones: one card per format -->
          <ul class="pcards">
            {
              formats.map((f, fi) => (
                <li class={`pcard pt-${tones[fi % 3]}`}>
                  <div class="pcard-head">
                    <span class="pt-fmt mono">{f.label}</span>
                    <span class="pt-size">{f.size}</span>
                  </div>
                  <dl>
                    {f.tiers.map((t, i) => (
                      <div class={i === f.tiers.length - 1 ? 'pt-best' : undefined}>
                        <dt>{columns[i]}</dt>
                        <dd class="mono">{rub(t.price)}</dd>
                      </div>
                    ))}
                  </dl>
                  <span class="pcard-save mono">−{saving(f)}% от 100 шт</span>
                </li>
              ))
            }
          </ul>
          <ul class="prices-notes">
            <li><Icon name="check" size={16} /> Изделие — ваше: светлая синтетика или вещь с покрытием для сублимации.</li>
            <li><Icon name="check" size={16} /> Нужен шоппер? Наш шоппер для сублимации с печатью считает калькулятор выше.</li>
            <li><Icon name="check" size={16} /> Кружки и фотоподарки — с изделием в цене, смотрите их страницы.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ how it works (dark band) ============ -->
  <section class="section proc" aria-labelledby="proc-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Технология</p>
          <h2 id="proc-h">Как работает сублимация</h2>
        </div>
        <p>Это не наклейка и не плёнка: краска уходит внутрь материала.</p>
      </div>
      <ol class="proc-steps">
        {
          page.steps.map((s, i) => (
            <li class={`proc-${['c', 'm', 'y', 'c'][i]}`}>
              <div class="proc-pic" aria-hidden="true">
                <svg viewBox="0 0 64 64" width="64" height="64">
                  {i === 0 && (
                    <g>
                      <rect x="14" y="6" width="36" height="48" rx="4" fill="#fffcf5" />
                      <g transform="translate(64 0) scale(-1 1)">
                        <text x="32" y="40" text-anchor="middle" font-family="Rubik Variable, sans-serif" font-weight="800" font-size="26" fill="#e5007d" opacity="0.6">R</text>
                      </g>
                      <path d="M10 58 H54" stroke="#00a0dc" stroke-width="4" stroke-linecap="round" />
                    </g>
                  )}
                  {i === 1 && (
                    <g>
                      <rect x="6" y="8" width="52" height="14" rx="5" fill="#fffcf5" />
                      <rect x="10" y="20" width="44" height="4" rx="2" fill="#e5007d" />
                      <g fill="none" stroke="#ffd21f" stroke-width="3" stroke-linecap="round">
                        <path d="M18 30 q4 4 0 8 q-4 4 0 8" />
                        <path d="M32 30 q4 4 0 8 q-4 4 0 8" />
                        <path d="M46 30 q4 4 0 8 q-4 4 0 8" />
                      </g>
                      <rect x="6" y="52" width="52" height="6" rx="3" fill="#fffcf5" />
                    </g>
                  )}
                  {i === 2 && (
                    <g>
                      <circle cx="20" cy="44" r="7" fill="#00a0dc" />
                      <circle cx="36" cy="34" r="9" fill="#e5007d" />
                      <circle cx="48" cy="48" r="5" fill="#ffd21f" />
                      <circle cx="26" cy="20" r="4" fill="#ffd21f" />
                      <circle cx="46" cy="14" r="5" fill="#00a0dc" />
                      <circle cx="14" cy="10" r="3" fill="#e5007d" />
                    </g>
                  )}
                  {i === 3 && (
                    <g>
                      <rect x="6" y="14" width="52" height="36" rx="8" fill="#fffcf5" />
                      <g fill="none" stroke="#cfc5b1" stroke-width="2">
                        <path d="M6 24 q13 -5 26 0 t26 0" />
                        <path d="M6 32 q13 -5 26 0 t26 0" />
                        <path d="M6 40 q13 -5 26 0 t26 0" />
                      </g>
                      <circle cx="16" cy="28" r="3.5" fill="#00a0dc" />
                      <circle cx="30" cy="36" r="3.5" fill="#e5007d" />
                      <circle cx="44" cy="28" r="3.5" fill="#ffd21f" />
                      <circle cx="50" cy="38" r="3" fill="#e5007d" />
                      <circle cx="22" cy="40" r="3" fill="#ffd21f" />
                    </g>
                  )}
                </svg>
              </div>
              <span class="proc-num mono">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ what we print on ============ -->
  <section class="section things" aria-labelledby="things-h">
    <div class="wrap">
      <p class="eyebrow">Изделия</p>
      <h2 id="things-h" class="things-title">На чём печатаем сублимацией</h2>
      <ul class="things-grid">
        {
          items.map((it, i) => (
            <li class={`thing thing-${tones[i % 3]}`}>
              <a href={it.href}>
                <span class="thing-img">
                  <img src={it.image} alt="" width="480" height="360" loading="lazy" decoding="async" />
                </span>
                <span class="thing-body">
                  <span class="thing-title">{it.title}</span>
                  <span class="thing-text">{it.text}</span>
                  <span class="thing-foot">
                    {it.from !== undefined ? (
                      <span class="thing-price mono">
                        от {rub(it.from)}
                        <small>{it.priceLabel}</small>
                      </span>
                    ) : (
                      <span class="thing-price thing-price-none">Цена — на странице</span>
                    )}
                    <span class="thing-go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ fits / does not fit ============ -->
  <section class="section fit" aria-labelledby="fit-h">
    <div class="wrap">
      <p class="eyebrow">Перед заказом</p>
      <h2 id="fit-h" class="fit-title">Какие изделия подходят для сублимации</h2>
      <div class="fit-grid">
        <div class="fit-col fit-yes">
          <div class="fit-head">
            <svg viewBox="0 0 80 80" width="72" height="72" aria-hidden="true">
              <path d="M26 8 Q40 18 54 8 L74 18 L80 36 L66 40 L65 76 Q40 80 15 76 L14 40 L0 36 L6 18 Z" fill="#fff" stroke="#16141b" stroke-width="2.5" stroke-linejoin="round" />
              <circle cx="46" cy="34" r="8" fill="#ffd21f" />
              <path d="M24 56 L34 40 L42 50 L48 44 L58 56 Z" fill="#e5007d" />
              <path d="M24 54 q6 -4 12 0 t12 0 t10 0 V60 H24 Z" fill="#00a0dc" />
            </svg>
            <h3>Подходит</h3>
          </div>
          <ul>
            {page.fit.yes.map((f) => (
              <li>
                <span class="fit-ico mono" aria-hidden="true">✓</span>
                <span><b>{f.title}.</b> {f.text}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="fit-col fit-no">
          <div class="fit-head">
            <svg viewBox="0 0 80 80" width="72" height="72" aria-hidden="true">
              <path d="M26 8 Q40 18 54 8 L74 18 L80 36 L66 40 L65 76 Q40 80 15 76 L14 40 L0 36 L6 18 Z" fill="#2a2731" stroke="#16141b" stroke-width="2.5" stroke-linejoin="round" />
              <g opacity="0.22">
                <circle cx="46" cy="34" r="8" fill="#ffd21f" />
                <path d="M24 56 L34 40 L42 50 L48 44 L58 56 Z" fill="#e5007d" />
              </g>
            </svg>
            <h3>Не подходит</h3>
          </div>
          <ul>
            {page.fit.no.map((f) => (
              <li>
                <span class="fit-ico mono" aria-hidden="true">✕</span>
                <span><b>{f.title}.</b> {f.text}</span>
              </li>
            ))}
          </ul>
          <a class="fit-dtf" href="/pechat-na-odezhde">
            <span>{page.fit.dtfNote}</span>
            <b>Печать на одежде DTF →</b>
          </a>
        </div>
      </div>
      <p class="fit-note">Не уверены в составе ткани — принесите изделие или пришлите фото ярлыка, подскажем.</p>
    </div>
  </section>

  <!-- ============ sublimation vs DTF ============ -->
  <section class="section cmp" aria-labelledby="cmp-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Сравнение</p>
          <h2 id="cmp-h">Сублимация или DTF</h2>
        </div>
        <p>Обе технологии дают яркий полноцветный рисунок — разница в материалах.</p>
      </div>
      <div class="cmp-table" role="table" aria-label="Сублимация или DTF">
        <div class="cmp-row cmp-headrow" role="row">
          <span role="columnheader" class="cmp-label"></span>
          {page.compare.columns.map((c, i) => <span role="columnheader" class={`cmp-col cmp-col-${i}`}>{c}</span>)}
        </div>
        {
          page.compare.rows.map((r) => (
            <div class="cmp-row" role="row">
              <span role="rowheader" class="cmp-label">{r.label}</span>
              {r.values.map((v, i) => (
                <span role="cell" class={`cmp-cell cmp-cell-${i}`} data-col={page.compare.columns[i]}>
                  {v}
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ how to order ============ -->
  <section class="section how" aria-labelledby="how-h">
    <div class="wrap how-grid">
      <div>
        <p class="eyebrow">Заказ</p>
        <h2 id="how-h">Как заказать сублимационную печать</h2>
        <ol class="how-steps">
          {
            page.order.map((s, i) => (
              <li>
                <span class="how-dot mono">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <aside class="how-side">
        <details class="how-card" open data-fold>
          <summary><h3>{page.layout.title}</h3></summary>
          <ul class="how-list">
            {page.layout.items.map((t) => <li>{t}</li>)}
          </ul>
          <a class="how-more" href="/trebovaniya-k-maketam">Требования к макетам →</a>
        </details>
        <div class="how-b2b">
          <h3>Тиражи для команд и компаний</h3>

  <script is:inline>
    // the layout card is always open on a computer; on a phone it starts folded (tap to open), as on the mugs page
    (function () {
      var m = matchMedia('(max-width: 760px)');
      document.querySelectorAll('.how [data-fold]').forEach(function (d) {
        if (m.matches) d.open = false;
        d.querySelector('summary').addEventListener('click', function (e) {
          if (!m.matches) e.preventDefault();

---
// «3D-стикеры» — own page (like the badges and mugs pages): first screen, calculator (стикеры, стикерпак, набор 3×3),
// ready options, how the price is counted (area × rate, examples), simple or complex cut, sticker packs and sets,
// what a 3D sticker is made of + layout tips, audience, how to order, works, reviews, FAQ, SEO text.
// Content — src/data/stickersPage.ts; every price — src/data/pricing.ts (category 'stickers');
// drawings — src/components/sticker/StickerArt.astro. The services.ts entry stays for menus/sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import StickerArt from '@/components/sticker/StickerArt.astro';
import StickerPackages from '@/components/sticker/StickerPackages.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { stickersPage as page, buildStickerFaq } from '@/data/stickersPage';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { PACK_MAX, PACK_MIN, STICKER_MAX, STICKER_MIN, STICKER_MIN_SUM, VINYL_MIN, VINYL_PACK_MIN, defaultSelection, findProduct, rub, stickerDiscounts, stickerRate, vinylTiers } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Стикеры', href: page.slug },
];

// ---- prices, all from pricing.ts
const sticker = findProduct('stickers', 'sticker-3d')!;
const set = findProduct('stickers', 'sticker-set')!;
const vinyl = findProduct('stickers', 'vinyl-sticker')!;
const vinylPack = findProduct('stickers', 'vinyl-pack')!;
const vinylUnit = (w: number, h: number, qty: number) => vinyl.quote({ ...defaultSelection(vinyl), qty, dims: { w, h } }).unit;
const vinylDemo = { w: 5, h: 5 };
const unitOf = (w: number, h: number, cut: 'simple' | 'complex', qty = STICKER_MIN) =>
  sticker.quote({ ...defaultSelection(sticker), qty, options: { cut }, dims: { w, h } }).unit;
const fmt = (n: number) => String(n).replace('.', ',');
const examples = page.examples.map((e) => ({ ...e, area: e.w * e.h, simple: unitOf(e.w, e.h, 'simple'), complex: unitOf(e.w, e.h, 'complex') }));
const demo = { w: 4, h: 4 };
const demoArea = demo.w * demo.h;
const offs = stickerDiscounts.map((d) => ({ from: d.from, pct: Math.round(d.off * 100), unit: unitOf(demo.w, demo.h, 'simple', d.from) }));
const setTiers = set.ladder!(defaultSelection(set));
const faq = buildStickerFaq({
  min: STICKER_MIN,
  simple: stickerRate.simple,
  complex: stickerRate.complex,
  example: `стикер ${demo.w} × ${demo.h} см = ${demoArea} см² × ${stickerRate.simple} ₽ = ${rub(unitOf(demo.w, demo.h, 'simple'))}`,
  setMin: set.qty.min,
  max: STICKER_MAX,
  vinylMin: VINYL_MIN,
  vinylRates: `${rub(vinylTiers[0].price)} при заказе от ${vinylTiers[0].from} штук и ${rub(vinylTiers[1].price)} от ${vinylTiers[1].from} штук`,
  vinylPackMin: VINYL_PACK_MIN,
  packMin: PACK_MIN,
  packMax: PACK_MAX,
  minSum: STICKER_MIN_SUM,
});
const vinylPackRows = vinylPack.table!.rows;
const vinylPackCols = vinylPack.table!.columns;
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
const hasStickerReviews = reviews.some((r) => page.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));
const tones = ['c', 'm', 'y'];
const packArt = [
  { shape: 'contour', motif: 'heart' },
  { shape: 'circle', motif: 'logo' },
  { shape: 'rect', motif: 'smile' },
  { shape: 'circle', motif: 'wave' },
  { shape: 'contour', motif: 'star' },
  { shape: 'rect', motif: 'text' },
] as const;
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/img/showcase/stickers-3d.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: Math.min(...examples.map((e) => e.simple)), offerCount: 5 }),
    faqPage(faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <section class="shero">
    <div class="wrap shero-grid">
      <div class="shero-text">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow shero-eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.lead}</p>
        <ul class="shero-chips">
          {page.highlights.map((h) => <li><Icon name="check" size={18} /> {h}</li>)}
        </ul>
        <div class="shero-actions">
          <a class="btn btn-magenta" href="#calc"><Icon name="calc" size={20} /> <span>Рассчитать<span class="long"> стоимость</span></span></a>
          <button type="button" class="btn btn-ghost" data-order>Отправить макет</button>
        </div>
      </div>
      <div class="shero-media" role="img" aria-label={page.heroAlt}>
        <span class="shero-dot shero-dot-c" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-m" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-y" aria-hidden="true"></span>
        <div class="shero-wall halftone" aria-hidden="true">
          <div class="shero-stage">
            <StickerArt shape="contour" w={36} h={34} motif="heart" scale={3.6} class="bb bb-heart" />
            <StickerArt shape="rect" w={50} h={20} motif="text" text="BRAND" scale={3.4} class="bb bb-text" />
            <StickerArt shape="circle" w={44} motif="logo" scale={5.2} class="bb bb-main" />
            <StickerArt shape="contour" w={30} motif="star" scale={4.2} class="bb bb-pin" />
            <StickerArt shape="rect" w={28} motif="smile" scale={3.4} class="bb bb-back" />
          </div>
        </div>
        <span class="sticker shero-price">
          <span class="mono">{stickerRate.simple} ₽</span><small>за см²</small>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ calculator ============ -->
  <div class="band band-tint">
  <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">01</span>
          <p class="eyebrow">Калькулятор</p>
          <h2 id="calc-h">Посчитайте свои <span class="mark sec-mark">стикеры</span></h2>
        </div>
        <p class="calc-sub">Выберите 3D или виниловые стикеры, укажите размер, вырубку и количество — цена за штуку и за весь заказ пересчитается сразу. 3D — от {STICKER_MIN} шт, виниловые — от {VINYL_MIN} шт; заказ стикеров — от {STICKER_MIN_SUM} ₽, для маленьких размеров калькулятор сам подставит нужное количество.</p>
      </div>
      <Calculator client:visible category="stickers" product="sticker-3d" hideCategories />
    </div>
    <AlsoOrder slugs={page.alsoOrder} />
  </section>
  </div>

  <div class="band">
  <StickerPackages />
  </div>

  <!-- ============ how the price is counted ============ -->
  <div class="band band-tint">
  <section class="section pr" aria-labelledby="pr-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-m">
          <span class="sec-num mono" aria-hidden="true">02</span>
          <p class="eyebrow">Цена</p>
          <h2 id="pr-h">Как считается цена <span class="mark sec-mark">стикера</span></h2>
        </div>
        <p class="pr-sub">3D-стикеры: платите только за площадь — ширина × высота × цена за см². Минимальный заказ — {STICKER_MIN} стикеров и не меньше {STICKER_MIN_SUM} ₽, больше {STICKER_MAX} — индивидуально.</p>
      </div>
      <div class="pr-grid">
        <div class="pr-demo">
          <div class="pr-art" aria-hidden="true">
            <StickerArt shape="rect" w={demo.w * 10} h={demo.h * 10} motif="smile" grid dims scale={5.4} />
          </div>
          <p class="pr-formula mono">
            <span>{demo.w} × {demo.h} см</span>
            <i>=</i>
            <span>{demoArea} см²</span>
            <i>×</i>
            <span>{stickerRate.simple} ₽</span>
            <i>=</i>
            <b>{rub(unitOf(demo.w, demo.h, 'simple'))}</b>
          </p>
          <ul class="pr-offs">
            <li><span class="mono">{STICKER_MIN}–{offs[0].from - 1} шт</span><b class="mono">{rub(unitOf(demo.w, demo.h, 'simple'))}</b></li>
            {offs.map((o) => (
              <li class="pr-off"><span class="mono">от {o.from} шт · −{o.pct}%</span><b class="mono">{rub(o.unit)}</b></li>
            ))}
          </ul>
        </div>
        <div class="pr-tbl-wrap">
          <p class="pr-cap">Цена одного стикера при заказе от {STICKER_MIN} шт</p>
          <table class="pr-tbl">
            <thead>
              <tr>
                <th scope="col">Размер</th>
                <th scope="col">Площадь</th>
                <th scope="col">Простая<br /><small>{stickerRate.simple} ₽/см²</small></th>
                <th scope="col">Сложная<br /><small>{stickerRate.complex} ₽/см²</small></th>
              </tr>
            </thead>
            <tbody>
              {examples.map((e) => (
                <tr>
                  <th scope="row">{fmt(e.w)} × {fmt(e.h)} см<small>{e.note}</small></th>
                  <td class="mono">{fmt(e.area)} см²</td>
                  <td class="mono">{rub(e.simple)}</td>
                  <td class="mono">{rub(e.complex)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="pr-note"><Icon name="check" size={16} /> От {offs[0].from} шт — минус {offs[0].pct}%, от {offs[1].from} шт — минус {offs[1].pct}%. Стикеры меньше 4 см² — +30%. Больше {STICKER_MAX} шт — индивидуально. Любой другой размер — в калькуляторе.</p>
        </div>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ simple or complex cut ============ -->
  <div class="band">
  <section class="section typ" aria-labelledby="typ-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-c">
          <span class="sec-num mono" aria-hidden="true">03</span>
          <p class="eyebrow">Вырубка</p>
          <h2 id="typ-h">Простая или сложная <span class="mark sec-mark">вырубка</span></h2>
        </div>
        <p>От формы зависит цена за см². Пример — стикер {demo.w} × {demo.h} см при заказе от {STICKER_MIN} штук.</p>
      </div>
      <div class="typ-grid">
        {
          page.cuts.map((c, i) => {
            const rate = c.id === 'complex' ? stickerRate.complex : stickerRate.simple;
            return (
              <article class={`typ-card typ-${i ? 'c' : 'm'}`}>
                <div class="typ-art" aria-hidden="true">
                  {c.id === 'simple' ? (
                    <>
                      <StickerArt shape="circle" w={40} motif="logo" scale={4.4} class="typ-front" />
                      <StickerArt shape="rect" w={46} h={24} motif="text" text="BRAND" scale={3.6} class="typ-back" />
                    </>
                  ) : (
                    <>
                      <StickerArt shape="contour" w={42} motif="star" scale={4.4} class="typ-front" />
                      <StickerArt shape="contour" w={40} h={34} motif="heart" scale={3.4} class="typ-back" />
                    </>
                  )}
                </div>
                <div class="typ-body">
                  <div class="typ-top">
                    <h3>{c.title}</h3>
                    <span class="typ-tag mono">{c.tag}</span>
                  </div>
                  <p class="typ-sizes"><Icon name="check" size={16} /> {rate} ₽ за см²</p>
                  <p class="typ-text">{c.text}</p>
                  <ul class="typ-points">
                    <li>{demo.w} × {demo.h} см — {rub(unitOf(demo.w, demo.h, c.id as 'simple' | 'complex'))}</li>
                    {offs.map((o) => <li>от {o.from} шт — {rub(unitOf(demo.w, demo.h, c.id as 'simple' | 'complex', o.from))}</li>)}
                  </ul>
                  <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:sticker-3d#calc`}>Рассчитать</a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
  </div>

  <!-- ============ sticker packs and sets ============ -->
  <div class="band band-tint">
  <section class="section typ pk" aria-labelledby="pk-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">04</span>
          <p class="eyebrow">Наборы</p>
          <h2 id="pk-h">Стикерпаки и наборы по <span class="mark sec-mark">фото</span></h2>
        </div>
        <p>Несколько разных стикеров в одном наборе — для мерча, подарков и маркетов.</p>
      </div>
      <div class="typ-grid">
        <article class="typ-card typ-m">
          <div class="typ-art pk-art" aria-hidden="true">
            <div class="pk-sheet">
              {packArt.map((a) => <StickerArt shape={a.shape} w={30} motif={a.motif} text="HI" scale={2.7} />)}
            </div>
          </div>
          <div class="typ-body">
            <div class="typ-top">
              <h3>{page.pack.title}</h3>
              <span class="typ-tag mono">по формуле</span>
            </div>
            <p class="typ-text">{page.pack.text}</p>
            <ul class="typ-points">
              {page.pack.points.map((x) => <li>{x}</li>)}
            </ul>
            <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:sticker-pack#calc`}>Рассчитать стикерпак</a>
          </div>
        </article>
        <article class="typ-card typ-c">
          <div class="typ-art pk-art" aria-hidden="true">
            <div class="pk-trio">
              <StickerArt shape="rect" w={30} motif="smile" scale={4} />
              <StickerArt shape="rect" w={30} motif="heart" scale={4} />
              <StickerArt shape="rect" w={30} motif="wave" scale={4} />
            </div>
          </div>
          <div class="typ-body">
            <div class="typ-top">
              <h3>{page.set.title}</h3>
              <span class="typ-tag mono">от {set.qty.min} шт</span>
            </div>
            <p class="typ-text">{page.set.text}</p>
            <ul class="pk-tiers">
              {setTiers.map((t, i) => (
                <li>
                  <small>{i < setTiers.length - 1 ? `${t.from}–${setTiers[i + 1].from - 1} шт` : `${t.from}–${set.qty.max} шт`}</small>
                  <b class="mono">{rub(t.price)}</b>
                  <small>за стикер</small>
                </li>
              ))}
            </ul>
            <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:sticker-set#calc`}>Рассчитать набор</a>
          </div>
        </article>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ vinyl stickers ============ -->
  <div class="band">
  <section class="section typ vn" aria-labelledby="vn-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-m">
          <span class="sec-num mono" aria-hidden="true">05</span>
          <p class="eyebrow">Виниловые стикеры</p>
          <h2 id="vn-h">Стикеры на виниловой плёнке с контурной <span class="mark sec-mark">резкой</span></h2>
        </div>
        <p>Плоские, глянцевые или матовые — дешевле 3D-стикеров и подходят для больших тиражей. Форма вырубки на цену не влияет. Заказ — от {VINYL_MIN} шт и от {STICKER_MIN_SUM} ₽.</p>
      </div>
      <div class="typ-grid">
        <article class="typ-card typ-y">
          <div class="typ-art" aria-hidden="true">
            <StickerArt shape="contour" w={44} motif="star" dome={false} scale={4.2} class="typ-front" />
            <StickerArt shape="contour" w={40} h={34} motif="wave" dome={false} scale={3.4} class="typ-back" />
          </div>
          <div class="typ-body">
            <div class="typ-top">
              <h3>{page.vinyl.title}</h3>
              <span class="typ-tag mono">от {VINYL_MIN} шт</span>
            </div>
            <p class="typ-text">{page.vinyl.text}</p>
            <ul class="typ-points">
              {page.vinyl.points.map((x) => <li>{x}</li>)}
            </ul>
            <ul class="pk-tiers pk-tiers-2">
              {vinylTiers.map((t, i) => (
                <li>
                  <small>{i < vinylTiers.length - 1 ? `${t.from}–${vinylTiers[i + 1].from - 1} шт` : `от ${t.from} шт`}</small>
                  <b class="mono">{rub(t.price)}</b>
                  <small>за см² · {vinylDemo.w} × {vinylDemo.h} см — {rub(vinylUnit(vinylDemo.w, vinylDemo.h, t.from))}</small>
                </li>
              ))}
            </ul>
            <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:vinyl-sticker#calc`}>Рассчитать виниловые</a>
          </div>
        </article>
        <article class="typ-card typ-c">
          <div class="typ-art pk-art" aria-hidden="true">
            <div class="pk-sheet pk-sheet-flat">
              {packArt.map((a) => <StickerArt shape="contour" w={30} motif={a.motif} text="HI" dome={false} scale={2.7} />)}
            </div>
          </div>
          <div class="typ-body">
            <div class="typ-top">
              <h3>{page.vinyl.pack.title}</h3>
              <span class="typ-tag mono">от {VINYL_PACK_MIN} шт</span>
            </div>
            <p class="typ-text">{page.vinyl.pack.text}</p>
            <div class="typ-tbl-wrap">
              <table class="typ-tbl">
                <thead>
                  <tr>
                    <th scope="col">Лист</th>
                    {vinylPackCols.map((c) => <th scope="col">{c}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {vinylPackRows.map((r) => (
                    <tr>
                      <th scope="row">{r.label}</th>
                      {r.cells.map((c) => <td class="mono">{c}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:vinyl-pack#calc`}>Рассчитать стикерпак</a>
          </div>
        </article>
      </div>
      <div class="vn-cmp-wrap">
        <table class="vn-cmp">
          <caption>3D-стикер или виниловый</caption>
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">3D-стикер из смолы</th>
              <th scope="col">Виниловый стикер</th>
            </tr>
          </thead>
          <tbody>
            {page.compare.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.epoxy}</td>
                <td>{r.vinyl}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ what a 3D sticker is made of + layout ============ -->
  <div class="band band-tint">
  <section class="section gd" aria-labelledby="gd-h">
    <div class="wrap gd-grid">
      <div class="gd-art" aria-hidden="true">
        <svg class="lay-svg" viewBox="0 0 320 210" width="320" height="210">
          {/* cross-section: base, print, epoxy lens */}
          <path d="M 30 150 Q 30 70 160 66 Q 290 70 290 150 Z" fill="#00a0dc" fill-opacity="0.28" stroke="#00a0dc" stroke-width="2.5" />
          <path d="M 64 96 Q 110 74 170 74" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-opacity="0.85" />
          <rect x="30" y="150" width="260" height="9" rx="2" fill="#e5007d" />
          <rect x="30" y="159" width="260" height="13" rx="3" fill="#ffd21f" stroke="#16141b" stroke-width="1.5" />
          <path d="M 30 176 H 290" stroke="#16141b" stroke-width="1.5" stroke-dasharray="5 4" />
          {[
            { n: 1, x: 250, y: 92, c: '#00a0dc', f: '#16141b' },
            { n: 2, x: 304, y: 154, c: '#e5007d', f: '#fff' },
            { n: 3, x: 304, y: 180, c: '#ffd21f', f: '#16141b' },
          ].map((m) => (
            <g>
              <circle cx={m.x} cy={m.y} r="12" fill={m.c} stroke="#16141b" stroke-width="1.5" />
              <text x={m.x} y={m.y + 4.5} font-size="13" font-weight="800" text-anchor="middle" fill={m.f}>{m.n}</text>
            </g>
          ))}
          <text x="160" y="200" font-size="11" font-weight="700" text-anchor="middle" fill="#16141b" class="mono">стикер в разрезе</text>
        </svg>
      </div>
      <div class="gd-info">
        <p class="eyebrow">Что внутри</p>
        <h2 id="gd-h">Из чего состоит <span class="mark">3D-стикер</span></h2>
        <ol class="gd-list">
          {
            page.layers.map((it, i) => (
              <li class={`gd-${it.tone}`}>
                <span class="gd-num mono">{i + 1}</span>
                <div>
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="gd-note">
          <b>{page.layout.title}</b>
          <ul>
            {page.layout.items.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <a class="how-more" href="/trebovaniya-k-maketam">Требования к макетам →</a>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ for whom ============ -->
  <div class="band">
  <section class="section aud" aria-labelledby="aud-h">

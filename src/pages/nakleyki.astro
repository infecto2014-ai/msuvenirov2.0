---
// «3D-стикеры» — own page (like the badges and mugs pages): first screen, calculator (стикеры, стикерпак, набор 3×3),
// ready options, how the price is counted (area × rate, examples), simple or complex cut, sticker packs and sets,
// what a 3D sticker is made of + layout tips, audience, how to order, works, reviews, FAQ, SEO text.
// Content — src/data/stickersPage.ts; every price — src/data/pricing.ts (category 'stickers');
// drawings — src/components/sticker/StickerArt.astro. The services.ts entry stays for menus/sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import TeeHead from '@/components/tee/TeeHead.astro';
import PpHero from '@/components/product-page/PpHero.astro';
import PpSteps from '@/components/product-page/PpSteps.astro';
import PpAudience from '@/components/product-page/PpAudience.astro';
import PpHow from '@/components/product-page/PpHow.astro';
import PpSeo from '@/components/product-page/PpSeo.astro';
import '@/components/product-page/pp.css';
import StickerArt from '@/components/sticker/StickerArt.astro';
import StickerPackages from '@/components/sticker/StickerPackages.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import { stickersPage as page, buildStickerFaq } from '@/data/stickersPage';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { PACK_MAX, PACK_MIN, STICKER_MAX, STICKER_MIN, STICKER_MIN_SUM, VINYL_MIN, VINYL_PACK_MIN, defaultSelection, findProduct, rub, stickerDiscounts, stickerRate, vinylTiers } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Стикеры', href: page.slug },
];

// ---- prices, all from pricing.ts
const sticker = findProduct('stickers', 'sticker-3d')!;
const set = findProduct('stickers', 'sticker-set')!;
const vinyl = findProduct('stickers', 'vinyl-sticker')!;
const vinylPack = findProduct('stickers', 'vinyl-pack')!;
const vinylUnit = (w: number, h: number, qty: number) => vinyl.quote({ ...defaultSelection(vinyl), qty, dims: { w, h } }).unit;
const vinylDemo = { w: 5, h: 5 };
const unitOf = (w: number, h: number, cut: 'simple' | 'complex', qty = STICKER_MIN) =>
  sticker.quote({ ...defaultSelection(sticker), qty, options: { cut }, dims: { w, h } }).unit;
const fmt = (n: number) => String(n).replace('.', ',');
const examples = page.examples.map((e) => ({ ...e, area: e.w * e.h, simple: unitOf(e.w, e.h, 'simple'), complex: unitOf(e.w, e.h, 'complex') }));
const demo = { w: 4, h: 4 };
const demoArea = demo.w * demo.h;
const offs = stickerDiscounts.map((d) => ({ from: d.from, pct: Math.round(d.off * 100), unit: unitOf(demo.w, demo.h, 'simple', d.from) }));
const setTiers = set.ladder!(defaultSelection(set));
const faq = buildStickerFaq({
  min: STICKER_MIN,
  simple: stickerRate.simple,
  complex: stickerRate.complex,
  example: `стикер ${demo.w} × ${demo.h} см = ${demoArea} см² × ${stickerRate.simple} ₽ = ${rub(unitOf(demo.w, demo.h, 'simple'))}`,
  setMin: set.qty.min,
  max: STICKER_MAX,
  vinylMin: VINYL_MIN,
  vinylRates: `${rub(vinylTiers[0].price)} при заказе от ${vinylTiers[0].from} штук и ${rub(vinylTiers[1].price)} от ${vinylTiers[1].from} штук`,
  vinylPackMin: VINYL_PACK_MIN,
  packMin: PACK_MIN,
  packMax: PACK_MAX,
  minSum: STICKER_MIN_SUM,
});
const vinylPackRows = vinylPack.table!.rows;
const vinylPackCols = vinylPack.table!.columns;
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
const hasStickerReviews = reviews.some((r) => page.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));
const packArt = [
  { shape: 'contour', motif: 'heart' },
  { shape: 'circle', motif: 'logo' },
  { shape: 'rect', motif: 'smile' },
  { shape: 'circle', motif: 'wave' },
  { shape: 'contour', motif: 'star' },
  { shape: 'rect', motif: 'text' },
] as const;

// three facts under the buttons of the first screen (same row as on the t-shirt page)
const heroFacts = [{ big: 'от 30 шт', small: '3D-стикеры из смолы' },{ big: 'от 100 шт', small: 'виниловые с контурной резкой' },{ big: '0 ₽', small: 'простой макет соберём сами' }];
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/img/showcase/stickers-3d.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: Math.min(...examples.map((e) => e.simple)), offerCount: 5 }),
    faqPage(faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <PpHero eyebrow={page.eyebrow} h1={page.h1} lead={page.lead} crumbs={crumbs} mark="заказ" heroAlt={page.heroAlt} facts={heroFacts} price={{ value: `${stickerRate.simple} ₽`, note: 'за см²' }}>
    <StickerArt shape="contour" w={36} h={34} motif="heart" scale={3.6} class="bb bb-heart" />
    <StickerArt shape="rect" w={50} h={20} motif="text" text="BRAND" scale={3.4} class="bb bb-text" />
    <StickerArt shape="circle" w={44} motif="logo" scale={5.2} class="bb bb-main" />
    <StickerArt shape="contour" w={30} motif="star" scale={4.2} class="bb bb-pin" />
    <StickerArt shape="rect" w={28} motif="smile" scale={3.4} class="bb bb-back" />
  </PpHero>

  <!-- ============ calculator (light grey) ============ -->
  <div class="band band-tint">
    <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
      <div class="wrap">
        <TeeHead icon="calc" eyebrow="Калькулятор" id="calc-h" title="Посчитайте свои стикеры" mark="стикеры">
          <p class="calc-sub">Выберите 3D или виниловые стикеры, укажите размер, вырубку и количество — цена за штуку и за весь заказ пересчитается сразу. 3D — от {STICKER_MIN} шт, виниловые — от {VINYL_MIN} шт; заказ стикеров — от {STICKER_MIN_SUM} ₽, для маленьких размеров калькулятор сам подставит нужное количество.</p>
        </TeeHead>
        <Calculator client:visible category="stickers" product="sticker-3d" hideCategories />
      </div>
      <AlsoOrder slugs={page.alsoOrder} />
    </section>
  </div>

  <!-- ============ ready options (white) ============ -->
  <div class="band">
    <StickerPackages />
  </div>

  <!-- ============ how the price is counted (light grey) ============ -->
  <div class="band band-tint">
    <section class="section pr pp-sec" aria-labelledby="pr-h">
      <div class="wrap">
        <TeeHead icon="tag" eyebrow="Цена" id="pr-h" title="Как считается цена стикера" mark="стикера">
          <p class="pp-sub">3D-стикеры: платите только за площадь — ширина × высота × цена за см². Минимальный заказ — {STICKER_MIN} стикеров и не меньше {STICKER_MIN_SUM} ₽, больше {STICKER_MAX} — индивидуально.</p>
        </TeeHead>
        <div class="pr-grid">
          <div class="pr-demo pp-card">
            <div class="pr-art pp-art" aria-hidden="true">
              <StickerArt shape="rect" w={demo.w * 10} h={demo.h * 10} motif="smile" grid dims scale={5.4} />
            </div>
            <p class="pr-formula">
              <span>{demo.w} × {demo.h} см</span>
              <i>=</i>
              <span>{demoArea} см²</span>
              <i>×</i>
              <span>{stickerRate.simple} ₽</span>
              <i>=</i>
              <b>{rub(unitOf(demo.w, demo.h, 'simple'))}</b>
            </p>
            <ul class="pr-offs">
              <li><span>{STICKER_MIN}–{offs[0].from - 1} шт</span><b>{rub(unitOf(demo.w, demo.h, 'simple'))}</b></li>
              {offs.map((o) => (
                <li class="pr-off"><span>от {o.from} шт · −{o.pct}%</span><b>{rub(o.unit)}</b></li>
              ))}
            </ul>
          </div>
          <div class="pr-side">
            <div class="pp-tbl-wrap">
              <table class="pp-tbl">
                <caption>Цена одного стикера при заказе от {STICKER_MIN} шт</caption>
                <thead>
                  <tr>
                    <th scope="col">Размер</th>
                    <th scope="col">Площадь</th>
                    <th scope="col">Простая<small>{stickerRate.simple} ₽/см²</small></th>
                    <th scope="col">Сложная<small>{stickerRate.complex} ₽/см²</small></th>
                  </tr>
                </thead>
                <tbody>
                  {examples.map((e) => (
                    <tr>
                      <th scope="row">{fmt(e.w)} × {fmt(e.h)} см<small>{e.note}</small></th>
                      <td>{fmt(e.area)} см²</td>
                      <td>{rub(e.simple)}</td>
                      <td>{rub(e.complex)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="pr-note pp-card">От {offs[0].from} шт — минус {offs[0].pct}%, от {offs[1].from} шт — минус {offs[1].pct}%. Стикеры меньше 4 см² — +30%. Больше {STICKER_MAX} шт — индивидуально. Любой другой размер — в калькуляторе.</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ simple or complex cut (white) ============ -->
  <div class="band">
    <section class="section typ pp-sec" aria-labelledby="typ-h">
      <div class="wrap">
        <TeeHead icon="layers" eyebrow="Вырубка" id="typ-h" title="Простая или сложная вырубка" mark="вырубка">
          <p class="pp-sub">От формы зависит цена за см². Пример — стикер {demo.w} × {demo.h} см при заказе от {STICKER_MIN} штук.</p>
        </TeeHead>
        <div class="typ-grid">
          {
            page.cuts.map((c) => {
              const rate = c.id === 'complex' ? stickerRate.complex : stickerRate.simple;
              return (
                <article class="typ-card pp-card">
                  <div class="typ-art pp-art" aria-hidden="true">
                    {c.id === 'simple' ? (
                      <>
                        <StickerArt shape="circle" w={40} motif="logo" scale={4.4} class="typ-front" />
                        <StickerArt shape="rect" w={46} h={24} motif="text" text="BRAND" scale={3.6} class="typ-back" />
                      </>
                    ) : (
                      <>
                        <StickerArt shape="contour" w={42} motif="star" scale={4.4} class="typ-front" />
                        <StickerArt shape="contour" w={40} h={34} motif="heart" scale={3.4} class="typ-back" />
                      </>
                    )}
                  </div>
                  <div class="typ-body">
                    <div class="typ-top">
                      <h3>{c.title}</h3>
                      <span class="pp-tag">{c.tag}</span>
                    </div>
                    <p class="typ-sizes">{rate} ₽ за см²</p>
                    <p class="typ-text">{c.text}</p>
                    <ul class="pp-ticks">
                      <li>{demo.w} × {demo.h} см — {rub(unitOf(demo.w, demo.h, c.id as 'simple' | 'complex'))}</li>
                      {offs.map((o) => <li>от {o.from} шт — {rub(unitOf(demo.w, demo.h, c.id as 'simple' | 'complex', o.from))}</li>)}
                    </ul>
                    <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:sticker-3d#calc`}>Рассчитать</a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </div>

  <!-- ============ sticker packs and sets (light grey) ============ -->
  <div class="band band-tint">
    <section class="section typ pk pp-sec" aria-labelledby="pk-h">
      <div class="wrap">
        <TeeHead icon="gift" eyebrow="Наборы" id="pk-h" title="Стикерпаки и наборы по фото" mark="фото">
          <p class="pp-sub">Несколько разных стикеров в одном наборе — для мерча, подарков и маркетов.</p>
        </TeeHead>
        <div class="typ-grid">
          <article class="typ-card pp-card">
            <div class="typ-art pp-art" aria-hidden="true">
              <div class="pk-sheet">
                {packArt.map((a) => <StickerArt shape={a.shape} w={30} motif={a.motif} text="HI" scale={2.7} />)}
              </div>
            </div>
            <div class="typ-body">
              <div class="typ-top">
                <h3>{page.pack.title}</h3>
                <span class="pp-tag">по формуле</span>
              </div>
              <p class="typ-text">{page.pack.text}</p>
              <ul class="pp-ticks">
                {page.pack.points.map((x) => <li>{x}</li>)}
              </ul>
              <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:sticker-pack#calc`}>Рассчитать стикерпак</a>
            </div>
          </article>
          <article class="typ-card pp-card">
            <div class="typ-art pp-art" aria-hidden="true">
              <div class="pk-trio">
                <StickerArt shape="rect" w={30} motif="smile" scale={4} />
                <StickerArt shape="rect" w={30} motif="heart" scale={4} />
                <StickerArt shape="rect" w={30} motif="wave" scale={4} />
              </div>
            </div>
            <div class="typ-body">
              <div class="typ-top">
                <h3>{page.set.title}</h3>
                <span class="pp-tag">от {set.qty.min} шт</span>
              </div>
              <p class="typ-text">{page.set.text}</p>
              <ul class="pk-tiers">
                {setTiers.map((t, i) => (
                  <li>
                    <small>{i < setTiers.length - 1 ? `${t.from}–${setTiers[i + 1].from - 1} шт` : `${t.from}–${set.qty.max} шт`}</small>
                    <b>{rub(t.price)}</b>
                    <small>за стикер</small>
                  </li>
                ))}
              </ul>
              <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:sticker-set#calc`}>Рассчитать набор</a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ vinyl stickers (white) ============ -->
  <div class="band">
    <section class="section typ vn pp-sec" aria-labelledby="vn-h">
      <div class="wrap">
        <TeeHead icon="tag" eyebrow="Виниловые стикеры" id="vn-h" title="Стикеры на виниловой плёнке с контурной резкой" mark="резкой">
          <p class="pp-sub">Плоские, глянцевые или матовые — дешевле 3D-стикеров и подходят для больших тиражей. Форма вырубки на цену не влияет. Заказ — от {VINYL_MIN} шт и от {STICKER_MIN_SUM} ₽.</p>
        </TeeHead>
        <div class="typ-grid">
          <article class="typ-card pp-card">
            <div class="typ-art pp-art" aria-hidden="true">
              <StickerArt shape="contour" w={44} motif="star" dome={false} scale={4.2} class="typ-front" />
              <StickerArt shape="contour" w={40} h={34} motif="wave" dome={false} scale={3.4} class="typ-back" />
            </div>
            <div class="typ-body">
              <div class="typ-top">
                <h3>{page.vinyl.title}</h3>
                <span class="pp-tag">от {VINYL_MIN} шт</span>
              </div>
              <p class="typ-text">{page.vinyl.text}</p>
              <ul class="pp-ticks">
                {page.vinyl.points.map((x) => <li>{x}</li>)}
              </ul>
              <ul class="pk-tiers pk-tiers-2">
                {vinylTiers.map((t, i) => (
                  <li>
                    <small>{i < vinylTiers.length - 1 ? `${t.from}–${vinylTiers[i + 1].from - 1} шт` : `от ${t.from} шт`}</small>
                    <b>{rub(t.price)}</b>
                    <small>за см² · {vinylDemo.w} × {vinylDemo.h} см — {rub(vinylUnit(vinylDemo.w, vinylDemo.h, t.from))}</small>
                  </li>
                ))}
              </ul>
              <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:vinyl-sticker#calc`}>Рассчитать виниловые</a>
            </div>
          </article>
          <article class="typ-card pp-card">
            <div class="typ-art pp-art" aria-hidden="true">
              <div class="pk-sheet pk-sheet-flat">
                {packArt.map((a) => <StickerArt shape="contour" w={30} motif={a.motif} text="HI" dome={false} scale={2.7} />)}
              </div>
            </div>
            <div class="typ-body">
              <div class="typ-top">
                <h3>{page.vinyl.pack.title}</h3>
                <span class="pp-tag">от {VINYL_PACK_MIN} шт</span>
              </div>
              <p class="typ-text">{page.vinyl.pack.text}</p>
              <div class="pp-tbl-wrap">
                <table class="pp-tbl">
                  <thead>
                    <tr>
                      <th scope="col">Лист</th>
                      {vinylPackCols.map((c) => <th scope="col">{c}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {vinylPackRows.map((r) => (
                      <tr>
                        <th scope="row">{r.label}</th>
                        {r.cells.map((c) => <td>{c}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=stickers:vinyl-pack#calc`}>Рассчитать стикерпак</a>
            </div>
          </article>
        </div>
        <div class="pp-tbl-wrap vn-cmp-wrap">
          <table class="pp-tbl vn-cmp">
            <caption>3D-стикер или виниловый</caption>
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col">3D-стикер из смолы</th>
                <th scope="col">Виниловый стикер</th>
              </tr>
            </thead>
            <tbody>
              {page.compare.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td>{r.epoxy}</td>
                  <td>{r.vinyl}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ what a 3D sticker is made of + layout (navy panel) ============ -->
  <div class="band band-ink">
    <section class="section gd pp-sec" aria-labelledby="gd-h">
      <div class="wrap gd-grid">
        <div class="gd-art pp-art" aria-hidden="true">
          <svg class="lay-svg" viewBox="0 0 320 210" width="320" height="210">
            {/* cross-section: base, print, epoxy lens */}
            <path d="M 30 150 Q 30 70 160 66 Q 290 70 290 150 Z" fill="#14213d" fill-opacity="0.16" stroke="#14213d" stroke-width="2.5" />
            <path d="M 64 96 Q 110 74 170 74" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-opacity="0.9" />
            <rect x="30" y="150" width="260" height="9" rx="2" fill="#5b6f99" />
            <rect x="30" y="159" width="260" height="13" rx="3" fill="#e5e5e5" stroke="#14213d" stroke-width="1.5" />
            <path d="M 30 176 H 290" stroke="#14213d" stroke-width="1.5" stroke-dasharray="5 4" />
            {[
              { n: 1, x: 250, y: 92 },
              { n: 2, x: 304, y: 154 },
              { n: 3, x: 304, y: 180 },
            ].map((m) => (
              <g>
                <circle cx={m.x} cy={m.y} r="12" fill="#14213d" />
                <text x={m.x} y={m.y + 4.5} font-size="13" font-weight="800" text-anchor="middle" fill="#fff">{m.n}</text>
              </g>
            ))}
            <text x="160" y="200" font-size="11" font-weight="700" text-anchor="middle" fill="#14213d">стикер в разрезе</text>
          </svg>
        </div>
        <div class="gd-info">
          <TeeHead icon="layers" eyebrow="Что внутри" id="gd-h" title="Из чего состоит 3D-стикер" mark="3D-стикер" dark />
          <PpSteps items={page.layers} />
          <div class="gd-note">
            <b>{page.layout.title}</b>
            <ul class="pp-ticks">
              {page.layout.items.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <a class="pp-link" href="/trebovaniya-k-maketam">Требования к макетам →</a>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ for whom (white) ============ -->
  <div class="band">
    <PpAudience title="Кому заказывают стикеры" mark="стикеры" items={page.audience} />
  </div>

  <!-- ============ how to order (light grey) ============ -->
  <div class="band band-tint">
    <PpHow title="Как заказать стикеры" mark="стикеры" steps={page.steps} b2b={page.b2b} b2bOrder="Стикеры с логотипом для компании — рассчитать тираж" />
  </div>

  <div class="band band-ink">
    <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: стикеры и наклейки" />
  </div>

  <div class="band">
    <Reviews keywords={hasStickerReviews ? page.reviewKeywords : undefined} title={hasStickerReviews ? 'Отзывы о стикерах' : 'Что говорят клиенты'} />
  </div>

  <div class="band band-tint">
    <FaqSection items={faq} title="Вопросы о стикерах" />
  </div>

  <div class="band">
    <PpSeo title={page.seo.title} sections={page.seo.sections}>
      <a href="/znachki">значки</a> · <a href="/breloki">брелоки</a> · <a href="/shirokoformatnaya-pechat">плёночные наклейки и наклейки на авто</a> ·
      <a href="/pechat-na-futbolkah">печать на футболках</a> · <a href="/korporativnym-klientam">корпоративным клиентам</a> ·
      <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
    </PpSeo>
  </div>

  <div class="band band-tint">
    {related.length > 0 && <TshirtRelated items={related} />}
  </div>


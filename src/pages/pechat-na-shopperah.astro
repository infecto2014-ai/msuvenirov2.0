---
// «Печать на шопперах» — own page (like the mugs and calendars pages): first screen, calculator with two shoppers,
// ready options, two kinds side by side in one scale, print sizes, DTF vs sublimation, audience, how to order,
// works, reviews, FAQ, SEO text.
// Content — src/data/shoppersPage.ts; every price — src/data/pricing.ts ('shopper', 'shopper-sub');
// drawings and sizes — src/components/shopper/ShopperArt.astro + shopper-geometry.ts. The services.ts entry stays for menus/sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import ShopperArt from '@/components/shopper/ShopperArt.astro';
import ShopperPackages from '@/components/shopper/ShopperPackages.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import HeroFacts from '@/components/tshirt/HeroFacts.astro';
import { shoppersPage as page, buildShopperFaq } from '@/data/shoppersPage';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { defaultSelection, dtfPrint, findProduct, rub, subPrint, type Product, type Selection } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Печать на шопперах', href: page.slug },
];

// ---- prices, all from pricing.ts
const CALC_PRODUCTS = ['shopper', 'shopper-sub'];
const cotton = findProduct('textile', 'shopper')!;
const sub = findProduct('textile', 'shopper-sub')!;
const selOf = (p: Product, options: Selection['options'] = {}, qty = p.qty.min): Selection => {
  const b = defaultSelection(p);
  return { ...b, qty, options: { ...b.options, ...options } };
};
/** price per piece at the smallest order, default options (A4 on one side) */
const firstUnit = (p: Product) => p.quote(selOf(p)).unit;
const heroFrom = Math.min(cotton.fromPrice, sub.fromPrice);
const formatsOf = (p: Product) => (p.options?.find((g) => g.id === 'print1')?.choices ?? []).map((c) => c.id).filter((id) => id !== 'none');
const dtfFormats = formatsOf(cotton);
const subFormats = formatsOf(sub);
const fmtRange = (f: string[]) => `${(dtfPrint as Record<string, { label: string }>)[f[0]].label}–${(dtfPrint as Record<string, { label: string }>)[f[f.length - 1]].label}`;

const kinds = page.kinds.map((k) => {
  const p = k.product === 'shopper' ? cotton : sub;
  return {
    ...k,
    min: p.qty.min,
    from: p.fromPrice,
    first: firstUnit(p),
    formats: fmtRange(formatsOf(p)),
    max: p.qty.individualAbove ? p.qty.max : undefined,
  };
});
const [kc, kl] = kinds;
const sizes = page.sizes.map((s) => ({
  ...s,
  dtf: dtfFormats.includes(s.id) ? dtfPrint[s.id].size : null,
  sub: subFormats.includes(s.id) ? subPrint[s.id].size : null,
}));
const faq = buildShopperFaq({
  oneDtf: rub(firstUnit(cotton)),
  sub10: rub(firstUnit(sub)),
  dtfMax: cotton.qty.max,
  subMin: sub.qty.min,
});
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
// reviews about shoppers, if there are any; otherwise the general reviews
const hasShopperReviews = reviews.some((r) => page.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));

const tones = ['c', 'm', 'y'];
// «Какие шопперы»: both drawings in one scale (px per mm), 5 cm grid behind them
const KSCALE = 0.62;

// three facts under the buttons of the first screen (same row as on the t-shirt page)
const heroFacts = [{ big: '1 шт', small: 'можно заказать один шоппер' },{ big: '2 стороны', small: 'принт спереди и сзади' },{ big: 'до А3', small: 'размер принта' }];
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/portfolio/shopper-bags.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: heroFrom, offerCount: CALC_PRODUCTS.length }),
    faqPage(faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <section class="shero">
    <div class="wrap shero-grid">
      <div class="shero-text">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow shero-eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.lead}</p>
        <div class="shero-actions">
          <a class="btn btn-magenta" href="#calc"><Icon name="calc" size={20} /> <span>Рассчитать<span class="long"> стоимость</span></span></a>
          <button type="button" class="btn btn-ghost" data-order><Icon name="upload" size={20} /> <span>Отправить макет</span></button>
        </div>
        <HeroFacts facts={heroFacts} />
      </div>
      <div class="shero-media" role="img" aria-label={page.heroAlt}>
        <span class="shero-dot shero-dot-c" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-m" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-y" aria-hidden="true"></span>
        <div class="shero-wall halftone" aria-hidden="true">
          <span class="shero-rail"></span>
          <div class="shero-stage">
            <ShopperArt type="cotton" color="black" print="text" printSize="a5" scale={0.42} class="shero-bag shero-black" />
            <ShopperArt type="linen" print="photo" printSize="a4" scale={0.5} class="shero-bag shero-linen" />
            <ShopperArt type="cotton" color="natural" print="art" printSize="a4" scale={0.5} class="shero-bag shero-white" />
          </div>
        </div>
        <span class="sticker shero-price">
          от <span class="mono">{rub(heroFrom)}</span><small>шоппер с печатью</small>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ calculator ============ -->
  <div class="band band-tint">
  <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">01</span>
          <p class="eyebrow">Калькулятор</p>
          <h2 id="calc-h">Посчитайте свои <span class="mark sec-mark">шопперы</span></h2>
        </div>
        <p class="calc-sub">Выберите шоппер, размер принта с каждой стороны и количество — цена за штуку и за весь заказ пересчитается сразу. Сумка, печать и макет уже в цене.</p>
      </div>
      <Calculator client:visible category="textile" product="shopper" products={CALC_PRODUCTS} hideCategories />
    </div>
    <AlsoOrder slugs={page.alsoOrder} />
  </section>
  </div>

  <div class="band">
  <ShopperPackages />
  </div>

  <!-- ============ two kinds side by side, one scale ============ -->
  <div class="band band-tint">
  <section class="section kinds" aria-labelledby="kinds-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-m">
          <span class="sec-num mono" aria-hidden="true">03</span>
          <p class="eyebrow">Какие шопперы печатаем</p>
          <h2 id="kinds-h">Хлопковый шоппер и светлый шоппер цвета <span class="mark sec-mark">льна</span></h2>
        </div>
        <p class="kinds-sub">Оба нарисованы в одном масштабе. Одна клетка на фоне — 5 × 5 см.</p>
      </div>
      <div class="kinds-grid">
        <div class="kinds-wall" style={`--cell:${50 * KSCALE}px`}>
          <span class="kinds-rail" aria-hidden="true"></span>
          <ol class="kinds-row">
            {
              kinds.map((k, i) => (
                <li class={`kinds-item kinds-${tones[i === 0 ? 0 : 2]}`}>
                  <a class="kinds-art" href={`#kind-${k.art}`} aria-label={k.name}>
                    <ShopperArt type={k.art} color={k.color} print={k.print} printSize="a4" dims={k.art === 'linen'} scale={KSCALE} title={k.name} />
                  </a>
                  <span class="kinds-name">{k.name}</span>
                  <span class="kinds-tech mono">{k.tech}</span>
                </li>
              ))
            }
          </ol>
          <span class="kinds-legend mono" aria-hidden="true"><i></i> 5 см</span>
        </div>

        <div class="cmp" role="region" aria-label="Сравнение шопперов">
          <table class="cmp-table">
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Параметр</span></th>
                {
                  kinds.map((k, i) => (
                    <th scope="col" id={`kind-${k.art}`} class={`cmp-head kinds-${tones[i === 0 ? 0 : 2]}`}>
                      <span class="cmp-tag">{k.tag}</span>
                      <span class="cmp-name">{k.name}</span>
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {kc.specs.map((s, r) => (
                <tr>
                  <th scope="row">{s.label}</th>
                  <td class:list={[{ 'cmp-todo': 'todo' in s && s.todo }]}>{s.value}</td>
                  <td>{kl.specs[r]?.value}</td>
                </tr>
              ))}
              <tr>
                <th scope="row">Размер принта</th>
                <td>{kc.formats}, с двух сторон</td>
                <td>{kl.formats}, с двух сторон</td>
              </tr>
              <tr>
                <th scope="row">Тираж</th>
                <td>от {kc.min} шт{kc.max ? `, больше ${kc.max} — индивидуально` : ''}</td>
                <td>от {kl.min} шт</td>
              </tr>
              <tr>
                <th scope="row">Для чего</th>
                <td>{kc.use}</td>
                <td>{kl.use}</td>
              </tr>
              <tr class="cmp-price">
                <th scope="row">Цена</th>
                {kinds.map((k) => (
                  <td>
                    <b class="mono">от {rub(k.from)}</b>
                    <small>
                      {k.min} шт с принтом А4 — <span class="mono">{rub(k.first)}</span>/шт
                    </small>
                    <a class="btn btn-sm btn-ghost" href={`${page.slug}?calc=textile:${k.product}#calc`}>Рассчитать</a>
                  </td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ print sizes, in scale ============ -->
  <div class="band">
  <section class="section szs" aria-labelledby="szs-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-c">
          <span class="sec-num mono" aria-hidden="true">04</span>
          <p class="eyebrow">Размер принта</p>
          <h2 id="szs-h">А6, А5, А4 или А3 — как принт смотрится на <span class="mark sec-mark">сумке</span></h2>
        </div>
        <p>Принты нарисованы в настоящем масштабе на светлом шоппере 36 × 42 см. На хлопковом шоппере — до А4.</p>
      </div>
      <ul class="szs-grid">
        {
          sizes.map((s, i) => (
            <li class={`szs-card kinds-${tones[i % 3]}`}>
              <div class="szs-art" aria-hidden="true">
                <ShopperArt type="linen" print="photo" printSize={s.id} scale={0.4} />
                <span class="szs-badge">{s.title}</span>
              </div>
              <div class="szs-body">
                <dl class="szs-dims">
                  <div>
                    <dt>DTF</dt>
                    <dd class:list={['mono', { 'szs-no': !s.dtf }]}>{s.dtf ?? '—'}</dd>
                  </div>
                  <div>
                    <dt>Сублимация</dt>
                    <dd class="mono">{s.sub ?? '—'}</dd>
                  </div>
                </dl>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ DTF vs sublimation (dark band) ============ -->
  <div class="band">
  <section class="section vs" aria-labelledby="vs-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">05</span>
          <p class="eyebrow">Технология</p>
          <h2 id="vs-h">{page.tech.title}</h2>
        </div>
        <p>Обе технологии дают полноцветный принт. Разница — в ткани, тираже и ощущении рисунка.</p>
      </div>
      <div class="vs-grid">
        {
          [
            { t: page.tech.dtf, k: kc, tone: 'c' },
            { t: page.tech.sub, k: kl, tone: 'y' },
          ].map(({ t, k, tone }, i) => (
            <article class={`vs-card vs-${tone}`}>
              <div class="vs-top">
                <div class="vs-art" aria-hidden="true">
                  <ShopperArt type={k.art} color="natural" print={i === 0 ? 'art' : 'photo'} printSize="a4" scale={0.22} />
                </div>
                <div>
                  <span class="vs-on mono">{t.on}</span>
                  <h3>{t.name}</h3>
                  <p class="vs-from">
                    <b class="mono">от {rub(k.from)}</b> · от {k.min} шт
                  </p>
                </div>
              </div>
              <ul class="vs-list">
                {t.points.map((p) => <li><Icon name="check" size={16} /> {p}</li>)}
              </ul>
              <p class="vs-best">{t.best}</p>
              <a class="btn btn-sm vs-btn" href={`${page.slug}?calc=textile:${k.product}#calc`}>Рассчитать</a>
            </article>
          ))
        }
        <span class="vs-badge mono" aria-hidden="true">или</span>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ for whom ============ -->
  <div class="band band-tint">
  <section class="section aud" aria-labelledby="aud-h">
    <div class="wrap">
      <p class="eyebrow">Для кого</p>
      <h2 id="aud-h" class="aud-title">Кому заказывают шопперы с печатью</h2>
      <ul class="aud-grid">
        {
          page.audience.map((a, i) => (
            <li class={`aud-card kinds-${tones[i % 3]}`}>
              <span class="aud-tag mono">{a.tag}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="aud-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ how to order ============ -->
  <div class="band">
  <section class="section how" aria-labelledby="how-h">
    <div class="wrap how-grid">
      <div>
        <p class="eyebrow">Заказ</p>
        <h2 id="how-h">Как заказать печать на <span class="mark">шоппере</span></h2>
        <ol class="how-steps">
          {
            page.steps.map((s, i) => (
              <li>
                <span class="how-dot mono">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <aside class="how-side">
        <details class="how-card" open data-fold>
          <summary><h3>{page.layout.title}</h3></summary>
          <ul class="how-list">
            {page.layout.items.map((t) => <li>{t}</li>)}
          </ul>
          <a class="how-more" href="/trebovaniya-k-maketam">Требования к макетам →</a>
        </details>
        <div class="how-b2b">
          <h3>{page.b2b.title}</h3>
          <ul class="how-chips">
            {page.b2b.items.map((t) => <li><Icon name="check" size={16} /> {t}</li>)}
          </ul>
          <button type="button" class="btn btn-sm how-b2b-btn" data-order="Шопперы с логотипом для компании — рассчитать тираж">Рассчитать тираж</button>
          <a class="how-more" href="/korporativnym-klientam">Корпоративным клиентам →</a>
        </div>
      </aside>
    </div>
  </section>
  </div>

  <script is:inline>
    // folding cards are always open on a computer; on a phone they start folded (tap to open), as on the mugs page
    (function () {
      var m = matchMedia('(max-width: 760px)');
      document.querySelectorAll('.how [data-fold]').forEach(function (d) {
        if (m.matches) d.open = false;
        d.querySelector('summary').addEventListener('click', function (e) {
          if (!m.matches) e.preventDefault();
        });
        m.addEventListener('change', function (e) {
          d.open = !e.matches;
        });
      });
    })();
  </script>

  <div class="band band-tint">
  <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: шопперы и текстиль" />
  </div>

  <div class="band">
  <Reviews keywords={hasShopperReviews ? page.reviewKeywords : undefined} title={hasShopperReviews ? 'Отзывы о шопперах' : 'Что говорят клиенты'} />
  </div>

  <div class="band band-tint">
  <FaqSection items={faq} title="Вопросы о печати на шопперах" />
  </div>

  <!-- ============ SEO text (folded on phones) ============ -->
  <div class="band">
  <section class="section seo-text" aria-labelledby="seo-h">
    <div class="wrap">
      <h2 id="seo-h">{page.seo.title}</h2>
      <input type="checkbox" id="seo-more" class="seo-toggle" />
      <div class="seo-cols">
        {
          page.seo.sections.map((s) => (
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          ))
        }
        <div>
          <h3>Смотрите также</h3>
          <p>
            <a href="/pechat-na-odezhde">печать на одежде</a> · <a href="/pechat-na-futbolkah">печать на футболках</a> · <a href="/pechat-na-hudi">худи</a> ·
            <a href="/pechat-na-kepkah">кепки</a> · <a href="/korporativnym-klientam">корпоративным клиентам</a> ·
            <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
          </p>
        </div>
      </div>
      <label for="seo-more" class="seo-more-btn">Читать полностью</label>
    </div>
  </section>
  </div>

  <div class="band band-tint">
  {related.length > 0 && <TshirtRelated items={related} />}
  </div>

  <CtaBand title="Хотите шоппер со своим принтом?" text="Пришлите рисунок, фото или логотип — соберём макет, покажем, как он ляжет на сумку, и посчитаем цену." />
</BaseLayout>

<style>
  /* data-restyled: bands, numbered headings, hangers — like /pechat-na-futbolkah (owner, 07.11.2026) */
  /* ================= first screen ================= */
  .shero {
    padding-block: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 40px);
    overflow: clip;
  }
  .shero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .shero-text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .shero-eyebrow {
    margin: 0 0 -8px;
  }
  .shero-text h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }
  .shero-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .shero-chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .shero-chips :global(svg) {
    color: var(--m-ink);
  }
  .shero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .shero-media {
    position: relative;
    padding: 24px;
  }
  /* a wall with a rail: three shoppers hang on it; the stage is drawn at a fixed size and zoomed with the column */
  .shero-wall {
    position: relative;
    z-index: 1;
    aspect-ratio: 1;
    border-radius: 40px 40px 120px 40px;
    background-color: var(--paper-2);
    --dot: rgba(22, 20, 27, 0.1);
    overflow: clip;
  }
  .shero-rail {
    position: absolute;
    z-index: 2;
    left: 8%;
    right: 8%;
    top: 9%;
    height: 10px;
    border-radius: 999px;
    background: var(--ink);
    box-shadow: 0 6px 10px rgba(22, 20, 27, 0.18);
  }
  .shero-stage {
    --hz: 1;
    zoom: var(--hz);
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 440px;
    margin: -220px 0 0 -220px;
    z-index: 1;
  }
  .shero-stage :global(.shero-bag) {
    position: absolute;
    filter: drop-shadow(0 16px 18px rgba(22, 20, 27, 0.2));
  }
  .shero-stage :global(.shero-black) {
    left: 2px;
    top: 30px;
    transform: rotate(-4deg);
  }
  .shero-stage :global(.shero-linen) {
    left: 112px;
    top: 26px;
    z-index: 2;
  }
  .shero-stage :global(.shero-white) {
    right: -4px;
    top: 34px;
    z-index: 1;
    transform: rotate(4deg);
  }
  .shero-price {
    position: absolute;
    right: 0;
    bottom: 40px;
    z-index: 3;
    display: grid;
    font-size: 1.25rem;
    text-align: center;
  }
  .shero-price small {
    font-size: 0.75rem;
    font-weight: 700;
  }
  .shero-dot {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: multiply;
    z-index: 0;
  }
  .shero-dot-c {
    width: 120px;
    height: 120px;
    background: var(--c);
    top: -6px;
    right: -10px;
  }
  .shero-dot-m {
    width: 80px;
    height: 80px;
    background: var(--m);
    bottom: 10px;
    left: 70px;
    opacity: 0.8;
  }
  .shero-dot-y {
    width: 110px;
    height: 110px;
    background: var(--y);
    top: 40%;
    left: 0;
  }
  .calc-sec {
    background: var(--paper-2);
    border-radius: 48px;
    margin-inline: clamp(0px, 1.5vw, 20px);
  }

  /* ================= kinds: two shoppers in one scale + comparison ================= */
  .kinds-c { --tone: var(--c); --soft: var(--c-soft); }
  .kinds-m { --tone: var(--m); --soft: var(--m-soft); }
  .kinds-y { --tone: var(--y); --soft: var(--y-soft); }
  .kinds-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 16px;
    align-items: stretch;
  }
  /* --kz: zoom of the drawings on smaller screens; the 5 cm grid and the legend follow it, so the scale stays true */
  .kinds-wall {
    --kz: 1;
    --cz: calc(var(--cell) * var(--kz));
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 56px 12px 22px;
    border-radius: var(--radius-l);
    background:
      linear-gradient(0deg, rgba(22, 20, 27, 0.07) 1px, transparent 1px) 0 0 / 100% var(--cz),
      linear-gradient(90deg, rgba(22, 20, 27, 0.07) 1px, transparent 1px) 50% 0 / var(--cz) 100%,
      var(--paper-2);
    overflow: clip;
  }
  .kinds-rail {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 64px;
    height: 8px;
    border-radius: 999px;
    background: var(--ink);
  }
  .kinds-row {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(8px, 2vw, 28px);
  }
  .kinds-item {
    display: grid;
    justify-items: center;
    gap: 8px;
  }
  .kinds-art {
    display: block;
    color: inherit;
  }
  .kinds-art :global(svg) {
    display: block;
    zoom: var(--kz);
    transition: transform 0.2s ease;
    filter: drop-shadow(0 12px 12px rgba(22, 20, 27, 0.18));
  }
  .kinds-art:hover :global(svg) {
    transform: translateY(-4px);
  }
  .kinds-name {
    font-weight: 800;
    font-size: 0.95rem;
    text-align: center;
  }
  .kinds-tech {
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--tone);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .kinds-legend {
    position: absolute;
    right: 18px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .kinds-legend i {
    width: var(--cz);
    height: 6px;
    border: 1.5px solid var(--ink);
    border-top: 0;
  }
  /* comparison table */
  .cmp {
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
  }
  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.92rem;
  }
  .cmp-table col:first-child,
  .cmp-table th:first-child {
    width: 24%;
  }
  .cmp-table th,
  .cmp-table td {
    padding: 11px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px dashed var(--line);
    line-height: 1.4;
  }
  .cmp-table tbody th {
    color: var(--muted);
    font-weight: 600;
  }
  .cmp-table td {
    font-weight: 600;
  }
  .cmp-head {
    border-top: 6px solid var(--tone);
    background: var(--soft);
    scroll-margin-top: 90px;
  }
  .cmp-head:target {
    box-shadow: inset 0 0 0 2px var(--ink);
  }
  .cmp-tag {
    display: inline-block;
    margin-bottom: 4px;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .cmp-name {
    display: block;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .cmp-todo {
    color: var(--muted);
    font-style: italic;
  }
  .cmp-price td {
    border-bottom: 0;
  }
  .cmp-price th {
    border-bottom: 0;
    padding-top: 16px;
  }
  .cmp-price b {
    display: block;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }
  .cmp-price small {
    display: block;
    margin: 2px 0 10px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  /* ================= print sizes ================= */
  .szs-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .szs-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 26px 26px 26px 8px;
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
  }
  .szs-art {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding: 18px 10px 14px;
    background:
      radial-gradient(circle, rgba(22, 20, 27, 0.08) 1.3px, transparent 1.5px) 0 0 / 14px 14px,
      var(--soft);
  }
  .szs-art :global(svg) {
    flex: none;
    filter: drop-shadow(0 10px 12px rgba(22, 20, 27, 0.16));
  }
  .szs-badge {
    position: absolute;
    left: 14px;
    top: 14px;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-weight: 900;
    font-size: 1.2rem;
    box-shadow: 3px 3px 0 var(--tone);
  }
  .szs-body {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 14px 16px 18px;
  }
  .szs-dims {
    margin: 0;
    display: grid;
    gap: 3px;
    font-size: 0.86rem;
  }
  .szs-dims div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1px dashed var(--line);
  }
  .szs-dims dt {
    color: var(--muted);
  }
  .szs-dims dd {
    margin: 0;
    font-weight: 700;
    white-space: nowrap;
  }
  .szs-no {
    color: var(--muted);
  }
  .szs-body p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.45;
  }

  /* ================= DTF vs sublimation (dark band) ================= */
  .vs {
    background: var(--ink);
    color: var(--paper);
    border-radius: 48px;
    margin-inline: clamp(0px, 1.5vw, 20px);
  }
  .vs h2,
  .vs .eyebrow {
    color: var(--paper);
  }
  .vs .section-head p {
    color: rgba(255, 252, 245, 0.72);
  }
  .vs-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .vs-c { --tone: var(--c); }
  .vs-y { --tone: var(--y); }
  .vs-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 24px;
    border-radius: var(--radius-l);
    background: rgba(255, 252, 245, 0.06);
    border: 1.5px solid rgba(255, 252, 245, 0.14);
    border-top: 6px solid var(--tone);
  }
  .vs-top {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 18px;
  }
  .vs-art {
    display: grid;
    place-items: center;
    width: 128px;
    height: 176px;
    border-radius: 26px;
    background: radial-gradient(circle at 50% 45%, rgba(255, 252, 245, 0.22), transparent 70%);
  }
  .vs-art :global(svg) {
    filter: drop-shadow(0 10px 12px rgba(0, 0, 0, 0.45));
  }
  .vs-on {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--tone);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .vs-card h3 {
    margin: 6px 0 2px;
    color: var(--paper);
    font-size: 1.5rem;
  }
  .vs-from {
    margin: 0;
    color: rgba(255, 252, 245, 0.75);
    font-size: 0.9rem;
  }
  .vs-from b {
    color: var(--paper);
    font-size: 1.05rem;
  }
  .vs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .vs-list li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 0.95rem;
    color: rgba(255, 252, 245, 0.88);
  }
  .vs-list :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--tone);
  }
  .vs-best {
    margin: auto 0 0;
    padding: 10px 14px;
    border-radius: 16px;
    background: rgba(255, 252, 245, 0.08);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .vs-btn {
    background: var(--tone);
    border-color: var(--tone);
    color: var(--ink);
  }
  .vs-badge {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-8deg);
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--m);
    color: #fff;
    font-weight: 800;
    font-size: 1rem;
    box-shadow: 0 0 0 6px var(--ink);
  }

  /* ================= audience ================= */
  .aud-title {
    margin-bottom: 28px;
    max-width: 820px;
  }
  .aud-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .aud-card {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 8px;
    padding: 22px 22px 56px;
    border-radius: 26px 26px 26px 8px;
    background: var(--soft);
    overflow: clip;
  }
  .aud-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .aud-card h3 {
    font-size: 1.2rem;
  }
  .aud-card p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .aud-num {
    position: absolute;
    right: 16px;
    bottom: -14px;
    font-size: 4rem;
    font-weight: 800;
    color: var(--tone);
    opacity: 0.5;
    line-height: 1;
  }

  /* ================= how to order ================= */
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .how-grid h2 {
    margin-bottom: 26px;
  }
  .how-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .how-steps li {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding-bottom: 22px;
  }
  .how-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 48px;
    bottom: 4px;
    border-left: 2px dashed var(--line-strong);
  }
  .how-dot {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--card);
    font-weight: 700;
  }
  .how-steps li:nth-child(3n + 1) .how-dot { box-shadow: 3px 3px 0 var(--c); }
  .how-steps li:nth-child(3n + 2) .how-dot { box-shadow: 3px 3px 0 var(--m); }
  .how-steps li:nth-child(3n + 3) .how-dot { box-shadow: 3px 3px 0 var(--y); }
  .how-steps h3 {
    margin: 10px 0 4px;
    font-size: 1.1rem;
  }
  .how-steps p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .how-side {
    display: grid;
    gap: 14px;
  }
  .how-card,
  .how-b2b {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 22px;
    border-radius: var(--radius-l);
  }
  .how-card li {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .how-card {
    background: var(--y-soft);
  }
  .how-card summary {
    list-style: none;
    cursor: default;
  }
  .how-card summary::-webkit-details-marker {
    display: none;
  }
  .how-list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .how-list li::marker {
    color: var(--m);
  }
  .how-more {
    font-weight: 700;
    color: var(--m-ink);
  }
  .how-b2b {
    background: var(--ink);
    color: var(--paper);
  }
  .how-b2b h3 {
    color: var(--paper);
  }
  .how-b2b .how-more {
    color: var(--y);
  }
  .how-b2b-btn {
    background: var(--y);
    color: var(--ink);
    border-color: var(--y);
  }
  .how-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .how-chips li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 252, 245, 0.25);
    font-size: 0.84rem;
    font-weight: 600;
  }
  .how-chips :global(svg) {
    color: var(--y);
  }

  /* ================= seo text ================= */
  .seo-text h2 {
    margin-bottom: 24px;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .seo-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 48px;
  }
  .seo-cols h3 {
    margin-bottom: 8px;
    font-size: 1.1rem;
  }
  .seo-cols p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.96rem;
    line-height: 1.6;
  }
  .seo-toggle,
  .seo-more-btn {
    display: none;
  }

  /* ================= related ================= */
  .related-h {
    margin-bottom: 24px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .related-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 18px 10px 10px;
    border-radius: 24px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .related-card img {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    object-fit: cover;
  }
  .related-card span {
    flex: 1;
  }
  .related-card:hover {
    border-color: var(--ink);
    box-shadow: 4px 4px 0 var(--y);
    color: var(--ink);
  }

  /* ================= tablets ================= */
  @media (max-width: 1180px) {
    .aud-grid,
    .szs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shero-stage {
      --hz: 0.85;
    }
    .kinds-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 960px) {
    .how-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .shero-grid {
      grid-template-columns: 1fr;
    }
    .shero-media {
      max-width: 400px;
      justify-self: center;
      padding: 12px;
    }
    .shero-stage {
      --hz: 0.82;
    }
    .vs-grid {
      grid-template-columns: 1fr;
    }
    .vs-badge {
      display: none;
    }
  }

  /* ================= phones (≤ 760px): compact, desktop untouched ================= */
  @media (max-width: 760px) {
    .shero {
      padding-block: 14px 22px;
    }
    .shero-grid {
      grid-template-columns: minmax(0, 1fr) 118px;
      gap: 12px 14px;
      align-items: start;
    }
    .shero-text {
      display: contents;
    }
    .shero-text > :global(.crumbs),
    .shero-text h1,
    .shero-chips,
    .shero-actions {
      grid-column: 1 / -1;
    }
    .shero-eyebrow {
      display: none;
    }
    .shero-text > :global(.crumbs) {
      order: 1;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .shero-text > :global(.crumbs) :global(ol) {
      flex-wrap: nowrap;
      white-space: nowrap;
      font-size: 0.78rem;
    }
    .shero-text h1 {
      order: 2;
      font-size: clamp(1.7rem, 7.6vw, 2.1rem);
    }
    .lead {
      order: 3;
      grid-column: 1;
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.45;
    }
    .shero-media {
      order: 4;
      grid-column: 2;
      grid-row: 3;
      max-width: none;
      justify-self: stretch;
      padding: 0 0 12px;
    }
    .shero-wall {
      aspect-ratio: 3 / 4.6;
      border-radius: 20px 20px 48px 20px;
    }
    .shero-rail {
      top: 7%;
      height: 6px;
    }
    /* phone: only the light shopper and the white one */
    .shero-stage {
      --hz: 1;
      zoom: 1;
      inset: 0;
      width: auto;
      height: auto;
      margin: 0;
    }
    .shero-stage :global(.shero-black) {
      display: none;
    }
    .shero-stage :global(.shero-bag) {
      height: auto;
      filter: drop-shadow(0 6px 8px rgba(22, 20, 27, 0.2));
    }
    .shero-stage :global(.shero-linen) {
      width: 74%;
      left: 0;
      top: 5%;
    }
    .shero-stage :global(.shero-white) {
      width: 58%;
      right: -6%;
      top: 13%;
      z-index: 1;
    }
    .shero-dot {
      display: none;
    }
    .shero-price {
      right: -4px;
      bottom: 0;
      padding: 4px 8px;
      border-radius: 10px;
      font-size: 0.76rem;
      line-height: 1.15;
    }
    .shero-price small {
      font-size: 0.75rem;
    }
    .shero-price::before {
      display: none;
    }
    .shero-chips {
      order: 5;
      flex-wrap: nowrap;
      gap: 6px;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .shero-chips::-webkit-scrollbar,
    .shero-text > :global(.crumbs)::-webkit-scrollbar {
      display: none;
    }
    .shero-chips li {
      flex: none;
      gap: 4px;
      padding: 5px 10px;
      font-size: 0.8rem;
      white-space: nowrap;
    }
    .shero-chips :global(svg) {
      width: 14px;
      height: 14px;
    }
    .shero-actions {
      order: 6;
      flex-wrap: nowrap;
      gap: 8px;
    }
    .shero-actions .btn {
      flex: 1 1 0;
      min-height: 46px;
      padding: 0 12px;
      gap: 6px;
      font-size: 0.92rem;
      white-space: nowrap;
    }
    .shero-actions .btn :global(svg) {
      width: 18px;
      height: 18px;
    }
    .long {
      display: none;
    }
    .calc-sec {
      border-radius: 28px;
      padding-block: 28px 32px;
    }
    .calc-sec .section-head {
      margin-bottom: 16px;
    }
    .calc-sec .section-head .eyebrow {
      margin-bottom: 6px;
    }
    .calc-sub {
      display: none;
    }

    /* tighter sections */
    .kinds,
    .szs,
    .vs,
    .aud,
    .how,
    .seo-text,
    .related {
      padding-block: 32px;
    }
    .kinds .section-head,
    .szs .section-head,
    .vs .section-head {
      margin-bottom: 14px;
      gap: 6px;
    }
    .kinds .section-head .eyebrow,
    .szs .section-head .eyebrow,
    .vs .section-head .eyebrow {
      margin-bottom: 6px;
    }
    .szs .section-head p,
    .vs .section-head p {
      font-size: 0.86rem;
    }
    .kinds-sub {
      font-size: 0.86rem;
    }

    /* kinds: both shoppers still side by side, smaller (same scale); compact table */

---
// «Значки на заказ» — own page (like the mugs and caps pages): first screen, calculator (закатные и на цанге),
// ready options, all six sizes on one grid in one scale, «закатной или на цанге» (front + back, price tables),
// how to prepare the picture, audience, how to order, works, reviews, FAQ, SEO text.
// Content — src/data/badgesPage.ts; every price — src/data/pricing.ts (category 'badges');
// drawings — src/components/badge/BadgeArt.astro. The services.ts entry stays for menus/sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import TeeHead from '@/components/tee/TeeHead.astro';
import PpHero from '@/components/product-page/PpHero.astro';
import PpSteps from '@/components/product-page/PpSteps.astro';
import PpAudience from '@/components/product-page/PpAudience.astro';
import PpHow from '@/components/product-page/PpHow.astro';
import PpSeo from '@/components/product-page/PpSeo.astro';
import '@/components/product-page/pp.css';
import BadgeArt from '@/components/badge/BadgeArt.astro';
import BadgePackages from '@/components/badge/BadgePackages.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import { badgesPage as page, buildBadgeFaq } from '@/data/badgesPage';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { defaultSelection, findCategory, findProduct, rub, type Product } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Значки', href: page.slug },
];

// ---- prices, all from pricing.ts
const cat = findCategory('badges')!;
const roll = findProduct('badges', 'badge-roll')!;
const pin = findProduct('badges', 'badge-pin')!;
const steps = (p: Product, variant: string) => p.ladder!({ ...defaultSelection(p), options: { variant } });
const variantsOf = (p: Product) => p.options!.find((g) => g.id === 'variant')!.choices.map((c) => ({ id: c.id, mm: parseInt(c.label, 10) }));
// first discount: the second step of the 38 mm ladder (owner, 05.11.2026: from 50 pcs)
const roll38 = steps(roll, 'd38');
const discountFrom = roll38[1].from;
const sizes = [
  ...variantsOf(pin).map((v) => ({ ...v, type: 'pin' as const, product: pin })),
  ...variantsOf(roll).map((v) => ({ ...v, type: 'roll' as const, product: roll })),
].map((s) => {
  const st = steps(s.product, s.id);
  return { ...s, first: st[0].price, from: st[st.length - 1].price, off: Math.round((1 - st[1].price / st[0].price) * 100) };
});
const types = page.types.map((t) => ({ ...t, product: t.id === 'badge-pin' ? pin : roll }));
const faq = buildBadgeFaq({
  roll38: rub(roll38[0].price),
  roll38at50: rub(roll38[1].price),
  rollMin: roll.qty.min,
  pinMin: pin.qty.min,
  discountFrom,
  max: roll.qty.max,
});
const lowPrice = Math.min(...cat.products.map((p) => p.fromPrice));
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
const hasBadgeReviews = reviews.some((r) => page.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));
// «Все размеры»: one scale for all drawings (px per mm); 1 cm grid behind them
const SSCALE = 4;

// three facts under the buttons of the first screen (same row as on the t-shirt page)
const heroFacts = [{ big: '6', small: 'размеров: от 15 до 56 мм' },{ big: 'от 10 шт', small: 'закатные, на цанге — от 25 шт' },{ big: 'от 50 шт', small: 'тираж со скидкой' }];
const splitTail = (t: string): [string, string] => {
  const i = t.lastIndexOf(' ');
  return [t.slice(0, i + 1), t.slice(i + 1)];
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/img/showcase/keychains.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice, offerCount: sizes.length }),
    faqPage(faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <PpHero eyebrow={page.eyebrow} h1={page.h1} lead={page.lead} crumbs={crumbs} mark="значки" heroAlt={page.heroAlt} facts={heroFacts} price={{ pre: 'от', value: rub(lowPrice), note: 'за значок' }}>
    <BadgeArt type="roll" size={38} motif="heart" scale={3.4} class="bb bb-heart" />
    <BadgeArt type="roll" size={38} motif="text" text="ВЫПУСК" scale={3.6} class="bb bb-text" />
    <BadgeArt type="roll" size={56} motif="logo" scale={4.3} class="bb bb-main" />
    <BadgeArt type="pin" size={25} motif="star" scale={4.4} class="bb bb-pin" />
    <BadgeArt type="roll" size={38} view="back" motif="smile" scale={2.8} class="bb bb-back" />
  </PpHero>

  <!-- ============ calculator (light grey) ============ -->
  <div class="band band-tint">
    <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
      <div class="wrap">
        <TeeHead icon="calc" eyebrow="Калькулятор" id="calc-h" title="Посчитайте свои значки" mark="значки">
          <p class="calc-sub">Выберите вид значка, диаметр и количество — цена за штуку и за весь заказ пересчитается сразу. Первая скидка — уже с {discountFrom} штук.</p>
        </TeeHead>
        <Calculator client:visible category="badges" product="badge-roll" hideCategories />
      </div>
      <AlsoOrder slugs={page.alsoOrder} />
    </section>
  </div>

  <!-- ============ ready options (white) ============ -->
  <div class="band">
    <BadgePackages />
  </div>

  <!-- ============ all sizes on one grid, one scale (light grey) ============ -->
  <div class="band band-tint">
    <section class="section sz pp-sec" aria-labelledby="sz-h">
      <div class="wrap">
        <TeeHead icon="ruler" eyebrow="Размеры" id="sz-h" title="Шесть размеров: от 15 до 56 мм" mark="мм">
          <p class="pp-sub">Все значки нарисованы в одном масштабе — видно, какой больше. Одна клетка на фоне — 1 × 1 см.</p>
        </TeeHead>
        <div class="sz-shelf" style={`--cell:${10 * SSCALE}px`}>
          <ol class="sz-row">
            {
              sizes.map((s, i) => (
                <li class="sz-item">
                  <a class="sz-art" href={`${page.slug}?calc=badges:${s.product.id}#calc`} aria-label={`${s.type === 'pin' ? 'Значок на цанге' : 'Закатной значок'} ${s.mm} мм — рассчитать`}>
                    <BadgeArt type={s.type} size={s.mm} motif={s.type === 'pin' ? (i % 2 ? 'star' : 'logo') : i % 2 ? 'smile' : 'text'} text="2026" scale={SSCALE} />
                  </a>
                  <span class="sz-mm">{s.mm} мм</span>
                  <span class="sz-kind">{s.type === 'pin' ? 'на цанге' : 'закатной'}</span>
                  <span class="sz-price">от {rub(s.from)}</span>
                </li>
              ))
            }
          </ol>
          <span class="sz-legend" aria-hidden="true"><i></i> 1 см</span>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ roll or pin (white) ============ -->
  <div class="band">
    <section class="section typ pp-sec" aria-labelledby="typ-h">
      <div class="wrap">
        <TeeHead icon="layers" eyebrow="Виды значков" id="typ-h" title="Закатной или на цанге" mark="цанге">
          <p class="pp-sub">С {discountFrom} штук цена за значок ниже, дальше снижается с ростом тиража — цены в таблицах за 1 штуку.</p>
        </TeeHead>
        <div class="typ-grid">
          {
            types.map((t) => (
              <article class="typ-card pp-card">
                <div class="typ-art pp-art" aria-hidden="true">
                  <BadgeArt type={t.type} size={t.size} motif={t.motif} scale={t.type === 'pin' ? 5.2 : 3.9} class="typ-front" />
                  <BadgeArt type={t.type} size={t.size} view="back" motif={t.motif} scale={t.type === 'pin' ? 3.4 : 2.5} class="typ-back" />
                  <span class="typ-flip">лицо · обратная сторона</span>
                </div>
                <div class="typ-body">
                  <div class="typ-top">
                    <h3>{t.title}</h3>
                    <span class="pp-tag">{t.tag}</span>
                  </div>
                  <p class="typ-sizes">Диаметр {t.sizes}</p>
                  <p class="typ-text">{t.text}</p>
                  <ul class="pp-ticks">
                    {t.points.map((x) => <li>{x}</li>)}
                  </ul>
                  {t.product.table && (
                    <div class="pp-tbl-wrap">
                      <table class="pp-tbl">
                        <thead>
                          <tr>
                            <th scope="col">Диаметр</th>
                            {t.product.table.columns.map((c) => <th scope="col">{c}</th>)}
                          </tr>
                        </thead>
                        <tbody>
                          {t.product.table.rows.map((r) => (
                            <tr>
                              <th scope="row">{r.label}</th>
                              {r.cells.map((c) => <td>{c}</td>)}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                  <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=badges:${t.id}#calc`}>Рассчитать {t.type === 'pin' ? 'на цанге' : 'закатные'}</a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <!-- ============ how to prepare the picture (navy panel) ============ -->
  <div class="band band-ink">
    <section class="section gd pp-sec" aria-labelledby="gd-h">
      <div class="wrap gd-grid">
        <div class="gd-art pp-art" aria-hidden="true">
          <BadgeArt type="roll" size={56} motif="text" text="ТЕКСТ" guide scale={5.6} title="Разметка макета закатного значка: 1 — край, который уходит на бортик, 2 — безопасная зона" />
        </div>
        <div class="gd-info">
          <TeeHead icon="camera" eyebrow="Макет" id="gd-h" title={page.layoutGuide.title} mark={splitTail(page.layoutGuide.title)[1]} dark />
          <p class="gd-lead">{page.layoutGuide.text}</p>
          <PpSteps items={page.layoutGuide.items} />
          <p class="gd-note">{page.layoutGuide.note}</p>
          <a class="pp-link" href="/trebovaniya-k-maketam">Требования к макетам →</a>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ for whom (white) ============ -->
  <div class="band">
    <PpAudience title="Кому заказывают значки" mark="значки" items={page.audience} />
  </div>

  <!-- ============ how to order (light grey) ============ -->
  <div class="band band-tint">
    <PpHow title="Как заказать значки" mark="значки" steps={page.steps} b2b={page.b2b} b2bOrder="Значки с логотипом для компании — рассчитать тираж" />
  </div>

  <div class="band band-ink">
    <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: значки и брелоки" />
  </div>

  <div class="band">
    <Reviews keywords={hasBadgeReviews ? page.reviewKeywords : undefined} title={hasBadgeReviews ? 'Отзывы о значках' : 'Что говорят клиенты'} />
  </div>

  <div class="band band-tint">
    <FaqSection items={faq} title="Вопросы о значках" />
  </div>

  <div class="band">
    <PpSeo title={page.seo.title} sections={page.seo.sections}>
      <a href="/breloki">брелоки</a> · <a href="/magnity">магниты</a> · <a href="/nakleyki">3D-стикеры</a> ·
      <a href="/pechat-na-futbolkah">печать на футболках</a> · <a href="/korporativnym-klientam">корпоративным клиентам</a> ·
      <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
    </PpSeo>
  </div>

  <div class="band band-tint">
    {related.length > 0 && <TshirtRelated items={related} />}
  </div>

  <CtaBand title="Хотите значки со своим рисунком?" text="Пришлите картинку, логотип или идею — подгоним под круг, покажем макет и посчитаем цену." />
</BaseLayout>

<style>
  .calc-sub {
    max-width: 52ch;
  }

  /* ---- first screen: badges on the stage */
  :global(.ph-stage .bb) {
    position: absolute;
    filter: drop-shadow(0 14px 16px rgba(20, 33, 61, 0.2));
  }
  :global(.ph-stage .bb-heart) {
    left: 6px;
    top: 14px;
    transform: rotate(-12deg);
  }
  :global(.ph-stage .bb-text) {
    right: 6px;
    top: 36px;
    transform: rotate(9deg);
  }
  :global(.ph-stage .bb-main) {
    left: 70px;
    top: 128px;
    z-index: 2;
  }
  :global(.ph-stage .bb-pin) {
    right: 14px;
    bottom: 34px;
    z-index: 3;
    transform: rotate(-8deg);
  }
  :global(.ph-stage .bb-back) {
    left: 0;
    bottom: 10px;
    z-index: 1;
    transform: rotate(16deg);
  }

  /* ---- sizes: six badges on a 1 cm grid */
  .sz-shelf {
    --kz: 1;
    --cz: calc(var(--cell) * var(--kz));
    position: relative;
    padding: 52px clamp(12px, 3vw, 40px) 26px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.95);
    background:
      linear-gradient(0deg, rgba(20, 33, 61, 0.07) 1px, transparent 1px) 0 0 / 100% var(--cz),
      linear-gradient(90deg, rgba(20, 33, 61, 0.07) 1px, transparent 1px) 50% 0 / var(--cz) 100%,
      radial-gradient(80% 70% at 50% 35%, #ffffff 0%, #eef0f4 100%);
    box-shadow: 0 30px 60px -40px rgba(20, 33, 61, 0.45);
    overflow: clip;
  }
  .sz-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }
  .sz-item {
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .sz-art {
    display: block;
    color: inherit;
  }
  .sz-art :global(svg) {
    zoom: var(--kz);
    filter: drop-shadow(0 10px 10px rgba(20, 33, 61, 0.18));
    transition: transform 0.2s ease;
  }
  .sz-art:hover :global(svg) {
    transform: translateY(-4px);
  }
  .sz-mm {
    margin-top: 4px;
    padding: 5px 14px;
    border-radius: 999px;
    background: var(--navy, #14213d);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .sz-kind {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
  }
  .sz-price {
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--navy, #14213d);
  }
  .sz-legend {
    position: absolute;
    right: 18px;
    top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--navy, #14213d);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .sz-legend i {
    width: var(--cz);
    height: 6px;
    border: 1.5px solid var(--navy, #14213d);
    border-top: 0;
  }

  @media (max-width: 1180px) {
    .sz-shelf {
      --kz: 0.8;
    }
  }
  @media (max-width: 860px) {
    .sz-shelf {
      --kz: 0.62;
    }
  }
  @media (max-width: 760px) {
    .calc-sub {
      display: none;
    }
    .calc-sec {
      padding-block: 28px 32px;
    }
    /* sizes: two rows of three, same scale */
    .sz-shelf {
      --kz: 0.5;
      padding: 38px 8px 14px;
      border-radius: 24px;
    }
    .sz-row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
      gap: 14px 4px;
    }
    .sz-mm {
      padding: 3px 9px;
      font-size: 0.75rem;
    }
    .sz-kind {
      font-size: 0.75rem;
    }
    .sz-price {
      font-size: 0.8rem;
    }
    .sz-legend {
      right: 10px;
      top: 8px;
      font-size: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sz-art :global(svg) {
      transition: none;
    }
  }
</style>

---
// «Значки на заказ» — own page (like the mugs and caps pages): first screen, calculator (закатные и на цанге),
// ready options, all six sizes on one grid in one scale, «закатной или на цанге» (front + back, price tables),
// how to prepare the picture, audience, how to order, works, reviews, FAQ, SEO text.
// Content — src/data/badgesPage.ts; every price — src/data/pricing.ts (category 'badges');
// drawings — src/components/badge/BadgeArt.astro. The services.ts entry stays for menus/sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import BadgeArt from '@/components/badge/BadgeArt.astro';
import BadgePackages from '@/components/badge/BadgePackages.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import HeroFacts from '@/components/tshirt/HeroFacts.astro';
import { badgesPage as page, buildBadgeFaq } from '@/data/badgesPage';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { defaultSelection, findCategory, findProduct, rub, type Product } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: 'Значки', href: page.slug },
];

// ---- prices, all from pricing.ts
const cat = findCategory('badges')!;
const roll = findProduct('badges', 'badge-roll')!;
const pin = findProduct('badges', 'badge-pin')!;
const steps = (p: Product, variant: string) => p.ladder!({ ...defaultSelection(p), options: { variant } });
const variantsOf = (p: Product) => p.options!.find((g) => g.id === 'variant')!.choices.map((c) => ({ id: c.id, mm: parseInt(c.label, 10) }));
// first discount: the second step of the 38 mm ladder (owner, 05.11.2026: from 50 pcs)
const roll38 = steps(roll, 'd38');
const discountFrom = roll38[1].from;
const sizes = [
  ...variantsOf(pin).map((v) => ({ ...v, type: 'pin' as const, product: pin })),
  ...variantsOf(roll).map((v) => ({ ...v, type: 'roll' as const, product: roll })),
].map((s) => {
  const st = steps(s.product, s.id);
  return { ...s, first: st[0].price, from: st[st.length - 1].price, off: Math.round((1 - st[1].price / st[0].price) * 100) };
});
const types = page.types.map((t) => ({ ...t, product: t.id === 'badge-pin' ? pin : roll }));
const faq = buildBadgeFaq({
  roll38: rub(roll38[0].price),
  roll38at50: rub(roll38[1].price),
  rollMin: roll.qty.min,
  pinMin: pin.qty.min,
  discountFrom,
  max: roll.qty.max,
});
const lowPrice = Math.min(...cat.products.map((p) => p.fromPrice));
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
const hasBadgeReviews = reviews.some((r) => page.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));
const tones = ['c', 'm', 'y'];
// «Все размеры»: one scale for all drawings (px per mm); 1 cm grid behind them
const SSCALE = 4;

// three facts under the buttons of the first screen (same row as on the t-shirt page)
const heroFacts = [{ big: '6', small: 'размеров: от 15 до 56 мм' },{ big: 'от 10 шт', small: 'закатные, на цанге — от 25 шт' },{ big: 'от 50 шт', small: 'тираж со скидкой' }];
const splitTail = (t: string): [string, string] => {
  const i = t.lastIndexOf(' ');
  return [t.slice(0, i + 1), t.slice(i + 1)];
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/img/showcase/keychains.webp"
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice, offerCount: sizes.length }),
    faqPage(faq),
  ]}
>
  <!-- ============ first screen ============ -->
  <section class="shero">
    <div class="wrap shero-grid">
      <div class="shero-text">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow shero-eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.lead}</p>
        <div class="shero-actions">
          <a class="btn btn-magenta" href="#calc"><Icon name="calc" size={20} /> <span>Рассчитать<span class="long"> стоимость</span></span></a>
          <button type="button" class="btn btn-ghost" data-order><Icon name="upload" size={20} /> <span>Отправить макет</span></button>
        </div>
        <HeroFacts facts={heroFacts} />
      </div>
      <div class="shero-media" role="img" aria-label={page.heroAlt}>
        <span class="shero-dot shero-dot-c" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-m" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-y" aria-hidden="true"></span>
        <div class="shero-wall halftone" aria-hidden="true">
          <div class="shero-stage">
            <BadgeArt type="roll" size={38} motif="heart" scale={3.4} class="bb bb-heart" />
            <BadgeArt type="roll" size={38} motif="text" text="ВЫПУСК" scale={3.6} class="bb bb-text" />
            <BadgeArt type="roll" size={56} motif="logo" scale={4.3} class="bb bb-main" />
            <BadgeArt type="pin" size={25} motif="star" scale={4.4} class="bb bb-pin" />
            <BadgeArt type="roll" size={38} view="back" motif="smile" scale={2.8} class="bb bb-back" />
          </div>
        </div>
        <span class="sticker shero-price">
          от <span class="mono">{rub(lowPrice)}</span><small>за значок</small>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ calculator ============ -->
  <div class="band band-tint">
  <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">01</span>
          <p class="eyebrow">Калькулятор</p>
          <h2 id="calc-h">Посчитайте свои <span class="mark sec-mark">значки</span></h2>
        </div>
        <p class="calc-sub">Выберите вид значка, диаметр и количество — цена за штуку и за весь заказ пересчитается сразу. Первая скидка — уже с {discountFrom} штук.</p>
      </div>
      <Calculator client:visible category="badges" product="badge-roll" hideCategories />
    </div>
    <AlsoOrder slugs={page.alsoOrder} />
  </section>
  </div>

  <div class="band">
  <BadgePackages />
  </div>

  <!-- ============ all sizes on one grid, one scale ============ -->
  <div class="band band-tint">
  <section class="section sz" aria-labelledby="sz-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-m">
          <span class="sec-num mono" aria-hidden="true">03</span>
          <p class="eyebrow">Размеры</p>
          <h2 id="sz-h">Шесть размеров: от 15 до 56 <span class="mark sec-mark">мм</span></h2>
        </div>
        <p class="sz-sub">Все значки нарисованы в одном масштабе — видно, какой больше. Одна клетка на фоне — 1 × 1 см.</p>
      </div>
      <div class="sz-shelf" style={`--cell:${10 * SSCALE}px`}>
        <ol class="sz-row">
          {
            sizes.map((s, i) => (
              <li class={`sz-item sz-${s.type === 'pin' ? 'c' : i % 2 ? 'y' : 'm'}`}>
                <a class="sz-art" href={`${page.slug}?calc=badges:${s.product.id}#calc`} aria-label={`${s.type === 'pin' ? 'Значок на цанге' : 'Закатной значок'} ${s.mm} мм — рассчитать`}>
                  <BadgeArt type={s.type} size={s.mm} motif={s.type === 'pin' ? (i % 2 ? 'star' : 'logo') : i % 2 ? 'smile' : 'text'} text="2026" scale={SSCALE} />
                </a>
                <span class="sz-mm mono">{s.mm} мм</span>
                <span class="sz-kind">{s.type === 'pin' ? 'на цанге' : 'закатной'}</span>
                <span class="sz-price mono">от {rub(s.from)}</span>
              </li>
            ))
          }
        </ol>
        <span class="sz-legend mono" aria-hidden="true"><i></i> 1 см</span>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ roll or pin ============ -->
  <div class="band">
  <section class="section typ" aria-labelledby="typ-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-c">
          <span class="sec-num mono" aria-hidden="true">04</span>
          <p class="eyebrow">Виды значков</p>
          <h2 id="typ-h">Закатной или на <span class="mark sec-mark">цанге</span></h2>
        </div>
        <p>С {discountFrom} штук цена за значок ниже, дальше снижается с ростом тиража — цены в таблицах за 1 штуку.</p>
      </div>
      <div class="typ-grid">
        {
          types.map((t, i) => (
            <article class={`typ-card typ-${i ? 'c' : 'm'}`}>
              <div class="typ-art" aria-hidden="true">
                <BadgeArt type={t.type} size={t.size} motif={t.motif} scale={t.type === 'pin' ? 5.2 : 3.9} class="typ-front" />
                <BadgeArt type={t.type} size={t.size} view="back" motif={t.motif} scale={t.type === 'pin' ? 3.4 : 2.5} class="typ-back" />
                <span class="typ-flip mono">лицо · обратная сторона</span>
              </div>
              <div class="typ-body">
                <div class="typ-top">
                  <h3>{t.title}</h3>
                  <span class="typ-tag mono">{t.tag}</span>
                </div>
                <p class="typ-sizes"><Icon name="check" size={16} /> Диаметр {t.sizes}</p>
                <p class="typ-text">{t.text}</p>
                <ul class="typ-points">
                  {t.points.map((x) => <li>{x}</li>)}
                </ul>
                {t.product.table && (
                  <div class="typ-tbl-wrap">
                    <table class="typ-tbl">
                      <thead>
                        <tr>
                          <th scope="col">Диаметр</th>
                          {t.product.table.columns.map((c) => <th scope="col">{c}</th>)}
                        </tr>
                      </thead>
                      <tbody>
                        {t.product.table.rows.map((r) => (
                          <tr>
                            <th scope="row">{r.label}</th>
                            {r.cells.map((c) => <td class="mono">{c}</td>)}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
                <a class="btn btn-sm btn-magenta" href={`${page.slug}?calc=badges:${t.id}#calc`}>Рассчитать {t.type === 'pin' ? 'на цанге' : 'закатные'}</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  </div>

  <!-- ============ how to prepare the picture ============ -->
  <div class="band band-tint">
  <section class="section gd" aria-labelledby="gd-h">
    <div class="wrap gd-grid">
      <div class="gd-art" aria-hidden="true">
        <BadgeArt type="roll" size={56} motif="text" text="ТЕКСТ" guide scale={5.6} title="Разметка макета закатного значка: 1 — край, который уходит на бортик, 2 — безопасная зона" />
      </div>
      <div class="gd-info">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">05</span>
          <p class="eyebrow">Макет</p>
          <h2 id="gd-h">{splitTail(page.layoutGuide.title)[0]}<span class="mark sec-mark">{splitTail(page.layoutGuide.title)[1]}</span></h2>
        </div>
        <p class="gd-lead">{page.layoutGuide.text}</p>
        <ol class="gd-list">
          {
            page.layoutGuide.items.map((it, i) => (
              <li class={`gd-${it.tone}`}>
                <span class="gd-num mono">{i + 1}</span>
                <div>
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="gd-note">{page.layoutGuide.note}</p>
        <a class="how-more" href="/trebovaniya-k-maketam">Требования к макетам →</a>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ for whom ============ -->
  <div class="band">
  <section class="section aud" aria-labelledby="aud-h">
    <div class="wrap">
      <p class="eyebrow">Для кого</p>
      <h2 id="aud-h" class="aud-title">Кому заказывают значки</h2>
      <ul class="aud-grid">
        {
          page.audience.map((a, i) => (
            <li class={`aud-card kinds-${tones[i % 3]}`}>
              <span class="aud-tag mono">{a.tag}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="aud-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ how to order ============ -->
  <div class="band band-tint">
  <section class="section how" aria-labelledby="how-h">
    <div class="wrap how-grid">
      <div>
        <p class="eyebrow">Заказ</p>
        <h2 id="how-h">Как заказать <span class="mark">значки</span></h2>
        <ol class="how-steps">
          {
            page.steps.map((s, i) => (
              <li>
                <span class="how-dot mono">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <aside class="how-side">
        <div class="how-b2b">
          <h3>{page.b2b.title}</h3>
          <ul class="how-chips">
            {page.b2b.items.map((t) => <li><Icon name="check" size={16} /> {t}</li>)}
          </ul>
          <button type="button" class="btn btn-sm how-b2b-btn" data-order="Значки с логотипом для компании — рассчитать тираж">Рассчитать тираж</button>
          <a class="how-more" href="/korporativnym-klientam">Корпоративным клиентам →</a>
        </div>
      </aside>
    </div>
  </section>
  </div>

  <script is:inline>
    // folding cards are always open on a computer; on a phone they start folded (tap to open), as on the shoppers page
    (function () {
      var m = matchMedia('(max-width: 760px)');
      document.querySelectorAll('[data-fold]').forEach(function (d) {
        if (m.matches) d.open = false;
        d.querySelector('summary').addEventListener('click', function (e) {
          if (!m.matches) e.preventDefault();
        });
        m.addEventListener('change', function (e) {
          d.open = !e.matches;
        });
      });
    })();
  </script>

  <div class="band">
  <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: значки и брелоки" />
  </div>

  <div class="band band-tint">
  <Reviews keywords={hasBadgeReviews ? page.reviewKeywords : undefined} title={hasBadgeReviews ? 'Отзывы о значках' : 'Что говорят клиенты'} />
  </div>

  <div class="band">
  <FaqSection items={faq} title="Вопросы о значках" />
  </div>

  <!-- ============ SEO text (folded on phones) ============ -->
  <div class="band band-tint">
  <section class="section seo-text" aria-labelledby="seo-h">
    <div class="wrap">
      <h2 id="seo-h">{page.seo.title}</h2>
      <input type="checkbox" id="seo-more" class="seo-toggle" />
      <div class="seo-cols">
        {
          page.seo.sections.map((s) => (
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          ))
        }
        <div>
          <h3>Смотрите также</h3>
          <p>
            <a href="/breloki">брелоки</a> · <a href="/magnity">магниты</a> · <a href="/nakleyki">3D-стикеры</a> ·
            <a href="/pechat-na-futbolkah">печать на футболках</a> · <a href="/korporativnym-klientam">корпоративным клиентам</a> ·
            <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
          </p>
        </div>
      </div>
      <label for="seo-more" class="seo-more-btn">Читать полностью</label>
    </div>
  </section>
  </div>

  <div class="band">
  {related.length > 0 && <TshirtRelated items={related} />}
  </div>

  <CtaBand title="Хотите значки со своим рисунком?" text="Пришлите картинку, логотип или идею — подгоним под круг, покажем макет и посчитаем цену." />
</BaseLayout>

<style>
  /* data-restyled: bands, numbered headings, hangers — like /pechat-na-futbolkah (owner, 07.11.2026) */
  /* ================= first screen ================= */
  .shero {
    padding-block: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 40px);
    overflow: clip;
  }
  .shero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .shero-text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .shero-eyebrow {
    margin: 0 0 -8px;
  }
  .shero-text h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }
  .shero-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .shero-chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .shero-chips :global(svg) {
    color: var(--m-ink);
  }
  .shero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .shero-media {
    position: relative;
    padding: 24px;
  }
  /* a wall: badges on it; the stage is drawn at a fixed size and zoomed with the column */
  .shero-wall {
    position: relative;
    z-index: 1;
    aspect-ratio: 1;
    border-radius: 40px 40px 120px 40px;
    background-color: var(--paper-2);
    --dot: rgba(22, 20, 27, 0.1);
    overflow: clip;
  }
  .shero-stage {
    --hz: 1;
    zoom: var(--hz);
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 440px;
    margin: -220px 0 0 -220px;
    z-index: 1;
  }
  .shero-price {
    position: absolute;
    right: 0;
    bottom: 40px;
    z-index: 3;
    display: grid;
    font-size: 1.25rem;
    text-align: center;
  }
  .shero-price small {
    font-size: 0.75rem;
    font-weight: 700;
  }
  .shero-dot {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: multiply;
    z-index: 0;
  }
  .shero-dot-c {
    width: 120px;
    height: 120px;
    background: var(--c);
    top: -6px;
    right: -10px;
  }
  .shero-dot-m {
    width: 80px;
    height: 80px;
    background: var(--m);
    bottom: 10px;
    left: 70px;
    opacity: 0.8;
  }
  .shero-dot-y {
    width: 110px;
    height: 110px;
    background: var(--y);
    top: 40%;
    left: 0;
  }
  .calc-sec {
    background: var(--paper-2);
    border-radius: 48px;
    margin-inline: clamp(0px, 1.5vw, 20px);
  }


  /* badges on the wall */
  .shero-stage :global(.bb) {
    position: absolute;
    filter: drop-shadow(0 14px 16px rgba(22, 20, 27, 0.2));
  }
  .shero-stage :global(.bb-heart) {
    left: 6px;
    top: 14px;
    transform: rotate(-12deg);
  }
  .shero-stage :global(.bb-text) {
    right: 6px;
    top: 36px;
    transform: rotate(9deg);
  }
  .shero-stage :global(.bb-main) {
    left: 70px;
    top: 128px;
    z-index: 2;
  }
  .shero-stage :global(.bb-pin) {
    right: 14px;
    bottom: 34px;
    z-index: 3;
    transform: rotate(-8deg);
  }
  .shero-stage :global(.bb-back) {
    left: 0;
    bottom: 10px;
    z-index: 1;
    transform: rotate(16deg);
  }

  .kinds-c { --tone: var(--c); --soft: var(--c-soft); }
  .kinds-m { --tone: var(--m); --soft: var(--m-soft); }
  .kinds-y { --tone: var(--y); --soft: var(--y-soft); }

  /* ================= sizes: six badges on a 1 cm grid ================= */
  .sz-c { --tone: var(--c); --soft: var(--c-soft); }
  .sz-m { --tone: var(--m); --soft: var(--m-soft); }
  .sz-y { --tone: var(--y); --soft: var(--y-soft); }
  .sz-shelf {
    --kz: 1;
    --cz: calc(var(--cell) * var(--kz));
    position: relative;
    padding: 48px clamp(12px, 3vw, 40px) 26px;
    border-radius: var(--radius-l);
    background:
      linear-gradient(0deg, rgba(22, 20, 27, 0.07) 1px, transparent 1px) 0 0 / 100% var(--cz),
      linear-gradient(90deg, rgba(22, 20, 27, 0.07) 1px, transparent 1px) 50% 0 / var(--cz) 100%,
      var(--paper-2);
    overflow: clip;
  }
  .sz-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }
  .sz-item {
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .sz-art {
    display: block;
    color: inherit;
  }
  .sz-art :global(svg) {
    zoom: var(--kz);
    filter: drop-shadow(0 10px 10px rgba(22, 20, 27, 0.16));
    transition: transform 0.2s ease;
  }
  .sz-art:hover :global(svg) {
    transform: translateY(-4px);
  }
  .sz-mm {
    margin-top: 4px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tone);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .sz-m .sz-mm {
    color: #fff;
  }
  .sz-kind {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
  }
  .sz-price {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .sz-legend {
    position: absolute;
    right: 18px;
    top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .sz-legend i {
    width: var(--cz);
    height: 6px;
    border: 1.5px solid var(--ink);
    border-top: 0;
  }

  /* ================= roll or pin ================= */
  .typ-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .typ-c { --tone: var(--c); --soft: var(--c-soft); }
  .typ-m { --tone: var(--m); --soft: var(--m-soft); }
  .typ-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 34px 34px 34px 10px;
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
  }
  .typ-art {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6%;
    height: 300px;
    padding: 24px 16px 40px;
    background:
      radial-gradient(circle, rgba(22, 20, 27, 0.08) 1.3px, transparent 1.5px) 0 0 / 14px 14px,
      var(--soft);
  }
  .typ-art :global(svg) {
    filter: drop-shadow(0 12px 12px rgba(22, 20, 27, 0.18));
  }
  .typ-art :global(.typ-back) {
    transform: rotate(-10deg);
  }
  .typ-flip {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .typ-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 20px 22px 24px;
  }
  .typ-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .typ-top h3 {
    font-size: 1.45rem;
  }
  .typ-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--tone);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .typ-m .typ-tag {
    color: #fff;
  }
  .typ-sizes {
    margin: 0;
    display: flex;
    gap: 6px;
    align-items: center;
    font-weight: 700;
  }
  .typ-sizes :global(svg) {
    color: var(--m-ink);
  }
  .typ-text {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .typ-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .typ-points li {
    padding: 4px 11px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    font-size: 0.84rem;
    font-weight: 600;
  }
  .typ-tbl-wrap {
    width: 100%;
    overflow-x: auto;
    border-radius: 18px;
    border: 1.5px solid var(--line);
  }
  .typ-tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  .typ-tbl th,
  .typ-tbl td {
    padding: 7px 8px;
    text-align: right;
    white-space: nowrap;
    border-bottom: 1px dashed var(--line);
  }
  .typ-tbl tbody tr:last-child > * {
    border-bottom: 0;
  }
  .typ-tbl thead th {
    background: var(--paper-2);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--muted);
  }
  .typ-tbl th:first-child {
    text-align: left;
  }
  .typ-tbl tbody th {
    font-weight: 700;
  }
  .typ-tbl td:nth-child(3) {
    background: var(--y-soft);
    font-weight: 700;
  }
  .typ-body .btn {
    margin-top: auto;
  }

  /* ================= how to prepare the picture ================= */
  .gd-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }
  .gd-art {
    position: relative;
    display: grid;
    place-items: center;
    padding: 30px;
    border-radius: 40px 40px 120px 40px;
    background:
      radial-gradient(circle, rgba(22, 20, 27, 0.08) 1.3px, transparent 1.5px) 0 0 / 14px 14px,
      var(--m-soft);
  }
  .gd-art :global(svg) {
    width: min(100%, 340px);
    filter: drop-shadow(0 16px 16px rgba(22, 20, 27, 0.2));
  }
  .gd-info {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .gd-info .eyebrow {
    margin: 0 0 -6px;
  }
  .gd-lead {
    margin: 0;
    color: var(--ink-2);
  }
  .gd-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    width: 100%;
  }
  .gd-list li {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 12px;
    align-items: start;
    padding: 14px 16px;
    border-radius: 22px 22px 22px 8px;
    background: var(--card);
    border: 1.5px solid var(--line);
  }
  .gd-num {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-weight: 800;
  }
  .gd-k .gd-num {
    background: var(--ink);
    color: var(--paper);
  }
  .gd-m .gd-num {
    background: var(--m);
    color: #fff;
  }
  .gd-c .gd-num {
    background: var(--c);
  }
  .gd-list h3 {
    margin: 6px 0 2px;
    font-size: 1.05rem;
  }
  .gd-list p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .gd-note {
    margin: 0;
    padding: 12px 16px;
    border-radius: 18px;
    background: var(--y-soft);
    font-size: 0.92rem;
    font-weight: 600;
  }
  /* ================= audience ================= */
  .aud-title {
    margin-bottom: 28px;
    max-width: 820px;
  }
  .aud-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .aud-card {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 8px;
    padding: 22px 22px 56px;
    border-radius: 26px 26px 26px 8px;
    background: var(--soft);
    overflow: clip;
  }
  .aud-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .aud-card h3 {
    font-size: 1.2rem;
  }
  .aud-card p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .aud-num {
    position: absolute;
    right: 16px;
    bottom: -14px;
    font-size: 4rem;
    font-weight: 800;
    color: var(--tone);
    opacity: 0.5;
    line-height: 1;
  }

  /* ================= how to order ================= */
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .how-grid h2 {
    margin-bottom: 26px;
  }
  .how-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .how-steps li {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding-bottom: 22px;
  }
  .how-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 48px;
    bottom: 4px;
    border-left: 2px dashed var(--line-strong);
  }
  .how-dot {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--card);
    font-weight: 700;
  }
  .how-steps li:nth-child(3n + 1) .how-dot { box-shadow: 3px 3px 0 var(--c); }
  .how-steps li:nth-child(3n + 2) .how-dot { box-shadow: 3px 3px 0 var(--m); }
  .how-steps li:nth-child(3n + 3) .how-dot { box-shadow: 3px 3px 0 var(--y); }
  .how-steps h3 {
    margin: 10px 0 4px;
    font-size: 1.1rem;
  }
  .how-steps p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .how-side {
    display: grid;
    gap: 14px;
  }
  .how-card,
  .how-b2b {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 22px;
    border-radius: var(--radius-l);
  }
  .how-card li {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .how-card {
    background: var(--y-soft);
  }
  .how-card summary {
    list-style: none;
    cursor: default;
  }
  .how-card summary::-webkit-details-marker {
    display: none;
  }
  .how-list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .how-list li::marker {
    color: var(--m);
  }
  .how-more {
    font-weight: 700;
    color: var(--m-ink);
  }
  .how-b2b {
    background: var(--ink);
    color: var(--paper);
  }
  .how-b2b h3 {
    color: var(--paper);
  }
  .how-b2b .how-more {
    color: var(--y);
  }
  .how-b2b-btn {
    background: var(--y);
    color: var(--ink);
    border-color: var(--y);
  }
  .how-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .how-chips li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 252, 245, 0.25);
    font-size: 0.84rem;
    font-weight: 600;
  }
  .how-chips :global(svg) {
    color: var(--y);
  }

  /* ================= seo text ================= */
  .seo-text h2 {
    margin-bottom: 24px;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .seo-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 48px;
  }
  .seo-cols h3 {
    margin-bottom: 8px;
    font-size: 1.1rem;
  }
  .seo-cols p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.96rem;
    line-height: 1.6;
  }
  .seo-toggle,
  .seo-more-btn {
    display: none;
  }

  /* ================= related ================= */
  .related-h {
    margin-bottom: 24px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .related-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 18px 10px 10px;
    border-radius: 24px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .related-card img {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    object-fit: cover;
  }
  .related-card span {
    flex: 1;
  }
  .related-card:hover {
    border-color: var(--ink);
    box-shadow: 4px 4px 0 var(--y);
    color: var(--ink);
  }


  /* ================= tablets ================= */
  @media (max-width: 1180px) {
    .aud-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shero-stage {
      --hz: 0.85;
    }
    .sz-shelf {
      --kz: 0.8;
    }
  }
  @media (max-width: 960px) {
    .how-grid,
    .typ-grid,
    .gd-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .gd-art {
      max-width: 420px;
    }
  }
  @media (max-width: 860px) {
    .shero-grid {
      grid-template-columns: 1fr;
    }
    .shero-media {
      max-width: 400px;
      justify-self: center;
      padding: 12px;
    }
    .shero-stage {
      --hz: 0.82;
    }
    .sz-shelf {
      --kz: 0.62;
    }
  }

  @media (max-width: 760px) {
    .shero {
      padding-block: 14px 22px;
    }
    .shero-grid {
      grid-template-columns: minmax(0, 1fr) 118px;
      gap: 12px 14px;
      align-items: start;
    }
    .shero-text {
      display: contents;
    }
    .shero-text > :global(.crumbs),
    .shero-text h1,
    .shero-chips,
    .shero-actions {
      grid-column: 1 / -1;
    }
    .shero-eyebrow {
      display: none;
    }
    .shero-text > :global(.crumbs) {
      order: 1;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .shero-text > :global(.crumbs) :global(ol) {
      flex-wrap: nowrap;
      white-space: nowrap;
      font-size: 0.78rem;
    }
    .shero-text h1 {
      order: 2;
      font-size: clamp(1.7rem, 7.6vw, 2.1rem);
    }
    .lead {
      order: 3;
      grid-column: 1;
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.45;
    }
    .shero-media {
      order: 4;
      grid-column: 2;
      grid-row: 3;
      max-width: none;
      justify-self: stretch;
      padding: 0 0 12px;
    }
    .shero-wall {
      aspect-ratio: 3 / 4.6;
      border-radius: 20px 20px 48px 20px;
    }
    /* phone: the big badge and one small one */
    .shero-stage {
      --hz: 1;
      zoom: 1;
      inset: 0;
      width: auto;
      height: auto;
      margin: 0;
    }
    .shero-stage :global(.bb) {
      display: none;
    }
    .shero-stage :global(.bb-main) {
      display: block;
      left: -8%;
      top: 8%;
      width: 116%;
      height: auto;
      filter: drop-shadow(0 6px 8px rgba(22, 20, 27, 0.2));
    }
    .shero-stage :global(.bb-pin) {
      display: block;
      left: auto;
      right: 2%;
      top: auto;
      bottom: 16%;
      width: 46%;
      height: auto;
    }
    .shero-dot {
      display: none;
    }
    .shero-price {
      right: -4px;
      bottom: 0;
      padding: 4px 8px;
      border-radius: 10px;
      font-size: 0.76rem;
      line-height: 1.15;
    }
    .shero-price small {
      font-size: 0.75rem;
    }
    .shero-price::before {
      display: none;
    }
    .shero-chips {
      order: 5;
      flex-wrap: nowrap;
      gap: 6px;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .shero-chips::-webkit-scrollbar,
    .shero-text > :global(.crumbs)::-webkit-scrollbar {
      display: none;
    }
    .shero-chips li {
      flex: none;
      gap: 4px;
      padding: 5px 10px;
      font-size: 0.8rem;
      white-space: nowrap;
    }
    .shero-chips :global(svg) {
      width: 14px;
      height: 14px;
    }
    .shero-actions {
      order: 6;
      flex-wrap: nowrap;
      gap: 8px;
    }
    .shero-actions .btn {
      flex: 1 1 0;
      min-height: 46px;
      padding: 0 12px;
      gap: 6px;
      font-size: 0.92rem;
      white-space: nowrap;
    }
    .shero-actions .btn :global(svg) {
      width: 18px;
      height: 18px;
    }
    .long {
      display: none;
    }
    .calc-sec {
      border-radius: 28px;
      padding-block: 28px 32px;
    }
    .calc-sec .section-head {
      margin-bottom: 16px;
    }
    .calc-sec .section-head .eyebrow {
      margin-bottom: 6px;
    }
    .calc-sub {
      display: none;
    }

    /* tighter sections */
    .sz,
    .typ,
    .gd,
    .aud,
    .how,
    .seo-text,
    .related {
      padding-block: 32px;
    }
    .sz .section-head {
      margin-bottom: 14px;
      gap: 6px;
    }
    .sz .section-head .eyebrow {
      margin-bottom: 6px;
    }
    .sz .section-head p {
      font-size: 0.86rem;
    }

    .sz-sub {
      font-size: 0.86rem;
    }

    /* sizes: two rows of three, same scale */
    .sz-shelf {
      --kz: 0.5;
      margin-inline: calc(var(--gutter) * -0.5);
      padding: 34px 8px 14px;
      border-radius: 24px;
    }
    .sz-row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
      gap: 14px 4px;
    }
    .sz-mm {
      padding: 2px 8px;
      font-size: 0.75rem;
    }
    .sz-kind {
      font-size: 0.75rem;
    }
    .sz-price {
      font-size: 0.8rem;
    }
    .sz-legend {
      right: 10px;
      top: 8px;
      font-size: 0.75rem;
    }

    /* roll or pin */
    .typ .section-head {
      margin-bottom: 14px;
      gap: 6px;
    }
    .typ .section-head .eyebrow {
      margin-bottom: 6px;
    }
    .typ .section-head p {
      font-size: 0.86rem;
    }
    .typ-grid {
      gap: 12px;
    }
    .typ-card {
      border-radius: 24px 24px 24px 8px;
    }
    .typ-art {
      height: 200px;
      padding: 14px 10px 34px;
    }
    .typ-art :global(svg) {
      zoom: 0.66;
    }
    .typ-flip {
      bottom: 8px;
      font-size: 0.75rem;
    }
    .typ-body {
      gap: 8px;
      padding: 14px 14px 16px;
    }
    .typ-top h3 {
      font-size: 1.15rem;
    }
    .typ-sizes,
    .typ-text {
      font-size: 0.86rem;
    }
    .typ-points li {
      padding: 3px 9px;
      font-size: 0.75rem;
    }
    .typ-tbl {
      font-size: 0.76rem;
    }
    .typ-tbl th,
    .typ-tbl td {
      padding: 6px 7px;
    }

    /* picture guide: small badge left, list compact */
    .gd-grid {
      gap: 14px;
    }
    .gd-art {
      max-width: none;
      padding: 16px;
      border-radius: 24px 24px 60px 24px;
    }
    .gd-art :global(svg) {
      width: min(62%, 220px);
    }
    .gd-list {
      gap: 8px;
    }
    .gd-list li {
      grid-template-columns: 30px 1fr;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 18px 18px 18px 6px;
    }
    .gd-num {
      width: 30px;
      height: 30px;
      font-size: 0.8rem;
    }
    .gd-list h3 {
      margin-top: 4px;
      font-size: 0.95rem;
    }
    .gd-list p,
    .gd-note,
    .gd-lead {
      font-size: 0.82rem;
    }
    /* audience: compact 2×2 */
    .aud-title {
      margin-bottom: 14px;
    }
    .aud .eyebrow {
      margin-bottom: 6px;
    }
    .aud-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .aud-card {
      gap: 4px;
      padding: 12px 12px 30px;
      border-radius: 20px 20px 20px 6px;
    }
    .aud-card h3 {
      font-size: 0.95rem;
      line-height: 1.2;
    }
    .aud-card p {
      font-size: 0.78rem;
      line-height: 1.38;
    }
    .aud-tag {
      padding: 2px 8px;
      font-size: 0.75rem;
    }
    .aud-num {
      right: 10px;
      bottom: -8px;
      font-size: 2.4rem;
    }

    /* how to order */
    .how-grid h2 {
      margin-bottom: 16px;
    }
    .how-steps li {
      grid-template-columns: 36px 1fr;
      gap: 12px;
      padding-bottom: 14px;
    }
    .how-steps li:not(:last-child)::before {
      left: 17px;
      top: 36px;
    }

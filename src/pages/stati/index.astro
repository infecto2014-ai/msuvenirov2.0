---
// «Статьи» — list of articles (gift ideas and similar SEO material). Data — src/data/articles.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { articles, ruDate } from '@/data/articles';
import { breadcrumbs } from '@/lib/schema';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Статьи', href: '/stati' },
];
const list = [...articles].sort((a, b) => b.published.localeCompare(a.published));
---

<BaseLayout
  title="Статьи об идеях подарков и печати — Мастерская сувениров, Калининград"
  description="Идеи подарков с фото и логотипом, советы по печати на одежде и сувенирах от мастерской в Калининграде."
  path="/stati"
  schema={[breadcrumbs(crumbs)]}
>
  <section class="section st">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Статьи</p>
      <h1>Идеи подарков и советы по печати</h1>
      <p class="lead">Подборки подарков к праздникам и полезное о печати на одежде и сувенирах — от мастерской в Калининграде.</p>
      <ul class="st-grid">
        {
          list.map((a) => (
            <li class="st-card">
              <a class="st-pic" href={a.slug} tabindex="-1" aria-hidden="true">
                <img src={a.cover} alt="" width="400" height="300" loading="lazy" decoding="async" />
                <span class="st-tag">{a.tag}</span>
              </a>
              <div class="st-body">
                <h2>
                  <a href={a.slug}>{a.title}</a>
                </h2>
                <p>{a.description}</p>
                <p class="st-meta mono">
                  <time datetime={a.published}>{ruDate(a.published)}</time> · {a.readMinutes} мин
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .st h1 {
    margin-top: 6px;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
  }
  .st .lead {
    margin-top: 10px;
  }
  .st-grid {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .st-card {
    display: flex;
    flex-direction: column;
    border-radius: 26px;
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .st-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 36px -26px rgba(3, 32, 48, 0.45);
  }
  .st-pic {
    position: relative;
    display: block;
    flex: none;
    aspect-ratio: 16 / 10;
    overflow: clip;
  }
  .st-pic img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .st-tag {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 5px 12px;
    border-radius: 999px;
    background: #8a1e1c;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .st-body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 20px;
  }
  .st-body h2 {
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .st-body h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  .st-body h2 a:hover {
    text-decoration: underline;
  }
  .st-body p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .st-body .st-meta {
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 1020px) {
    .st-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .st-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

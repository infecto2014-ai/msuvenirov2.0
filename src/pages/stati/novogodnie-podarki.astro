---
// Article: New Year gift ideas (owner, 06.11.2026) — SEO and easy browsing, no calculator.
// Ideas and prices — src/data/nyGiftsArticle.ts (prices quoted from pricing.ts).
// Style «Ink» (14.11.2026): navy snow panel header, glass cards, icons instead of numbers, alternating bands.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import TeeHead from '@/components/tee/TeeHead.astro';
import { articleBySlug, ruDate } from '@/data/articles';
import IdeaCards from '@/components/ny/IdeaCards.astro';
import { faq, groups, hoursNote, ideasCount, intro, introTitle, outro, steps, tips } from '@/data/nyGiftsArticle';
import { site } from '@/data/site';
import { BUSINESS_ID, breadcrumbs, faqPage } from '@/lib/schema';

const slug = '/stati/novogodnie-podarki';
const a = articleBySlug(slug)!;
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Статьи', href: '/stati' },
  { name: 'Новогодние подарки', href: slug },
];
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.title,
  description: a.description,
  image: `${site.url}${a.cover}`,
  datePublished: a.published,
  dateModified: a.updated ?? a.published,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@id': BUSINESS_ID },
  mainEntityOfPage: `${site.url}${slug}`,
};

const P = {
  heart: 'M12 20s-8-4.6-8-10.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15.4 12 20 12 20Z',
  gift: 'M4 11h16v9H4zM3 7h18v4H3zM12 7v13M12 7c-2.5 0-4.5-1-4.5-2.5S9 2.5 12 7c3-4.5 4.5-3 4.5-1.5S14.5 7 12 7Z',
  star: 'm12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9Z',
  bag: 'M5 8h14l-1.2 12H6.2zM9 8V6a3 3 0 0 1 6 0v2',
  bulb: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1.1 2V16h5v-.2c.1-.8.5-1.5 1.1-2A6 6 0 0 0 12 3Z',
  camera: 'M4 8h3l2-3h6l2 3h3v11H4zM12 17a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z',
  chat: 'M4 5h16v11H9l-5 4zM8 9h8M8 12h5',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 7v5l3 2',
  users: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM2.5 20c.5-3.6 3-5.5 6.5-5.5s6 1.9 6.5 5.5M16 4.5a3.5 3.5 0 0 1 0 6.5M18 14.8c1.9.7 3.2 2.3 3.5 5.2',
  upload: 'M12 16V4m-5 5 5-5 5 5M5 20h14',
  ok: 'M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM8 12.5l2.8 2.8L16 9.6',
  cal: 'M3 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM16 2v4M8 2v4M3 11h18',
  doc: 'M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5',
  layers: 'm12 3 9 5-9 5-9-5zM3 13l9 5 9-5M3 17.5l9 5 9-5',
};
const groupIcon = { family: 'heart', kids: 'gift', friends: 'star', work: 'bag' } as const;
const stepIcon = [P.chat, P.upload, P.ok, P.bag];
const tipIcon = [P.heart, P.camera, P.chat, P.clock, P.users];
const ideasWord = (n: number) => {
  const d = n % 10, h = n % 100;
  return d === 1 && h !== 11 ? 'идея' : d >= 2 && d <= 4 && (h < 12 || h > 14) ? 'идеи' : 'идей';
};
const seeAlso = [
  { href: '/fotopodarki', title: 'Фотоподарки', text: 'Ёлочные шары, подушки и другое с фото' },
  { href: '/pechat-na-kruzhkah', title: 'Печать на кружках', text: 'Фото, надписи, кружки-хамелеоны' },
  { href: '/pechat-na-futbolkah', title: 'Печать на футболках', text: 'Взрослые и детские, от 1 штуки' },
  { href: '/kalendari', title: 'Календари на 2027 год', text: 'Квартальные с логотипом, от 10 штук' },
  { href: '/korporativnym-klientam', title: 'Мерч для компаний', text: 'Счёт без НДС и закрывающие документы' },
  { href: '/stati', title: 'Все статьи', text: 'Идеи и советы мастерской' },
];
const b2bPoints = ['Счёт без НДС', 'Закрывающие документы', 'Макет по вашему брендбуку', 'Образец перед тиражом'];
---

<BaseLayout title={`${a.title} — Мастерская сувениров, Калининград`} description={a.description} path={slug} image={a.cover} schema={[articleLd, breadcrumbs(crumbs), faqPage(faq)]}>
  <article class="ng">
    <!-- night header: navy rounded panel with snow, the family photo in a glass ornament and the countdown -->
    <header class="ng-head lx-dark">
      <span class="ny-snow" aria-hidden="true"></span>
      <div class="wrap ng-head-in">
        <Breadcrumbs items={crumbs} />
        <div class="ng-head-grid">
          <div class="ng-head-text">
            <p class="ng-eyebrow">Статьи · {a.tag}</p>
            <h1>Что подарить на Новый год: {ideasCount} идей подарков <span class="serif">с&nbsp;фото и&nbsp;логотипом</span></h1>
            <p class="ng-lead">
              Без носков с оленями и дежурных свечек. Собрали подарки, которые делают специально для человека, — с ценами, сроками и честными советами из
              мастерской.
            </p>
            <p class="ng-meta">
              <time datetime={a.published}>{ruDate(a.published)}</time> · {a.readMinutes} минут чтения
            </p>
          </div>
          <div class="ng-head-art" aria-hidden="true">
            <figure class="ng-orn">
              <span class="ng-string"></span>
              <span class="ng-cap"></span>
              <span class="ng-ball"><img src="/img/ny/ball-photo.webp" alt="" width="240" height="240" /></span>
            </figure>
            <p class="ng-days">
              <span class="ng-days-top">до Нового года</span>
              <b data-ny-days>—</b>
              <span data-ny-word>дней</span>
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- intro: readable text column + "who are we gifting" contents card -->
    <section class="ng-intro" aria-labelledby="intro-h">
      <div class="wrap ng-intro-grid">
        <div class="ng-intro-text">
          <p class="eyebrow">Вместо вступления</p>
          <h2 id="intro-h">{introTitle}</h2>
          {intro.map((p) => <p>{p}</p>)}
        </div>
        <nav class="ng-toc-card" aria-labelledby="toc-h">
          <p class="ng-toc-title" id="toc-h">Кому дарим</p>
          <ol>
            {
              groups.map((g) => (
                <li>
                  <a href={`#${g.id}`}>
                    <span class="ng-ico" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d={P[groupIcon[g.id]]} /></svg>
                    </span>
                    <span class="ng-toc-name">{g.label}</span>
                    <span class="ng-toc-count">
                      {g.ideas.length} {ideasWord(g.ideas.length)}
                    </span>
                    <span class="ng-toc-go" aria-hidden="true"><Icon name="arrow" size={14} /></span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </section>

    <div class="ng-groups">
      <!-- compact section bar, sticks under the site header on tablets and desktops -->
      <nav class="ng-bar" aria-label="Разделы с идеями">
        <div class="wrap ng-bar-in">
          <span class="ng-bar-label">Кому дарим</span>
          <ul>
            {
              groups.map((g) => (
                <li>
                  <a href={`#${g.id}`} data-bar={g.id}>
                    {g.label} <span class="ng-bar-count">{g.ideas.length}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      {
        groups.map((g, i) => (
          <div class={`band${i % 2 === 0 ? ' band-tint' : ''}`}>
            <section class="section ng-group" id={g.id} aria-labelledby={`${g.id}-h`}>
              <div class="wrap">
                <TeeHead
                  icon={groupIcon[g.id]}
                  eyebrow={`${g.label} · ${g.ideas.length} ${ideasWord(g.ideas.length)}`}
                  id={`${g.id}-h`}
                  title={g.title}
                  mark={g.title.replace(/^Подарки\s+/, '')}
                >
                  <p class="ng-gh-intro">{g.intro}</p>
                </TeeHead>
                <IdeaCards ideas={g.ideas} />
                <aside class="ng-note" aria-label="Совет мастерской">
                  <span class="ng-ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d={P.bulb} /></svg>
                  </span>
                  <div>
                    <p class="ng-note-label">Совет мастерской</p>
                    <p class="ng-note-text">{g.tip}</p>
                  </div>
                </aside>
              </div>
            </section>
          </div>
        ))
      }
    </div>

    <div class="band band-ink ng-tips-band">
      <span class="ny-snow" aria-hidden="true"></span>
      <section class="section ng-tips" aria-labelledby="tips-h">
        <div class="wrap">
          <TeeHead dark icon="bulb" eyebrow={`${tips.length} правил от мастерской`} id="tips-h" title={`Как выбрать подарок, который не\u00a0передарят`} mark={`не\u00a0передарят`} />
          <ol class="ng-tips-list">
            {
              tips.map((t, i) => (
                <li>
                  <span class="ng-ico ng-ico-light" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d={tipIcon[i]} /></svg>
                  </span>
                  <h3>{t.title}</h3>
                  <p>{t.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
    </div>

    <div class="band band-tint">
      <section class="section ng-how" aria-labelledby="how-h">
        <div class="wrap">
          <TeeHead icon="check" eyebrow="4 шага" id="how-h" title="Как заказать подарок к Новому году" mark="заказать" />
          <ol class="ng-route">
            {
              steps.map((s, i) => (
                <li class="ng-stop">
                  <span class="ng-dot" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d={stepIcon[i]} /></svg>
                  </span>
                  <div class="ng-glass">
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="ng-facts">
            <p class="ng-fact ng-fact-dark">
              <span class="ng-ico ng-ico-light" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d={P.clock} /></svg>
              </span>
              <span>{hoursNote}</span>
            </p>
            <p class="ng-fact">
              <span class="ng-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d={P.cal} /></svg>
              </span>
              <span>
                <b>Совет:</b> в декабре заказов больше, чем обычно. Если нужен тираж для коллег или подарок к конкретной дате — напишите заранее, и мы спокойно
                всё успеем.
              </span>
            </p>
          </div>
        </div>
      </section>
    </div>

    <div class="band band-ink">
      <section class="section ng-b2b" aria-labelledby="b2b-h">
        <div class="wrap ng-b2b-grid">
          <div class="ng-b2b-main">
            <TeeHead dark icon="layers" eyebrow="Компаниям" id="b2b-h" title="Новогодние подарки сотрудникам и партнёрам" mark="сотрудникам и партнёрам">
              <p class="ng-b2b-lead">Соберём набор под ваш бюджет: кружки, футболки, календари, бейсболки и значки с логотипом.</p>
            </TeeHead>
            <ul class="ng-b2b-list">
              {
                b2bPoints.map((t) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    {t}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="ng-b2b-actions">
            <button type="button" class="btn btn-magenta" data-order="Новогодние подарки для компании">Запросить расчёт</button>
            <a class="btn btn-ghost" href="/kp-msuvenirov.pdf" download>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
              Скачать КП (PDF)
            </a>
            <a class="ng-b2b-link" href="/korporativnym-klientam">Условия для компаний <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    </div>

    <div class="band band-tint">
      <section class="section ng-outro" aria-labelledby="outro-h">
        <div class="wrap">
          <div class="ng-outro-card">
            <div class="ng-outro-l">
              <TeeHead icon="gift" eyebrow="С наступающим!" id="outro-h" title="Итого" />
            </div>
            <div class="ng-outro-r">
              <p>{outro}</p>
              <button type="button" class="btn btn-magenta" data-order="Новогодний подарок">Подобрать подарок</button>
            </div>
          </div>
        </div>
      </section>
    </div>

    <FaqSection items={faq} title="Вопросы о новогодних подарках" />

    <div class="band band-tint">
      <section class="section ng-links" aria-labelledby="links-h">
        <div class="wrap">
          <TeeHead icon="star" eyebrow="Читайте и смотрите" id="links-h" title="Смотрите также" />
          <ul>
            {
              seeAlso.map((l) => (
                <li>
                  <a href={l.href}>
                    <span class="ng-link-t">{l.title}</span>
                    <span class="ng-link-d">{l.text}</span>
                    <span class="ng-link-go" aria-hidden="true"><Icon name="arrow" size={14} /></span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>
  </article>

  <CtaBand title="Не нашли подходящую идею?" text="Напишите, кому дарите и какой бюджет, — подскажем подарок и покажем макет." />
</BaseLayout>

<script>
  // Days to New Year on Ded Moroz's sign (visitor's clock)
  const daysEl = document.querySelector('[data-ny-days]');
  if (daysEl) {
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const d = Math.round((new Date(now.getFullYear() + 1, 0, 1).getTime() - today.getTime()) / 86400000);
    const a = d % 10, b = d % 100;
    daysEl.textContent = String(d);
    const w = document.querySelector('[data-ny-word]');
    if (w) w.textContent = a === 1 && b !== 11 ? 'день' : a >= 2 && a <= 4 && (b < 12 || b > 14) ? 'дня' : 'дней';
  }

  // Sticky section bar: highlight the group currently in view
  const barLinks = document.querySelectorAll<HTMLAnchorElement>('[data-bar]');
  if (barLinks.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          barLinks.forEach((l) => (l.dataset.bar === e.target.id ? l.setAttribute('aria-current', 'location') : l.removeAttribute('aria-current')));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    barLinks.forEach((l) => {
      const s = document.getElementById(l.dataset.bar!);
      if (s) io.observe(s);
    });
  }
</script>
<style>
  /* ---------- night header: navy rounded panel with snow (as the home page New Year strip) */
  .ng-head {
    position: relative;
    isolation: isolate;
    overflow: clip;
    margin: 12px 12px 0;
    padding-block: 18px clamp(40px, 5vw, 64px);
    border-radius: 32px;
    color: #fff;
    background:
      radial-gradient(50% 80% at 90% 0%, rgba(255, 255, 255, 0.09), transparent 65%),
      linear-gradient(160deg, var(--navy, #14213d) 0%, #0b1426 100%);
  }
  .ng-head-in {
    position: relative;
  }
  .ng-head :global(.crumbs ol),
  .ng-head :global(.crumbs a),
  .ng-head :global(.crumbs li),
  .ng-head :global(.crumbs span) {
    color: rgba(255, 255, 255, 0.78);
  }
  .ng-head :global(.crumbs li + li::before) {
    color: rgba(255, 255, 255, 0.4);
  }
  .ng-head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: 14px;
  }
  .ng-head-text {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .ng-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
  }
  .ng-eyebrow::before {
    content: '';
    width: 24px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .ng-head h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.9rem, 3.6vw, 3.1rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  .ng-lead {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.4vw, 1.16rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
  }
  .ng-meta {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
  }
  /* the family photo in a glass ornament + glass countdown plate */
  .ng-head-art {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 3vw, 36px);
    padding-top: 28px;
  }
  .ng-orn {
    position: relative;
    flex: none;
    width: clamp(130px, 14vw, 190px);
    margin: 0;
    padding-top: 22px;
  }
  .ng-string {
    position: absolute;
    top: -80px;
    left: 50%;
    width: 1px;
    height: 100px;
    background: linear-gradient(rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.6));
  }
  .ng-cap {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 30px;
    height: 16px;
    transform: translateX(-50%);
    border-radius: 6px 6px 3px 3px;
    background: linear-gradient(90deg, #9aa3b5, #e5e5e5 45%, #ffffff 55%, #9aa3b5);
  }
  .ng-ball {
    display: block;
    aspect-ratio: 1;
    padding: 7px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.1);
    box-shadow:
      0 0 0 4px rgba(255, 255, 255, 0.85),
      0 24px 40px -18px rgba(0, 0, 0, 0.7);
  }
  .ng-ball img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .ng-days {
    display: grid;
    justify-items: center;
    gap: 4px;
    margin: 0;
    padding: 16px 22px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .ng-days-top {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .ng-days b {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .ng-days [data-ny-word] {
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* ---------- shared: icon in a circle */
  .ng-ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--navy, #14213d);
    color: #fff;
  }
  .ng-ico-light {
    background: #fff;
    color: var(--navy, #14213d);
  }
  .ng-ico svg,
  .ng-dot svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ng-glass {
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.4);
  }

  /* ---------- intro: text + contents card */
  .ng-intro {
    padding-block: clamp(40px, 5.5vw, 76px) clamp(36px, 5vw, 64px);
  }
  .ng-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 400px);
    gap: clamp(28px, 6vw, 88px);
    align-items: start;
  }
  .ng-intro-text {
    max-width: 66ch;
  }
  .ng-intro-text .eyebrow {
    margin: 0 0 14px;
  }
  .ng-intro-text h2 {
    margin: 0 0 18px;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
  }

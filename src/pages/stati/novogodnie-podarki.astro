---
// Article: New Year gift ideas (owner, 06.11.2026) — SEO and easy browsing, no calculator.
// Ideas and prices — src/data/nyGiftsArticle.ts (prices quoted from pricing.ts).
import '@fontsource/caveat/600.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import { articleBySlug, ruDate } from '@/data/articles';
import NyBall from '@/components/ny/NyBall.astro';
import NyGarland from '@/components/ny/NyGarland.astro';
import PolaroidWall from '@/components/ny/PolaroidWall.astro';
import { faq, groups, hoursNote, ideasCount, intro, introTitle, outro, steps, tips } from '@/data/nyGiftsArticle';
import { site } from '@/data/site';
import { BUSINESS_ID, breadcrumbs, faqPage } from '@/lib/schema';

const slug = '/stati/novogodnie-podarki';
const a = articleBySlug(slug)!;
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Статьи', href: '/stati' },
  { name: 'Новогодние подарки', href: slug },
];
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.title,
  description: a.description,
  image: `${site.url}${a.cover}`,
  datePublished: a.published,
  dateModified: a.updated ?? a.published,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@id': BUSINESS_ID },
  mainEntityOfPage: `${site.url}${slug}`,
};

// group colours: --acc decorates (bars, dots, pin heads), --acc-ink is the readable text tone (≥4.5:1 on paper)
const tone = {
  family: { acc: '#d7262e', ink: '#b81d24' },
  kids: { acc: '#ffd21f', ink: '#7a5a00' },
  friends: { acc: '#00a0dc', ink: '#006f99' },
  work: { acc: '#e5007d', ink: '#b30062' },
} as const;
const num = (i: number) => String(i + 1).padStart(2, '0');
const ideasWord = (n: number) => {
  const d = n % 10, h = n % 100;
  return d === 1 && h !== 11 ? 'идея' : d >= 2 && d <= 4 && (h < 12 || h > 14) ? 'идеи' : 'идей';
};
const seeAlso = [
  { href: '/fotopodarki', title: 'Фотоподарки', text: 'Ёлочные шары, подушки и другое с фото' },
  { href: '/pechat-na-kruzhkah', title: 'Печать на кружках', text: 'Фото, надписи, кружки-хамелеоны' },
  { href: '/pechat-na-futbolkah', title: 'Печать на футболках', text: 'Взрослые и детские, от 1 штуки' },
  { href: '/kalendari', title: 'Календари на 2027 год', text: 'Квартальные с логотипом, от 10 штук' },
  { href: '/korporativnym-klientam', title: 'Мерч для компаний', text: 'Счёт без НДС и закрывающие документы' },
  { href: '/stati', title: 'Все статьи', text: 'Идеи и советы мастерской' },
];
const b2bPoints = ['Счёт без НДС', 'Закрывающие документы', 'Макет по вашему брендбуку', 'Образец перед тиражом'];
---

<BaseLayout title={`${a.title} — Мастерская сувениров, Калининград`} description={a.description} path={slug} image={a.cover} schema={[articleLd, breadcrumbs(crumbs), faqPage(faq)]}>
  <article class="ng">
    <!-- festive night header: garland, snow, red ball with a family photo, Ded Moroz with the countdown -->
    <header class="ng-head">
      <span class="ny-snow" aria-hidden="true"></span>
      <NyGarland class="ng-garland" />
      <div class="wrap ng-head-in">
        <Breadcrumbs items={crumbs} />
        <div class="ng-head-grid">
          <div class="ng-head-text">
            <p class="ng-eyebrow mono">Статьи · {a.tag}</p>
            <h1>Что подарить на Новый год: {ideasCount} идей подарков <span class="ng-serif">с&nbsp;фото и&nbsp;логотипом</span></h1>
            <p class="ng-lead">
              Без носков с оленями и дежурных свечек. Собрали подарки, которые делают специально для человека, — с ценами, сроками и честными советами из
              мастерской.
            </p>
            <p class="ng-meta mono">
              <time datetime={a.published}>{ruDate(a.published)}</time> · {a.readMinutes} минут чтения
            </p>
          </div>
          <div class="ng-head-art" aria-hidden="true">
            <div class="ng-ball"><NyBall id="ngb" photo="/img/ny/ball-photo.webp" /></div>
            <span class="ng-hand">проверено<br />на родственниках!</span>
            <div class="ng-santa">
              <img src="/img/ny/ded-moroz-640.webp" srcset="/img/ny/ded-moroz-360.webp 360w, /img/ny/ded-moroz-640.webp 640w" sizes="(max-width: 760px) 46vw, 300px" alt="" width="640" height="640" />
              <span class="ng-sign">
                <span class="ng-sign-top">до Нового года</span>
                <b data-ny-days>—</b>
                <span data-ny-word>дней</span>
              </span>
            </div>
          </div>
        </div>
      </div>
      <svg class="ng-head-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V30C240 0 480 50 720 30s480-40 720-6v36z" /></svg>
    </header>

    <!-- intro: readable text column + "who are we gifting" contents card -->
    <section class="ng-intro" aria-labelledby="intro-h">
      <div class="wrap ng-intro-grid">
        <div class="ng-intro-text">
          <p class="ng-kicker mono">Вместо вступления</p>
          <h2 id="intro-h">{introTitle}</h2>
          {intro.map((p) => <p>{p}</p>)}
        </div>
        <nav class="ng-toc-card" aria-labelledby="toc-h">
          <p class="ng-toc-title" id="toc-h">Кому дарим</p>
          <ol>
            {
              groups.map((g, i) => (
                <li style={`--acc:${tone[g.id].acc};--acc-ink:${tone[g.id].ink}`}>
                  <a href={`#${g.id}`}>
                    <span class="ng-toc-n mono" aria-hidden="true">{num(i)}</span>
                    <span class="ng-toc-name">{g.label}</span>
                    <span class="ng-toc-count">
                      {g.ideas.length} {ideasWord(g.ideas.length)}
                    </span>
                    <svg class="ng-toc-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </section>

    <div class="ng-groups">
      <!-- compact section bar, sticks under the site header on tablets and desktops -->
      <nav class="ng-bar" aria-label="Разделы с идеями">
        <div class="wrap ng-bar-in">
          <span class="ng-bar-label mono">Кому дарим</span>
          <ul>
            {
              groups.map((g) => (
                <li style={`--acc:${tone[g.id].acc}`}>
                  <a href={`#${g.id}`} data-bar={g.id}>
                    {g.label} <span class="ng-bar-count">{g.ideas.length}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      {
        groups.map((g, i) => (
          <section class={`section ng-group${i % 2 ? ' ng-group-alt' : ''}`} id={g.id} aria-labelledby={`${g.id}-h`} style={`--acc:${tone[g.id].acc};--acc-ink:${tone[g.id].ink}`}>
            <div class="wrap">
              <header class="ng-gh">
                <span class="ng-gh-n" aria-hidden="true">{num(i)}</span>
                <div class="ng-gh-title">
                  <p class="ng-gh-eyebrow mono">
                    <span class="ng-gh-dot" aria-hidden="true" />
                    {g.label} · {g.ideas.length} {ideasWord(g.ideas.length)}
                  </p>
                  <h2 id={`${g.id}-h`}>
                    Подарки <span class="ng-mark">{g.title.replace(/^Подарки\s+/, '')}</span>
                  </h2>
                </div>
                <p class="ng-gh-intro">{g.intro}</p>
              </header>
              <PolaroidWall ideas={g.ideas} accent={tone[g.id].acc} />
              <aside class="ng-note" aria-label="Совет мастерской">
                <span class="ng-note-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
                    <path d="M9 18h6M10 22h4" />
                  </svg>
                </span>
                <div>
                  <p class="ng-note-label mono">Совет мастерской</p>
                  <p class="ng-note-text">{g.tip}</p>
                </div>
              </aside>
            </div>
          </section>
        ))
      }
    </div>

    <section class="section ng-tips" aria-labelledby="tips-h">
      <span class="ny-snow" aria-hidden="true"></span>
      <NyGarland class="ng-garland ng-garland-tips" />
      <div class="wrap">
        <div class="ng-tips-head">
          <p class="ng-kicker mono">{tips.length} правил от мастерской</p>
          <h2 id="tips-h">Как выбрать подарок, который <span class="ng-serif">не&nbsp;передарят</span></h2>
        </div>
        <ol class="ng-tips-list">
          {
            tips.map((t, i) => (
              <li>
                <span class="ng-tip-n mono" aria-hidden="true">{num(i)}</span>
                <h3>{t.title}</h3>
                <p>{t.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section ng-how" aria-labelledby="how-h">
      <div class="wrap">
        <div class="ng-sec-head">
          <p class="ng-kicker mono">4 шага</p>
          <h2 id="how-h">Как заказать подарок к Новому году</h2>
        </div>
        <ol class="ng-steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="ng-step-n mono" aria-hidden="true">{num(i)}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="ng-facts">
          <p class="ng-fact ng-fact-dark">
            <span class="ng-fact-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            </span>
            <span>{hoursNote}</span>
          </p>
          <p class="ng-fact">
            <span class="ng-fact-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M16 3v4M8 3v4M3 11h18" /></svg>
            </span>
            <span>
              <b>Совет:</b> в декабре заказов больше, чем обычно. Если нужен тираж для коллег или подарок к конкретной дате — напишите заранее, и мы спокойно
              всё успеем.
            </span>
          </p>
        </div>
      </div>
    </section>

    <section class="section ng-b2b" aria-labelledby="b2b-h">
      <div class="wrap">
        <div class="ng-b2b-card">
          <span class="ng-b2b-dots" aria-hidden="true"></span>
          <div class="ng-b2b-main">
            <p class="ng-kicker mono">Компаниям</p>
            <h2 id="b2b-h">Новогодние подарки сотрудникам и партнёрам</h2>
            <p>Соберём набор под ваш бюджет: кружки, футболки, календари, бейсболки и значки с логотипом.</p>
            <ul class="ng-b2b-list">
              {
                b2bPoints.map((t) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    {t}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="ng-b2b-actions">
            <button type="button" class="btn btn-yellow" data-order="Новогодние подарки для компании">Запросить расчёт</button>
            <a class="btn ng-btn-line" href="/kp-msuvenirov.pdf" download>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
              Скачать КП (PDF)
            </a>
            <a class="ng-b2b-link" href="/korporativnym-klientam">Условия для компаний <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section ng-outro" aria-labelledby="outro-h">
      <div class="wrap">
        <div class="ng-outro-card">
          <span class="ng-cmyk" aria-hidden="true"></span>
          <div class="ng-outro-l">
            <p class="ng-hand ng-hand-dark">С наступающим!</p>
            <h2 id="outro-h">Итого</h2>
          </div>
          <div class="ng-outro-r">
            <p>{outro}</p>
            <button type="button" class="btn btn-magenta" data-order="Новогодний подарок">Подобрать подарок</button>
          </div>
        </div>
      </div>
    </section>

    <FaqSection items={faq} title="Вопросы о новогодних подарках" />

    <section class="section ng-links" aria-labelledby="links-h">
      <div class="wrap">
        <div class="ng-sec-head">
          <p class="ng-kicker mono">Читайте и смотрите</p>
          <h2 id="links-h">Смотрите также</h2>
        </div>
        <ul>
          {
            seeAlso.map((l) => (
              <li>
                <a href={l.href}>
                  <span class="ng-link-t">{l.title}</span>
                  <span class="ng-link-d">{l.text}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>

  <CtaBand title="Не нашли подходящую идею?" text="Напишите, кому дарите и какой бюджет, — подскажем подарок и покажем макет." />
</BaseLayout>

<script>
  // Days to New Year on Ded Moroz's sign (visitor's clock)
  const daysEl = document.querySelector('[data-ny-days]');
  if (daysEl) {
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const d = Math.round((new Date(now.getFullYear() + 1, 0, 1).getTime() - today.getTime()) / 86400000);
    const a = d % 10, b = d % 100;
    daysEl.textContent = String(d);
    const w = document.querySelector('[data-ny-word]');
    if (w) w.textContent = a === 1 && b !== 11 ? 'день' : a >= 2 && a <= 4 && (b < 12 || b > 14) ? 'дня' : 'дней';
  }

  // Sticky section bar: highlight the group currently in view
  const barLinks = document.querySelectorAll<HTMLAnchorElement>('[data-bar]');
  if (barLinks.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          barLinks.forEach((l) => (l.dataset.bar === e.target.id ? l.setAttribute('aria-current', 'location') : l.removeAttribute('aria-current')));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    barLinks.forEach((l) => {
      const s = document.getElementById(l.dataset.bar!);
      if (s) io.observe(s);
    });
  }
</script>

<style>
  /* ---------- festive header */
  .ng {
    --candy: #d7262e;
    --candy-ink: #a3121a;
    --night: #0f1d27;
  }
  .ng-head {
    position: relative;
    overflow: clip;
    isolation: isolate;
    padding-block: clamp(48px, 4.6vw, 66px) clamp(50px, 6vw, 76px);
    color: #fffcf5;
    background:
      radial-gradient(50% 70% at 50% 0%, rgba(80, 150, 200, 0.18), transparent 70%),
      linear-gradient(180deg, var(--night) 0%, #142f3d 100%);
  }
  .ng-head :global(.ng-garland),
  .ng-tips :global(.ng-garland) {
    position: absolute;
    left: 0;
    top: -4px;
    width: 100%;
    height: clamp(46px, 4.4vw, 62px);
    z-index: 0;
  }
  .ng-head-in {
    position: relative;
    z-index: 1;
  }
  .ng-head :global(.crumbs a),
  .ng-head :global(.crumbs span),
  .ng-head :global(.crumbs li) {
    color: rgba(255, 252, 245, 0.75);
  }
  .ng-head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: 10px;
  }
  .ng-head-text {
    display: grid;
    gap: 14px;
  }
  .ng-eyebrow {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--y);
  }
  .ng-head h1 {
    font-size: clamp(1.9rem, 3.6vw, 3.1rem);
    line-height: 1.06;
    text-wrap: balance;
  }
  .ng-serif {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.1em;
    letter-spacing: 0;
    color: #ff8f94;
  }
  .ng-lead {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: 1.6;
    color: rgba(255, 252, 245, 0.85);
  }
  .ng-meta {
    margin: 0;
    font-size: 0.82rem;
    color: rgba(255, 252, 245, 0.6);
  }
  .ng-head-art {
    position: relative;
    aspect-ratio: 1 / 0.86;
    width: 100%;
    max-width: 440px;
    justify-self: end;
  }
  .ng-ball {
    position: absolute;
    left: 2%;
    top: -8%;
    width: 44%;
    transform: rotate(-12deg);
    transform-origin: 50% 0;
    filter: drop-shadow(0 20px 24px rgba(0, 0, 0, 0.45));
  }
  .ng-ball :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .ng-hand {
    margin: 0;
    font-family: 'Caveat', 'Segoe Print', cursive;
    font-weight: 600;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.05;
    color: var(--y);
  }
  .ng-head-art .ng-hand {
    position: absolute;
    left: -6%;
    bottom: 26%;
    transform: rotate(-7deg);
  }
  .ng-santa {
    position: absolute;
    right: 0;
    /* sit on the header's bottom edge, but high enough that the wave never covers the sign */
    bottom: calc(clamp(50px, 6vw, 76px) * -1 + clamp(22px, 3vw, 34px));
    width: 62%;
    container-type: inline-size;
  }
  .ng-santa img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* the blank sign in the picture: 13.5%–85% across, 56%–91.5% down */
  .ng-sign {
    position: absolute;
    left: 13.5%;
    width: 71.5%;
    top: 56%;
    height: 35.5%;
    display: grid;
    place-content: center;
    justify-items: center;
    line-height: 1;
    color: var(--candy-ink);
    font-variant-numeric: tabular-nums;
  }
  .ng-sign-top {
    font-family: 'Caveat', cursive;
    font-weight: 600;
    font-size: 6.6cqi;
    color: var(--ink-2);
  }
  .ng-sign b {
    font-size: 17cqi;
    font-weight: 900;
    letter-spacing: -0.03em;
  }
  .ng-sign [data-ny-word] {
    font-size: 5.4cqi;
    font-weight: 700;
  }
  .ng-head-wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(26px, 4vw, 54px);
    fill: var(--paper);
    z-index: 2;
  }


  /* ---------- shared editorial bits */
  .ng-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ng-kicker::before {
    content: '';
    width: 28px;
    height: 2px;
    background: currentColor;
  }
  .ng-sec-head {
    margin-bottom: clamp(26px, 3.4vw, 40px);
  }
  .ng-sec-head h2,
  .ng-tips-head h2 {
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    max-width: 22ch;
  }

  /* ---------- intro: text + contents card */
  .ng-intro {
    padding-block: clamp(40px, 5.5vw, 76px) clamp(28px, 4vw, 52px);
  }
  .ng-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    gap: clamp(28px, 6vw, 88px);
    align-items: start;
  }
  .ng-intro-text {
    max-width: 66ch;
  }
  .ng-intro-text h2 {
    margin-bottom: 18px;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
  }
  .ng-intro-text p:not(.ng-kicker) {
    margin: 0 0 16px;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--ink-2);
  }
  /* editorial drop cap */
  .ng-intro-text h2 + p::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-size: 3.5em;
    line-height: 0.82;
    color: var(--candy);
  }
  .ng-toc-card {
    position: relative;
    padding: 22px 22px 14px;
    border-radius: 26px;
    background: var(--card);
    border: 1.5px solid var(--line);
    box-shadow: var(--shadow);
  }
  .ng-toc-title {

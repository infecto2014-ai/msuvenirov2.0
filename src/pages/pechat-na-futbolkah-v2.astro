---
// VARIANT 2 for review (owner, 07.11.2026: «сделать ещё круче… сразу не заменяй старую»), built with ideas from
// the 21st.dev catalog and the ui-ux-pro-max skill. Not in the sitemap, noindex. Base: /pechat-na-futbolkah.
// «Печать на футболках» — own page (owner, 06.11.2026: «блоки выглядят однородно скучно»), built in the spirit of
// the home page and the gift article: bands of different grounds with waves, big outlined section numbers,
// marker words, photo cards and polaroids.
// Order of the top part is the owner's garment-page order (02.11.2026): first screen → calculator of this product →
// «С этим заказывают» → ready options → the blank («Изделие») → the rest.
// Texts — services.ts + garments.ts entries for '/pechat-na-futbolkah' (they stay for menus/sitemap);
// every price — src/data/pricing.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import ServiceBlocks from '@/components/ServiceBlocks.astro';
import TshirtCompare from '@/components/tshirt/TshirtCompare.astro';
import TshirtIdeas from '@/components/tshirt/TshirtIdeas.astro';
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import TeeHeroV2 from '@/components/tee2/TeeHeroV2.astro';
import InkMarquee from '@/components/tee2/InkMarquee.astro';
import PrintReveal from '@/components/tee2/PrintReveal.astro';
import TshirtHead from '@/components/tshirt/TshirtHead.astro';
import TshirtPackages from '@/components/tshirt/TshirtPackages.astro';
import TshirtDetails from '@/components/tshirt/TshirtDetails.astro';
import { garmentBySlug } from '@/data/garments';
import { reviews as allReviews } from '@/data/reviews';
import { services } from '@/data/services';
import { findCategory, findProduct } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const SLUG = '/pechat-na-futbolkah';
const page = services.find((s) => s.slug === SLUG)!;
const garment = garmentBySlug(SLUG)!;
const product = findProduct('textile', garment.productId)!;
const cat = findCategory(page.calcCategory)!;

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi' },
  { name: page.name, href: page.slug },
];
// same schema numbers as the generic service template
const allPrices = cat.products.map((p) => p.fromPrice);
const hasReviews = allReviews.some((r) => garment.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];

const compare = page.blocks.find((b) => b.kind === 'compare');
const ideas = page.blocks.find((b) => b.kind === 'ideas');
const otherBlocks = page.blocks.filter((b) => b.kind !== 'compare' && b.kind !== 'ideas');

---

<BaseLayout
  title={page.title}
  description={page.description}
  path="/pechat-na-futbolkah-v2"
  noindex
  image={page.image}
  schema={[
    breadcrumbs(crumbs),
    serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: Math.min(...allPrices), offerCount: cat.products.length }),
    faqPage(page.faq),
  ]}
>
  <TeeHeroV2 crumbs={crumbs} lead={page.lead} info={garment} from={product.fromPrice} />

  <InkMarquee items={['от 1 штуки', 'DTF-печать', 'белые и чёрные — в наличии', '50+ стирок', 'простой макет бесплатно', 'ТЦ «Экватор»', 'ежедневно 10–20']} />

  <!-- ============ 01 calculator (tinted band) ============ -->
  <div class="band band-tint">
    <section id="calc" class="section tcalc" aria-labelledby="calc-h">
      <div class="wrap">
        <TshirtHead num="01" eyebrow="Калькулятор" id="calc-h" title="Посчитайте свой вариант" mark="свой" tone="y">
          <p class="tcalc-sub">Выберите цвет, размеры принтов и количество — цена пересчитается сразу. Несколько принтов: самый дорогой по полной цене, следующий −30%, остальные −50%.</p>
        </TshirtHead>
        <div class="tcalc-box">
          <Calculator client:visible category="textile" product={garment.productId} hideCategories lockProduct />
        </div>
      </div>
      {garment.alsoOrder && <AlsoOrder slugs={garment.alsoOrder} />}
    </section>
  </div>

  <!-- ============ 02 before / after (paper) ============ -->
  <PrintReveal num="02" />

  <!-- ============ 03 ready options ============ -->
  <div class="band band-tint">
    <TshirtPackages info={garment} num="03" />
  </div>

  <InkMarquee tone="y" items={['футболка с фото', 'парные', 'для команды', 'имя и номер', 'свой рисунок', 'логотип компании']} />

  <!-- ============ 03 the blank (dark band) ============ -->
  <div class="band band-ink">
    <TshirtDetails info={garment} productName={product.name} num="04" />
  </div>

  <!-- ============ the rest: paper and tinted bands alternate, so neighbours never merge ============ -->
  {compare && <TshirtCompare block={compare} />}

  {
    ideas && (
      <div class="band band-tint">
        <TshirtIdeas block={ideas} />
      </div>
    )
  }

  {otherBlocks.length > 0 && <ServiceBlocks blocks={otherBlocks} />}

  <PortfolioGrid tags={page.portfolioTags} title="Примеры: печать на футболках" />

  {
    hasReviews && (
      <div class="band band-tint">
        <Reviews keywords={garment.reviewKeywords} title="Отзывы: печать на футболках" />
      </div>
    )
  }

  <FaqSection items={page.faq} title="Вопросы: печать на футболках" />

  {
    related.length > 0 && <TshirtRelated items={related} />
  }

  <CtaBand />
</BaseLayout>

<style>
  .tcalc {
    position: relative;
  }
  .tcalc-sub {
    max-width: 52ch;
  }
  @media (max-width: 760px) {
    .tcalc {
      padding-block: 28px 32px;
    }
    .tcalc-sub {
      display: none;
    }
  }
</style>

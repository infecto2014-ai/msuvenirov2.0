---
// «Печать на спортивной форме» — own page (like the workwear page): first screen, calculator (print on the customer's
// form, sublimation T-shirt, cotton T-shirt), ready options, team list → form, what we print, DTF or sublimation,
// audience, how to order, works, reviews, FAQ, SEO text. Content — src/data/sportPage.ts; prices — pricing.ts
// (category 'textile'); drawings — src/components/sport/SportArt.astro. Listed in the «Одежда» menu and in the sitemap.
import TshirtRelated from '@/components/tshirt/TshirtRelated.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Calculator from '@/components/islands/Calculator';
import AlsoOrder from '@/components/garment/AlsoOrder.astro';
import SportArt from '@/components/sport/SportArt.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { sportPage as page, buildSportFaq } from '@/data/sportPage';
import { services } from '@/data/services';
import { reviews } from '@/data/reviews';
import { defaultSelection, extraPrintFactor, findProduct, rub, type Selection } from '@/data/pricing';
import { breadcrumbs, faqPage, service as serviceLd } from '@/lib/schema';
import type { ServicePage } from '@/data/types';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Печать на одежде', href: '/pechat-na-odezhde' },
  { name: 'Спортивная форма', href: page.slug },
];

// ---- prices, all from pricing.ts
const quoteOf = (productId: string, qty: number, options: Selection['options']) => {
  const p = findProduct('textile', productId)!;
  const b = defaultSelection(p);
  return p.quote({ ...b, qty, options: { ...b.options, ...options } });
};
const own = findProduct('textile', 'own-item')!;
const sub = findProduct('textile', 'tshirt-sub')!;
const extraOff = Math.round((1 - extraPrintFactor[1]) * 100);
const lowest = quoteOf('own-item', own.qty.max, { print1: 'a6', print2: 'none', print3: 'none' }).unit;
const faq = buildSportFaq({
  a4: rub(quoteOf('own-item', 1, { print1: 'a4', print2: 'none', print3: 'none' }).unit),
  a6: rub(quoteOf('own-item', 1, { print1: 'a6', print2: 'none', print3: 'none' }).unit),
  extraOff,
  subMin: sub.qty.min,
});
const packages = page.packages.map((pk, i) => {
  const q = quoteOf(pk.product, pk.qty, pk.options);
  return { ...pk, unit: q.unit, total: q.total, own: pk.product === 'own-item', tone: ['c', 'm', 'y'][i % 3] };
});
const related = page.related.map((r) => services.find((s) => s.slug === r)).filter(Boolean) as ServicePage[];
const hasReviews = reviews.some((r) => page.reviewKeywords.some((k) => r.text.toLowerCase().includes(k)));
const tones = ['c', 'm', 'y'];
const teamColors = [
  { color: '#1f4fd1', trim: '#ffd21f' },
  { color: '#1f4fd1', trim: '#ffd21f' },
  { color: '#1f4fd1', trim: '#ffd21f' },
  { color: '#1f4fd1', trim: '#ffd21f' },
];
const placeArt = [
  { type: 'jersey', view: 'back', color: '#1f4fd1', trim: '#ffd21f', name: '' },
  { type: 'jersey', view: 'back', color: '#c8202a', trim: '#ffffff', name: 'КУЗНЕЦОВ' },
  { type: 'jersey', view: 'front', color: '#ffd21f', trim: '#16141b', name: '' },
  { type: 'shorts', view: 'front', color: '#16141b', trim: '#e5007d', name: '' },
] as const;
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.slug}
  image="/portfolio/sport-jersey.webp"
  schema={[breadcrumbs(crumbs), serviceLd({ name: page.h1, description: page.description, url: page.slug, lowPrice: lowest }), faqPage(faq)]}
>
  <!-- ============ first screen ============ -->
  <section class="shero">
    <div class="wrap shero-grid">
      <div class="shero-text">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow shero-eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.lead}</p>
        <ul class="shero-chips">
          {page.highlights.map((h) => <li><Icon name="check" size={18} /> {h}</li>)}
        </ul>
        <div class="shero-actions">
          <a class="btn btn-magenta" href="#calc"><Icon name="calc" size={20} /> <span>Рассчитать<span class="long"> форму</span></span></a>
          <button type="button" class="btn btn-ghost" data-order="Спортивная форма — номера и фамилии по списку">Отправить список</button>
        </div>
      </div>
      <div class="shero-media" role="img" aria-label={page.heroAlt}>
        <span class="shero-dot shero-dot-c" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-m" aria-hidden="true"></span>
        <span class="shero-dot shero-dot-y" aria-hidden="true"></span>
        <div class="shero-wall halftone" aria-hidden="true">
          <div class="shero-stage">
            <SportArt type="tank" color="#e5007d" trim="#ffffff" number={23} name="ПЕТРОВ" scale={1.05} class="shero-sp shero-tank" />
            <SportArt type="shorts" view="front" color="#16141b" trim="#ffd21f" number={7} scale={1} class="shero-sp shero-shorts" />
            <SportArt type="jersey" color="#1f4fd1" trim="#ffd21f" number={10} name="ИВАНОВ" scale={1.6} class="shero-sp shero-jersey" />
          </div>
        </div>
        <span class="sticker shero-price">
          от <span class="mono">{rub(lowest)}</span><small>за принт</small>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ calculator ============ -->
  <div class="band band-tint">
  <section id="calc" class="section calc-sec" aria-labelledby="calc-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">01</span>
          <p class="eyebrow">Калькулятор</p>
          <h2 id="calc-h">Посчитайте <span class="mark sec-mark">форму</span></h2>
        </div>
        <p class="calc-sub">Печать на вашей форме или наши футболки с печатью: номер с фамилией на спину, эмблема на грудь, количество — цена пересчитается сразу.</p>
      </div>
      <Calculator client:visible category="textile" product="own-item" products={['own-item', 'tshirt-sub', 'tshirt-unisex']} hideCategories />
    </div>
    <AlsoOrder slugs={page.alsoOrder} />
  </section>
  </div>

  <!-- ============ ready options ============ -->
  <div class="band">
  <section class="section spk" aria-labelledby="spk-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-m">
          <span class="sec-num mono" aria-hidden="true">02</span>
          <p class="eyebrow">Популярное</p>
          <h2 id="spk-h">Готовые варианты с <span class="mark sec-mark">ценой</span></h2>
        </div>
        <p class="spk-sub">Макет с фамилиями и номерами включён. На вашей форме — цена только за печать, на наших футболках — вместе с футболкой.</p>
      </div>
      <ul class="spk-grid">
        {
          packages.map((it) => (
            <li class={`spk-card spk-${it.tone}`}>
              <div class="spk-art" aria-hidden="true">
                <SportArt type={it.art.type} view={it.art.view} color={it.art.color} trim={it.art.trim} number={it.art.number} name={it.art.name} scale={1} />
                <span class="spk-qty mono">{it.qty} шт</span>
                <span class="spk-tech mono">{it.own ? 'ваша форма' : it.product === 'tshirt-sub' ? 'сублимация' : 'наша футболка'}</span>
              </div>
              <div class="spk-body">
                <h3>{it.title}</h3>
                <p class="spk-note">{it.note}</p>
                <p class="spk-price mono">
                  {rub(it.total)}
                  <small>{rub(it.unit)} / шт</small>
                </p>
                <button type="button" class="btn btn-sm btn-magenta" data-order={`${it.title}, ${it.qty} шт — ${rub(it.total)}`}>
                  Заказать
                </button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ team list → form ============ -->
  <div class="band band-tint">
  <section class="section rst" aria-labelledby="rst-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-c">
          <span class="sec-num mono" aria-hidden="true">03</span>
          <p class="eyebrow">Фамилии и номера</p>
          <h2 id="rst-h">Пришлите список — напечатаем каждому <span class="mark sec-mark">своё</span></h2>
        </div>
        <p>Фамилия, номер и размер для каждого игрока — таблицей или просто сообщением. Подготовим макет на всю команду и ничего не перепутаем.</p>
      </div>
      <div class="rst-grid">
        <div class="rst-list">
          <table>
            <caption>Список команды</caption>
            <thead>
              <tr><th scope="col">Фамилия</th><th scope="col">Номер</th><th scope="col">Размер</th></tr>
            </thead>
            <tbody>
              {page.roster.map((r) => (
                <tr><td>{r.name}</td><td class="mono">{r.number}</td><td class="mono">{r.size}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <span class="rst-arrow" aria-hidden="true">→</span>
        <ul class="rst-team" aria-label="Форма команды с фамилиями и номерами из списка">
          {page.roster.map((r, i) => (
            <li><SportArt type="jersey" color={teamColors[i].color} trim={teamColors[i].trim} number={r.number} name={r.name} scale={0.7} /></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ what we print ============ -->
  <div class="band">
  <section class="section plc" aria-labelledby="plc-h">
    <div class="wrap">
      <div class="section-head">
        <div class="sec-titled sec-y">
          <span class="sec-num mono" aria-hidden="true">04</span>
          <p class="eyebrow">Что наносим</p>
          <h2 id="plc-h">Номер, фамилия, <span class="mark sec-mark">эмблема</span></h2>
        </div>
        <p>До трёх принтов на одной вещи. Второй принт стоит на {extraOff}% дешевле первого, третий — вдвое дешевле.</p>
      </div>
      <ul class="plc-grid plc-grid-4">
        {page.places.map((p, i) => {
          const a = placeArt[i];
          return (
            <li class={`plc-card plc-${tones[i % 3]}`}>
              <div class="plc-art" aria-hidden="true">
                <SportArt type={a.type} view={a.view} color={a.color} trim={a.trim} number={i === 3 ? 7 : 9} name={a.name} zones scale={1} />
                <span class="plc-num mono">{p.n}</span>
              </div>
              <div class="plc-body">
                <span class="plc-tag mono">{p.tag}</span>
                <h3>{p.title}</h3>
                <p class="plc-size"><Icon name="check" size={16} /> {p.size}</p>
                <p>{p.text}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ DTF or sublimation ============ -->
  <div class="band band-tint">
  <section class="section ways" aria-labelledby="ways-h">
    <div class="wrap">
      <p class="eyebrow">Технология</p>
      <h2 id="ways-h" class="ways-title">DTF-печать или сублимация</h2>
      <div class="ways-grid">
        {
          page.tech.map((w, i) => (
            <article class={`ways-card ways-${i ? 'ink' : 'y'}`}>
              <span class="ways-tag mono">{w.tag}</span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
              <ul>
                {w.points.map((x) => <li><Icon name="check" size={16} /> {x}</li>)}
              </ul>
              {i === 0 ? (
                <a class="btn btn-sm btn-magenta" href="#calc">Рассчитать печать</a>
              ) : (
                <a class="btn btn-sm ways-btn" href="/sublimacionnaya-pechat">Про сублимацию</a>
              )}
            </article>
          ))
        }
      </div>
      <details class="ways-care" open data-fold>
        <summary><h3>Уход за формой с номерами</h3></summary>
        <ul>
          {page.care.map((t) => <li>{t}</li>)}
        </ul>
      </details>
    </div>
  </section>
  </div>

  <!-- ============ for whom ============ -->
  <div class="band">
  <section class="section aud" aria-labelledby="aud-h">
    <div class="wrap">
      <p class="eyebrow">Для кого</p>
      <h2 id="aud-h" class="aud-title">Кому делаем спортивную форму</h2>
      <ul class="aud-grid">
        {
          page.audience.map((a, i) => (
            <li class={`aud-card kinds-${tones[i % 3]}`}>
              <span class="aud-tag mono">{a.tag}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="aud-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <!-- ============ how to order ============ -->
  <div class="band band-tint">
  <section class="section how" aria-labelledby="how-h">
    <div class="wrap how-grid">
      <div>
        <p class="eyebrow">Заказ</p>
        <h2 id="how-h">Как заказать печать на <span class="mark">форме</span></h2>
        <ol class="how-steps">
          {
            page.steps.map((s, i) => (
              <li>
                <span class="how-dot mono">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <aside class="how-side">
        <details class="how-card" open data-fold>
          <summary><h3>{page.layout.title}</h3></summary>
          <ul class="how-list">
            {page.layout.items.map((t) => <li>{t}</li>)}
          </ul>
          <a class="how-more" href="/trebovaniya-k-maketam">Требования к макетам →</a>
        </details>
        <div class="how-b2b">
          <h3>{page.b2b.title}</h3>
          <ul class="how-chips">
            {page.b2b.items.map((t) => <li><Icon name="check" size={16} /> {t}</li>)}
          </ul>
          <button type="button" class="btn btn-sm how-b2b-btn" data-order="Спортивная форма для команды — рассчитать комплект">Рассчитать партию</button>
          <a class="how-more" href="/korporativnym-klientam">Корпоративным клиентам →</a>
        </div>
      </aside>
    </div>
  </section>
  </div>

  <script is:inline>
    // folding cards are always open on a computer; on a phone they start folded (tap to open), as on the shoppers page
    (function () {
      var m = matchMedia('(max-width: 760px)');
      document.querySelectorAll('[data-fold]').forEach(function (d) {
        if (m.matches) d.open = false;
        d.querySelector('summary').addEventListener('click', function (e) {
          if (!m.matches) e.preventDefault();
        });
        m.addEventListener('change', function (e) {
          d.open = !e.matches;
        });
      });
    })();
  </script>

  <div class="band">
  <PortfolioGrid tags={page.portfolioTags} limit={4} title="Примеры: форма и футболки" />
  </div>

  <div class="band band-tint">
  <Reviews keywords={hasReviews ? page.reviewKeywords : undefined} title={hasReviews ? 'Отзывы о форме' : 'Что говорят клиенты'} />
  </div>

  <div class="band">
  <FaqSection items={faq} title="Вопросы о печати на спортивной форме" />
  </div>

  <!-- ============ SEO text (folded on phones) ============ -->
  <div class="band band-tint">
  <section class="section seo-text" aria-labelledby="seo-h">
    <div class="wrap">
      <h2 id="seo-h">{page.seo.title}</h2>
      <input type="checkbox" id="seo-more" class="seo-toggle" />
      <div class="seo-cols">
        {
          page.seo.sections.map((s) => (
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          ))
        }
        <div>
          <h3>Смотрите также</h3>
          <p>
            <a href="/pechat-na-odezhde">печать на одежде</a> · <a href="/pechat-na-futbolkah">печать на футболках</a> · <a href="/pechat-na-hudi">худи</a> ·
            <a href="/sublimacionnaya-pechat">сублимационная печать</a> · <a href="/pechat-na-specodezhde">спецодежда</a> · <a href="/znachki">значки</a> ·
            <a href="/trebovaniya-k-maketam">требования к макетам</a> · <a href="/price">все цены</a>
          </p>
        </div>
      </div>
      <label for="seo-more" class="seo-more-btn">Читать полностью</label>
    </div>
  </section>
  </div>

  <div class="band">
  {related.length > 0 && <TshirtRelated items={related} />}
  </div>



  <CtaBand title="Готовите форму к сезону или турниру?" text="Пришлите список игроков и эмблему — подготовим макет с фамилиями и номерами и посчитаем комплект." />
</BaseLayout>

<style>
  /* data-restyled: bands, numbered headings, hangers — like /pechat-na-futbolkah (owner, 07.11.2026) */
  /* ================= first screen ================= */
  .shero {
    padding-block: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 40px);
    overflow: clip;
  }
  .shero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .shero-text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .shero-eyebrow {
    margin: 0 0 -8px;
  }
  .shero-text h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }
  .shero-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .shero-chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .shero-chips :global(svg) {
    color: var(--m-ink);
  }
  .shero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .shero-media {
    position: relative;
    padding: 24px;
  }
  /* a wall: three caps on it; the stage is drawn at a fixed size and zoomed with the column */
  .shero-wall {
    position: relative;
    z-index: 1;
    aspect-ratio: 1;
    border-radius: 40px 40px 120px 40px;
    background-color: var(--paper-2);
    --dot: rgba(22, 20, 27, 0.1);
    overflow: clip;
  }
  .shero-stage {
    --hz: 1;
    zoom: var(--hz);
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 440px;
    margin: -220px 0 0 -220px;
    z-index: 1;
  }
  .shero-price {
    position: absolute;
    right: 0;
    bottom: 40px;
    z-index: 3;
    display: grid;
    font-size: 1.25rem;
    text-align: center;
  }
  .shero-price small {
    font-size: 0.72rem;
    font-weight: 700;
  }
  .shero-dot {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: multiply;
    z-index: 0;
  }
  .shero-dot-c {
    width: 120px;
    height: 120px;
    background: var(--c);
    top: -6px;
    right: -10px;
  }
  .shero-dot-m {
    width: 80px;
    height: 80px;
    background: var(--m);
    bottom: 10px;
    left: 70px;
    opacity: 0.8;
  }
  .shero-dot-y {
    width: 110px;
    height: 110px;
    background: var(--y);
    top: 40%;
    left: 0;
  }
  .calc-sec {
    background: var(--paper-2);
    border-radius: 48px;
    margin-inline: clamp(0px, 1.5vw, 20px);
  }



  /* form on the wall */
  .shero-stage :global(.shero-sp) {
    position: absolute;
    filter: drop-shadow(0 14px 16px rgba(22, 20, 27, 0.18));
  }
  .shero-stage :global(.shero-tank) {
    left: -6px;
    top: 10px;
    transform: rotate(-7deg);
  }
  .shero-stage :global(.shero-shorts) {
    right: -10px;
    top: 30px;
    transform: rotate(6deg);
  }
  .shero-stage :global(.shero-jersey) {
    left: 72px;
    top: 96px;
    z-index: 2;
  }
  .shero-swatches {
    display: none;
  }

  .spk-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }
  .spk-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .spk-card:hover {
    transform: translateY(-3px);
    box-shadow: 5px 5px 0 var(--tone);
  }
  .spk-c { --tone: var(--c); --soft: var(--c-soft); }
  .spk-m { --tone: var(--m); --soft: var(--m-soft); }
  .spk-y { --tone: var(--y); --soft: var(--y-soft); }
  /* the cap sits in a coloured frame with halftone dots */
  .spk-art {
    position: relative;
    height: 250px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: clip;
    background:
      radial-gradient(circle, rgba(22, 20, 27, 0.09) 1.3px, transparent 1.5px) 0 0 / 14px 14px,
      var(--soft);
  }
  .spk-art :global(svg) {
    flex: none;
    max-width: 78%;
    height: auto;
    filter: drop-shadow(0 10px 12px rgba(22, 20, 27, 0.16));
  }
  .spk-qty,
  .spk-tech {
    position: absolute;
    z-index: 1;
    top: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .spk-qty {
    right: 12px;
    background: var(--ink);
    color: var(--paper);
  }
  .spk-tech {
    left: 12px;
    background: var(--card);
  }
  .spk-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 14px 16px 18px;
  }
  .spk-body h3 {
    font-size: 1.05rem;
  }
  .spk-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .spk-price {
    margin: auto 0 10px;
    padding-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .spk-price small {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0;
  }
  @media (max-width: 1180px) {
    .spk-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* phone: a carousel of compact cards, like on the mugs and calendars pages */
  @media (max-width: 760px) {
    .spk {
      padding-block: 32px;
    }
    .spk .section-head {
      margin-bottom: 14px;
      gap: 6px;
    }
    .spk .section-head .eyebrow {
      margin-bottom: 6px;
    }
    .spk-sub {
      display: none;
    }
    .spk-grid {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 8px;
      scrollbar-width: none;
    }
    .spk-grid::-webkit-scrollbar {
      display: none;
    }
    .spk-card {
      flex: 0 0 min(210px, 60%);
      scroll-snap-align: start;
      border-radius: 22px;
    }
    .spk-art {
      height: 150px;
    }
    .spk-art :global(svg) {
      zoom: 0.62;
    }
    .spk-qty,
    .spk-tech {
      top: 8px;
      padding: 3px 8px;
      font-size: 0.68rem;
    }
    .spk-qty {
      right: 8px;
    }
    .spk-tech {
      left: 8px;
    }
    .spk-body {
      gap: 2px;
      padding: 10px 12px 12px;
    }
    .spk-body h3 {
      font-size: 0.95rem;
    }
    .spk-note {
      font-size: 0.78rem;
      line-height: 1.35;
    }
    .spk-price {
      margin-bottom: 8px;
      padding-top: 8px;
      gap: 4px;
      font-size: 1.1rem;
    }
    .spk-price small {
      font-size: 0.72rem;
    }
    .spk-body .btn {
      min-height: 38px;
      padding: 0 16px;
      font-size: 0.85rem;
    }
  }

  .kinds-c { --tone: var(--c); --soft: var(--c-soft); }
  .kinds-m { --tone: var(--m); --soft: var(--m-soft); }
  .kinds-y { --tone: var(--y); --soft: var(--y-soft); }
  /* ================= team list → form ================= */
  .rst-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) auto minmax(0, 1.1fr);
    gap: 18px;
    align-items: center;
  }
  .rst-list {
    margin: 0;
    padding: 18px;
    border-radius: 28px 28px 28px 8px;
    background: var(--card);
    border: 1.5px solid var(--line);
    box-shadow: 6px 6px 0 var(--y);
    transform: rotate(-1.5deg);
  }
  .rst-list table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .rst-list caption {
    caption-side: top;
    text-align: left;
    padding-bottom: 8px;
    font-weight: 800;
  }
  .rst-list th,
  .rst-list td {
    padding: 8px 10px;
    border-bottom: 1px dashed var(--line);
    text-align: left;
  }
  .rst-list thead th {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .rst-list tbody tr:last-child td {
    border-bottom: 0;
  }
  .rst-list td:nth-child(2) {
    font-weight: 800;
  }
  .rst-arrow {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--m);
    color: #fff;
    font-size: 1.6rem;
    font-weight: 800;
  }
  .rst-team {
    list-style: none;
    margin: 0;
    padding: 18px 10px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
    border-radius: 34px;
    background:
      radial-gradient(circle, rgba(22, 20, 27, 0.08) 1.3px, transparent 1.5px) 0 0 / 14px 14px,
      var(--c-soft);
  }
  .rst-team :global(svg) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 8px rgba(22, 20, 27, 0.16));
  }
  .rst-team li:nth-child(even) {
    transform: translateY(14px);
  }
  .rst-note {
    margin: 14px 0 0;
    font-weight: 600;
    color: var(--ink-2);
  }
  /* ================= own or sourced ================= */
  .ways-title {
    margin-bottom: 24px;
  }
  .ways-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .ways-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px;
    border-radius: 34px 34px 34px 10px;
  }
  .ways-y {
    background: var(--y-soft);
  }
  .ways-ink {
    background: var(--ink);
    color: var(--paper);
  }
  .ways-ink h3 {
    color: var(--paper);
  }
  .ways-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    font-size: 0.74rem;
    font-weight: 700;
  }
  .ways-ink .ways-tag {
    background: var(--y);
  }
  .ways-card h3 {
    font-size: 1.4rem;
  }
  .ways-card p {
    margin: 0;
    font-size: 0.95rem;
  }
  .ways-y p {
    color: var(--ink-2);
  }
  .ways-ink p {
    color: rgba(255, 252, 245, 0.8);
  }
  .ways-card ul {
    list-style: none;
    margin: 0 0 6px;
    padding: 0;
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .ways-card li {
    display: flex;
    gap: 6px;
    align-items: flex-start;
  }
  .ways-card li :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--m-ink);
  }
  .ways-ink li :global(svg) {
    color: var(--y);
  }
  .ways-card .btn {
    margin-top: auto;
  }
  .ways-btn {
    background: var(--y);
    color: var(--ink);
    border-color: var(--y);
  }
  .ways-care {
    margin-top: 16px;
    padding: 16px 20px;
    border-radius: 24px;
    background: var(--card);
    border: 1.5px solid var(--line);
  }
  .ways-care summary {
    list-style: none;
    cursor: default;
  }
  .ways-care summary::-webkit-details-marker {
    display: none;
  }
  .ways-care h3 {
    font-size: 1.05rem;
  }
  .ways-care ul {
    margin: 8px 0 0;
    padding-left: 18px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 24px;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .ways-care li::marker {
    color: var(--m);
  }

  /* ================= where we print ================= */
  .plc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .plc-c { --tone: var(--c); --soft: var(--c-soft); }
  .plc-m { --tone: var(--m); --soft: var(--m-soft); }
  .plc-y { --tone: var(--y); --soft: var(--y-soft); }
  .plc-grid-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 1180px) {
    .plc-grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* three places: picture on top, text below */
  .plc-card {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
    align-items: start;
    border-radius: 34px 34px 34px 10px;
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
  }
  .plc-art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 18px 10px;
    background:
      radial-gradient(circle, rgba(22, 20, 27, 0.08) 1.3px, transparent 1.5px) 0 0 / 14px 14px,
      var(--soft);
  }
  .plc-art :global(svg) {
    filter: drop-shadow(0 12px 12px rgba(22, 20, 27, 0.18));
  }
  .plc-num {
    position: absolute;
    left: 14px;
    top: 14px;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-weight: 800;
    font-size: 1.1rem;
    box-shadow: 3px 3px 0 var(--tone);
  }
  .plc-body {
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 20px 22px;
  }
  .plc-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--tone);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .plc-y .plc-tag {
    background: var(--y);
    color: var(--ink);
  }
  .plc-m .plc-tag {
    color: #fff;
  }
  .plc-body h3 {
    font-size: 1.4rem;
  }
  .plc-size {
    margin: 0;
    display: flex;
    gap: 6px;
    align-items: flex-start;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .plc-size :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--m-ink);
  }
  .plc-body p:not(.plc-size) {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  /* ================= audience ================= */
  .aud-title {
    margin-bottom: 28px;
    max-width: 820px;
  }
  .aud-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .aud-card {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 8px;
    padding: 22px 22px 56px;
    border-radius: 26px 26px 26px 8px;
    background: var(--soft);
    overflow: clip;
  }
  .aud-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .aud-card h3 {
    font-size: 1.2rem;
  }
  .aud-card p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .aud-num {
    position: absolute;
    right: 16px;
    bottom: -14px;
    font-size: 4rem;
    font-weight: 800;
    color: var(--tone);
    opacity: 0.5;
    line-height: 1;
  }

  /* ================= how to order ================= */
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .how-grid h2 {
    margin-bottom: 26px;
  }
  .how-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .how-steps li {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding-bottom: 22px;
  }
  .how-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 48px;
    bottom: 4px;
    border-left: 2px dashed var(--line-strong);
  }
  .how-dot {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--card);
    font-weight: 700;
  }
  .how-steps li:nth-child(3n + 1) .how-dot { box-shadow: 3px 3px 0 var(--c); }
  .how-steps li:nth-child(3n + 2) .how-dot { box-shadow: 3px 3px 0 var(--m); }
  .how-steps li:nth-child(3n + 3) .how-dot { box-shadow: 3px 3px 0 var(--y); }
  .how-steps h3 {
    margin: 10px 0 4px;
    font-size: 1.1rem;
  }
  .how-steps p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .how-side {
    display: grid;
    gap: 14px;
  }
  .how-card,
  .how-b2b {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 22px;
    border-radius: var(--radius-l);
  }
  .how-card li {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .how-card {
    background: var(--y-soft);
  }
  .how-card summary {
    list-style: none;
    cursor: default;
  }
  .how-card summary::-webkit-details-marker {
    display: none;
  }
  .how-list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .how-list li::marker {
    color: var(--m);
  }
  .how-more {
    font-weight: 700;
    color: var(--m-ink);
  }
  .how-b2b {
    background: var(--ink);
    color: var(--paper);
  }
  .how-b2b h3 {
    color: var(--paper);
  }
  .how-b2b .how-more {
    color: var(--y);
  }
  .how-b2b-btn {
    background: var(--y);
    color: var(--ink);
    border-color: var(--y);
  }
  .how-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .how-chips li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 252, 245, 0.25);
    font-size: 0.84rem;
    font-weight: 600;
  }
  .how-chips :global(svg) {
    color: var(--y);
  }

  /* ================= seo text ================= */
  .seo-text h2 {
    margin-bottom: 24px;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .seo-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 48px;
  }
  .seo-cols h3 {
    margin-bottom: 8px;
    font-size: 1.1rem;
  }
  .seo-cols p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.96rem;
    line-height: 1.6;
  }
  .seo-toggle,
  .seo-more-btn {
    display: none;
  }

  /* ================= related ================= */
  .related-h {
    margin-bottom: 24px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .related-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 18px 10px 10px;
    border-radius: 24px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .related-card img {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    object-fit: cover;
  }
  .related-card span {
    flex: 1;
  }
  .related-card:hover {
    border-color: var(--ink);
    box-shadow: 4px 4px 0 var(--y);
    color: var(--ink);
  }

  /* ================= tablets ================= */
  @media (max-width: 1180px) {
    .aud-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shero-stage {
      --hz: 0.85;
    }
    .plc-card {
      grid-template-columns: 1fr;
    }
    .rst-grid {
      grid-template-columns: 1fr;
    }
    .rst-arrow {
      transform: rotate(90deg);
    }
  }
  @media (max-width: 960px) {
    .how-grid,
    .ways-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .shero-grid {
      grid-template-columns: 1fr;
    }
    .shero-media {
      max-width: 400px;
      justify-self: center;
      padding: 12px;
    }
    .shero-stage {
      --hz: 0.82;
    }
  }

  /* ================= phones (≤ 760px): compact, desktop untouched ================= */
  @media (max-width: 760px) {
    .shero {
      padding-block: 14px 22px;
    }
    .shero-grid {
      grid-template-columns: minmax(0, 1fr) 118px;
      gap: 12px 14px;
      align-items: start;
    }
    .shero-text {
      display: contents;
    }
    .shero-text > :global(.crumbs),
    .shero-text h1,
    .shero-chips,
    .shero-actions {
      grid-column: 1 / -1;
    }
    .shero-eyebrow {
      display: none;
    }
    .shero-text > :global(.crumbs) {
      order: 1;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .shero-text > :global(.crumbs) :global(ol) {
      flex-wrap: nowrap;
      white-space: nowrap;
      font-size: 0.78rem;
    }
    .shero-text h1 {
      order: 2;
      font-size: clamp(1.7rem, 7.6vw, 2.1rem);
    }
    .lead {
      order: 3;
      grid-column: 1;
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.45;
    }
    .shero-media {
      order: 4;
      grid-column: 2;
      grid-row: 3;
      max-width: none;
      justify-self: stretch;
      padding: 0 0 12px;
    }
    .shero-wall {
      aspect-ratio: 3 / 4.6;
      border-radius: 20px 20px 48px 20px;
    }
    /* phone: only the black cap and the colour row */
    .shero-stage {
      --hz: 1;
      zoom: 1;
      inset: 0;
      width: auto;
      height: auto;
      margin: 0;
    }
    .shero-stage :global(.shero-tank),
    .shero-stage :global(.shero-shorts) {
      display: none;
    }
    .shero-stage :global(.shero-jersey) {
      left: -8%;
      top: 4%;
      width: 116%;
      height: auto;
      filter: drop-shadow(0 6px 8px rgba(22, 20, 27, 0.2));
    }
    .shero-swatches {
      bottom: 34px;
      gap: 3px;
      padding: 4px 5px;
    }
    .shero-swatches li {
      width: 9px;
      height: 9px;
      border-radius: 3px;
    }
    .shero-dot {
      display: none;
    }
    .shero-price {
      right: -4px;
      bottom: 0;
      padding: 4px 8px;
      border-radius: 10px;
      font-size: 0.76rem;
      line-height: 1.15;
    }
    .shero-price small {
      font-size: 0.6rem;
    }
    .shero-price::before {
      display: none;
    }
    .shero-chips {
      order: 5;
      flex-wrap: nowrap;
      gap: 6px;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .shero-chips::-webkit-scrollbar,
    .shero-text > :global(.crumbs)::-webkit-scrollbar {
      display: none;
    }
    .shero-chips li {
      flex: none;
      gap: 4px;
      padding: 5px 10px;
      font-size: 0.8rem;
      white-space: nowrap;
    }
    .shero-chips :global(svg) {
      width: 14px;
      height: 14px;
    }
    .shero-actions {
      order: 6;
      flex-wrap: nowrap;
      gap: 8px;
    }
    .shero-actions .btn {
      flex: 1 1 0;
      min-height: 46px;
      padding: 0 12px;
      gap: 6px;
      font-size: 0.92rem;
      white-space: nowrap;
    }

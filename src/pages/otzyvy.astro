---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InkHero from '@/components/ink/InkHero.astro';
import Reviews from '@/components/Reviews.astro';
import CtaBand from '@/components/CtaBand.astro';
import { reviews } from '@/data/reviews';
import { breadcrumbs } from '@/lib/schema';
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Отзывы', href: '/otzyvy' },
];
---

<BaseLayout
  title="Отзывы клиентов — Мастерская сувениров, Калининград"
  description="Отзывы о печати на футболках, кружках и сувенирах в Мастерской сувениров. Отзывы собраны на Авито, Яндекс Картах, 2ГИС и других площадках."
  path="/otzyvy"
  schema={[breadcrumbs(crumbs)]}
>
  <InkHero
    crumbs={crumbs}
    h1="Отзывы клиентов"
    mark="клиентов"
    lead="Настоящие отзывы с Авито, Яндекс Карт и 2ГИС — с площадкой и датой."
    facts={[
      { big: String(reviews.length), small: 'отзывов на этой странице' },
      { big: '3', small: 'площадки: Авито, Яндекс Карты, 2ГИС' },
    ]}
  />
  <div class="band band-tint">
    <Reviews limit={reviews.length} more={false} scroll={false} />
  </div>
  <div class="band">
    <CtaBand title="Заказывали у нас?" text="Будем благодарны за отзыв на Яндекс Картах, 2ГИС или Авито — это помогает другим найти мастерскую." />
  </div>
</BaseLayout>

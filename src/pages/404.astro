---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена — Мастерская сувениров" description="Такой страницы нет. Перейдите на главную или в каталог услуг." noindex path="/404">
  <section class="wrap nf">
    <p class="nf-code mono misreg" aria-hidden="true">404</p>
    <h1>Эта страница не напечаталась</h1>
    <p class="lead">Возможно, ссылка устарела. Посмотрите услуги или посчитайте цену в калькуляторе.</p>
    <div class="nf-actions">
      <a class="btn" href="/">На главную</a>
      <a class="btn btn-ghost" href="/uslugi">Все услуги</a>
      <a class="btn btn-ghost" href="/price">Калькулятор</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding-block: clamp(48px, 8vw, 120px);
  }
  .nf-code {
    font-size: clamp(5rem, 18vw, 12rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>

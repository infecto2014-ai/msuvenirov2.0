---
import ContentPageView from '@/components/ContentPageView.astro';
import PortfolioGrid from '@/components/PortfolioGrid.astro';
import Reviews from '@/components/Reviews.astro';
import { aboutPage } from '@/data/pages';
import { site } from '@/data/site';
const facts = [
  { big: String(site.founded), small: 'год открытия мастерской' },
  { big: '10+', small: 'лет опыта в печати' },
  { big: '1 шт', small: 'минимальный заказ на большинство изделий' },
  { big: '7 дней', small: 'в неделю, 10:00–20:00' },
];
---

<ContentPageView page={aboutPage} path="/o-nas" crumb="О нас" mark="Мастерской сувениров" facts={facts}>
  <Fragment slot="after">
    <div class="band band-ink">
      <PortfolioGrid />
    </div>
    <div class="band">
      <Reviews limit={3} />
    </div>
  </Fragment>
</ContentPageView>

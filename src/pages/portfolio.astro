---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InkHero from '@/components/ink/InkHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { portfolio } from '@/data/portfolio';
import { breadcrumbs } from '@/lib/schema';

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Работы', href: '/portfolio' },
];
const tagNames: Record<string, string> = {
  futbolki: 'Футболки',
  hudi: 'Худи',
  shoppery: 'Шопперы',
  kepki: 'Бейсболки',
  kruzhki: 'Кружки',
  znachki: 'Значки',
  breloki: 'Брелоки',
  magnity: 'Магниты',
  nakleyki: 'Наклейки',
  poligrafiya: 'Полиграфия',
  kalendari: 'Календари',
  korporativ: 'Для компаний',
  podarki: 'Подарки',
  sport: 'Спорт',
  svadba: 'Свадьба',
  fandom: 'Фандомы',
};
const used = Object.keys(tagNames).filter((t) => portfolio.some((p) => p.tags.includes(t)));
---

<BaseLayout
  title="Портфолио: примеры печати на футболках и сувенирах | Мастерская сувениров"
  description="Примеры наших работ: футболки, худи, кружки, значки, магниты и подарки с печатью. Корпоративные заказы и подарки от 1 шт. Калининград."
  path="/portfolio"
  schema={[breadcrumbs(crumbs)]}
>
  <InkHero
    crumbs={crumbs}
    h1="Наши работы"
    mark="работы"
    lead={`${portfolio.length} примеров печати — от одной футболки в подарок до партий мерча для компаний.`}
    facts={[
      { big: String(portfolio.length), small: 'примеров печати' },
      { big: '1 шт', small: 'минимальный заказ на большинство изделий' },
    ]}
  >
    <a class="ib ib-main" href="/price">Рассчитать стоимость <span class="ib-go" aria-hidden="true"><Icon name="arrow" size={16} /></span></a>
    <button type="button" class="ib ib-glass" data-order><span class="ib-ico" aria-hidden="true"><Icon name="upload" size={16} /></span> Отправить макет</button>
  </InkHero>

  <div class="band">
    <section class="section pgrid-sec" aria-label="Работы">
      <div class="wrap">
        <div class="filters" role="group" aria-label="Фильтр работ">
          <button type="button" class="pchip" aria-pressed="true" data-filter="all">Все</button>
          {
            used.map((t) => (
              <button type="button" class="pchip" aria-pressed="false" data-filter={t}>
                {tagNames[t]}
              </button>
            ))
          }
        </div>
        <ul class="pgrid">
          {
            portfolio.map((w, i) => (
              <li class="pw" data-tags={w.tags.join(' ')}>
                <figure>
                  <img src={w.src} alt={w.title} width="480" height="480" loading={i < 8 ? 'eager' : 'lazy'} decoding="async" />
                  <figcaption>
                    <b>{w.title}</b>
                    <span>{w.tech}</span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <div class="band band-tint">
    <CtaBand title="Хотите так же?" text="Пришлите идею или пример, который понравился, — сделаем похожее с вашим дизайном." />
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.pw');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((it) => {
        it.hidden = f !== 'all' && !(it.dataset.tags ?? '').split(' ').includes(f);
      });
    }),
  );
</script>

<style>
  .pgrid-sec {
    padding-block: clamp(32px, 4vw, 56px);
  }
  /* filter: a glass track, the chosen one is a navy pill */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 32px;
    padding: 5px;
    border-radius: 28px;
    border: 1px solid #e5e5e5;
    background: rgba(242, 242, 242, 0.8);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .pchip {
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-weight: 600;
    font-size: 0.94rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .pchip:hover {
    background: rgba(255, 255, 255, 0.9);
  }
  .pchip[aria-pressed='true'] {
    background: var(--navy, #14213d);
    color: #fff;
  }
  .pgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 4 240px;
    column-gap: 20px;
  }
  .pw {
    break-inside: avoid;
    margin-bottom: 20px;
  }
  .pw figure {
    margin: 0;
    overflow: clip;
    border-radius: 24px;
    border: 1px solid #e5e5e5;
    background: #fff;
    box-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.4);
  }
  .pw img {
    display: block;
    width: 100%;
    height: auto;
    background: #f2f2f2;
  }
  .pw figcaption {
    display: grid;
    gap: 2px;
    padding: 12px 16px 14px;
    font-size: 0.94rem;
  }
  .pw figcaption span {
    color: var(--muted);
    font-size: 0.78rem;
  }
  @media (max-width: 560px) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }
    .pchip {
      flex: none;
      white-space: nowrap;
      scroll-snap-align: start;
    }
    .pgrid {
      columns: 2 150px;
      column-gap: 10px;
    }
    .pw {
      margin-bottom: 10px;
    }
    .pw figure {
      border-radius: 18px;
    }
    .pw figcaption {
      padding: 8px 10px 10px;
      font-size: 0.82rem;
    }
  }
</style>

---
import { reviews } from '@/data/reviews';
import { site } from '@/data/site';
interface Props {
  limit?: number;
  more?: boolean;
  /** on phones show reviews as a sideways carousel (off on the full reviews page) */
  scroll?: boolean;
  /** only reviews that mention one of these lowercase word stems, e.g. ['футболк'] */
  keywords?: string[];
  title?: string;
}
const { limit = 6, more = true, scroll = true, keywords, title = 'Что говорят клиенты' } = Astro.props;
const matching = keywords?.length ? reviews.filter((r) => keywords.some((k) => r.text.toLowerCase().includes(k))) : reviews;
const list = matching.slice(0, limit);
const tones = ['var(--c-soft)', 'var(--m-soft)', 'var(--y-soft)'];
const fmt = (n: number) => n.toLocaleString('ru-RU', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

<section class="section reviews" aria-labelledby="rev-h">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Отзывы</p>
        <h2 id="rev-h">{title}</h2>
      </div>
      <p>Оценки на площадках, где клиенты оставляют отзывы после заказа. Нажмите, чтобы прочитать все отзывы.</p>
    </div>
    <ul class="rev-ratings" aria-label="Рейтинг на площадках отзывов">
      {
        site.ratings.map((r) => (
          <li>
            <a href={r.href} target="_blank" rel="noopener">
              <span class="rev-rating mono">{fmt(r.rating)}</span>
              <span class="rev-stars" aria-hidden="true" style={`--r: ${(r.rating / 5) * 100}%`}></span>
              <span class="rev-platform">
                <b>{r.platform}</b>
                <small>
                  {r.count} {r.unit}
                </small>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class:list={['rev-grid', { 'rev-scroll': scroll }]}>
      {
        list.map((r, i) => (
          <figure class="rev" style={`--tone:${tones[i % 3]}`}>
            <span class="rev-quote" aria-hidden="true">“</span>
            <blockquote>
              <p>{r.text}</p>
            </blockquote>
            <figcaption>
              <span class="rev-avatar" aria-hidden="true">{r.name.charAt(0)}</span>
              <span>
                <b>{r.name}</b>
                {(r.source || r.date) && (
                  <small>
                    {r.rating && <span class="rev-mini-stars" aria-label={`Оценка ${r.rating} из 5`}>{'★'.repeat(r.rating)} </span>}
                    {[r.source, r.date].filter(Boolean).join(' · ')}
                  </small>
                )}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <div class="rev-links">
      {more && <a class="btn btn-ghost btn-sm" href="/otzyvy">Все отзывы</a>}
    </div>
  </div>
</section>

<style>
  .rev-grid {
    columns: 3 300px;
    column-gap: 18px;
  }
  .rev {
    position: relative;
    break-inside: avoid;
    margin: 0 0 18px;
    padding: 28px 26px 22px;
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1.5px solid var(--line);
  }
  .rev::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 8px;
    border-radius: var(--radius-l) var(--radius-l) 0 0;
    background: var(--tone);
  }
  .rev-quote {
    position: absolute;
    top: 6px;
    right: 22px;
    font-size: 4.5rem;
    line-height: 1;
    font-weight: 900;
    color: var(--line-strong);
  }
  .rev blockquote {
    margin: 0;
    padding-right: 34px;
    color: var(--ink-2);
  }
  .rev figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
  }
  .rev figcaption small {
    display: block;
    color: var(--muted);
  }
  .rev-avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--tone);
    font-weight: 800;
  }
  .rev-ratings {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .rev-ratings a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'num stars' 'num name';
    align-items: center;
    gap: 0 14px;
    padding: 16px 20px;
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1.5px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .rev-ratings a:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .rev-rating {
    grid-area: num;
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  /* stars filled in proportion to the rating: 4,6 shows 4 and a bit, not 5 */
  .rev-stars {
    grid-area: stars;
    position: relative;
    justify-self: start;
    letter-spacing: 2px;
    line-height: 1;
  }
  .rev-stars::before {
    content: '★★★★★';
    color: var(--line-strong);
  }
  .rev-stars::after {
    content: '★★★★★';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--r);
    overflow: hidden;
    white-space: nowrap;
    color: #f5b700;
  }
  .rev-platform {
    grid-area: name;
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    align-items: baseline;
  }
  .rev-platform small {
    color: var(--muted);
  }
  .rev-mini-stars {
    color: #f5b700;
  }
  @media (max-width: 760px) {
    .rev-ratings {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .rev-ratings a {
      padding: 12px 16px;
    }
    .rev-rating {
      font-size: 1.7rem;
    }
  }
  /* phones: reviews scroll sideways instead of a 2000px column */
  @media (max-width: 640px) {
    .rev-scroll {
      columns: auto;
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      align-items: flex-start;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 8px;
      scrollbar-width: none;
    }
    .rev-scroll .rev {
      flex: 0 0 82%;
      scroll-snap-align: center;
      margin: 0;
    }
  }
  .rev-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }
</style>

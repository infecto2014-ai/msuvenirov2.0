---
// «Готовые варианты» on /nakleyki: ready orders with the turnkey price from pricing.ts (product.quote).
// Same look as BadgePackages / MugPackages, the picture is a 3D sticker drawing (StickerArt).
import StickerArt from '@/components/sticker/StickerArt.astro';
import { defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import { stickersPage } from '@/data/stickersPage';

const tech: Record<string, string> = { 'sticker-3d': '3D-стикер', 'sticker-pack': 'стикерпак', 'sticker-set': 'набор 3×3', 'vinyl-pack': 'винил' };
const items = stickersPage.packages.map((pk) => {
  const product = findProduct('stickers', pk.product)!;
  const base = defaultSelection(product);
  const sel: Selection = { ...base, qty: pk.qty, options: { ...base.options, ...pk.options }, dims: { ...base.dims, ...(pk.dims ?? { w: pk.w / 10, h: pk.h / 10 }) } };
  const q = product.quote(sel);
  return { ...pk, unit: q.unit, total: q.total, from: q.from };
});
import TeeHead from '@/components/tee/TeeHead.astro';
import Icon from '@/components/Icon.astro';
import '@/components/product-page/pp.css';
---

<section class="section spk pp-sec" aria-labelledby="spk-h">
  <div class="wrap">
    <TeeHead icon="tag" eyebrow="Популярное" id="spk-h" title="Готовые варианты с ценой" mark="ценой">
      <p class="pp-sub">Цена вместе со стикерами и макетом. Другой размер, вырубка или количество — в калькуляторе выше.</p>
    </TeeHead>
    <ul class="pk-grid">
      {
        items.map((it) => {
          const many = it.product !== 'sticker-3d';
          const qtyLabel = it.product === 'sticker-pack' ? `${it.qty} наб.` : it.product === 'vinyl-pack' ? `${it.qty} лист.` : `${it.qty} шт`;
          const label = `${it.title}, ${qtyLabel} — ${it.from ? 'от ' : ''}${rub(it.total)}`;
          const sc = 120 / Math.max(it.w, it.h);
          return (
            <li class="pk-card pp-card">
              <div class="pk-art pp-art" aria-hidden="true">
                <span class="spk-pile">
                  {many && <StickerArt shape={it.flat ? 'contour' : it.shape === 'rect' ? 'circle' : 'rect'} w={it.w} h={it.h} motif={it.motif === 'logo' ? 'wave' : 'logo'} dome={!it.flat} scale={sc * 0.8} class="spk-b2" />}
                  <StickerArt shape={it.shape} w={it.w} h={it.h} motif={it.motif} text={it.text} dome={!it.flat} scale={sc} class={many ? 'spk-b1' : 'spk-solo'} />
                </span>
                <span class="pk-qty">{qtyLabel}</span>
                <span class="pk-tech">{tech[it.product]}</span>
              </div>
              <div class="pk-body">
                <h3>{it.title}</h3>
                <p class="pk-note">{it.note}</p>
                <p class="pk-price">
                  <b>{it.from && 'от '}{rub(it.total)}</b>
                  {it.qty > 1 && <small>{rub(it.unit)} / {it.product === 'sticker-pack' ? 'набор' : it.product === 'vinyl-pack' ? 'лист' : 'шт'}</small>}
                </p>
                <button type="button" class="pk-btn" data-order={label}>
                  Заказать
                  <span class="pk-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                </button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .spk { --cols: 3; }
  .spk-pile { position: relative; display: grid; place-items: center; width: 190px; height: 170px; }
  .spk-pile :global(.spk-b2) { position: absolute; right: 0; top: 6px; width: 46%; transform: rotate(14deg); opacity: 0.95; }
  .spk-pile :global(.spk-solo) { width: 80%; transform: rotate(-5deg); }
  .spk-pile :global(.spk-b1) { position: relative; left: -18px; top: 8px; width: 74%; transform: rotate(-6deg); }
  @media (max-width: 760px) { .spk-pile { zoom: 0.72; } }
  .pk-art { --art-h: 240px; }
  .pk-art :global(svg) { filter: drop-shadow(0 10px 12px rgba(20, 33, 61, 0.2)); }
</style>

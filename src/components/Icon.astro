---
// Small inline stroke/brand icons. Decorative unless `label` is given.
interface Props {
  name: 'phone' | 'telegram' | 'max' | 'vk' | 'calc' | 'arrow' | 'pin' | 'clock' | 'mail' | 'upload' | 'check' | 'menu' | 'chat';
  size?: number;
  label?: string;
}
const { name, size = 22, label } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'telegram' && <path d="m21 4-3 16-6-5-3 3v-5l9-8-11 7-4-2z" />}
  {name === 'max' && (
    <>
      <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" />
      <path d="M8.5 15V9.5l3.5 3 3.5-3V15" />
    </>
  )}
  {name === 'vk' && <path d="M3 7h3.2c.5 3 2 5 3.3 5.5V7h3v3.2c1.5-.2 2.8-1.7 3.4-3.2H19c-.5 2-1.9 3.7-3.2 4.5 1.4.7 2.8 2.2 3.6 4.5h-3.2c-.7-1.5-2-2.7-3.6-2.9V16h-.4C7.3 16 3.5 13.3 3 7Z" />}
  {name === 'calc' && (
    <>
      <rect x="5" y="3" width="14" height="18" rx="3" />
      <path d="M8.5 7.5h7M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 16h.01M12 16h.01M15.5 16h.01" />
    </>
  )}
  {name === 'arrow' && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === 'pin' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === 'upload' && <path d="M12 16V4m-5 5 5-5 5 5M5 20h14" />}
  {name === 'chat' && <path d="M4 5h16v11H9l-4 4v-4H4zM8 9.5h8M8 12.5h5" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h10" />}
</svg>

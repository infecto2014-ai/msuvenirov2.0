---
// «Изделие» on the t-shirt page, style «Ink» (sits on a navy rounded panel made by the page):
// a big t-shirt that takes the colour you tap, a spec sheet in glass tiles with icons, care tips and the size chart.
// On a phone care tips and the size chart start folded. Data — src/data/garments.ts.
import TeeHead from './TeeHead.astro';
import logoSvg from '@/assets/logo.svg?raw';
import type { GarmentInfo } from '@/data/types';

interface Props {
  info: GarmentInfo;
  productName: string;
}
const { info, productName } = Astro.props;

/** dark print (ink) on light fabric, white print on dark fabric */
const isLight = (hex: string) => {
  const n = parseInt(hex.replace('#', ''), 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.32;
};
const colors = info.colors.map((c) => ({ ...c, print: isLight(c.hex) ? '#16141b' : '#ffffff' }));
const first = colors[0];
const logo = logoSvg.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');

// stroke icons (24x24) picked by the spec label
const icons: Record<string, string> = {
  shirt: 'M8 3 3 6l2 4 2-1v11h10V9l2 1 2-4-5-3c-.5 1.5-2 2.3-4 2.3S8.5 4.5 8 3Z',
  fabric: 'M4 7c3-3 5 3 8 0s5 3 8 0M4 13c3-3 5 3 8 0s5 3 8 0M4 19c3-3 5 3 8 0s5 3 8 0',
  weight: 'M6 8h12l2 12H4L6 8Zm3 0a3 3 0 1 1 6 0M12 13v3',
  size: 'M3 16 16 3l5 5L8 21l-5-5Zm5-3 2 2m1-5 2 2m-7 1 2 2',
  print: 'M7 9V3h10v6M7 17H4v-7h16v7h-3M7 14h10v7H7v-7Z',
  place: 'M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11Zm0-8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  frame: 'M4 4h16v16H4V4Zm4 4h8v8H8V8Z',
  wash: 'M12 3s6 6.5 6 11a6 6 0 1 1-12 0c0-4.5 6-11 6-11Z',
  child: 'M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm-6 9c0-3.5 2.7-6 6-6s6 2.5 6 6',
  tag: 'M3 12V4h8l10 10-8 8L3 12Zm5-4h.01',
};
const iconFor = (label: string) => {
  const l = label.toLowerCase();
  if (l.includes('детск')) return icons.child;
  if (l.includes('размер принта')) return icons.frame;
  if (l.includes('размер')) return icons.size;
  if (l.includes('состав')) return icons.fabric;
  if (l.includes('плотн')) return icons.weight;
  if (l.includes('мест')) return icons.place;
  if (l.includes('технолог') || l.includes('печат')) return icons.print;
  if (l.includes('стойк') || l.includes('стир')) return icons.wash;
  if (l.includes('модел')) return icons.shirt;
  return icons.tag;
};
---

<section class="section tdet" aria-labelledby="tdet-h" data-tdet>
  <div class="wrap">
    <TeeHead dark icon="shirt" eyebrow="Изделие" id="tdet-h" title={`${productName}: цвет, ткань, размеры`} mark="цвет" />

    <div class="tdet-grid">
      <!-- colours with a live preview -->
      <div class="tdet-card tdet-colors">
        <div class="tdet-shirt" style={`--shirt:${first.hex};--print:${first.print}`} aria-hidden="true">
          <svg viewBox="0 0 300 320" class="tdet-shirt-svg">
            <defs>
              <linearGradient id="tdet-fold" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color="#000" stop-opacity="0.16" />
                <stop offset="0.25" stop-color="#000" stop-opacity="0" />
                <stop offset="0.75" stop-color="#000" stop-opacity="0" />
                <stop offset="1" stop-color="#000" stop-opacity="0.16" />
              </linearGradient>
            </defs>
            <path class="tdet-shirt-body" d="M104 16c14 22 78 22 92 0l56 22 44 60-42 30-20-16v200c0 6-4 10-10 10H76c-6 0-10-4-10-10V112l-20 16L4 98l44-60z" />
            <path d="M104 16c14 22 78 22 92 0l56 22 44 60-42 30-20-16v200c0 6-4 10-10 10H76c-6 0-10-4-10-10V112l-20 16L4 98l44-60z" fill="url(#tdet-fold)" />
            <path class="tdet-shirt-collar" d="M104 16c14 30 78 30 92 0" />
          </svg>
          <span class="tdet-logo" set:html={logo} />
        </div>
        <div class="tdet-colors-side">
          <h3>Цвет</h3>
          <p class="tdet-current" aria-live="polite">
            <span class="sr-only">Выбран цвет: </span><b data-tdet-name>{first.name}</b>
          </p>
          <ul class="tdet-swatches" aria-label="Цвета футболок">
            {
              colors.map((c, i) => (
                <li>
                  <button type="button" class="tdet-sw" data-hex={c.hex} data-print={c.print} data-name={c.name} aria-pressed={i === 0 ? 'true' : 'false'}>
                    <span class="tdet-sq" style={`--sw:${c.hex}`} aria-hidden="true" />
                    <span>{c.name}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- spec sheet -->
      <div class="tdet-card tdet-specs-card">
        <h3>Характеристики</h3>
        <dl class="tdet-specs">
          {
            info.specs.map((s) => (
              <div class="tdet-spec">
                <span class="tdet-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d={iconFor(s.label)} />
                  </svg>
                </span>
                <div>
                  <dt>{s.label}</dt>
                  <dd>
                    {s.value}
                    {s.todo && <small class="tdet-todo">уточняйте</small>}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- care -->
      <details class="tdet-card tdet-care-card tdet-fold" open data-tfold>
        <summary><h3>Как ухаживать</h3></summary>
        <ul class="tdet-care">
          {
            info.care.map((c) => (
              <li>
                <span class="tdet-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                </span>
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
      </details>

      <!-- size chart -->
      {
        info.sizes && (
          <details class="tdet-card tdet-sizes tdet-fold" open data-tfold>
            <summary>
              <h3>
                Таблица размеров{info.sizes.todo && <small class="tdet-todo">уточняйте у менеджера</small>}
              </h3>
            </summary>
            <div class="tdet-table-wrap">
              <table class="tdet-table">
                <thead>
                  <tr>
                    {info.sizes.columns.map((c) => (
                      <th scope="col">{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {info.sizes.rows.map((r) => (
                    <tr>
                      {r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )
      }
    </div>
  </div>
</section>

<script is:inline>
  // Folding cards: always open on a computer, folded on a phone (tap to open). Runs before the first paint.
  (function () {
    var m = matchMedia('(max-width: 760px)');
    document.querySelectorAll('[data-tfold]').forEach(function (d) {
      if (m.matches) d.open = false;
      d.querySelector('summary').addEventListener('click', function (e) {
        if (!m.matches) e.preventDefault();
      });
      m.addEventListener('change', function (e) {
        d.open = !e.matches;
      });
    });
  })();
</script>

<script>
  // tapping a colour repaints the big t-shirt
  for (const root of document.querySelectorAll<HTMLElement>('[data-tdet]')) {
    const shirt = root.querySelector<HTMLElement>('.tdet-shirt');
    const name = root.querySelector<HTMLElement>('[data-tdet-name]');
    const buttons = root.querySelectorAll<HTMLButtonElement>('.tdet-sw');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        shirt?.style.setProperty('--shirt', b.dataset.hex ?? '');
        shirt?.style.setProperty('--print', b.dataset.print ?? '');
        if (name) name.textContent = b.dataset.name ?? '';
      }),
    );
  }
</script>

<style>
  .tdet-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    color: #fff;
  }
  .tdet-card {
    min-width: 0;
    padding: 24px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .tdet-card h3 {
    margin-bottom: 16px;
    font-size: 1.15rem;
    color: #fff;
  }
  .tdet-colors {
    grid-column: span 7;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 24px;
    align-items: center;
  }
  .tdet-specs-card {
    grid-column: span 5;
  }
  .tdet-care-card {
    grid-column: span 5;
  }
  .tdet-sizes {
    grid-column: span 7;
  }

  /* ---------- the big t-shirt */
  .tdet-shirt {
    display: grid;
    place-items: center;
    position: relative;
    padding: 18px 6px;
    border-radius: 22px;
    background: radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.14), transparent 70%);
  }
  .tdet-shirt-svg {
    width: 100%;
    max-width: 300px;
    height: auto;
    filter: drop-shadow(0 18px 22px rgba(0, 0, 0, 0.45));
  }
  .tdet-shirt-body {
    fill: var(--shirt);
    stroke: rgba(0, 0, 0, 0.18);
    stroke-width: 1.5;
    transition: fill 0.3s ease;
  }
  .tdet-shirt-collar {
    fill: none;
    stroke: rgba(0, 0, 0, 0.2);
    stroke-width: 2;
  }
  .tdet-logo {
    position: absolute;
    left: 33%;
    top: 34%;
    width: 34%;
    color: var(--print);
    transition: color 0.3s ease;
    pointer-events: none;
  }
  .tdet-logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .tdet-current {
    margin: -6px 0 16px;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.78);
  }
  .tdet-current b {
    color: #fff;
    font-weight: 700;
  }

  /* ---------- colour list: round swatch + name */
  .tdet-swatches {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 10px;
  }
  .tdet-sw {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 4px 10px 4px 4px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: rgba(255, 255, 255, 0.86);
    font: inherit;
    font-size: 0.96rem;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .tdet-sw:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .tdet-sw[aria-pressed='true'] {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-weight: 700;
  }
  .tdet-sw:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .tdet-sq {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    transition: box-shadow 0.15s ease;
  }
  .tdet-sw[aria-pressed='true'] .tdet-sq {
    box-shadow: 0 0 0 2px #14213d, 0 0 0 4px #fff;
  }

  /* ---------- icon in a white circle */
  .tdet-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    color: #14213d;
  }

  /* ---------- spec sheet: glass tiles */
  .tdet-specs {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .tdet-spec {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px 10px 10px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .tdet-spec dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
  .tdet-spec dd {
    margin: 2px 0 0;
    font-weight: 600;
    font-size: 0.96rem;
    line-height: 1.35;
    color: #fff;
  }
  .tdet-todo {
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: #fff;
    color: #14213d;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /* ---------- care */
  .tdet-care {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .tdet-care li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.88);
  }
  .tdet-care .tdet-ico {
    width: 28px;
    height: 28px;
  }

  /* ---------- sizes: glass table */
  .tdet-sizes h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
  }
  .tdet-table-wrap {
    overflow-x: auto;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
  }
  .tdet-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.94rem;
    color: #fff;
  }
  .tdet-table th,
  .tdet-table td {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    background: none;
    color: #fff;
  }
  .tdet-table thead th {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.72);
    background: rgba(255, 255, 255, 0.08);
  }
  .tdet-table tbody th {
    font-weight: 700;
  }
  .tdet-table tbody tr:last-child th,
  .tdet-table tbody tr:last-child td {
    border-bottom: 0;
  }

  /* summaries look like plain headings on a computer */
  .tdet-fold > summary {
    display: block;
    list-style: none;
    cursor: default;
  }
  .tdet-fold > summary::-webkit-details-marker {
    display: none;
  }

  @media (max-width: 1100px) {
    .tdet-colors,
    .tdet-specs-card,
    .tdet-care-card,
    .tdet-sizes {
      grid-column: 1 / -1;
    }
  }

  /* ---------- phone */
  @media (max-width: 760px) {
    .tdet {
      padding-block: 32px;
    }
    .tdet-grid {
      gap: 10px;
    }
    .tdet-card {
      padding: 16px;
      border-radius: 22px;
    }
    .tdet-card h3 {
      margin-bottom: 10px;
      font-size: 1rem;
    }
    .tdet-colors {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .tdet-shirt {
      width: 62%;
      justify-self: center;
      padding: 6px;
    }
    .tdet-colors-side {
      display: grid;
    }
    .tdet-colors-side h3 {
      margin-bottom: 2px;
    }
    .tdet-current {
      margin: 0 0 8px;
      font-size: 0.95rem;
    }
    .tdet-sw {
      gap: 8px;
      font-size: 0.9rem;
    }
    .tdet-sq {
      width: 28px;
      height: 28px;
    }
    .tdet-spec {
      gap: 12px;
      padding: 8px 12px 8px 8px;
    }
    .tdet-ico {
      width: 32px;
      height: 32px;
    }
    .tdet-spec dd {
      font-size: 0.88rem;
    }
    .tdet-care li {
      font-size: 0.88rem;
    }
    .tdet-fold > summary {
      position: relative;
      padding-right: 40px;
      min-height: 44px;
      display: flex;
      align-items: center;
      cursor: pointer;
    }
    .tdet-fold > summary::after {
      content: '+';
      position: absolute;
      right: 0;
      top: 50%;
      width: 32px;
      height: 32px;
      margin-top: -16px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      border: 1.5px solid #fff;
      font-weight: 700;
      line-height: 1;
    }
    .tdet-fold[open] > summary::after {
      content: '−';
    }
    .tdet-fold > summary h3,
    .tdet-fold:not([open]) > summary h3 {
      margin-bottom: 0;
    }
    .tdet-fold[open] > summary {
      margin-bottom: 8px;
    }
    .tdet-table {
      font-size: 0.86rem;
    }
    .tdet-table th,
    .tdet-table td {
      padding: 8px 10px;
    }
    .tdet-table thead th {
      white-space: normal;
      font-size: 0.75rem;
      vertical-align: bottom;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tdet-shirt-body,
    .tdet-logo,
    .tdet-sq {
      transition: none;
    }
  }
</style>

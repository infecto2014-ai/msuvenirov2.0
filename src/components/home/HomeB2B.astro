---
// «Компаниям» on the home page in the new style (owner, 07.11.2026): marker heading, four benefit cards with
// big outlined numbers, red main button, and real corporate work as polaroids on push pins. No client logos here —
// they are shown once, in the first screen.
import TshirtHead from '@/components/tshirt/TshirtHead.astro';
import Icon from '@/components/Icon.astro';

const points = [
  { n: '01', t: 'Счёт без НДС', s: 'и закрывающие документы' },
  { n: '02', t: 'Одна смета', s: 'на футболки, кружки, значки и полиграфию' },
  { n: '03', t: 'Макет по брендбуку', s: 'согласуем до печати' },
  { n: '04', t: 'Образец', s: 'перед тиражом' },
];
const shots = [
  { img: '/portfolio/corporate-polo.webp', cap: 'поло для команды', pin: 'var(--c)' },
  { img: '/portfolio/branded-caps.webp', cap: 'кепки с логотипом', pin: 'var(--m)' },
  { img: '/portfolio/portfolio-20.webp', cap: 'футболки на выезд', pin: 'var(--y)' },
];
---

<section class="section hb" aria-labelledby="b2b-h">
  <div class="wrap">
    <TshirtHead eyebrow="Компаниям" id="b2b-h" title="Мерч и подарки с логотипом для компаний" mark="для компаний" tone="c">
      <p>Футболки для команды, подарки партнёрам, календари к Новому году, значки для мероприятий. Соберём смету на весь набор и подготовим макеты.</p>
    </TshirtHead>

    <div class="hb-grid">
      <div class="hb-main">
        <ul class="hb-points">
          {
            points.map((p) => (
              <li>
                <span class="hb-n mono" aria-hidden="true">{p.n}</span>
                <b>{p.t}</b>
                <span>{p.s}</span>
              </li>
            ))
          }
        </ul>
        <div class="hb-actions">
          <button type="button" class="btn btn-magenta" data-order="Запрос расчёта для компании">Запросить расчёт</button>
          <a class="btn btn-ghost" href="/korporativnym-klientam">Условия для компаний</a>
          <a class="hb-kp" href="/kp-msuvenirov.pdf" download><Icon name="arrow" size={18} /> Скачать КП (PDF)</a>
        </div>
      </div>

      <ul class="hb-wall" aria-hidden="true">
        {
          shots.map((s, i) => (
            <li class={`hb-shot hb-shot-${i + 1}`} style={`--pin: ${s.pin}`}>
              <span class="hb-pin" />
              <img src={s.img} alt="" width="360" height="360" loading="lazy" decoding="async" />
              <span class="hb-cap">{s.cap}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hb-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .hb-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .hb-points li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 20px 20px 22px;
    border-radius: 22px 22px 22px 8px;
    background: #fff;
    box-shadow: 0 1px 0 rgba(22, 20, 27, 0.06), 0 14px 30px -22px rgba(22, 20, 27, 0.45);
  }
  .hb-points li:nth-child(4n + 1) { --tone: var(--c); }
  .hb-points li:nth-child(4n + 2) { --tone: var(--m); }
  .hb-points li:nth-child(4n + 3) { --tone: var(--y); }
  .hb-points li:nth-child(4n + 4) { --tone: var(--red); }
  .hb-n {
    margin-bottom: 6px;
    font-family: var(--font);
    font-size: 2.3rem;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    text-shadow: 3px 3px 0 var(--tone);
  }
  .hb-points b {
    font-size: 1.08rem;
  }
  .hb-points span:last-child {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .hb-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 26px;
  }
  .hb-kp {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hb-kp :global(svg) {
    transform: rotate(90deg);
  }

  /* polaroids on push pins, slightly scattered */
  .hb-wall {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    min-height: 540px;
  }
  .hb-shot {
    position: absolute;
    width: 54%;
    padding: 10px 10px 0;
    background: #fff;
    box-shadow: 0 18px 30px -16px rgba(22, 20, 27, 0.45);
    transform: rotate(var(--r));
  }
  .hb-shot img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .hb-cap {
    display: block;
    padding: 8px 4px 12px;
    font-family: 'Caveat', cursive;
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1;
    text-align: center;
    color: var(--ink);
  }
  .hb-shot-1 { --r: -4deg; left: 0; top: 30px; }
  .hb-shot-2 { --r: 3deg; right: 0; top: 0; z-index: 1; }
  .hb-shot-3 { --r: -1.5deg; left: 30%; top: 270px; z-index: 2; width: 46%; }
  .hb-pin {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: -11px;
    width: 26px;
    height: 26px;
    margin-left: -13px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 34% 30%, rgba(255, 255, 255, 0.9) 0 3px, transparent 5px),
      radial-gradient(circle at 40% 38%, color-mix(in srgb, var(--pin) 60%, #fff), var(--pin) 55%, color-mix(in srgb, var(--pin) 70%, #000));
    box-shadow: 3px 5px 6px rgba(22, 20, 27, 0.35);
  }

  @media (max-width: 1020px) {
    .hb-grid {
      grid-template-columns: 1fr;
    }
    .hb-wall {
      width: min(100%, 520px);
      justify-self: center;
    }
  }
  @media (max-width: 560px) {
    .hb-points {
      gap: 10px;
    }
    .hb-points li {
      padding: 14px;
    }
    .hb-n {
      font-size: 1.8rem;
    }
    .hb-actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
    .hb-wall {
      min-height: 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-top: 8px;
    }
    .hb-shot,
    .hb-shot-3 {
      position: relative;
      inset: auto;
      width: auto;
      padding: 6px 6px 0;
    }
    .hb-cap {
      font-size: 0.95rem;
      padding: 6px 2px 8px;
    }
    .hb-pin {
      width: 18px;
      height: 18px;
      margin-left: -9px;
      top: -8px;
    }
  }
</style>

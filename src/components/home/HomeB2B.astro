---
/**
 * «Компаниям» on the home page (owner, 14.11.2026: «перерабатываем под наш дизайн», «цифры 01–04 смотрятся неудачно»).
 * Sits on a navy rounded panel (band-ink): heading + four benefits as glass tiles with icons (no numbers), white main
 * button, and real corporate work as a straight rounded photo mosaic. No client logos — they are under the first screen.
 */
import Icon from '@/components/Icon.astro';

const points = [
  { t: 'Счёт без НДС', s: 'и закрывающие документы', icon: 'M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5' },
  { t: 'Одна смета', s: 'на футболки, кружки, значки и полиграфию', icon: 'M5 6h14M5 12h14M5 18h9' },
  { t: 'Макет по брендбуку', s: 'согласуем до печати', icon: 'M12 3l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.4 6.7 19.1l1-5.8-4.2-4.1 5.9-.9z' },
  { t: 'Образец', s: 'перед тиражом', icon: 'M8 4l-4 3 2 3 2-1v11h8V9l2 1 2-3-4-3c-.5 1.5-2 2.5-4 2.5S8.5 5.5 8 4z' },
];
const shots = [
  { img: '/portfolio/corporate-polo.webp', alt: 'Поло с логотипом для команды' },
  { img: '/portfolio/branded-caps.webp', alt: 'Кепки с логотипом компании' },
  { img: '/portfolio/portfolio-20.webp', alt: 'Корпоративные футболки на выезде' },
];
---

<section class="section hb lx-dark" aria-labelledby="b2b-h">
  <div class="wrap hb-grid">
    <div class="hb-main">
      <p class="eyebrow">Компаниям</p>
      <h2 id="b2b-h">Мерч и подарки с&nbsp;логотипом <span class="serif">для компаний</span></h2>
      <p class="hb-lead">Футболки для команды, подарки партнёрам, календари к Новому году, значки для мероприятий. Соберём смету на весь набор и подготовим макеты.</p>

      <ul class="hb-points">
        {
          points.map((p) => (
            <li>
              <span class="hb-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={p.icon} />
                </svg>
              </span>
              <span class="hb-txt">
                <b>{p.t}</b>
                <span>{p.s}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <div class="hb-actions">
        <button type="button" class="hb-btn" data-order="Запрос расчёта для компании">Запросить расчёт <span class="hb-btn-go" aria-hidden="true"><Icon name="arrow" size={16} /></span></button>
        <a class="hb-link" href="/korporativnym-klientam">Условия для компаний</a>
        <a class="hb-link" href="/kp-msuvenirov.pdf" download>Скачать КП (PDF)</a>
      </div>
    </div>

    <ul class="hb-mosaic">
      {
        shots.map((s, i) => (
          <li class={`hb-shot hb-shot-${i + 1}`}>
            <img src={s.img} alt={s.alt} width="480" height="480" loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hb-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .hb-main h2 {
    margin: 0;
    color: #fff;
    text-wrap: balance;
  }
  .hb-lead {
    max-width: 36em;
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.78);
  }
  /* four benefits: glass tiles with an icon in a white circle */
  .hb-points {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .hb-points li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .hb-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #fff;
    color: var(--navy, #14213d);
  }
  .hb-txt {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .hb-txt b {
    color: #fff;
    font-size: 0.98rem;
  }
  .hb-txt span {
    font-size: 0.84rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.7);
  }
  .hb-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    margin-top: 28px;
  }
  .hb-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 54px;
    padding: 6px 6px 6px 22px;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .hb-btn:hover {
    background: #e5e5e5;
  }
  .hb-btn-go {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #000;
    color: #fff;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .hb-btn:hover .hb-btn-go {
    transform: translateX(3px);
  }
  .hb-link {
    padding-block: 12px;
    color: #fff;
    font-weight: 600;
    font-size: 0.94rem;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 4px;
  }
  .hb-link:hover {
    color: #fff;
    text-decoration-color: #fff;
  }
  /* photo mosaic: one tall, two square */
  .hb-mosaic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 12px;
    aspect-ratio: 1.05;
  }
  .hb-shot {
    border-radius: 22px;
    overflow: clip;
    background: rgba(255, 255, 255, 0.06);
  }
  .hb-shot-1 {
    grid-row: span 2;
  }
  .hb-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 1020px) {
    .hb-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hb-mosaic {
      max-width: 560px;
    }
  }
  @media (max-width: 560px) {
    .hb-points {
      grid-template-columns: minmax(0, 1fr);
    }
    .hb-btn {
      width: 100%;
      justify-content: space-between;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hb-btn,
    .hb-btn-go {
      transition: none;
    }
  }
</style>

---
/**
 * New Year block of the home page in the «Ink & Amber» glass concept (owner, 14.11.2026: «убираем конверт,
 * новогодний блок должен соответствовать общей концепции»). A rounded navy panel with snow, like the first screen:
 * text + glass countdown tiles + amber button on the left, the family photo in a glass «ornament» on the right.
 * Shown only from 1 November to 31 December (script), honest countdown to 1 January by the visitor's clock.
 * The old envelope block is src/components/NewYearBlock.astro (kept, not used on the home page).
 */
import Icon from '@/components/Icon.astro';

interface Props {
  photo?: string;
  link?: string;
}
const { photo = '/img/ny/ball-photo.webp', link = '/stati/novogodnie-podarki' } = Astro.props;
---

<section class="hny lx-dark" aria-labelledby="hny-h" data-hny hidden>
  <span class="ny-snow" aria-hidden="true"></span>
  <div class="hny-inner">
    <figure class="hny-orn" aria-hidden="true">
      <span class="hny-string"></span>
      <span class="hny-cap"></span>
      <span class="hny-ball">
        <img src={photo} alt="" width="240" height="240" loading="lazy" decoding="async" />
      </span>
    </figure>

    <div class="hny-copy">
      <p class="hny-kicker">Новый год уже близко</p>
      <h2 id="hny-h">Подарки с&nbsp;вашим <span class="serif">фото и&nbsp;логотипом</span></h2>
    </div>

    <div class="hny-cd" data-hny-cd role="timer" aria-label="До Нового года">
      <span class="hny-tile"><b data-d>—</b><small data-dw>дней</small></span>
      <span class="hny-tile"><b data-h>—</b><small>часов</small></span>
      <span class="hny-tile"><b data-m>—</b><small>минут</small></span>
    </div>

    <a class="hny-btn" href={link}>Идеи подарков <span class="hny-btn-go" aria-hidden="true"><Icon name="arrow" size={16} /></span></a>
  </div>
</section>

<script>
  // Season (1 Nov – 31 Dec) and the countdown to 1 January by the visitor's clock; updates every 30 s.
  const plural = (n: number, one: string, few: string, many: string) => {
    const a = n % 10, b = n % 100;
    return a === 1 && b !== 11 ? one : a >= 2 && a <= 4 && (b < 12 || b > 14) ? few : many;
  };
  const pad = (n: number) => String(n).padStart(2, '0');
  const block = document.querySelector<HTMLElement>('[data-hny]');
  const month = new Date().getMonth();
  if (block && (month === 10 || month === 11)) {
    block.hidden = false;
    const el = block.querySelector<HTMLElement>('[data-hny-cd]')!;
    const set = (sel: string, v: string) => {
      const n = el.querySelector(sel);
      if (n) n.textContent = v;
    };
    const tick = () => {
      const now = new Date();
      const ms = Math.max(0, new Date(now.getFullYear() + 1, 0, 1).getTime() - now.getTime());
      const min = Math.floor(ms / 60000);
      const d = Math.floor(min / 1440), h = Math.floor((min % 1440) / 60), m = min % 60;
      set('[data-d]', String(d));
      set('[data-dw]', plural(d, 'день', 'дня', 'дней'));
      set('[data-h]', pad(h));
      set('[data-m]', pad(m));
      el.setAttribute('aria-label', `До Нового года ${d} ${plural(d, 'день', 'дня', 'дней')} ${h} ч ${m} мин`);
    };
    tick();
    setInterval(tick, 30000);
  }
</script>

<style>
  /* a compact strip (owner, 14.11.2026: «уже в 2 раза»): ornament · title · countdown · button in one row */
  .hny {
    position: relative;
    isolation: isolate;
    margin: 16px 12px 0;
    border-radius: 32px;
    overflow: clip;
    color: #fff;
    background:
      radial-gradient(40% 120% at 8% 0%, rgba(255, 255, 255, 0.08), transparent 70%),
      linear-gradient(160deg, var(--navy, #14213d) 0%, #0b1426 100%);
  }
  .hny-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    max-width: 1320px;
    margin-inline: auto;
    padding: 26px clamp(20px, 4vw, 48px);
  }
  .hny-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--amber, #fff);
  }
  .hny-kicker::before {
    content: '';
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--amber, #fff);
  }
  .hny h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.4rem, 2.3vw, 2rem) !important;
    line-height: 1.1 !important;
    font-weight: 800 !important;
    text-wrap: balance;
  }
  /* countdown: three glass tiles */
  .hny-cd {
    display: flex;
    gap: 8px;
    font-variant-numeric: tabular-nums;
  }
  .hny-tile {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-width: 70px;
    padding: 10px 10px 8px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .hny-tile b {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--amber, #fff);
  }
  .hny-tile small {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .hny-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    padding: 6px 6px 6px 22px;
    border-radius: 999px;
    background: var(--amber, #fff);
    color: #000;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .hny-btn:hover {
    background: var(--amber-dark, #e5e5e5);
    color: #000;
  }
  .hny-btn-go {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #000;
    color: #fff;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .hny-btn:hover .hny-btn-go {
    transform: translateX(3px);
  }
  /* the family photo as a small glass ornament on a string from the top edge */
  .hny-orn {
    position: relative;
    width: 112px;
    margin: 0;
    padding-top: 18px;
    transform-origin: 50% -40px;
  }
  .hny-string {
    position: absolute;
    top: -60px;
    left: 50%;
    width: 1px;
    height: 70px;
    background: linear-gradient(rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.6));
  }
  .hny-cap {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 26px;
    height: 14px;
    transform: translateX(-50%);
    border-radius: 6px 6px 3px 3px;
    background: linear-gradient(90deg, #9aa3b5, #e5e5e5 45%, #ffffff 55%, #9aa3b5);
  }
  .hny-ball {
    display: block;
    aspect-ratio: 1;
    padding: 6px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.1);
    box-shadow:
      0 0 0 4px rgba(255, 255, 255, 0.85),
      0 24px 40px -18px rgba(0, 0, 0, 0.7);
  }
  .hny-ball img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (max-width: 1100px) {
    .hny-inner {
      grid-template-columns: auto minmax(0, 1fr);
      row-gap: 18px;
    }
    .hny-cd {
      grid-column: 1 / 2;
      grid-row: 2;
    }
    .hny-btn {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
    }
  }
  @media (max-width: 560px) {
    .hny {
      margin: 12px 8px 0;
      border-radius: 24px;
    }
    .hny-inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 14px 16px;
      padding: 20px 16px 18px;
    }
    .hny-orn {
      width: 84px;
    }
    .hny-cd {
      grid-column: 1 / -1;
    }
    .hny-tile {
      flex: 1;
      min-width: 0;
    }
    .hny-btn {
      grid-column: 1 / -1;
      grid-row: 3;
      justify-self: stretch;
      justify-content: space-between;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hny-btn,
    .hny-btn-go {
      transition: none;
    }
  }
</style>

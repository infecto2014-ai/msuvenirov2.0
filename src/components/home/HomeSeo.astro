---
// SEO text of the home page (owner, 14.11.2026: «SEO-текст внизу нужно оформить достойно», номера 01–04 не нужны).
// Left: sticky column with eyebrow, h2 and intro. Right: four glass cards, each with an icon in a navy circle.
// Words and links are unchanged (they matter for search). On phones only the first card is open, the rest unfold
// with «Читать полностью» (checkbox, no JS).
const items = [
  {
    icon: 'M8 3 3 6l2 4 3-1v11h8V9l3 1 2-4-5-3a4 4 0 0 1-8 0Z',
    h: 'Печать на футболках и худи',
    html: `Печатаем на <a href="/pechat-na-futbolkah">футболках</a>, <a href="/pechat-na-hudi">худи</a>, свитшотах, поло и <a href="/pechat-na-shopperah">шопперах</a> от
          одной штуки. Основная технология — DTF: яркий принт на ткани любого цвета, который выдерживает больше 50 стирок. Можно принести свою вещь или выбрать нашу — белые и
          чёрные футболки всегда в наличии.`,
  },
  {
    icon: 'M5 6h11v9a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4Zm11 2h2a2.5 2.5 0 0 1 0 5h-2M8 2v2m3-2v2',
    h: 'Печать на кружках и фотоподарки',
    html: `Делаем <a href="/pechat-na-kruzhkah">кружки с фото</a> и надписью: белые, цветные, хамелеон. Из фотографий получаются
          <a href="/fotopodarki">подушки, пазлы, ёлочные шары</a> и <a href="/magnity">магниты</a> — подарок, который можно забрать в тот же день или к нужной дате.`,
  },
  {
    icon: 'M3 8h18v12H3ZM9 8V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3M3 13h18',
    h: 'Мерч и сувениры с логотипом для компаний',
    html: `Для компаний Калининграда делаем корпоративный мерч: футболки и поло с логотипом, <a href="/pechat-na-kepkah">бейсболки</a>, <a href="/znachki">значки</a>,
          <a href="/breloki">брелоки</a>, подарки сотрудникам и партнёрам. Работаем по счёту без НДС, перед тиражом согласуем макет и показываем образец. Подробнее — в разделе
          <a href="/korporativnym-klientam">для компаний</a>.`,
  },
  {
    icon: 'M6 3h9l4 4v14H6ZM14 3v5h5M9 13h7M9 17h7',
    h: 'Полиграфия и широкоформатная печать',
    html: `Печатаем <a href="/vizitki">визитки</a>, <a href="/poligrafiya">листовки и блокноты</a>, <a href="/kalendari">календари</a> — квартальные, настенные и карманные.
          Для вывесок и витрин — <a href="/shirokoformatnaya-pechat">широкоформатная печать</a> на плёнке и баннере. Нет макета — поможем его сделать.`,
  },
];
---

<section class="section hs" aria-labelledby="seo-h">
  <div class="wrap">
    <input type="checkbox" id="seo-more" class="hs-toggle" />
    <div class="hs-layout">
      <header class="hs-intro">
        <p class="eyebrow">О мастерской</p>
        <h2 id="seo-h">Печать на заказ <span class="hs-mark">в Калининграде</span></h2>
        <p class="hs-lead">Своя мастерская в ТЦ «Экватор»: печатаем от одной штуки до тиража для компании.</p>
      </header>

      <div class="hs-list">
        {
          items.map((it) => (
            <article class="hs-card">
              <span class="hs-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={it.icon} />
                </svg>
              </span>
              <div class="hs-body">
                <h3>{it.h}</h3>
                <p set:html={it.html} />
              </div>
            </article>
          ))
        }
        <label for="seo-more" class="hs-more">Читать полностью</label>
      </div>
    </div>
  </div>
</section>

<style>
  .hs-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .hs-intro {
    position: sticky;
    top: 112px;
    display: grid;
    gap: 14px;
  }
  .hs-intro h2 {
    margin: 0;
  }
  .hs-mark {
    background: linear-gradient(transparent 62%, rgba(20, 33, 61, 0.14) 62%);
    padding-inline: 0.06em;
  }
  .hs-lead {
    margin: 0;
    max-width: 34ch;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .hs-list {
    display: grid;
    gap: 14px;
  }
  .hs-card {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    padding: 24px 26px 26px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.4), 0 0 0 1px rgba(20, 33, 61, 0.07);
  }
  .hs-ico {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--navy, #14213d);
    color: #fff;
  }
  .hs-card:last-of-type .hs-ico {
    background: #000;
  }
  .hs-card h3 {
    margin: 2px 0 8px;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .hs-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.65;
  }
  .hs-card :global(a) {
    /* bigger tap area without moving the text */
    padding-block: 10px;
    color: var(--navy, #14213d);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(20, 33, 61, 0.45);
  }
  .hs-card :global(a:hover) {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  .hs-toggle,
  .hs-more {
    display: none;
  }

  @media (max-width: 900px) {
    .hs-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .hs-intro {
      position: static;
    }
    .hs-lead {
      max-width: none;
    }
  }
  @media (max-width: 760px) {
    .hs-card {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 14px;
      padding: 18px 18px 20px;
      border-radius: 24px;
    }
    .hs-ico {
      width: 44px;
      height: 44px;
    }
    .hs-card:not(:first-of-type) {
      display: none;
    }
    .hs-toggle:checked ~ .hs-layout .hs-card {
      display: grid;
    }
    .hs-more {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--navy, #14213d);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
    }
    .hs-toggle:checked ~ .hs-layout .hs-more {
      display: none;
    }
    .hs-toggle:focus-visible ~ .hs-layout .hs-more {
      outline: 2px solid var(--focus, var(--navy, #14213d));
      outline-offset: 3px;
    }
  }
</style>

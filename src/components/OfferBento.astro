---
// Bento of ready offers with a turnkey price (first used on the t-shirt page, 06.11.2026; now shared):
// one big photo card, wide and small ones, text on a dark gradient over the photo, price as a yellow sticker.
// Callers compute prices from pricing.ts and pass them in — never type prices by hand.
import TshirtHead from './tshirt/TshirtHead.astro';
import { rub } from '@/data/pricing';

export interface Offer {
  title: string;
  note: string;
  img: string;
  qty: number;
  total: number;
  unit: number;
  from?: boolean;
  /** optional «другой тираж» link, e.g. /price?calc=textile:tshirt-unisex#calc */
  more?: string;
}
interface Props {
  items: Offer[];
  id: string;
  num?: string;
  eyebrow?: string;
  title?: string;
  mark?: string;
  tone?: 'c' | 'm' | 'y';
  sub?: string;
}
const { items, id, num, eyebrow = 'Популярное', title = 'Готовые варианты с ценой', mark = 'с ценой', tone = 'm', sub } = Astro.props;
const tones = ['y', 'c', 'm', 'y', 'c', 'm'];
---

<section class="section ob" aria-labelledby={id} data-count={items.length}>
  <div class="wrap">
    <TshirtHead num={num} eyebrow={eyebrow} id={id} title={title} mark={mark} tone={tone}>
      {sub && <p>{sub}</p>}
    </TshirtHead>
    <ul class="ob-grid">
      {
        items.map((it, i) => {
          const label = `${it.title} (${it.note}), ${it.qty} шт — ${it.from ? 'от ' : ''}${rub(it.total)}`;
          return (
            <li class={`ob-card ob-${i + 1} ob-${tones[i % tones.length]}`}>
              <img src={it.img} alt={it.title} width="480" height="480" loading="lazy" decoding="async" />
              <span class="ob-qty mono">{it.qty} шт</span>
              <p class="ob-price">
                <span class="sr-only">Цена: </span>
                <b class="mono">
                  {it.from && 'от '}
                  {rub(it.total)}
                </b>
                {it.qty > 1 && <small>{rub(it.unit)} / шт</small>}
              </p>
              <div class="ob-body">
                <h3>{it.title}</h3>
                <p class="ob-note">{it.note}</p>
                <div class="ob-actions">
                  <button type="button" class="btn btn-sm btn-magenta" data-order={label}>
                    Заказать
                  </button>
                  {it.more && <a class="ob-more" href={it.more}>Другой тираж →</a>}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .ob-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 292px;
    gap: 16px;
  }
  /* bento: 1 — big square, 2 — wide, 3 and 4 — small */
  .ob-1 {
    grid-column: span 2;
    grid-row: span 2;
  }
  .ob-2 {
    grid-column: span 2;
  }
  /* six cards: big + wide + two small, then two wide */
  [data-count='6'] .ob-5,
  [data-count='6'] .ob-6 {
    grid-column: span 2;
  }
  .ob-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }
  .ob-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ob-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    border-radius: 30px 30px 30px 10px;
    overflow: clip;
    isolation: isolate;
    background: #2a2033;
    color: #fff;
  }
  .ob-y { --tone: var(--y); }
  .ob-c { --tone: var(--c); }
  .ob-m { --tone: var(--m); }
  .ob-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.5s ease;
  }
  /* dark gradient under the text: keeps white text above 4.5:1 on any photo */
  .ob-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(15, 18, 26, 0.94) 0%, rgba(15, 18, 26, 0.78) 32%, rgba(15, 18, 26, 0.12) 64%, rgba(15, 18, 26, 0) 80%);
  }
  .ob-1::before {
    background: linear-gradient(to top, rgba(15, 18, 26, 0.94) 0%, rgba(15, 18, 26, 0.7) 26%, rgba(15, 18, 26, 0) 55%);
  }
  @media (hover: hover) {
    .ob-card:hover img {
      transform: scale(1.05);
    }
  }
  .ob-qty {
    position: absolute;
    left: 16px;
    top: 16px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 252, 245, 0.94);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .ob-price {
    position: absolute;
    right: 14px;
    top: 14px;
    display: grid;
    justify-items: end;
    margin: 0;
    padding: 8px 14px 9px;
    border-radius: 16px 16px 4px 16px;
    background: var(--y);
    color: #16141b;
    line-height: 1.05;
    transform: rotate(3deg);
    box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.6);
  }
  .ob-price b {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .ob-price small {
    font-size: 0.75rem;
    font-weight: 700;
  }
  .ob-1 .ob-price {
    padding: 12px 20px 14px;
    transform: rotate(-3deg);
  }
  .ob-1 .ob-price b {
    font-size: 2.1rem;
  }
  .ob-body {
    display: grid;
    justify-items: start;
    gap: 6px;
    width: 100%;
    padding: 18px 20px 20px;
  }
  .ob-body h3 {
    color: #fff;
    font-size: 1.15rem;
  }
  /* a colour tick before the title */
  .ob-body h3::before {
    content: '';
    display: block;
    width: 34px;
    height: 5px;
    margin-bottom: 10px;
    border-radius: 5px;
    background: var(--tone);
  }
  .ob-1 .ob-body {
    padding: 28px;
    gap: 8px;
  }
  .ob-1 .ob-body h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  }
  .ob-note {
    margin: 0 0 6px;
    max-width: 40ch;
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.86rem;
    line-height: 1.4;
  }
  .ob-1 .ob-note {
    font-size: 1rem;
  }
  .ob-body .btn {
    min-height: 44px;
  }

  @media (max-width: 1100px) {
    .ob-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 300px;
    }
    .ob-1 {
      grid-row: span 1;
    }
    [data-count='6'] .ob-5,
    [data-count='6'] .ob-6 {
      grid-column: span 1;
    }
  }

  /* phone: a carousel of tall photo cards */
  @media (max-width: 760px) {
    .ob {
      padding-block: 32px;
    }
    .ob-grid {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1);
      padding: 6px var(--gutter) 8px;
      scrollbar-width: none;
    }
    .ob-grid::-webkit-scrollbar {
      display: none;
    }
    .ob-card {
      flex: 0 0 min(260px, 74%);
      min-height: 300px;
      scroll-snap-align: start;
      border-radius: 22px 22px 22px 8px;
    }
    .ob-1 .ob-body,
    .ob-body {
      gap: 4px;
      padding: 14px;
    }
    .ob-1 .ob-body h3,
    .ob-body h3 {
      font-size: 1.02rem;
    }
    .ob-body h3::before {
      width: 26px;
      height: 4px;
      margin-bottom: 6px;
    }
    .ob-1 .ob-note,
    .ob-note {
      font-size: 0.8rem;
      line-height: 1.35;
      margin-bottom: 6px;
    }
    .ob-qty {
      left: 12px;
      top: 12px;
      font-size: 0.75rem;
    }
    .ob-1 .ob-price,
    .ob-price {
      right: 10px;
      top: 10px;
      padding: 6px 10px 7px;
    }
    .ob-1 .ob-price b,
    .ob-price b {
      font-size: 1.1rem;
    }
    .ob-price small {
      font-size: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ob-card img {
      transition: none;
    }
  }
</style>

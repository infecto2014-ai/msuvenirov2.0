---
// «Готовые варианты» on /kalendari: ready orders of quarterly calendars, turnkey price from pricing.ts (product.quote).
// Same look as GarmentPackages, but the picture is a calendar drawing instead of a photo.
import CalendarArt from '@/components/calendar/CalendarArt.astro';
import { defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import { calendarsPage } from '@/data/calendarsPage';

const product = findProduct('calendars', 'cal-quarterly')!;
const items = calendarsPage.packages.map((pk) => {
  const base = defaultSelection(product);
  const sel: Selection = { ...base, qty: pk.qty, options: { ...base.options, ...pk.options } };
  const q = product.quote(sel);
  return { ...pk, unit: q.unit, total: q.total, from: q.from };
});
import TeeHead from '@/components/tee/TeeHead.astro';
import Icon from '@/components/Icon.astro';
import '@/components/product-page/pp.css';
---

<section class="section cpk pp-sec" aria-labelledby="cpk-h">
  <div class="wrap">
    <TeeHead icon="tag" eyebrow="Популярное" id="cpk-h" title="Готовые варианты с ценой" mark="ценой">
      <p class="pp-sub">Цена за весь тираж вместе с печатью и сборкой. Свой вариант — в калькуляторе выше.</p>
    </TeeHead>
    <ul class="pk-grid">
      {
        items.map((it) => {
          const label = `Квартальный календарь ${it.title}, ${it.qty} шт — ${it.from ? 'от ' : ''}${rub(it.total)}`;
          return (
            <li class="pk-card pp-card">
              <div class="pk-art pp-art" aria-hidden="true">
                <CalendarArt type={it.model} strip={it.strip ?? 'none'} fold={it.fold} scale={0.36} title={it.title} />
                <span class="pk-qty">{it.qty} шт</span>
              </div>
              <div class="pk-body">
                <h3>{it.title}</h3>
                <p class="pk-note">{it.note}</p>
                <p class="pk-price">
                  <b>{it.from && 'от '}{rub(it.total)}</b>
                  <small>{rub(it.unit)} / шт</small>
                </p>
                <button type="button" class="pk-btn" data-order={label}>
                  Заказать
                  <span class="pk-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                </button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .cpk { --cols: 4; }
  .pk-art { --art-h: 260px; }
  .pk-art :global(svg) { filter: drop-shadow(0 10px 12px rgba(20, 33, 61, 0.2)); }
</style>

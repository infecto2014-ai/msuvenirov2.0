---
// Static, always-visible price tables generated from src/data/pricing.ts (indexable by search engines).
import { findCategory, type PriceTable } from '@/data/pricing';

interface Props {
  categoryId: string;
  /** show only these products (ids); omit for the whole category */
  productIds?: string[];
  /** heading level for product names */
  level?: 'h3' | 'h4';
}
const { categoryId, productIds, level = 'h3' } = Astro.props;
const cat = findCategory(categoryId);
const Heading = level;

// Fixed-price products (single "Цена" column) are merged into one table.
type Block = { title?: string; table: PriceTable };
const blocks: Block[] = [];
let merged: PriceTable | null = null;
for (const p of (cat?.products ?? []).filter((x) => !productIds || productIds.includes(x.id))) {
  if (!p.table) continue;
  if (p.table.columns.length === 1 && p.table.columns[0] === 'Цена') {
    if (!merged) {
      merged = { columns: ['Цена'], rows: [] };
      blocks.push({ title: cat!.products.length > 1 && blocks.length ? 'Другие изделия' : undefined, table: merged });
    }
    merged.rows.push(...p.table.rows);
  } else {
    blocks.push({ title: p.name, table: p.table });
  }
}
---

{
  cat && (
    <div class="ptables">
      {blocks.map((b) => (
        <div class="ptable">
          {b.title && (
            <Heading class="ptable-title">
              <span class="ptable-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9zM8 8h.01" />
                </svg>
              </span>
              {b.title}
            </Heading>
          )}
          <div class="pt-box">
            <div class="pt-scroll" tabindex="0">
              <table class="pt">
                <thead>
                  <tr>
                    <th scope="col">{b.title && b.table.rows.length > 1 ? 'Вариант' : 'Изделие'}</th>
                    {b.table.columns.map((c) => (
                      <th scope="col">{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {b.table.rows.map((r) => (
                    <tr>
                      <th scope="row">{r.label}</th>
                      {r.cells.map((c) => (
                        <td>{c}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          {b.table.note && <p class="ptable-note">{b.table.note}</p>}
        </div>
      ))}
    </div>
  )
}

<style>
  /* «Ink» price tables: light glass by default, dark glass on a navy band (.band-ink) */
  .ptables {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(22px, 3vw, 32px);
    --pt-glass: rgba(255, 255, 255, 0.78);
    --pt-bd: rgba(255, 255, 255, 0.9);
    --pt-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.4);
    --pt-head-bg: var(--navy, #14213d);
    --pt-head-fg: #fff;
    --pt-line: rgba(20, 33, 61, 0.1);
    --pt-fg: var(--navy, #14213d);
    --pt-hover: rgba(20, 33, 61, 0.05);
    --pt-note: var(--muted);
    --pt-ico-bg: var(--navy, #14213d);
    --pt-ico-fg: #fff;
  }
  :global(.band-ink) .ptables {
    --pt-glass: rgba(255, 255, 255, 0.06);
    --pt-bd: rgba(255, 255, 255, 0.14);
    --pt-shadow: none;
    --pt-head-bg: rgba(255, 255, 255, 0.1);
    --pt-head-fg: #fff;
    --pt-line: rgba(255, 255, 255, 0.12);
    --pt-fg: #fff;
    --pt-hover: rgba(255, 255, 255, 0.06);
    --pt-note: rgba(255, 255, 255, 0.72);
    --pt-ico-bg: #fff;
    --pt-ico-fg: var(--navy, #14213d);
  }
  .ptable-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 14px;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--pt-fg);
  }
  .ptable-ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--pt-ico-bg);
    color: var(--pt-ico-fg);
  }
  .pt-box {
    border-radius: 24px;
    border: 1px solid var(--pt-bd);
    background: var(--pt-glass);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: var(--pt-shadow);
    overflow: clip;
  }
  .pt-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .pt-scroll:focus-visible {
    outline: 2px solid var(--focus, #14213d);
    outline-offset: -2px;
  }
  .pt {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 0.95rem;
    color: var(--pt-fg);
  }
  .pt th,
  .pt td {
    padding: 13px 18px;
    text-align: right;
    white-space: nowrap;
    border-bottom: 1px solid var(--pt-line);
  }
  .pt thead th {
    background: var(--pt-head-bg);
    color: var(--pt-head-fg);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 0;
  }
  .pt th:first-child,
  .pt td:first-child {
    text-align: left;
    white-space: normal;
    min-width: 200px;
  }
  .pt tbody th {
    font-weight: 600;
  }
  .pt td {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .pt tbody tr:last-child th,
  .pt tbody tr:last-child td {
    border-bottom: 0;
  }
  .pt tbody tr {
    transition: background-color 0.2s ease;
  }
  .pt tbody tr:hover {
    background: var(--pt-hover);
  }
  .ptable-note {
    margin: 10px 6px 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--pt-note);
  }
  @media (max-width: 560px) {
    .pt-box {
      border-radius: 20px;
    }
    .pt th,
    .pt td {
      padding: 11px 14px;
    }
    .pt th:first-child,
    .pt td:first-child {
      min-width: 150px;
    }
    .pt {
      font-size: 0.9rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pt tbody tr {
      transition: none;
    }
  }
</style>

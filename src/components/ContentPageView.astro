---
// Content pages (О нас, Требования к макетам) in the «Ink» look: light first screen (InkHero), blocks as bands
// (InkBlocks), then the page's own extra bands (slot «after»), FAQ and the closing navy panel.
import BaseLayout from '@/layouts/BaseLayout.astro';
import InkHero from '@/components/ink/InkHero.astro';
import InkBlocks from '@/components/ink/InkBlocks.astro';
import FaqSection from '@/components/FaqSection.astro';
import CtaBand from '@/components/CtaBand.astro';
import type { ContentPage } from '@/data/pages';
import { breadcrumbs, faqPage } from '@/lib/schema';

interface Props {
  page: ContentPage;
  path: string;
  crumb: string;
  /** word of the h1 to mark */
  mark?: string;
  facts?: { big: string; small: string }[];
  /** tone of the FAQ band; the closing panel takes the other one */
  faqTone?: 'plain' | 'tint';
}
const { page, path, crumb, mark, facts, faqTone = 'tint' } = Astro.props;
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: crumb, href: path },
];
---

<BaseLayout title={page.title} description={page.description} path={path} schema={[breadcrumbs(crumbs), ...(page.faq.length ? [faqPage(page.faq)] : [])]}>
  <InkHero crumbs={crumbs} h1={page.h1} mark={mark} lead={page.lead} facts={facts}>
    <slot name="hero" />
    {Astro.slots.has('aside') && <slot name="aside" slot="aside" />}
  </InkHero>
  <slot />
  <InkBlocks blocks={page.blocks} />
  <slot name="after" />
  {
    page.faq.length > 0 && (
      <div class={faqTone === 'tint' ? 'band band-tint' : 'band'}>
        <FaqSection items={page.faq} />
      </div>
    )
  }
  <div class={faqTone === 'tint' ? 'band' : 'band band-tint'}>
    <CtaBand />
  </div>
</BaseLayout>

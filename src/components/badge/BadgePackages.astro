---
// «Готовые варианты» on /znachki: ready orders with the turnkey price from pricing.ts (product.quote).
// Same look as MugPackages / CapPackages, the picture is a badge drawing (BadgeArt).
import BadgeArt from '@/components/badge/BadgeArt.astro';
import { defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import { badgesPage } from '@/data/badgesPage';

const items = badgesPage.packages.map((pk) => {
  const product = findProduct('badges', pk.product)!;
  const base = defaultSelection(product);
  const sel: Selection = { ...base, qty: pk.qty, options: { ...base.options, ...pk.options } };
  const q = product.quote(sel);
  return { ...pk, unit: q.unit, total: q.total, from: q.from };
});
import TeeHead from '@/components/tee/TeeHead.astro';
import Icon from '@/components/Icon.astro';
import '@/components/product-page/pp.css';
---

<section class="section spk pp-sec" aria-labelledby="spk-h">
  <div class="wrap">
    <TeeHead icon="tag" eyebrow="Популярное" id="spk-h" title="Готовые варианты с ценой" mark="ценой">
      <p class="pp-sub">Цена вместе со значками и макетом. Другое количество или размер — в калькуляторе выше.</p>
    </TeeHead>
    <ul class="pk-grid">
      {
        items.map((it) => {
          const label = `${it.title}, ${it.qty} шт — ${it.from ? 'от ' : ''}${rub(it.total)}`;
          const pin = it.product === 'badge-pin';
          return (
            <li class="pk-card pp-card">
              <div class="pk-art pp-art" aria-hidden="true">
                {/* a small pile: two badges, the front one bigger */}
                <span class="spk-pile">
                  <BadgeArt type={pin ? 'pin' : 'roll'} size={it.size} motif={it.motif === 'logo' ? 'smile' : 'logo'} scale={pin ? 4.2 : 2.6} class="spk-b2" />
                  <BadgeArt type={pin ? 'pin' : 'roll'} size={it.size} motif={it.motif} text={it.text} scale={pin ? 4.2 : 2.6} class="spk-b1" />
                </span>
                <span class="pk-qty">{it.qty} шт</span>
                <span class="pk-tech">{pin ? 'цанга' : 'закатной'} · {it.size} мм</span>
              </div>
              <div class="pk-body">
                <h3>{it.title}</h3>
                <p class="pk-note">{it.note}</p>
                <p class="pk-price">
                  <b>{it.from && 'от '}{rub(it.total)}</b>
                  {it.qty > 1 && <small>{rub(it.unit)} / шт</small>}
                </p>
                <button type="button" class="pk-btn" data-order={label}>
                  Заказать
                  <span class="pk-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                </button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .spk { --cols: 5; }
  .pk-art { --art-h: 240px; }
  .spk-pile { position: relative; display: grid; place-items: center; width: 190px; height: 170px; }
  .spk-pile :global(.spk-b2) { position: absolute; right: 0; top: 6px; width: 46%; transform: rotate(14deg); opacity: 0.95; }
  .spk-pile :global(.spk-b1) { position: relative; left: -18px; top: 8px; width: 74%; transform: rotate(-6deg); }
  .pk-art :global(svg) { filter: drop-shadow(0 10px 12px rgba(20, 33, 61, 0.2)); }
  @media (max-width: 760px) { .spk-pile { zoom: 0.72; } }
</style>

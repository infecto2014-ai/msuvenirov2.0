---
// Иллюстрация значка (плоская графика «CMYK 2.0»).
// type="roll" — закатной: картинка под плёнкой, край заворачивается на бортик, сзади — жестяная крышка и булавка.
// type="pin"  — металлический на цанге: металлический ободок, сзади — штифт и цанга-«бабочка».
// viewBox — в миллиметрах: значки разного диаметра при одном scale рисуются в реальном соотношении.
// Без растров и внешних шрифтов.

import type { BadgeMotif, BadgeType, BadgeView } from './badge-types';

interface Props {
  type?: BadgeType; // по умолчанию 'roll'
  view?: BadgeView; // по умолчанию 'front'
  size?: number; // диаметр, мм (по умолчанию 38)
  motif?: BadgeMotif; // рисунок на лицевой стороне (по умолчанию 'logo')
  bg?: string; // цвет фона рисунка (hex); по умолчанию свой у каждого рисунка
  text?: string; // надпись для motif="text"
  dims?: boolean; // размерная линия «38 мм» под значком
  guide?: boolean; // разметка макета: край, который уходит на бортик, и безопасная зона
  scale?: number; // px на мм, по умолчанию 4
  title?: string;
  class?: string;
}

const { type = 'roll', view = 'front', size = 38, motif = 'logo', bg, text = 'КОМАНДА', dims = false, guide = false, scale = 4, title, class: cls } = Astro.props;

const C = '#00a0dc';
const M = '#e5007d';
const Y = '#ffd21f';
const K = '#16141b';
const P = '#fffcf5';
const defaultBg: Record<BadgeMotif, string> = { logo: P, text: M, star: C, heart: '#fde7f2', smile: Y, none: '#f2efe8' };
const fill = bg ?? defaultBg[motif as BadgeMotif];

const r = size / 2;
const u = 1 / scale; // 1 px на экране в мм
const depth = type === 'roll' ? Math.max(1.2, size * 0.045) : Math.max(0.8, size * 0.04); // видимая толщина снизу
const pad = 3 + 8 * u;
const dimH = dims ? 14 * u + 4 : 0;
const vbW = size + 2 * pad;
const vbH = size + depth + 2 * pad + dimH;
const cx = pad + r;
const cy = pad + r;
const fs = 11 * u; // подписи ≈ 11 px

const uid = 'bdg' + crypto.randomUUID().slice(0, 8);
const id = (s: string) => `${uid}-${s}`;
const url = (s: string) => `url(#${id(s)})`;

const label =
  title ??
  `${type === 'roll' ? 'Закатной значок' : 'Значок на цанге'} ${size} мм${view === 'back' ? ', обратная сторона' : ''}`;

// рисунок рисуется в квадрате 100×100 и вписывается в круг
const k = size / 100;
const art = `translate(${cx - r} ${cy - r}) scale(${k})`;
// у металлического значка рисунок внутри ободка
const rim = type === 'pin' ? Math.max(0.7, size * 0.05) : 0;
const faceR = r - rim;

const starPath = (x: number, y: number, R: number, ri: number, n = 5, rot = -90) =>
  Array.from({ length: n * 2 }, (_, i) => {
    const a = ((rot + (i * 180) / n) * Math.PI) / 180;
    const rr = i % 2 ? ri : R;
    return `${i ? 'L' : 'M'} ${(x + rr * Math.cos(a)).toFixed(2)} ${(y + rr * Math.sin(a)).toFixed(2)}`;
  }).join(' ') + ' Z';
const rays = Array.from({ length: 16 }, (_, i) => {
  const a1 = ((i * 22.5 - 5) * Math.PI) / 180;
  const a2 = ((i * 22.5 + 5) * Math.PI) / 180;
  return `M 50 50 L ${(50 + 80 * Math.cos(a1)).toFixed(2)} ${(50 + 80 * Math.sin(a1)).toFixed(2)} L ${(50 + 80 * Math.cos(a2)).toFixed(2)} ${(50 + 80 * Math.sin(a2)).toFixed(2)} Z`;
}).join(' ');
const tfs = Math.min(22, 104 / Math.max(3, text.length));
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${vbW.toFixed(2)} ${vbH.toFixed(2)}`}
  width={Math.round(vbW * scale)}
  height={Math.round(vbH * scale)}
  role="img"
  aria-label={label}
  class:list={['badgeart', cls]}
>
  <title>{label}</title>
  <defs>
    <clipPath id={id('face')}><circle cx={cx} cy={cy} r={faceR} /></clipPath>
    {/* закатной: край картинки заворачивается — к краю темнее */}
    <radialGradient id={id('wrap')} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0.8" stop-color="#000" stop-opacity="0" />
      <stop offset="0.93" stop-color="#000" stop-opacity="0.1" />
      <stop offset="1" stop-color="#000" stop-opacity="0.32" />
    </radialGradient>
    <linearGradient id={id('metal')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f5f5f6" />
      <stop offset="0.35" stop-color="#c3c6cc" />
      <stop offset="0.6" stop-color="#eeeef0" />
      <stop offset="1" stop-color="#9a9ea6" />
    </linearGradient>
    <radialGradient id={id('tin')} cx="0.38" cy="0.32" r="0.75">
      <stop offset="0" stop-color="#f4f4f5" />
      <stop offset="0.6" stop-color="#cfd1d5" />
      <stop offset="1" stop-color="#a7abb2" />
    </radialGradient>
    <pattern id={id('dots')} width="7" height="7" patternUnits="userSpaceOnUse">
      <circle cx="3.5" cy="3.5" r="1.1" fill="#000" fill-opacity="0.12" />
    </pattern>
  </defs>

  {/* толщина значка — тёмный край снизу */}
  <circle cx={cx} cy={cy + depth} r={r} fill={view === 'back' ? '#7d828a' : type === 'pin' ? '#8d9199' : '#000'} fill-opacity={view === 'back' || type === 'pin' ? 1 : 0.35} />
  {type === 'roll' && view === 'front' && <circle cx={cx} cy={cy + depth * 0.5} r={r} fill={fill} />}
  {type === 'roll' && view === 'front' && <circle cx={cx} cy={cy + depth * 0.5} r={r} fill="#000" fill-opacity="0.25" />}

  {
    view === 'front' && (
      <g>
        {type === 'pin' && <circle cx={cx} cy={cy} r={r} fill={url('metal')} />}
        <g clip-path={url('face')}>
          <circle cx={cx} cy={cy} r={r} fill={fill} />
          <g transform={art}>
            {motif === 'logo' && (
              <g>
                <rect width="100" height="100" fill={url('dots')} />
                <circle cx="50" cy="50" r="34" fill={K} />
                <circle cx="50" cy="50" r="29" fill={P} />
                <g>
                  <circle cx="42" cy="45" r="12" fill={C} style="mix-blend-mode:multiply" />
                  <circle cx="58" cy="45" r="12" fill={M} style="mix-blend-mode:multiply" />
                  <circle cx="50" cy="59" r="12" fill={Y} style="mix-blend-mode:multiply" />
                </g>
              </g>
            )}
            {motif === 'text' && (
              <g>
                <rect width="100" height="100" fill={url('dots')} />
                <rect x="-5" y="38" width="110" height="24" fill={K} transform="rotate(-8 50 50)" />
                <text x="50" y={50 + tfs * 0.36} font-size={tfs} font-weight="900" text-anchor="middle" fill={Y} transform="rotate(-8 50 50)">
                  {text}
                </text>
                <path d={starPath(30, 24, 7, 3)} fill={Y} />
                <path d={starPath(72, 78, 6, 2.6)} fill={P} />
              </g>
            )}
            {motif === 'star' && (
              <g>
                <path d={rays} fill={P} fill-opacity="0.22" />
                <path d={starPath(50, 52, 30, 13)} fill={Y} stroke={K} stroke-width="2.4" stroke-linejoin="round" />
                <circle cx="44" cy="47" r="2.6" fill={K} />
                <circle cx="56" cy="47" r="2.6" fill={K} />
                <path d="M 44 56 Q 50 61 56 56" fill="none" stroke={K} stroke-width="2.2" stroke-linecap="round" />
              </g>
            )}
            {motif === 'heart' && (
              <g>
                <rect width="100" height="100" fill={url('dots')} />
                <path d="M 50 76 C 22 58 16 44 22 34 C 28 24 43 24 50 36 C 57 24 72 24 78 34 C 84 44 78 58 50 76 Z" fill={M} stroke={K} stroke-width="2.4" stroke-linejoin="round" />
                <path d="M 31 37 Q 33 31 39 31" fill="none" stroke={P} stroke-width="3" stroke-linecap="round" />
              </g>
            )}
            {motif === 'smile' && (
              <g>
                <circle cx="37" cy="42" r="5" fill={K} />
                <circle cx="63" cy="42" r="5" fill={K} />
                <path d="M 28 58 Q 50 80 72 58" fill="none" stroke={K} stroke-width="5" stroke-linecap="round" />
                <circle cx="26" cy="58" r="5" fill={M} fill-opacity="0.45" />
                <circle cx="74" cy="58" r="5" fill={M} fill-opacity="0.45" />
              </g>
            )}
          </g>
          {type === 'roll' && <circle cx={cx} cy={cy} r={r} fill={url('wrap')} />}
        </g>
        {/* блик плёнки / металла */}
        <path
          d={`M ${cx - faceR * 0.72} ${cy - faceR * 0.28} A ${faceR * 0.78} ${faceR * 0.78} 0 0 1 ${cx - faceR * 0.12} ${cy - faceR * 0.76}`}
          fill="none"
          stroke="#fff"
          stroke-opacity={type === 'roll' ? 0.55 : 0.4}
          stroke-width={Math.max(0.5, size * 0.035)}
          stroke-linecap="round"
        />
        {type === 'pin' && <circle cx={cx} cy={cy} r={faceR} fill="none" stroke="#000" stroke-opacity="0.18" stroke-width={Math.max(0.2, size * 0.01)} />}
      </g>
    )
  }

  {
    view === 'back' && type === 'roll' && (
      <g>
        {/* завёрнутый край картинки и жестяная крышка */}
        <circle cx={cx} cy={cy} r={r} fill={fill} />
        <circle cx={cx} cy={cy} r={r} fill="#000" fill-opacity="0.18" />
        <circle cx={cx} cy={cy} r={r * 0.9} fill={url('tin')} stroke="#8a8e95" stroke-width={size * 0.006} />
        {/* булавка: пластина, игла, замок */}
        <rect x={cx - r * 0.62} y={cy + r * 0.02} width={r * 1.24} height={r * 0.16} rx={r * 0.06} fill="#9ca0a7" stroke="#6f737a" stroke-width={size * 0.006} />
        <path
          d={`M ${cx - r * 0.56} ${cy + r * 0.1} L ${cx - r * 0.62} ${cy - r * 0.08} L ${cx + r * 0.58} ${cy - r * 0.08}`}
          fill="none"
          stroke="#55595f"
          stroke-width={Math.max(0.35, size * 0.016)}
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d={`M ${cx + r * 0.5} ${cy - r * 0.2} q ${r * 0.16} 0 ${r * 0.16} ${r * 0.12} t ${-r * 0.16} ${r * 0.12}`}
          fill="none"
          stroke="#55595f"
          stroke-width={Math.max(0.35, size * 0.016)}
          stroke-linecap="round"
        />
        <path d={`M ${cx - r * 0.5} ${cy - r * 0.55} A ${r * 0.7} ${r * 0.7} 0 0 1 ${cx + r * 0.1} ${cy - r * 0.72}`} fill="none" stroke="#fff" stroke-opacity="0.6" stroke-width={size * 0.03} stroke-linecap="round" />
      </g>
    )
  }

  {
    view === 'back' && type === 'pin' && (
      <g>
        <circle cx={cx} cy={cy} r={r} fill={url('tin')} stroke="#7d828a" stroke-width={Math.max(0.2, size * 0.012)} />
        {/* цанга-«бабочка» на штифте: размер у неё постоянный, около 9 мм */}
        <g transform={`translate(${cx} ${cy})`}>
          <path d="M -4.6 -2.6 Q -4.6 -3.4 -3.8 -3.4 H 3.8 Q 4.6 -3.4 4.6 -2.6 V 2.6 Q 4.6 3.4 3.8 3.4 H -3.8 Q -4.6 3.4 -4.6 2.6 Z" fill="#c9a43a" stroke="#8a6d18" stroke-width="0.3" />
          <circle cx="-2.6" cy="0" r="1.6" fill="none" stroke="#8a6d18" stroke-width="0.45" />
          <circle cx="2.6" cy="0" r="1.6" fill="none" stroke="#8a6d18" stroke-width="0.45" />
          <circle cx="0" cy="0" r="0.75" fill="#55595f" />
          <path d="M -3.6 -2.6 H 2" stroke="#fff" stroke-opacity="0.55" stroke-width="0.45" stroke-linecap="round" />
        </g>
      </g>
    )
  }

  {
    guide && view === 'front' && (
      <g fill="none" stroke-width={1.6 * u}>
        <circle cx={cx} cy={cy} r={r - 0.4 * u} stroke={K} stroke-opacity="0.55" stroke-dasharray={`${4 * u} ${3 * u}`} />
        <circle cx={cx} cy={cy} r={r * 0.78} stroke={P} stroke-dasharray={`${5 * u} ${3 * u}`} />
        <circle cx={cx} cy={cy} r={r * 0.78} stroke={K} stroke-opacity="0.6" stroke-dasharray={`${5 * u} ${3 * u}`} stroke-dashoffset={`${4 * u}`} />
        {/* номера: 1 — край на бортик, 2 — безопасная зона (подписи — на странице) */}
        {[
          { n: 1, rr: r - 0.4 * u, bg: K, fg: P },
          { n: 2, rr: r * 0.78, bg: M, fg: '#fff' },
        ].map((m) => {
          const a = (-130 * Math.PI) / 180;
          const x = cx + m.rr * Math.cos(m.n === 1 ? a : -0.25 * Math.PI);
          const y = cy + m.rr * Math.sin(m.n === 1 ? a : -0.25 * Math.PI);
          return (
            <g>
              <circle cx={x} cy={y} r={Math.max(13 * u, size * 0.06)} fill={m.bg} stroke={P} stroke-width={2 * u} />
              <text x={x} y={y + Math.max(13 * u, size * 0.06) * 0.36} font-size={Math.max(13 * u, size * 0.06)} font-weight="800" text-anchor="middle" fill={m.fg} stroke="none">
                {m.n}
              </text>
            </g>
          );
        })}
      </g>
    )
  }

  {
    dims && (
      <g>
        <path
          d={`M ${cx - r} ${cy + r + depth + 3} v ${4 * u + 2} M ${cx + r} ${cy + r + depth + 3} v ${4 * u + 2} M ${cx - r} ${cy + r + depth + 4 + 2 * u} H ${cx + r}`}
          fill="none"
          stroke={K}
          stroke-width={1.2 * u}
        />
        <rect x={cx - (size >= 30 ? 4.6 : 3.6) * fs * 0.62} y={cy + r + depth + 4 + 2 * u - fs * 0.62} width={(size >= 30 ? 4.6 : 3.6) * fs * 1.24} height={fs * 1.24} rx={fs * 0.4} fill={Y} />
        <text x={cx} y={cy + r + depth + 4 + 2 * u + fs * 0.36} font-size={fs} font-weight="800" text-anchor="middle" fill={K} class="mono">
          {size} мм
        </text>
      </g>
    )
  }
</svg>

<style>
  .badgeart {
    display: block;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }
</style>

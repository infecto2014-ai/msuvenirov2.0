---
// ServiceBlock[] (src/data/types.ts) drawn in the «Ink» look for the content pages (О нас, Требования к макетам):
// each block is its own band (white / light grey alternate), heading = icon in a circle + eyebrow + h2,
// feature cards = glass with an icon instead of a number, tables = glass, text = calm column ≤ 72 characters.
import InkHead from './InkHead.astro';
import { ink, pickIcon } from './icons';
import type { ServiceBlock } from '@/data/types';

interface Props {
  blocks: ServiceBlock[];
  /** tone of the first band: 'plain' (white) or 'tint' (light grey) */
  start?: 'plain' | 'tint';
}
const { blocks, start = 'plain' } = Astro.props;

const headIcon = (b: ServiceBlock) =>
  pickIcon(b.title, 0, [
    [/кто мы/, 'heart'],
    [/доверя/, 'shield'],
    [/технолог/, 'layers'],
    [/найти/, 'pin'],
    [/требован/, 'check'],
    [/вылет|безопасн/, 'ruler'],
    [/макет/, 'pencil'],
  ], [b.kind === 'compare' ? 'layers' : b.kind === 'steps' ? 'check' : 'star']);
const eyebrowOf = (b: ServiceBlock) => (b.kind === 'compare' ? 'Сравнение' : b.kind === 'steps' ? 'Шаги' : b.kind === 'features' ? 'Коротко' : 'О нас');
const featIcon = (t: string, i: number) =>
  pickIcon(t, i, [
    [/производств/, 'factory'],
    [/от 1 шт/, 'box'],
    [/срочн/, 'bolt'],
    [/помощь|макет/, 'pencil'],
    [/совет/, 'chat'],
    [/частных|компаний/, 'building'],
    [/форматы/, 'file'],
    [/разрешен/, 'image'],
    [/шрифт/, 'type'],
    [/размер/, 'ruler'],
  ], ['star', 'check', 'layers', 'heart']);
const stepIcon = (i: number) => ['chat', 'pencil', 'check', 'box', 'gift'][i % 5];
const tone = (i: number) => ((i + (start === 'tint' ? 1 : 0)) % 2 === 1 ? 'band band-tint' : 'band');
---

{
  blocks.map((b, bi) => (
    <div class={tone(bi)}>
      <section class="section ib" aria-labelledby={`ib-${bi}`}>
        <div class="wrap">
          <InkHead icon={headIcon(b)} eyebrow={eyebrowOf(b)} id={`ib-${bi}`} title={b.title} />

          {b.kind === 'text' && (
            <div class="ib-text">
              {b.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          )}

          {(b.kind === 'features' || b.kind === 'ideas' || b.kind === 'links') && (
            <ul class="ib-cards">
              {b.items.map((it, i) => (
                <li class="ib-card">
                  <span class="ib-ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d={ink[featIcon(it.title, i)]} />
                    </svg>
                  </span>
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </li>
              ))}
            </ul>
          )}

          {b.kind === 'steps' && (
            <ol class="ib-steps">
              {b.items.map((it, i) => (
                <li class="ib-card">
                  <span class="ib-ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d={ink[stepIcon(i)]} />
                    </svg>
                  </span>
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </li>
              ))}
            </ol>
          )}

          {b.kind === 'compare' && (
            <div class="ib-table">
              <table>
                <thead>
                  <tr>
                    <th scope="col">
                      <span class="sr-only">Параметр</span>
                    </th>
                    {b.columns.map((c) => (
                      <th scope="col">{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {b.rows.map((r) => (
                    <tr>
                      <th scope="row">{r.label}</th>
                      {r.values.map((v, vi) => (
                        <td data-label={b.columns[vi]}>{v}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </section>
    </div>
  ))
}

<style>
  .ib {
    padding-block: clamp(40px, 5.5vw, 76px);
  }
  .ib-text {
    max-width: 72ch;
    display: grid;
    gap: 1em;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .ib-text p {
    margin: 0;
  }
  .ib-cards,
  .ib-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  /* glass cards: white glass on light bands */
  .ib-card {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.4);
    outline: 1px solid #e5e5e5;
    outline-offset: -1px;
  }
  .ib-ico {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--navy, #14213d);
    color: #fff;
  }
  .ib-card h3 {
    margin: 4px 0 0;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .ib-card p {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .ib-steps {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  /* glass table */
  .ib-table {
    overflow-x: auto;
    border-radius: 28px;
    border: 1px solid #e5e5e5;
    background: rgba(255, 255, 255, 0.8);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.4);
  }
  .ib-table table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.96rem;
  }
  .ib-table th,
  .ib-table td {
    padding: 16px 20px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid #e5e5e5;
    line-height: 1.5;
  }
  .ib-table thead th {
    background: var(--navy, #14213d);
    color: #fff;
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ib-table tbody th {
    width: 24%;
    font-weight: 700;
    color: #000;
  }
  .ib-table tbody tr:last-child th,
  .ib-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .ib-table tbody tr:hover td,
  .ib-table tbody tr:hover th {
    background: rgba(20, 33, 61, 0.04);
  }
  @media (max-width: 760px) {
    .ib {
      padding-block: 32px;
    }
    .ib-card {
      grid-template-columns: 44px minmax(0, 1fr);
      column-gap: 14px;
      row-gap: 4px;
      align-items: center;
      padding: 16px;
      border-radius: 22px;
    }
    .ib-card .ib-ico {
      grid-row: span 2;
      width: 44px;
      height: 44px;
      align-self: start;
    }
    .ib-card h3 {
      margin: 0;
      font-size: 1.05rem;
    }
    .ib-card p {
      grid-column: 2;
      font-size: 0.92rem;
    }
    .ib-cards,
    .ib-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .ib-text {
      font-size: 1rem;
    }
    /* table → cards: row name as a title, then «column: value» lines */
    .ib-table {
      overflow: visible;
      border: 0;
      background: none;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .ib-table table,
    .ib-table tbody,
    .ib-table tr,
    .ib-table th,
    .ib-table td {
      display: block;
      min-width: 0;
    }
    .ib-table thead {
      display: none;
    }
    .ib-table tbody {
      display: grid;
      gap: 10px;
    }
    .ib-table tbody tr {
      padding: 14px 16px;
      border-radius: 22px;
      border: 1px solid #e5e5e5;
      background: rgba(255, 255, 255, 0.85);
    }
    .ib-table th,
    .ib-table td,
    .ib-table tbody tr:last-child th,
    .ib-table tbody tr:last-child td {
      padding: 0;
      border: 0;
    }
    .ib-table tbody th {
      width: auto;
      margin-bottom: 6px;
      font-size: 1.02rem;
    }
    .ib-table td {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 10px;
      padding-block: 4px;
      font-size: 0.9rem;
    }
    .ib-table td::before {
      content: attr(data-label);
      color: var(--muted);
      font-size: 0.78rem;
    }
  }
</style>

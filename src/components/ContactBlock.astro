---
import Icon from './Icon.astro';
import { site } from '@/data/site';
interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${site.address.lng}%2C${site.address.lat}&z=16&pt=${site.address.lng},${site.address.lat},pm2rdm`;
---

<section class="section contact" aria-labelledby="contact-h">
  <div class="wrap contact-grid">
    <div class="contact-card">
      <p class="eyebrow">Контакты</p>
      <H id="contact-h">Приходите в мастерскую</H>
      <ul class="contact-list">
        <li><span class="cl-ico" aria-hidden="true"><Icon name="pin" size={20} /></span> <span>г. {site.address.city}, {site.address.street}<br />{site.address.place}</span></li>
        <li><span class="cl-ico" aria-hidden="true"><Icon name="clock" size={20} /></span> <span>{site.hours}</span></li>
        <li><span class="cl-ico" aria-hidden="true"><Icon name="phone" size={20} /></span> <a class="mono" href={site.phoneHref}>{site.phone}</a></li>
        <li><span class="cl-ico" aria-hidden="true"><Icon name="mail" size={20} /></span> <a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
      <div class="contact-actions">
        <a class="btn btn-magenta" href={site.social.telegram} target="_blank" rel="noopener"><Icon name="telegram" size={18} /> Telegram</a>
        <a class="btn btn-ghost" href={site.social.max} target="_blank" rel="noopener"><Icon name="max" size={18} /> MAX</a>
        <a class="btn btn-ghost" href={site.social.vk} target="_blank" rel="noopener"><Icon name="vk" size={18} /> ВКонтакте</a>
      </div>
    </div>
    <div class="contact-map" data-map={mapSrc}>
      <button type="button" class="contact-map-btn">
        <span class="contact-map-pill">Показать на карте</span>
        <span class="contact-map-hint">Карта загрузится по нажатию</span>
      </button>
      <a class="contact-map-link" href={site.yandexMapsOrg} target="_blank" rel="noopener">Открыть в Яндекс Картах →</a>
    </div>
  </div>
</section>

<script>
  // The map iframe is heavy: load it only when asked.
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.map!;
      f.title = 'Мастерская сувениров на карте';
      f.loading = 'lazy';
      f.allowFullscreen = true;
      box.querySelector('button')?.replaceWith(f);
    });
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 20px;
  }
  .contact-card {
    padding: clamp(26px, 4vw, 44px);
    border-radius: 32px;
  }
  .contact-list {
    list-style: none;
    margin: 24px 0;
    padding: 0;
    display: grid;
    gap: 12px;
    font-size: 1.05rem;
  }
  .contact-list li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 12px 14px;
    border-radius: 20px;
    border: 1px solid #e5e5e5;
    background: rgba(242, 242, 242, 0.6);
  }
  .cl-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--navy, #14213d);
    color: #fff;
  }
  .contact-list .cl-ico :global(svg) {
    margin: 0;
    color: #fff;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .contact-map {
    position: relative;
    min-height: 380px;
    border-radius: 32px;
    overflow: clip;
    border: 1px solid #e5e5e5;
    background: linear-gradient(135deg, #f2f2f2, #e5e5e5);
  }
  .contact-map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .contact-map-btn {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .contact-map-pill {
    padding: 14px 26px;
    border-radius: 999px;
    background: var(--navy, #14213d);
    color: #fff;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }
  .contact-map-btn:hover .contact-map-pill {
    background: #000;
  }
  .contact-map-hint {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .contact-map-link {
    position: absolute;
    left: 16px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  /* phones: compact card, buttons in one row, smaller map */
  @media (max-width: 560px) {
    .contact-card {
      padding: 20px 18px;
    }
    .contact-list li {
      padding: 10px 12px;
      font-size: 0.98rem;
    }
    .contact-actions {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
    }
    .contact-actions .btn {
      justify-content: center;
      padding-inline: 6px;
      font-size: 0.82rem;
    }
    .contact-actions .btn :global(svg) {
      display: none;
    }
    .contact-map {
      min-height: 190px;
    }
  }
</style>

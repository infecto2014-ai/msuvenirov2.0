---
import Icon from './Icon.astro';
import { site } from '@/data/site';
---

<nav class="mbar" aria-label="Быстрые действия">
  <a href={site.phoneHref}><Icon name="phone" /><span>Позвонить</span></a>
  <button type="button" data-chat><Icon name="chat" /><span>Чат</span></button>
  <a href="/price"><Icon name="calc" /><span>Цена</span></a>
  <button type="button" data-order class="mbar-cta"><Icon name="upload" /><span>Заявка</span></button>
</nav>

<style>
  .mbar {
    display: none;
  }
  @media (max-width: 760px) {
    .mbar {
      position: fixed;
      left: 8px;
      right: 8px;
      bottom: calc(8px + env(safe-area-inset-bottom));
      z-index: 45;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 4px;
      padding: 6px;
      border-radius: 24px;
      background: var(--ink);
      box-shadow: 0 16px 30px -12px rgba(3, 32, 48, 0.6);
    }
    .mbar a,
    .mbar button {
      display: grid;
      justify-items: center;
      gap: 2px;
      padding: 8px 2px;
      border: 0;
      border-radius: 18px;
      background: none;
      color: var(--paper);
      font-size: 0.72rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
    }
    .mbar .mbar-cta {
      background: var(--m);
      color: #fff;
    }
  }
</style>

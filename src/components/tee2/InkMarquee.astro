---
// A tilted ink ribbon with facts scrolling across (idea: 21st «Marquee»). Decorative copy of facts that are on the
// page anyway; paused on hover and stopped with reduced motion (skill: no endless motion you cannot stop).
interface Props {
  items: string[];
  tone?: 'ink' | 'y';
}
const { items, tone = 'ink' } = Astro.props;
const row = [...items, ...items];
---

<div class="im-clip" aria-hidden="true">
<div class:list={['im', `im-${tone}`]}>
  <div class="im-track">
    {
      [0, 1].map(() => (
        <span class="im-run">
          {row.map((t, i) => (
            <span class="im-item">
              {t}
              <i class={`im-dot im-dot-${i % 3}`} />
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>
</div>

<style>
  /* the ribbon is tilted wider than the screen; the wrapper clips it so the page never scrolls sideways */
  .im-clip {
    overflow: clip;
    padding-block: 18px;
    margin-block: -18px;
    position: relative;
    z-index: 2;
  }
  .im {
    position: relative;
    margin: -14px -2%;
    overflow: hidden;
    transform: rotate(-2deg);
    padding-block: 14px;
    box-shadow: 0 14px 26px -18px rgba(22, 20, 27, 0.6);
  }
  .im-ink {
    background: #16141b;
    color: #fffcf5;
  }
  .im-y {
    background: var(--y);
    color: #16141b;
  }
  .im-track {
    display: flex;
    width: max-content;
    animation: im-run 38s linear infinite;
  }
  .im:hover .im-track {
    animation-play-state: paused;
  }
  .im-run {
    display: flex;
  }
  .im-item {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding-right: 22px;
    font-weight: 900;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .im-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .im-dot-0 { background: var(--c); }
  .im-dot-1 { background: var(--m); }
  .im-dot-2 { background: var(--y); }
  .im-y .im-dot-2 { background: #16141b; }
  @keyframes im-run {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .im-track {
      animation: none;
    }
  }
</style>

---
// T-shirt page, variant 2 (owner, 07.11.2026: «сделать ещё круче», 21st + ui-ux-pro-max).
// Left: a poster headline whose last line keeps swapping («для мамы» → «для команды» …) with a round photo sticker
// of a real job popping in (idea: 21st «Animated Sticker Headline Hero»). Pause button, stops on hover/focus and
// with reduced motion (skill: auto-rotating content needs a stop control).
// Right: a big t-shirt in colourways — tap a colour, the shirt and the price tag change (idea: 21st «Sneaker
// Product Page Hero»). Prices from pricing.ts only.
import '@fontsource/caveat/600.css';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import logoSvg from '@/assets/logo.svg?raw';
import { rub } from '@/data/pricing';
import type { GarmentInfo } from '@/data/types';

interface Props {
  crumbs: { name: string; href: string }[];
  lead: string;
  info: GarmentInfo;
  /** lowest price of a t-shirt with print, from pricing.ts */
  from: number;
}
const { crumbs, lead, info, from } = Astro.props;

const words = [
  { w: 'для мамы', img: '/portfolio/dtf-bestdad.webp', alt: 'Футболка с фото в подарок' },
  { w: 'для команды', img: '/portfolio/portfolio-20.webp', alt: 'Футболки для команды' },
  { w: 'на свадьбу', img: '/portfolio/wedding-tshirts.webp', alt: 'Парные свадебные футболки' },
  { w: 'для фанатов', img: '/portfolio/kpop-tshirt.webp', alt: 'Футболка с авторским артом' },
  { w: 'для себя', img: '/portfolio/portfolio-15.webp', alt: 'Футболка со своим рисунком' },
];
const isLight = (hex: string) => {
  const n = parseInt(hex.replace('#', ''), 16);
  const lum = 0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255);
  return lum > 150;
};
const colors = info.colors.map((c) => ({ ...c, print: isLight(c.hex) ? '#16141b' : '#ffffff' }));
const first = colors[0];
const logo = logoSvg.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---

<section class="h2v" data-h2v>
  <div class="wrap h2v-grid">
    <div class="h2v-text">
      <Breadcrumbs items={crumbs} />
      <h1 class="h2v-title">
        <span class="h2v-line">Печать на футболках</span>
        <span class="h2v-rot" aria-live="off">
          {
            words.map((x, i) => (
              <span class:list={['h2v-word', { 'is-on': i === 0 }]} data-word={i}>
                {x.w}
              </span>
            ))
          }
          <span class="h2v-sticker" aria-hidden="true">
            {words.map((x, i) => <img class:list={{ 'is-on': i === 0 }} src={x.img} alt="" width="160" height="160" data-st={i} decoding="async" />)}
          </span>
        </span>
        <span class="sr-only"> в Калининграде</span>
      </h1>
      <p class="h2v-city">в Калининграде — <span class="h2v-hand">от одной штуки</span></p>
      <p class="h2v-lead">{lead}</p>
      <div class="h2v-actions">
        <a class="btn btn-magenta" href="#calc"><Icon name="calc" size={20} /> <span>Рассчитать стоимость</span></a>
        <button type="button" class="btn btn-ghost" data-order><Icon name="upload" size={20} /> <span>Отправить макет</span></button>
        <button type="button" class="h2v-pause" data-pause aria-pressed="false" aria-label="Остановить смену надписей">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path class="i-pause" d="M7 5h3v14H7zM14 5h3v14h-3z" /><path class="i-play" d="M8 5v14l11-7z" /></svg>
        </button>
      </div>
    </div>

    <div class="h2v-stage" style={`--shirt:${first.hex};--print:${first.print}`} data-stage>
      <span class="h2v-blob" aria-hidden="true"></span>
      <div class="h2v-shirt" aria-hidden="true">
        <svg viewBox="0 0 300 320">
          <defs>
            <linearGradient id="h2v-fold" x1="0" x2="1">
              <stop offset="0" stop-color="#000" stop-opacity="0.18" />
              <stop offset="0.28" stop-color="#000" stop-opacity="0" />
              <stop offset="0.72" stop-color="#000" stop-opacity="0" />
              <stop offset="1" stop-color="#000" stop-opacity="0.18" />
            </linearGradient>
          </defs>
          <path class="h2v-body" d="M104 16c14 22 78 22 92 0l56 22 44 60-42 30-20-16v200c0 6-4 10-10 10H76c-6 0-10-4-10-10V112l-20 16L4 98l44-60z" />
          <path d="M104 16c14 22 78 22 92 0l56 22 44 60-42 30-20-16v200c0 6-4 10-10 10H76c-6 0-10-4-10-10V112l-20 16L4 98l44-60z" fill="url(#h2v-fold)" />
          <path class="h2v-collar" d="M104 16c14 30 78 30 92 0" />
        </svg>
        <span class="h2v-logo" set:html={logo} />
      </div>
      <span class="h2v-shadow" aria-hidden="true"></span>
      <p class="h2v-price">
        <span>от</span> <b class="mono">{rub(from)}</b>
        <small>с печатью</small>
      </p>
      <div class="h2v-swatches" role="radiogroup" aria-label="Цвет футболки">
        {
          colors.map((c, i) => (
            <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} class="h2v-sw" style={`--c:${c.hex}`} data-hex={c.hex} data-print={c.print} data-name={c.name} title={c.name}>
              <span class="sr-only">{c.name}</span>
            </button>
          ))
        }
      </div>
      <p class="h2v-colorname" data-colorname>{first.name}</p>
    </div>
  </div>
</section>

<script>
  // headline words: swap every 2.6 s; stop on hover/focus, with the pause button, and with reduced motion
  document.querySelectorAll<HTMLElement>('[data-h2v]').forEach((root) => {
    const words = [...root.querySelectorAll<HTMLElement>('[data-word]')];
    const stickers = [...root.querySelectorAll<HTMLElement>('[data-st]')];
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let paused = reduce;
    let hover = false;
    if (reduce) pauseBtn.hidden = true;
    const show = (n: number) => {
      words.forEach((w, k) => w.classList.toggle('is-on', k === n));
      stickers.forEach((s, k) => s.classList.toggle('is-on', k === n));
    };
    setInterval(() => {
      if (paused || hover || document.hidden) return;
      i = (i + 1) % words.length;
      show(i);
    }, 2600);
    const rot = root.querySelector('.h2v-rot')!;
    rot.addEventListener('mouseenter', () => (hover = true));
    rot.addEventListener('mouseleave', () => (hover = false));
    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.setAttribute('aria-label', paused ? 'Продолжить смену надписей' : 'Остановить смену надписей');
    });

    // colourways
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const name = root.querySelector<HTMLElement>('[data-colorname]')!;
    const sws = [...root.querySelectorAll<HTMLButtonElement>('.h2v-sw')];
    const pick = (b: HTMLButtonElement) => {
      sws.forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      stage.style.setProperty('--shirt', b.dataset.hex!);
      stage.style.setProperty('--print', b.dataset.print!);
      name.textContent = b.dataset.name!;
    };
    sws.forEach((b, k) => {
      b.addEventListener('click', () => pick(b));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const nb = sws[(k + d + sws.length) % sws.length];
        pick(nb);
        nb.focus();
      });
    });
  });
</script>

<style>
  .h2v {
    position: relative;
    overflow: clip;
    padding-block: clamp(20px, 3vw, 36px) clamp(40px, 6vw, 80px);
  }
  .h2v-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  .h2v-text {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .h2v-title {
    display: grid;
    margin: 6px 0 0;
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  /* rotating line: words stacked in one cell, the visible one slides in from below */
  .h2v-rot {
    position: relative;
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: center;
    justify-content: start;
    gap: 0.18em;
    color: var(--red);
  }
  .h2v-word {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.45em) rotate(2deg);
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.2, 0.9, 0.2, 1.2);
    background: linear-gradient(transparent 62%, rgba(255, 210, 31, 0.85) 62% 94%, transparent 94%);
  }
  .h2v-word.is-on {
    opacity: 1;
    transform: none;
  }
  /* round die-cut photo sticker next to the word */
  .h2v-sticker {
    grid-area: 1 / 2;
    position: relative;
    width: 1.15em;
    height: 1.15em;
  }
  .h2v-sticker img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 0.06em solid #fff;
    box-shadow: 0 0.06em 0.14em rgba(22, 20, 27, 0.35);
    opacity: 0;
    transform: scale(0.3) rotate(-30deg);
    transition: opacity 0.25s ease, transform 0.5s cubic-bezier(0.3, 1.6, 0.4, 1);
  }
  .h2v-sticker img.is-on {
    opacity: 1;
    transform: rotate(-8deg);
  }
  .h2v-city {
    margin: 0;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-weight: 800;
  }
  .h2v-hand {
    font-family: 'Caveat', cursive;
    font-weight: 600;
    font-size: 1.35em;
    color: var(--m-ink, #b0005f);
  }
  .h2v-lead {
    margin: 0;
    max-width: 48ch;
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .h2v-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
  }
  .h2v-pause {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .h2v-pause .i-play,
  .h2v-pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  .h2v-pause[aria-pressed='true'] .i-play {
    display: block;
  }
  .h2v-pause svg {
    fill: currentColor;
  }

  /* ---------- stage with the t-shirt */
  .h2v-stage {
    position: relative;
    display: grid;
    justify-items: center;
    padding-top: 10px;
  }
  .h2v-blob {
    position: absolute;
    inset: 4% 6% 18%;
    z-index: -1;
    border-radius: 46% 54% 42% 58% / 55% 44% 56% 45%;
    background:
      radial-gradient(circle at 30% 30%, rgba(0, 160, 220, 0.35), transparent 60%),
      radial-gradient(circle at 75% 35%, rgba(229, 0, 125, 0.28), transparent 60%),
      radial-gradient(circle at 50% 80%, rgba(255, 210, 31, 0.5), transparent 60%);
    filter: blur(6px);
  }
  .h2v-shirt {
    position: relative;
    width: min(100%, 440px);
    animation: h2v-float 5s ease-in-out infinite;
  }
  .h2v-shirt svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 18px rgba(22, 20, 27, 0.18));
  }
  .h2v-body {
    fill: var(--shirt);
    stroke: rgba(22, 20, 27, 0.18);
    stroke-width: 1.5;
    transition: fill 0.35s ease;
  }
  .h2v-collar {
    fill: none;
    stroke: rgba(22, 20, 27, 0.22);
    stroke-width: 4;
  }
  .h2v-logo {
    position: absolute;
    left: 50%;
    top: 30%;
    width: 38%;
    transform: translateX(-50%);
    color: var(--print);
    transition: color 0.35s ease;
  }
  .h2v-logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .h2v-shadow {
    width: 52%;
    height: 18px;
    margin-top: -6px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(22, 20, 27, 0.28), transparent);
    animation: h2v-shadow 5s ease-in-out infinite;
  }
  @keyframes h2v-float {
    50% {
      transform: translateY(-12px) rotate(-1deg);
    }
  }
  @keyframes h2v-shadow {
    50% {
      transform: scaleX(0.85);
      opacity: 0.7;
    }
  }
  .h2v-price {
    position: absolute;
    right: 2%;
    top: 12%;
    display: grid;
    justify-items: start;
    margin: 0;
    padding: 10px 16px 12px;
    border-radius: 18px 18px 4px 18px;
    background: var(--y);
    color: #16141b;
    line-height: 1;
    transform: rotate(6deg);
    box-shadow: 0 12px 22px -12px rgba(0, 0, 0, 0.5);
  }
  .h2v-price span {
    font-weight: 800;
    font-size: 0.85rem;
  }
  .h2v-price b {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .h2v-price small {
    font-weight: 700;
    font-size: 0.75rem;
  }
  .h2v-swatches {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 460px;
    margin-top: 12px;
  }
  .h2v-sw {
    width: 30px;
    height: 30px;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 1.5px rgba(22, 20, 27, 0.2);
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .h2v-sw[aria-checked='true'] {
    box-shadow: 0 0 0 2.5px var(--ink);
    transform: scale(1.12);
  }
  .h2v-sw:focus-visible {
    outline: 3px solid var(--c-ink, #006f99);
    outline-offset: 3px;
  }
  .h2v-colorname {
    margin: 6px 0 0;
    font-family: 'Caveat', cursive;
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1;
  }

  @media (max-width: 960px) {
    .h2v-grid {
      grid-template-columns: 1fr;
    }
    .h2v-shirt {
      width: min(80%, 360px);
    }
  }
  @media (max-width: 560px) {
    .h2v-title {
      font-size: 2.3rem;
    }
    .h2v-actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
    .h2v-price {
      right: 0;
      top: 4%;
      padding: 8px 12px 9px;
    }
    .h2v-sw {
      width: 40px;
      height: 40px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .h2v-shirt,
    .h2v-shadow {
      animation: none;
    }
    .h2v-word,
    .h2v-sticker img,
    .h2v-body,
    .h2v-logo {
      transition: none;
    }
  }
</style>

---
// «Для кого»: glass cards with a navy icon circle, a tag pill, a title and a text.
import './pp.css';
import TeeHead from '@/components/tee/TeeHead.astro';

interface Props {
  title: string;
  /** word of the title to mark */
  mark?: string;
  eyebrow?: string;
  items: { tag: string; title: string; text: string }[];
}
const { title, mark, eyebrow = 'Для кого', items } = Astro.props;
// four calm icons, cycled
const icons = [
  'M12 20s-8-4.6-8-10.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15.4 12 20 12 20Z',
  'M4 11h16v9H4zM3 7h18v4H3zM12 7v13M12 7c-2.5 0-4.5-1-4.5-2.5S9 2.5 12 7c3-4.5 4.5-3 4.5-1.5S14.5 7 12 7Z',
  'M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5M9 10h.01M15 10h.01M12 10h.01',
  'm12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9Z',
  'M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20M10 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM20 20v-1.5a3.5 3.5 0 0 0-2.6-3.4M15.5 4.7a3.5 3.5 0 0 1 0 6.6',
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM8.5 14.5s1.3 2 3.5 2 3.5-2 3.5-2M9 9.5h.01M15 9.5h.01',
];
---

<section class="section pa pp-sec" aria-labelledby="pa-h">
  <div class="wrap">
    <TeeHead icon="heart" eyebrow={eyebrow} id="pa-h" title={title} mark={mark} />
    <ul class="pa-grid">
      {
        items.map((a, i) => (
          <li class="pa-card pp-card">
            <span class="pp-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[i % icons.length]} />
              </svg>
            </span>
            <span class="pp-tag">{a.tag}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pa-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 14px;
  }
  .pa-card {
    display: grid;
    gap: 10px;
    align-content: start;
    justify-items: start;
    padding: 22px 22px 24px;
  }
  .pa-card :global(p) {
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.5;
  }
  @media (max-width: 760px) {
    .pa-card {
      padding: 18px;
    }
  }
</style>

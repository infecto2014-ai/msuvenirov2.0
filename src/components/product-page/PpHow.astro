---
// «Как заказать»: steps on a route (left), on the right the layout rules (folds on phones), the block for companies
// (and, for calendars, a season note via the `before` slot).
import './pp.css';
import TeeHead from '@/components/tee/TeeHead.astro';
import PpSteps from './PpSteps.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  title: string;
  mark?: string;
  steps: { title: string; text: string }[];
  layout?: { title: string; items: string[] };
  b2b: { title: string; items: string[] };
  /** text of the «Рассчитать тираж» button (data-order); no button when omitted */
  b2bOrder?: string;
}
const { title, mark, steps, layout, b2b, b2bOrder } = Astro.props;
---

<section class="section how pp-sec" aria-labelledby="how-h">
  <div class="wrap how-grid">
    <div class="how-main">
      <TeeHead icon="check" eyebrow="Заказ" id="how-h" title={title} mark={mark} />
      <PpSteps items={steps} />
    </div>
    <aside class="how-side">
      <slot name="before" />
      {
        layout && (
          <details class="how-card pp-card" open data-fold>
            <summary><h3>{layout.title}</h3></summary>
            <ul class="pp-ticks">{layout.items.map((t) => <li>{t}</li>)}</ul>
            <a class="pp-link" href="/trebovaniya-k-maketam">Требования к макетам →</a>
          </details>
        )
      }
      <div class="how-b2b pp-card">
        <h3>{b2b.title}</h3>
        <ul class="pp-ticks">{b2b.items.map((t) => <li>{t}</li>)}</ul>
        <div class="how-b2b-act">
          {
            b2bOrder && (
              <button type="button" class="pk-btn" data-order={b2bOrder}>
                Рассчитать тираж <span class="pk-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
              </button>
            )
          }
          <a class="pp-link" href="/korporativnym-klientam">Корпоративным клиентам →</a>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .how-main :global(.teh) {
    margin-bottom: 22px;
  }
  .how-side {
    display: grid;
    gap: 14px;
    align-content: start;
    padding-top: clamp(0px, 5vw, 76px);
  }
  .how-card,
  .how-b2b {
    display: grid;
    gap: 12px;
    padding: 22px 24px 20px;
  }
  .how-card summary {
    list-style: none;
    cursor: default;
  }
  .how-card summary::-webkit-details-marker {
    display: none;
  }
  .how-card[open] summary {
    margin-bottom: 12px;
  }
  .how-b2b-act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
  }
  .how-b2b-act .pk-btn {
    margin-top: 0;
  }
  @media (max-width: 960px) {
    .how-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .how-side {
      padding-top: 0;
    }
  }
  @media (max-width: 760px) {
    .how-card summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 44px;
      cursor: pointer;
    }
    .how-card summary::after {
      content: '';
      width: 10px;
      height: 10px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg);
      margin-right: 4px;
      transition: transform 0.2s ease;
    }
    .how-card[open] summary::after {
      transform: rotate(-135deg);
    }
    .how-card,
    .how-b2b {
      padding: 14px 18px;
    }
  }
</style>

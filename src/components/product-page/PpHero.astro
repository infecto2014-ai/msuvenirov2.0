---
// First screen of the standalone product pages in the «Ink» look of the t-shirt page (TeeHero): a rounded white frame,
// copy on the left (h1 with a marker word, lead, two buttons, three navy glass fact cards), the drawing of the product
// on a light glass panel on the right with a price chip. The drawing goes into the slot.
//   stage="fixed": the slot is drawn on a 440×440 stage zoomed with the panel (mugs, caps, badges, stickers);
//   stage="free": the slot fills the square panel and is laid out in % (calendars on a wall).
import './pp.css';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import HeroFacts from '@/components/tshirt/HeroFacts.astro';

interface Props {
  eyebrow: string;
  h1: string;
  lead: string;
  crumbs: { name: string; href: string }[];
  /** word(s) of the h1 to mark */
  mark: string;
  heroAlt: string;
  facts: { big: string; small: string }[];
  /** price chip: «от 250 ₽» + caption; `pre` is the small word before the number */
  price: { pre?: string; value: string; note: string };
  stage?: 'fixed' | 'free';
}
const { eyebrow, h1, lead, crumbs, mark, heroAlt, facts, price, stage = 'fixed' } = Astro.props;
const at = h1.indexOf(mark);
const parts = at >= 0 ? [h1.slice(0, at), mark, h1.slice(at + mark.length)] : [h1, '', ''];
const nb = (s: string) => s.replace(/ (?=\S{1,3}(?: |$))/g, ' ');
---

<section class="ph" aria-labelledby="ph-h">
  <div class="ph-frame">
    <div class="ph-copy">
      <Breadcrumbs items={crumbs} />
      <p class="ph-eyebrow">{eyebrow}</p>
      <h1 id="ph-h" class="ph-title">{parts[0]}{parts[1] && <span class="serif">{parts[1]}</span>}{parts[2].replace(/ в /g, ' в ')}</h1>
      <p class="ph-lead">{nb(lead)}</p>
      <div class="ph-actions">
        <a class="ph-btn ph-btn-main" href="#calc">Рассчитать стоимость <span class="ph-btn-go" aria-hidden="true"><Icon name="arrow" size={16} /></span></a>
        <button type="button" class="ph-btn ph-btn-glass" data-order><span class="ph-btn-ico" aria-hidden="true"><Icon name="upload" size={16} /></span> Отправить макет</button>
      </div>
      <HeroFacts facts={facts} />
    </div>
    <div class="ph-media" role="img" aria-label={heroAlt}>
      <div class:list={['ph-panel', `ph-panel-${stage}`]} aria-hidden="true">
        {stage === 'fixed' ? <div class="ph-stage"><slot /></div> : <slot />}
      </div>
      <p class="ph-price">{price.pre && <span>{price.pre}</span>} <b>{price.value}</b> <small>{price.note}</small></p>
    </div>
  </div>
</section>

<style>
  .ph {
    margin-top: 12px;
    padding-inline: 12px;
  }
  .ph-frame {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    max-width: 1500px;
    margin-inline: auto;
    padding: clamp(20px, 3vw, 36px) clamp(20px, 4vw, 56px) clamp(24px, 3vw, 40px);
    border-radius: 32px;
    overflow: clip;
    background:
      radial-gradient(60% 80% at 100% 10%, rgba(20, 33, 61, 0.07), transparent 65%),
      linear-gradient(180deg, #fff 0%, #f6f7f9 100%);
    color: var(--ink);
  }
  .ph-copy {
    display: grid;
    justify-items: start;
    gap: 0;
    max-width: 640px;
  }
  .ph-copy :global(.crumbs) {
    margin-bottom: 18px;
  }
  .ph-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2, #14213d);
  }
  .ph-eyebrow::before {
    content: '';
    width: 24px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .ph-title {
    margin: 0;
    font-size: clamp(2.4rem, 4.4vw, 3.9rem);
    line-height: 1.03;
    font-weight: 800 !important;
    letter-spacing: -0.03em;
    color: #000;
    text-wrap: balance;
  }
  .ph-lead {
    margin: 22px 0 0;
    max-width: 32em;
    font-size: 1.06rem;
    line-height: 1.55;
    color: var(--navy, #14213d);
  }
  .ph-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 30px;
  }
  .ph-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .ph-btn-main {
    padding: 7px 7px 7px 24px;
    border: 0;
    background: var(--navy, #14213d);
    color: #fff;
  }
  .ph-btn-main:hover {
    background: #000;
    color: #fff;
  }
  .ph-btn-go,
  .ph-btn-ico {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    flex: none;
    transition: transform 0.2s ease;
  }
  .ph-btn-go {
    background: #fff;
    color: var(--navy, #14213d);
  }
  .ph-btn-main:hover .ph-btn-go {
    transform: translateX(3px);
  }
  .ph-btn-glass {
    padding: 7px 24px 7px 7px;
    border: 1px solid rgba(20, 33, 61, 0.18);
    background: rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    color: var(--navy, #14213d);
  }
  .ph-btn-glass:hover {
    background: #fff;
    color: var(--navy, #14213d);
  }
  .ph-btn-ico {
    border: 1px solid rgba(20, 33, 61, 0.25);
  }

  /* the drawing on a light glass panel */
  .ph-media {
    position: relative;
    min-width: 0;
  }
  .ph-panel {
    position: relative;
    aspect-ratio: 1;
    border-radius: 28px;
    overflow: clip;
    border: 1px solid rgba(255, 255, 255, 0.95);
    background: radial-gradient(80% 70% at 50% 35%, #ffffff 0%, #e9ecf2 100%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9) inset, 0 30px 60px -36px rgba(20, 33, 61, 0.5);
  }
  /* a soft «table»: the lower third is a shade darker */
  .ph-panel::after {
    content: '';
    position: absolute;
    inset: 68% 0 0;
    background: linear-gradient(180deg, rgba(20, 33, 61, 0.07), rgba(20, 33, 61, 0.02));
    border-top: 1px solid rgba(20, 33, 61, 0.08);
    pointer-events: none;
  }
  .ph-panel-free::after {
    display: none;
  }
  .ph-stage {
    --hz: 1;
    zoom: var(--hz);
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 440px;
    margin: -220px 0 0 -220px;
  }
  .ph-price {
    position: absolute;
    z-index: 2;
    top: 18px;
    right: 18px;
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.5);
    color: var(--navy, #14213d);
    line-height: 1;
  }
  .ph-price b {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .ph-price span,
  .ph-price small {
    font-size: 0.82rem;
    font-weight: 600;
  }
  .ph-price small {
    color: var(--muted);
  }

  :global(html.motion-ready) .ph-copy {
    animation: lx-fade 0.7s cubic-bezier(0.23, 1, 0.32, 1) 0.1s both;
  }
  :global(html.motion-ready) .ph-media {
    animation: lx-fade 0.8s cubic-bezier(0.23, 1, 0.32, 1) 0.25s both;
  }

  @media (max-width: 1180px) {
    .ph-stage {
      --hz: 0.85;
    }
  }
  @media (max-width: 960px) {
    .ph-frame {
      grid-template-columns: minmax(0, 1fr);
    }
    .ph-media {
      order: -1;
      max-width: 520px;
      width: 100%;
      justify-self: center;
    }
    .ph-copy {
      max-width: none;
    }
    .ph-stage {
      --hz: 0.82;
    }
  }
  @media (max-width: 760px) {
    .ph {
      margin-top: 8px;
      padding-inline: 8px;
    }
    .ph-frame {
      gap: 16px;
      padding: 12px 16px 20px;
      border-radius: 24px;
    }
    .ph-panel {
      aspect-ratio: auto;
      height: 290px;
      border-radius: 22px;
    }
    .ph-panel-free {
      height: auto;
      aspect-ratio: 1.15;
    }
    .ph-stage {
      --hz: 0.64;
    }
    .ph-price {
      top: 12px;
      right: 12px;
      padding: 8px 14px;
    }
    .ph-price b {
      font-size: 1.1rem;
    }
    .ph-price small {
      display: none;
    }
    .ph-copy :global(.crumbs) {
      margin-bottom: 6px;
    }
    .ph-copy :global(.crumbs ol) {
      flex-wrap: nowrap;
      white-space: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .ph-eyebrow {
      margin-bottom: 10px;
      letter-spacing: 0.14em;
    }
    .ph-title {
      font-size: 2.05rem;
    }
    .ph-lead {
      margin-top: 14px;
      font-size: 1rem;
    }
    .ph-actions {
      display: grid;
      width: 100%;
      margin: 20px 0 22px;
    }
    .ph-btn {
      justify-content: space-between;
    }
    .ph-btn-glass {
      justify-content: flex-start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ph-btn,
    .ph-btn-go {
      transition: none;
    }
  }
</style>

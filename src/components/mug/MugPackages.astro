---
// «Готовые варианты» on /pechat-na-kruzhkah: ready orders with the turnkey price from pricing.ts (product.quote).
// Same look as CalendarPackages, the picture is a mug drawing.
import MugArt from '@/components/mug/MugArt.astro';
import { defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import { mugsPage } from '@/data/mugsPage';

const items = mugsPage.packages.map((pk) => {
  const product = findProduct('mugs', pk.product)!;
  const base = defaultSelection(product);
  const sel: Selection = { ...base, qty: pk.qty, options: { ...base.options, ...pk.options } };
  const q = product.quote(sel);
  return { ...pk, unit: q.unit, total: q.total, from: q.from };
});
import TeeHead from '@/components/tee/TeeHead.astro';
import Icon from '@/components/Icon.astro';
import '@/components/product-page/pp.css';
---

<section class="section mpk pp-sec" aria-labelledby="mpk-h">
  <div class="wrap">
    <TeeHead icon="tag" eyebrow="Популярное" id="mpk-h" title="Готовые варианты с ценой" mark="ценой">
      <p class="pp-sub">Цена вместе с кружкой, печатью и макетом. Другое количество или покрытие — в калькуляторе выше.</p>
    </TeeHead>
    <ul class="pk-grid">
      {
        items.map((it) => {
          const label = `${it.title}, ${it.qty} шт — ${it.from ? 'от ' : ''}${rub(it.total)}`;
          return (
            <li class="pk-card pp-card">
              <div class="pk-art pp-art" aria-hidden="true">
                <MugArt type={it.art} finish={it.finish} print={it.print} scale={it.art === 'beer600' ? 0.95 : it.art === 'coffee' ? 1.05 : 1.2} />
                <span class="pk-qty">{it.qty} шт</span>
              </div>
              <div class="pk-body">
                <h3>{it.title}</h3>
                <p class="pk-note">{it.note}</p>
                <p class="pk-price">
                  <b>{it.from && 'от '}{rub(it.total)}</b>
                  {it.qty > 1 && <small>{rub(it.unit)} / шт</small>}
                </p>
                <button type="button" class="pk-btn" data-order={label}>
                  Заказать
                  <span class="pk-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                </button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .mpk { --cols: 5; }
  .pk-art { --art-h: 210px; }
  .pk-art :global(svg) { filter: drop-shadow(0 10px 12px rgba(20, 33, 61, 0.16)); }
</style>

---
// Иллюстрация спецодежды (плоская графика «CMYK 2.0»): куртка, жилет, сигнальный жилет, комбинезон, фартук, поло.
// Вид спереди или сзади; принт — логотип на груди, крупная надпись на спине, маленький логотип на рукаве.
// Рисунок в условных единицах (холст 200 × 224), без растров и внешних шрифтов.
import { isDark, mix } from '@/components/cap/cap-geometry';
import { WW_COLORS, type WorkwearColor, type WorkwearPlace, type WorkwearType, type WorkwearView } from './workwear-types';

interface Props {
  type?: WorkwearType; // по умолчанию 'jacket'
  view?: WorkwearView; // по умолчанию 'front'
  color?: WorkwearColor; // по умолчанию свой у каждой модели
  print?: WorkwearPlace[]; // где принт; по умолчанию спереди — грудь, сзади — спина
  text?: string; // надпись на спине
  zones?: boolean; // пунктирные рамки мест печати с номерами (1 — грудь, 2 — спина, 3 — рукав)
  scale?: number; // px на единицу холста, по умолчанию 1
  title?: string;
  class?: string;
}

const defaults: Record<WorkwearType, WorkwearColor> = { jacket: 'navy', vest: 'graphite', signal: 'orange', overalls: 'navy', apron: 'black', polo: 'white' };
const { type = 'jacket', view = 'front', color: colorIn, text = 'КОМПАНИЯ', zones = false, scale = 1, title, class: cls } = Astro.props;
const color = colorIn ?? defaults[type as WorkwearType];
const printIn = Astro.props.print ?? (view === 'back' ? ['back'] : ['chest']);
const C = WW_COLORS[color as WorkwearColor] ?? WW_COLORS.navy;
const base = C.hex;
const dark = isDark(base);
const shade = mix(base, '#000000', dark ? 0.28 : 0.14);
const edge = mix(base, '#000000', dark ? 0.55 : 0.38);
const seam = dark ? mix(base, '#ffffff', 0.28) : mix(base, '#000000', 0.25);
const ink = type === 'signal' ? '#16141b' : dark ? '#fffcf5' : '#16141b';
const accent = type === 'signal' || color === 'red' ? '#16141b' : '#e5007d';
const hasSleeves = type === 'jacket' || type === 'overalls' || type === 'polo';
const back = view === 'back';

const uid = 'ww' + crypto.randomUUID().slice(0, 8);
const id = (s: string) => `${uid}-${s}`;
const url = (s: string) => `url(#${id(s)})`;

// ---- силуэты (одни и те же спереди и сзади, отличаются детали)
const neck = back ? 'Q 100 26 115 22' : 'Q 100 34 115 22';
const shapes: Record<WorkwearType, { body: string; sleeves?: string[] }> = {
  jacket: {
    body: `M 62 30 L 85 22 ${neck} L 138 30 L 148 96 L 150 204 L 50 204 L 52 96 Z`,
    sleeves: ['M 62 30 L 34 50 L 16 152 L 36 158 L 52 98 Z', 'M 138 30 L 166 50 L 184 152 L 164 158 L 148 98 Z'],
  },
  overalls: {
    body: `M 62 30 L 85 22 ${neck} L 138 30 L 146 96 L 150 216 L 108 216 L 100 146 L 92 216 L 50 216 L 54 96 Z`,
    sleeves: ['M 62 30 L 34 50 L 18 150 L 38 156 L 54 98 Z', 'M 138 30 L 166 50 L 182 150 L 162 156 L 146 98 Z'],
  },
  polo: {
    body: `M 64 30 L 86 22 ${neck} L 136 30 L 146 78 L 150 204 L 50 204 L 54 78 Z`,
    sleeves: ['M 64 30 L 34 50 L 26 84 L 50 90 L 56 72 Z', 'M 136 30 L 166 50 L 174 84 L 150 90 L 144 72 Z'],
  },
  vest: {
    body: back
      ? 'M 64 24 L 88 20 Q 100 26 112 20 L 136 24 Q 134 60 148 80 L 152 204 L 48 204 L 52 80 Q 66 60 64 24 Z'
      : 'M 64 24 L 88 20 Q 100 70 112 20 L 136 24 Q 134 60 148 80 L 152 204 L 48 204 L 52 80 Q 66 60 64 24 Z',
  },
  signal: {
    body: back
      ? 'M 64 24 L 88 20 Q 100 26 112 20 L 136 24 Q 134 60 148 80 L 152 200 L 48 200 L 52 80 Q 66 60 64 24 Z'
      : 'M 64 24 L 88 20 Q 100 70 112 20 L 136 24 Q 134 60 148 80 L 152 200 L 48 200 L 52 80 Q 66 60 64 24 Z',
  },
  apron: {
    body: 'M 74 44 L 126 44 L 127 98 Q 142 104 160 100 L 168 214 L 32 214 L 40 100 Q 58 104 73 98 Z',
  },
};
const S = shapes[type as WorkwearType];

// ---- места печати: прямоугольники в координатах холста
const Z = {
  chest: type === 'apron' ? { x: 84, y: 56, w: 32, h: 22 } : type === 'polo' ? { x: 112, y: 52, w: 22, h: 16 } : type === 'vest' || type === 'signal' ? { x: 114, y: 70, w: 22, h: 16 } : { x: 110, y: 50, w: 26, h: 18 },
  back: type === 'signal' ? { x: 64, y: 50, w: 72, h: 40 } : type === 'apron' ? { x: 84, y: 56, w: 32, h: 22 } : { x: 62, y: 56, w: 76, h: 58 },
  sleeve: { x: 22, y: 76, w: 16, h: 13 },
};
const show = (p: WorkwearPlace) => printIn.includes(p) && (p === 'chest' ? !back : p === 'back' ? back : hasSleeves && type !== 'polo') && !(type === 'apron' && p === 'back');
const label = title ?? `${C.label}: ${{ jacket: 'куртка', vest: 'жилет', signal: 'сигнальный жилет', overalls: 'комбинезон', apron: 'фартук', polo: 'поло' }[type as WorkwearType]}, ${back ? 'вид сзади' : 'вид спереди'}`;
const tfs = Math.min(15, (Z.back.w * 1.55) / Math.max(4, text.length));
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 200 224"
  width={Math.round(200 * scale)}
  height={Math.round(224 * scale)}
  role="img"
  aria-label={label}
  class:list={['wwart', cls]}
>
  <title>{label}</title>
  <defs>
    <clipPath id={id('body')}><path d={S.body} /></clipPath>
    <pattern id={id('weave')} width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
      <path d="M 0.7 0 V 3" stroke={dark ? '#fff' : '#000'} stroke-opacity="0.06" stroke-width="0.9" />
    </pattern>
    <linearGradient id={id('light')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity="0.1" />
      <stop offset="0.35" stop-color="#fff" stop-opacity="0.08" />
      <stop offset="1" stop-color="#000" stop-opacity="0.16" />
    </linearGradient>
  </defs>

  {/* фартук: лямка на шею и завязки */}
  {
    type === 'apron' && (
      <g fill="none" stroke={edge} stroke-width="3" stroke-linecap="round">
        <path d="M 78 46 Q 100 -2 122 46" />
        <path d="M 41 104 Q 26 110 14 126" />
        <path d="M 159 104 Q 174 110 186 126" />
      </g>
    )
  }

  {S.sleeves?.map((d) => <path d={d} fill={shade} stroke={edge} stroke-width="1.6" stroke-linejoin="round" />)}
  {S.sleeves?.map((d) => <path d={d} fill={url('weave')} />)}
  <path d={S.body} fill={base} stroke={edge} stroke-width="1.6" stroke-linejoin="round" />
  <g clip-path={url('body')}>
    <path d={S.body} fill={url('weave')} />
    <rect width="200" height="224" fill={url('light')} />

    {/* сигнальный жилет: световозвращающие полосы */}
    {
      type === 'signal' && (
        <g>
          <rect x="40" y="126" width="120" height="11" fill="#c9ccd2" />
          <rect x="40" y="158" width="120" height="11" fill="#c9ccd2" />
          <rect x="40" y="128.5" width="120" height="2" fill="#fff" fill-opacity="0.7" />
          <rect x="40" y="160.5" width="120" height="2" fill="#fff" fill-opacity="0.7" />
        </g>
      )
    }

    {/* детали спереди */}
    {
      !back && (type === 'jacket' || type === 'overalls') && (
        <g stroke={seam} fill="none">
          <path d={`M 100 30 V ${type === 'overalls' ? 146 : 204}`} stroke-width="2.2" />
          <path d={`M 100 30 V ${type === 'overalls' ? 146 : 204}`} stroke={edge} stroke-width="0.8" stroke-dasharray="1.6 1.2" />
          <rect x="62" y="132" width="28" height="7" rx="1.5" stroke-width="1.2" />
          {type === 'jacket' && <rect x="110" y="132" width="28" height="7" rx="1.5" stroke-width="1.2" />}
          {type === 'overalls' && <path d="M 54 112 H 146" stroke-width="1.4" stroke-dasharray="3 2" />}
          {type === 'overalls' && <rect x="66" y="48" width="22" height="20" rx="2" stroke-width="1.2" />}
        </g>
      )
    }
    {
      !back && (type === 'vest' || type === 'signal') && (
        <g stroke={seam} fill="none">
          <path d="M 100 52 V 204" stroke-width="2" />
          {type === 'vest' && <rect x="60" y="140" width="26" height="22" rx="2" stroke-width="1.2" />}
          {type === 'vest' && <rect x="114" y="140" width="26" height="22" rx="2" stroke-width="1.2" />}
        </g>
      )
    }
    {!back && type === 'apron' && <rect x="66" y="150" width="68" height="28" rx="3" fill="none" stroke={seam} stroke-width="1.4" />}
    {
      !back && type === 'polo' && (
        <g>
          <rect x="95" y="27" width="10" height="34" rx="1.5" fill={shade} stroke={seam} stroke-width="0.8" />
          <circle cx="100" cy="37" r="1.5" fill={seam} />
          <circle cx="100" cy="47" r="1.5" fill={seam} />
        </g>
      )
    }
    {/* подол и манжеты */}
    {type !== 'apron' && type !== 'overalls' && <rect x="40" y={type === 'signal' ? 194 : 196} width="120" height="8" fill="#000" fill-opacity="0.12" />}
    {back && type !== 'apron' && <path d="M 64 40 Q 100 50 136 40" fill="none" stroke={seam} stroke-width="1" stroke-dasharray="3 2" />}
  </g>

  {/* воротник */}
  {
    (type === 'jacket' || type === 'overalls') && (
      <path
        d={back ? 'M 84 22 L 86 12 Q 100 16 114 12 L 116 22 Q 100 26 84 22 Z' : 'M 84 22 L 86 11 Q 100 18 114 11 L 116 22 Q 100 33 84 22 Z'}
        fill={shade}
        stroke={edge}
        stroke-width="1.4"
        stroke-linejoin="round"
      />
    )
  }
  {
    type === 'polo' && (
      <path
        d={back ? 'M 84 22 Q 100 30 116 22 L 114 16 Q 100 22 86 16 Z' : 'M 86 22 L 98 40 L 100 30 L 102 40 L 114 22 L 112 16 Q 100 24 88 16 Z'}
        fill={mix(base, '#ffffff', dark ? 0.08 : 0)}
        stroke={edge}
        stroke-width="1.3"
        stroke-linejoin="round"
      />
    )
  }
  {/* манжеты */}
  {type === 'jacket' && <path d="M 16 152 L 36 158 L 35 163 L 15 157 Z M 184 152 L 164 158 L 165 163 L 185 157 Z" fill={edge} />}

  {/* ---- принт */}
  {
    show('chest') && (
      <g transform={`translate(${Z.chest.x} ${Z.chest.y})`}>
        <circle cx={Z.chest.h / 2} cy={Z.chest.h / 2} r={Z.chest.h / 2 - 1} fill="none" stroke={ink} stroke-width="1.8" />
        <circle cx={Z.chest.h / 2 - 2.4} cy={Z.chest.h / 2 - 1.2} r={Z.chest.h / 5} fill="#00a0dc" />
        <circle cx={Z.chest.h / 2 + 2.4} cy={Z.chest.h / 2 - 1.2} r={Z.chest.h / 5} fill="#e5007d" />
        <circle cx={Z.chest.h / 2} cy={Z.chest.h / 2 + 2.4} r={Z.chest.h / 5} fill="#ffd21f" />
        <rect x={Z.chest.h + 1.5} y={Z.chest.h / 2 - 3.6} width={Z.chest.w - Z.chest.h - 1.5} height="3" rx="1" fill={ink} />
        <rect x={Z.chest.h + 1.5} y={Z.chest.h / 2 + 1.2} width={(Z.chest.w - Z.chest.h - 1.5) * 0.7} height="2.2" rx="1" fill={ink} fill-opacity="0.7" />
      </g>
    )
  }
  {
    show('back') && (
      <g transform={`translate(${Z.back.x} ${Z.back.y})`}>
        <g transform={`translate(${Z.back.w / 2 - 9} 0)`}>
          <circle cx="9" cy="9" r="8.4" fill="none" stroke={ink} stroke-width="2" />
          <circle cx="6.6" cy="7.6" r="3.6" fill="#00a0dc" />
          <circle cx="11.4" cy="7.6" r="3.6" fill="#e5007d" />
          <circle cx="9" cy="11.6" r="3.6" fill="#ffd21f" />
        </g>
        <text x={Z.back.w / 2} y={22 + tfs} font-size={tfs} font-weight="900" text-anchor="middle" fill={ink}>
          {text}
        </text>
        {type !== 'signal' && <rect x={Z.back.w * 0.22} y={26 + tfs + 2} width={Z.back.w * 0.56} height="3" rx="1.5" fill={accent} />}
      </g>
    )
  }
  {
    show('sleeve') && !back && (
      <g transform={`translate(${Z.sleeve.x} ${Z.sleeve.y}) rotate(10)`}>
        <circle cx="6.5" cy="6.5" r="5.8" fill="none" stroke={ink} stroke-width="1.4" />
        <circle cx="4.9" cy="5.6" r="2.4" fill="#00a0dc" />
        <circle cx="8.1" cy="5.6" r="2.4" fill="#e5007d" />
        <circle cx="6.5" cy="8.3" r="2.4" fill="#ffd21f" />
      </g>
    )
  }

  {/* ---- рамки мест печати */}
  {
    zones && (
      <g>
        {(
          [
            ['chest', 1],
            ['back', 2],
            ['sleeve', 3],
          ] as [WorkwearPlace, number][]
        )
          .filter(([p]) => (p === 'chest' ? !back : p === 'back' ? back && type !== 'apron' : !back && hasSleeves && type !== 'polo'))
          .map(([p, n]) => {
            const z = Z[p];
            const pad = 3;
            return (
              <g>
                <rect
                  x={z.x - pad}
                  y={z.y - pad}
                  width={z.w + 2 * pad}
                  height={z.h + 2 * pad}
                  rx="2.5"
                  fill="none"
                  stroke={ink}
                  stroke-width="1.1"
                  stroke-dasharray="3 2"
                  transform={p === 'sleeve' ? `rotate(10 ${z.x} ${z.y})` : undefined}
                />
                <circle cx={z.x - pad} cy={z.y - pad} r="6" fill="#16141b" stroke="#fffcf5" stroke-width="1.2" />
                <text x={z.x - pad} y={z.y - pad + 3} font-size="8" font-weight="800" text-anchor="middle" fill="#fffcf5">
                  {n}
                </text>
              </g>
            );
          })}
      </g>
    )
  }
</svg>

<style>
  .wwart {
    display: block;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }
</style>

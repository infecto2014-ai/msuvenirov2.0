---
import { portfolio } from '@/data/portfolio';
import type { PortfolioItem } from '@/data/types';
interface Props {
  tags?: string[];
  /** only works made with this technology (e.g. 'Сублимация'); combined with tags if both are set */
  tech?: string;
  /** image paths of works to leave out */
  exclude?: string[];
  limit?: number;
  title?: string;
  /** show "all works" link */
  more?: boolean;
}
const { tags, tech, exclude, limit = 8, title = 'Наши работы', more = true } = Astro.props;
let items: PortfolioItem[] = tags?.length ? portfolio.filter((p) => p.tags.some((t) => tags.includes(t))) : portfolio;
if (tech) items = items.filter((p) => p.tech === tech);
if (exclude?.length) items = items.filter((p) => !exclude.includes(p.src));
// fill up with other works so the grid never looks empty
if (items.length < Math.min(4, limit)) items = [...items, ...portfolio.filter((p) => !items.includes(p))];
items = items.slice(0, limit);
const rot = [-2, 1.5, -1, 2, -1.5, 1, -2.5, 1.5];
---

<section class="section works" aria-labelledby="works-h">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Портфолио</p>
        <h2 id="works-h">{title}</h2>
      </div>
      {more && <a class="btn btn-ghost btn-sm" href="/portfolio">Все работы →</a>}
    </div>
    <ul class="works-grid">
      {
        items.map((w, i) => (
          <li class="work rope-item" style={`--r:${rot[i % rot.length]}deg`}>
            <span class="rope-pin" aria-hidden="true" />
            <figure>
              <img src={w.src} alt={w.title} width="480" height="480" loading="lazy" decoding="async" />
              <figcaption>
                <span class="work-title">{w.title}</span>
                <span class="work-tech mono">{w.tech}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .works-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 58px 22px;
    padding-top: 36px;
    --rope-gap: 22px;
  }
  .work {
    --pin-c: var(--m);
  }
  .work:nth-child(4n + 2) {
    --pin-c: var(--c);
  }
  .work:nth-child(4n + 3) {
    --pin-c: var(--y);
  }
  .work figure {
    transform-origin: 50% 0;
    margin: 0;
    padding: 10px 10px 14px;
    background: var(--card);
    border-radius: 20px;
    box-shadow: var(--shadow);
    transform: rotate(var(--r));
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .work:hover figure,
  .work:focus-within figure {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 6px 6px 0 var(--m), var(--shadow);
  }
  .work img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 14px;
    background: var(--paper-2);
  }
  .work figcaption {
    display: grid;
    gap: 2px;
    padding: 10px 4px 0;
  }
  .work-title {
    overflow-wrap: anywhere;
    hyphens: auto;
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.3;
  }
  .work-tech {
    font-size: 0.75rem;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .work figure {
      transition: none;
    }
  }
  @media (max-width: 980px) {
    .works-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .works-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 52px 14px;
      --rope-gap: 14px;
    }
  }
  /* phones: flat 2×2 grid, four works, short captions */
  @media (max-width: 560px) {
    /* "all works" sits on the short eyebrow line, so the title keeps the full width */
    .works .section-head {
      position: relative;
    }
    .works .section-head .btn {
      position: absolute;
      top: -6px;
      right: 0;
      min-height: 32px;
      padding: 0 12px;
      font-size: 0.82rem;
      border-width: 1.5px;
    }
    .works-grid {
      gap: 50px 10px;
      --rope-gap: 10px;
    }
    .work:nth-child(n + 5) {
      display: none;
    }
    .work figure,
    .work:hover figure {
      transform: none;
      padding: 6px 6px 10px;
      border-radius: 18px;
      box-shadow: none;
      border: 1.5px solid var(--line);
    }
    .work img {
      border-radius: 13px;
    }
    .work figcaption {
      padding: 8px 4px 0;
      gap: 0;
    }
    .work-title {
      font-size: 0.82rem;
      line-height: 1.25;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .work-tech {
      font-size: 0.68rem;
    }
  }
</style>

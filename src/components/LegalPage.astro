---
import Breadcrumbs from '@/components/Breadcrumbs.astro';

interface Props {
  /** H1 and last breadcrumb */
  title: string;
  /** edition date, e.g. "12.02.2026" */
  updated?: string;
}

const { title, updated } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<section class="section">
  <div class="wrap legal">
    <Breadcrumbs
      items={[
        { name: 'Главная', href: '/' },
        { name: title, href: path },
      ]}
    />
    <h1>{title}</h1>
    {updated && <p class="muted legal-updated">Редакция от {updated}</p>}
    <article class="prose legal-body">
      <slot />
    </article>
  </div>
</section>

<style>
  .legal h1 {
    margin-top: 0.6em;
    max-width: 780px;
  }
  .legal-updated {
    margin-top: 0.5em;
    font-size: 0.95rem;
  }
  .legal-body {
    max-width: 780px;
    margin-top: 2em;
    line-height: 1.7;
  }
  .legal-body :global(h2) {
    font-size: 1.35rem;
    line-height: 1.3;
    margin-top: 2em;
    margin-bottom: 0.6em;
  }
  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-body :global(p) {
    margin: 0;
  }
  .legal-body :global(p + p) {
    margin-top: 0.9em;
  }
  .legal-body :global(ul),
  .legal-body :global(ol) {
    margin: 0.6em 0 0.9em;
    padding-left: 1.4em;
  }
  .legal-body :global(ul) {
    list-style: disc;
  }
  .legal-body :global(ol) {
    list-style: decimal;
  }
  .legal-body :global(li + li) {
    margin-top: 0.35em;
  }
  .legal-body :global(ul + p),
  .legal-body :global(ol + p) {
    margin-top: 0.9em;
  }
  .legal-body :global(a) {
    color: var(--m-ink);
  }
</style>

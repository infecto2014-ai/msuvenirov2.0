---
// Legal text (политика, оферта) in the «Ink» look: light first screen, then a calm reading column ≤ 72 characters.
import InkHero from '@/components/ink/InkHero.astro';

interface Props {
  /** H1 and last breadcrumb */
  title: string;
  /** edition date, e.g. "12.02.2026" */
  updated?: string;
}

const { title, updated } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: title, href: path },
];
const words = title.split(' ');
const mark = words[words.length - 1];
---

<InkHero crumbs={crumbs} h1={title} mark={mark} lead={updated ? `Редакция от ${updated}` : undefined} />
<div class="band">
  <section class="section legal">
    <div class="wrap">
      <article class="legal-body">
        <slot />
      </article>
    </div>
  </section>
</div>

<style>
  .legal {
    padding-block: clamp(36px, 5vw, 72px);
  }
  .legal-body {
    max-width: 72ch;
    margin-inline: auto;
    font-size: 1.04rem;
    line-height: 1.7;
    color: var(--ink-2);
  }
  @media (min-width: 1100px) {
    .legal-body {
      margin-inline: 0;
    }
  }
  .legal-body :global(.muted) {
    padding: 14px 18px;
    border-radius: 20px;
    border: 1px solid #e5e5e5;
    background: #f2f2f2;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .legal-body :global(h2) {
    margin: 2em 0 0.6em;
    font-size: 1.35rem !important;
    line-height: 1.3 !important;
    color: #000;
  }
  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-body :global(p) {
    margin: 0;
  }
  .legal-body :global(p + p) {
    margin-top: 0.9em;
  }
  .legal-body :global(ul),
  .legal-body :global(ol) {
    margin: 0.6em 0 0.9em;
    padding-left: 1.4em;
  }
  .legal-body :global(ul) {
    list-style: disc;
  }
  .legal-body :global(ol) {
    list-style: decimal;
  }
  .legal-body :global(li + li) {
    margin-top: 0.35em;
  }
  .legal-body :global(ul + p),
  .legal-body :global(ol + p) {
    margin-top: 0.9em;
  }
  .legal-body :global(a) {
    color: var(--navy, #14213d);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal-body :global(h2 + p.muted),
  .legal-body :global(p.muted + h2) {
    margin-top: 1.6em;
  }
</style>

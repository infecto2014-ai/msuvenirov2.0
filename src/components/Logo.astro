---
// The owner's logo (CorelDRAW original, text converted to paths so it renders the same in every browser).
// Colour follows `currentColor`: black (ink) on light backgrounds, white with `inverse`.
import logoSvg from '@/assets/logo.svg?raw';

interface Props {
  inverse?: boolean;
  /** logo height in px on desktop (phones get 85% of it) */
  size?: number;
}
const { inverse = false, size = 54 } = Astro.props;
const svg = logoSvg.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---

<a href="/" class:list={['logo', { inverse }]} style={`--logo-h: ${size}px`} aria-label="Мастерская сувениров — на главную">
  <Fragment set:html={svg} />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    flex: none;
    color: var(--ink);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .logo:hover {
    color: var(--ink);
    opacity: 0.8;
  }
  .logo.inverse,
  .logo.inverse:hover {
    color: #fff;
  }
  .logo :global(svg) {
    display: block;
    height: var(--logo-h);
    width: auto;
  }
  @media (max-width: 560px) {
    .logo :global(svg) {
      height: calc(var(--logo-h) * 0.85);
    }
  }
</style>

---
import type { Faq } from '@/data/types';
interface Props {
  items: Faq[];
  title?: string;
  /** open the first answer by default */
  openFirst?: boolean;
}
const { items, title = 'Частые вопросы', openFirst = true } = Astro.props;
---

<section class="section faq-sec" aria-labelledby="faq-h">
  <div class="wrap faq-grid">
    <div class="faq-side">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-h">{title}</h2>
      <p class="muted">Не нашли ответ? Напишите нам — ответим в течение рабочего дня.</p>
      <button type="button" class="btn btn-ghost" data-order>Задать вопрос</button>
    </div>
    <div class="faq-list">
      {
        items.map((f, i) => (
          <details class="faq-item" open={openFirst && i === 0}>
            <summary>{f.q}</summary>
            <div class="faq-answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
      <p class="faq-more">
        Не нашли ответ? <button type="button" data-order>Задайте вопрос</button>
      </p>
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .faq-side {
    display: grid;
    gap: 16px;
    justify-items: start;
    position: sticky;
    top: 100px;
  }
  @media (max-width: 860px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .faq-side {
      position: static;
    }
  }
  .faq-more {
    display: none;
  }
  /* phones: heading only on top, the "ask us" line moves under the list */
  @media (max-width: 560px) {
    .faq-grid {
      gap: 16px;
    }
    .faq-side {
      gap: 0;
    }
    .faq-side > p.muted,
    .faq-side > .btn {
      display: none;
    }
    .faq-more {
      display: block;
      margin-top: 4px;
      font-size: 0.95rem;
      color: var(--muted);
    }
    .faq-more button {
      padding: 0;
      border: 0;
      background: none;
      color: var(--m-ink);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }
  }
</style>

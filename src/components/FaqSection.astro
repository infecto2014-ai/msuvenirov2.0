---
import type { Faq } from '@/data/types';
interface Props {
  items: Faq[];
  title?: string;
  /** open the first answer by default */
  openFirst?: boolean;
}
const { items, title = 'Частые вопросы', openFirst = true } = Astro.props;
---

<section class="section faq-sec" aria-labelledby="faq-h">
  <div class="wrap faq-grid">
    <div class="faq-side">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-h">{title}</h2>
      <p class="muted">Не нашли ответ? Напишите нам — ответим в течение рабочего дня.</p>
      <button type="button" class="btn btn-ghost" data-order>Задать вопрос</button>
    </div>
    <div class="faq-list">
      {
        items.map((f, i) => (
          <details class="faq-item" open={openFirst && i === 0}>
            <summary>{f.q}</summary>
            <div class="faq-answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .faq-side {
    display: grid;
    gap: 16px;
    justify-items: start;
    position: sticky;
    top: 100px;
  }
  @media (max-width: 860px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .faq-side {
      position: static;
    }
  }
</style>

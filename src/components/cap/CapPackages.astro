---
// «Готовые варианты» on /pechat-na-kepkah: ready orders with the turnkey price from pricing.ts (product.quote).
// Same look as MugPackages, the picture is a cap drawing (CapArt).
import CapArt from "@/components/cap/CapArt.astro";
import type { CapColor } from '@/components/cap/cap-geometry';
import { defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import { capsPage } from '@/data/capsPage';

const items = capsPage.packages.map((pk) => {
  const product = findProduct('textile', 'cap')!;
  const base = defaultSelection(product);
  const sel: Selection = { ...base, qty: pk.qty, options: { ...base.options, ...pk.options } };
  const q = product.quote(sel);
  return { ...pk, unit: q.unit, total: q.total, from: q.from };
});
import TeeHead from '@/components/tee/TeeHead.astro';
import Icon from '@/components/Icon.astro';
import '@/components/product-page/pp.css';
---

<section class="section spk pp-sec" aria-labelledby="spk-h">
  <div class="wrap">
    <TeeHead icon="tag" eyebrow="Популярное" id="spk-h" title="Готовые варианты с ценой" mark="ценой">
      <p class="pp-sub">Цена вместе с кепкой, печатью и макетом. Другое количество, цвет или второй принт — в калькуляторе выше.</p>
    </TeeHead>
    <ul class="pk-grid">
      {
        items.map((it) => {
          const label = `${it.title}, ${it.qty} шт — ${it.from ? 'от ' : ''}${rub(it.total)}`;
          return (
            <li class="pk-card pp-card">
              <div class="pk-art pp-art" aria-hidden="true">
                <CapArt view={it.view} color={it.options.color as CapColor} print={it.print} place={it.place} text={it.text} scale={0.82} />
                <span class="pk-qty">{it.qty} шт</span>
                <span class="pk-tech">{it.options.print2 && it.options.print2 !== 'none' ? '2 принта' : 'DTF'}</span>
              </div>
              <div class="pk-body">
                <h3>{it.title}</h3>
                <p class="pk-note">{it.note}</p>
                <p class="pk-price">
                  <b>{it.from && 'от '}{rub(it.total)}</b>
                  {it.qty > 1 && <small>{rub(it.unit)} / шт</small>}
                </p>
                <button type="button" class="pk-btn" data-order={label}>
                  Заказать
                  <span class="pk-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                </button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .spk { --cols: 5; }
  .pk-art :global(svg) { filter: drop-shadow(0 10px 12px rgba(20, 33, 61, 0.16)); }
</style>

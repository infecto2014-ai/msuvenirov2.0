---
// «Ещё печатаем» for the T-shirt page: other services hang on a clothes rail.
// Each link is a photo card on a wooden hanger; the rail is drawn per item (pieces meet across
// the column gap), so it also works when the grid wraps into rows on phones.
// Cards hang straight (gravity), held by two clips of a clip hanger whose hook loops over the rail.
// Hover/focus: the card swings a little on its hook and the arrow badge turns red.
import Icon from '@/components/Icon.astro';
import type { ServicePage } from '@/data/types';

interface Props {
  items: ServicePage[];
  title?: string;
}

const { items, title = 'Ещё печатаем' } = Astro.props;
const words = title.split(' ');
const lastWord = words.pop();
---

{
  items.length > 0 && (
    <section class="section tr" aria-labelledby="tr-h">
      <div class="wrap">
        <header class="tr-head">
          <p class="eyebrow">Соседние вешалки</p>
          <h2 id="tr-h">
            {words.join(' ')}{' '}<span class="mark">{lastWord}</span>
          </h2>
        </header>

        <ul class="tr-rack" role="list" style={`--n: ${Math.min(items.length, 4)}`}>
          {items.map((r, i) => (
            <li class="tr-item" style={`--sw: ${i % 2 ? 2 : -2}deg`}>
              <a class="tr-card" href={r.slug}>
                <span class="tr-hanger" aria-hidden="true">
                  <svg viewBox="0 0 160 76">
                    {/* metal hook looped over the rail */}
                    <path d="M80 40V21c0-5-6-7-6-13a6 6 0 1 1 12 0" fill="none" stroke="#7d7986" stroke-width="3" stroke-linecap="round" />
                    {/* straight wooden bar of a clip hanger */}
                    <rect x="10" y="37" width="140" height="8" rx="4" fill="#c99a5e" stroke="#a8743a" stroke-width="1.4" />
                    <path d="M16 39.5H144" stroke="#e2bd88" stroke-width="1.3" stroke-linecap="round" />
                    <circle cx="80" cy="41" r="3" fill="#a8743a" />
                    {/* two metal clips holding the card by its top edge */}
                    <g fill="#c7c3cf" stroke="#7d7986" stroke-width="1.2">
                      <path d="M24 44h12v4l-2 20h-8l-2-20z" />
                      <path d="M124 44h12v4l-2 20h-8l-2-20z" />
                    </g>
                    <path d="M27 50h6M127 50h6" stroke="#7d7986" stroke-width="1.2" />
                  </svg>
                </span>
                <span class="tr-photo">
                  <img src={r.image} alt="" width="519" height="696" loading="lazy" decoding="async" />
                  <span class="tr-name">
                    <span>{r.name}</span>
                    <span class="tr-go">
                      <Icon name="arrow" />
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .tr-head {
    margin-bottom: clamp(18px, 3vw, 30px);
  }

  .tr-rack {
    --gap: clamp(18px, 2.4vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 56px var(--gap);
  }

  /* ---------- the rail: each item draws its piece, neighbours' pieces meet in the gap */
  .tr-item {
    position: relative;
    padding-top: 18px;
    min-width: 0;
  }
  .tr-item::before {
    content: '';
    position: absolute;
    top: 2px;
    left: calc(var(--gap) / -2);
    right: calc(var(--gap) / -2);
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(180deg, #e9e6ee 0%, #b9b5c2 45%, #8b8794 70%, #c9c5d1 100%);
    box-shadow: 0 3px 4px -1px rgba(22, 20, 27, 0.28);
  }
  .tr-item:first-child::before {
    left: -6px;
  }
  .tr-item:last-child::before {
    right: -6px;
  }

  /* ---------- hanger + card swing together from the hook */
  .tr-card {
    position: relative;
    display: block;
    color: #fff;
    text-decoration: none;
    transform-origin: 50% 0;
    transition: transform 0.4s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  .tr-card:hover {
    color: #fff;
  }
  .tr-hanger {
    position: relative;
    z-index: 2;
    display: block;
    width: 92%;
    aspect-ratio: 160 / 76;
    /* the hook loop sits on the rail; the clips overlap the card's top edge */
    margin: -13px auto -10.6%;
    filter: drop-shadow(0 3px 2px rgba(22, 20, 27, 0.25));
  }
  .tr-hanger svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .tr-photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    /* square top edge where the clips hold it */
    border-radius: 4px 4px var(--radius) var(--radius);
    background: var(--paper-2);
    box-shadow: 0 24px 34px -26px rgba(22, 20, 27, 0.7);
  }
  .tr-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  /* readable scrim under the name */
  .tr-photo::after {
    content: '';
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(180deg, rgba(22, 20, 27, 0) 0%, rgba(22, 20, 27, 0.55) 45%, rgba(22, 20, 27, 0.88) 100%);
    pointer-events: none;
  }
  .tr-name {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 18px 18px 20px;
    font-weight: 800;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .tr-go {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--y);
    color: #16141b;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .tr-go :global(svg) {
    width: 20px;
    height: 20px;
  }

  @media (hover: hover) {
    .tr-card:hover {
      transform: rotate(var(--sw));
    }
    .tr-card:hover .tr-photo img {
      transform: scale(1.05);
    }
    .tr-card:hover .tr-go {
      background: var(--red);
      color: #fff;
      transform: translateX(3px);
    }
  }
  .tr-card:focus-visible {
    outline: none;
  }
  .tr-card:focus-visible .tr-photo {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  .tr-card:focus-visible .tr-go {
    background: var(--red);
    color: #fff;
  }

  /* ---------- tablet / phone: two hangers per rail */
  @media (max-width: 700px) {
    .tr-rack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 44px var(--gap);
    }
    .tr-item:nth-child(odd)::before {
      left: -6px;
    }
    .tr-item:nth-child(even)::before {
      right: -6px;
    }
  }
  @media (max-width: 560px) {
    .tr-rack {
      --gap: 14px;
      gap: 36px var(--gap);
    }
    .tr-hanger {
      margin-top: -12px;
    }
    .tr-photo {
      border-radius: 3px 3px 18px 18px;
    }
    .tr-name {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 12px;
      font-size: 0.98rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tr-card,
    .tr-card:hover {
      transform: none;
      transition: none;
    }
    .tr-photo img,
    .tr-go {
      transition: none;
    }
    .tr-card:hover .tr-photo img {
      transform: none;
    }
  }
</style>

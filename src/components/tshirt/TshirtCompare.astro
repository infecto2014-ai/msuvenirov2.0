---
// «Какой размер принта выбрать» for the T-shirt page: a to-scale size guide.
// Left — a T-shirt drawn in centimetres with every print size nested on the chest (true proportions),
// right — one card per size. Hovering a card highlights its frame on the shirt (CSS :has, no JS).
// If the rows carry no «W×H см» values, the shirt is skipped and only the cards are shown.
import '@fontsource/caveat/600.css';
import type { ServiceBlock } from '@/data/types';

interface Props {
  block: Extract<ServiceBlock, { kind: 'compare' }>;
}

const { block } = Astro.props;

// ---- find the column that holds dimensions like «10×15 см»
const DIM = /(\d+(?:[.,]\d+)?)\s*[×xх]\s*(\d+(?:[.,]\d+)?)/i;
const dimCol = block.columns.findIndex((_, i) => block.rows.every((r) => DIM.test(r.values[i] ?? '')));
const sizes =
  dimCol >= 0
    ? block.rows.map((r) => {
        const m = (r.values[dimCol] ?? '').match(DIM)!;
        return { w: parseFloat(m[1].replace(',', '.')), h: parseFloat(m[2].replace(',', '.')) };
      })
    : [];

// process colours cycle: cyan, magenta, yellow (darkened for the outline), key
const tones = [
  { line: '#0089bd', fill: '#00a0dc' },
  { line: '#c4006b', fill: '#e5007d' },
  { line: '#b88a00', fill: '#ffd21f' },
  { line: '#16141b', fill: '#16141b' },
];
const tone = (i: number) => tones[i % tones.length];

// ---- shirt geometry in centimetres (adult M-ish: ~52 cm chest, ~72 cm length)
const CX = 40; // centre line
const TOP = 11; // top edge of the print area, a few cm under the collar
const maxH = sizes.length ? Math.max(...sizes.map((s) => s.h)) : 0;
const shirtBottom = Math.max(78, TOP + maxH + 14);
const B = shirtBottom;
const shirt =
  `M30.5 5 C33.5 11 46.5 11 49.5 5 L61 7.2 C66 8.5 72 12 75.5 15.5 L79.5 26.5 C75.5 28.8 71.5 30 67.4 30.6 L66.2 26.8 ` +
  `C66 40 66.4 ${B - 20} 66.8 ${B} Q40 ${B + 1.8} 13.2 ${B} C13.6 ${B - 20} 14 40 13.8 26.8 L12.6 30.6 ` +
  `C8.5 30 4.5 28.8 0.5 26.5 L4.5 15.5 C8 12 14 8.5 19 7.2 Z`;
// draw the biggest frame first so the smaller ones sit on top
const order = sizes.map((s, i) => ({ ...s, i })).sort((a, b) => b.w * b.h - a.w * a.h);

const words = block.title.split(' ');
const lastWord = words.pop();
const otherCols = block.columns.map((c, i) => ({ c, i })).filter((x) => x.i !== dimCol);
---

<section class="section tc" aria-labelledby="tc-h">
  <div class="wrap">
    <header class="tc-head">
      <p class="eyebrow">{dimCol >= 0 ? 'Размеры принта · в сантиметрах' : 'Сравнение'}</p>
      <h2 id="tc-h">
        {words.join(' ')}{' '}<span class="mark">{lastWord}</span>
      </h2>
    </header>

    <div class:list={['tc-grid', { 'no-fig': dimCol < 0 }]}>
      {
        dimCol >= 0 && (
          <figure class="tc-fig">
            <div class="tc-stage">
              <svg
                class="tc-svg"
                viewBox={`0 0 80 ${shirtBottom + 4}`}
                role="img"
                aria-label={`Размеры принта на футболке в масштабе: ${block.rows.map((r) => `${r.label} — ${r.values[dimCol]}`).join(', ')}`}
              >
                <defs>
                  <pattern id="tc-dots" width="2.2" height="2.2" patternUnits="userSpaceOnUse">
                    <circle cx="1.1" cy="1.1" r="0.32" fill="#16141b" opacity="0.09" />
                  </pattern>
                  <linearGradient id="tc-cloth" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#ffffff" />
                    <stop offset="1" stop-color="#f3eee4" />
                  </linearGradient>
                </defs>
                {/* shirt: soft shadow, cloth, halftone texture, outline, collar rib and seams */}
                <path d={shirt} transform="translate(0.9 1.4)" fill="#16141b" opacity="0.08" />
                <path d={shirt} fill="url(#tc-cloth)" />
                <path d={shirt} fill="url(#tc-dots)" />
                <path d={shirt} fill="none" stroke="#cfc5b1" stroke-width="0.45" stroke-linejoin="round" />
                <path d="M30.5 5 C33.5 11 46.5 11 49.5 5" fill="none" stroke="#cfc5b1" stroke-width="1.7" stroke-linecap="round" />
                <path d="M19 7.2 Q15.6 17 13.8 26.8 M61 7.2 Q64.4 17 66.2 26.8" fill="none" stroke="#d9cfbb" stroke-width="0.35" stroke-dasharray="0.9 0.7" />

                {order.map(({ w, h, i }) => (
                  <g class="tc-r" data-i={i} style={`--tl: ${tone(i).line}; --tf: ${tone(i).fill}`}>
                    <rect x={CX - w / 2} y={TOP} width={w} height={h} rx="0.6" class="tc-r-box" />
                    <text x={CX} y={TOP + h - 1.3} text-anchor="middle" class="tc-r-label">
                      {block.rows[i].label}
                    </text>
                  </g>
                ))}

                {/* 10 cm scale bar: proves the drawing is to scale */}
                <g class="tc-scale" transform={`translate(19 ${shirtBottom - 6})`}>
                  <path d="M0 0 H10 M0 -1.1 V1.1 M5 -0.6 V0.6 M10 -1.1 V1.1" fill="none" stroke="#3d3944" stroke-width="0.35" />
                  <text x="11.6" y="1" class="tc-scale-t">10 см</text>
                </g>
              </svg>
              <p class="tc-note" aria-hidden="true">
                <svg viewBox="0 0 48 28" width="40" height="23" fill="none">
                  <path d="M45 8C34 22 20 24 5 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
                  <path d="M13 11l-8 7 9 4" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                всё в масштабе
              </p>
            </div>
            <figcaption class="tc-cap">
              Это поле печати на одежде — оно не совпадает с бумажными листами А4 и А3.
            </figcaption>
          </figure>
        )
      }

      <ul class="tc-list" role="list">
        {
          block.rows.map((r, i) => (
            <li class="tc-card" data-i={i} style={`--tl: ${tone(i).line}; --tf: ${tone(i).fill}`}>
              <div class="tc-top">
                <h3 class="tc-label">{r.label}</h3>
                {dimCol >= 0 && (
                  <p class="tc-dim">
                    <span class="tc-mini" aria-hidden="true" style={`--a: ${sizes[i].w / sizes[i].h}`} />
                    <span class="sr-only">{block.columns[dimCol]}: </span>
                    {r.values[dimCol]}
                  </p>
                )}
              </div>
              <dl class="tc-dl">
                {otherCols.map(({ c, i: ci }) => (
                  <div class="tc-row">
                    <dt>{c}</dt>
                    <dd>{r.values[ci]}</dd>
                  </div>
                ))}
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .tc-head {
    margin-bottom: clamp(26px, 4vw, 44px);
  }

  .tc-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  .tc-grid.no-fig {
    grid-template-columns: minmax(0, 1fr);
  }

  /* ---------- the shirt */
  .tc-fig {
    position: sticky;
    top: 104px;
    margin: 0;
  }
  .tc-stage {
    position: relative;
    padding: clamp(14px, 2vw, 24px);
    border-radius: var(--radius-l);
    background:
      radial-gradient(circle, rgba(22, 20, 27, 0.07) 1.2px, transparent 1.5px) 0 0 / 16px 16px,
      var(--paper-2);
  }
  .tc-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .tc-r-box {
    fill: color-mix(in srgb, var(--tf) 7%, transparent);
    stroke: var(--tl);
    stroke-width: 0.42;
    stroke-dasharray: 1.3 0.7;
    transition: fill 0.2s ease, stroke-width 0.2s ease, opacity 0.2s ease;
  }
  .tc-r-label {
    fill: #16141b;
    font-family: var(--font);
    font-weight: 800;
    font-size: 2.8px;
    letter-spacing: -0.02em;
  }
  .tc-scale-t {
    fill: #3d3944;
    font-family: var(--mono);
    font-size: 2.3px;
    font-weight: 600;
  }

  /* card hover / focus → its frame on the shirt lights up, the others step back */
  .tc-grid:has(.tc-card:hover) .tc-r {
    opacity: 0.35;
  }
  .tc-r {
    transition: opacity 0.2s ease;
  }
  .tc-grid:has(.tc-card[data-i='0']:hover) .tc-r[data-i='0'],
  .tc-grid:has(.tc-card[data-i='1']:hover) .tc-r[data-i='1'],
  .tc-grid:has(.tc-card[data-i='2']:hover) .tc-r[data-i='2'],
  .tc-grid:has(.tc-card[data-i='3']:hover) .tc-r[data-i='3'],
  .tc-grid:has(.tc-card[data-i='4']:hover) .tc-r[data-i='4'],
  .tc-grid:has(.tc-card[data-i='5']:hover) .tc-r[data-i='5'] {
    opacity: 1;
  }
  .tc-grid:has(.tc-card[data-i='0']:hover) .tc-r[data-i='0'] .tc-r-box,
  .tc-grid:has(.tc-card[data-i='1']:hover) .tc-r[data-i='1'] .tc-r-box,
  .tc-grid:has(.tc-card[data-i='2']:hover) .tc-r[data-i='2'] .tc-r-box,
  .tc-grid:has(.tc-card[data-i='3']:hover) .tc-r[data-i='3'] .tc-r-box,
  .tc-grid:has(.tc-card[data-i='4']:hover) .tc-r[data-i='4'] .tc-r-box,
  .tc-grid:has(.tc-card[data-i='5']:hover) .tc-r[data-i='5'] .tc-r-box {
    fill: color-mix(in srgb, var(--tf) 24%, transparent);
    stroke-width: 0.7;
    stroke-dasharray: none;
  }

  /* handwritten note */
  /* sits right of the 10 cm scale bar and points at it */
  .tc-note {
    position: absolute;
    left: 47%;
    bottom: 10.5%;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    font-family: 'Caveat', 'Segoe Print', cursive;
    font-weight: 600;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    line-height: 1;
    white-space: nowrap;
    color: var(--m-ink);
    transform: rotate(-4deg);
    pointer-events: none;
  }
  .tc-note svg {
    flex: none;
    margin-top: 10px;
  }

  .tc-cap {
    margin-top: 14px;
    padding-left: 14px;
    border-left: 3px solid var(--y);
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  /* ---------- size cards */
  .tc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .tc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 22px 22px 22px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: hidden;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  /* coloured corner tab, like an ink swatch on a print sheet */
  .tc-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 74px;
    height: 74px;
    background: radial-gradient(circle at 100% 0, var(--tf) 0 34px, transparent 34.5px);
    opacity: 0.9;
  }
  .tc-card:hover {
    border-color: var(--tl);
    box-shadow: 5px 5px 0 var(--tf);
    transform: translate(-2px, -2px);
  }

  .tc-top {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  .tc-label {
    font-size: clamp(2.4rem, 3.6vw, 3.1rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--ink);
  }
  .tc-dim {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 5px 12px 5px 8px;
    border-radius: 999px;
    background: var(--paper-2);
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
    white-space: nowrap;
  }
  /* a tiny frame with the print's real proportions */
  .tc-mini {
    width: calc(18px * var(--a));
    height: 18px;
    border-radius: 2px;
    border: 1.5px solid var(--tl);
    background: color-mix(in srgb, var(--tf) 22%, transparent);
  }

  .tc-dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .tc-row {
    display: grid;
    gap: 2px;
  }
  .tc-row dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tc-row dd {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .tc-row:first-child dd {
    color: var(--ink);
    font-weight: 700;
  }

  /* ---------- tablet: shirt above, cards 2×2 */
  @media (max-width: 960px) {
    .tc-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .tc-fig {
      position: static;
      width: 100%;
      max-width: 460px;
      justify-self: center;
    }
  }

  /* ---------- phone */
  @media (max-width: 760px) {
    .tc-list {
      gap: 12px;
    }
    .tc-card {
      padding: 18px;
      gap: 12px;
    }
    .tc-card::before {
      width: 54px;
      height: 54px;
      background: radial-gradient(circle at 100% 0, var(--tf) 0 24px, transparent 24.5px);
    }
  }
  @media (max-width: 560px) {
    .tc-fig {
      max-width: 340px;
    }
    .tc-stage {
      padding: 10px;
      border-radius: var(--radius);
    }
    .tc-cap {
      font-size: 0.9rem;
    }
    /* one card per row: label on the left, facts on the right */
    .tc-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .tc-card {
      display: grid;
      grid-template-columns: 74px minmax(0, 1fr);
      gap: 4px 14px;
      padding: 16px 16px 16px 14px;
    }
    .tc-top {
      display: contents;
    }
    .tc-label {
      grid-column: 1;
      grid-row: 1 / span 2;
      font-size: 2.3rem;
      align-self: start;
      padding-top: 4px;
    }
    .tc-dim {
      grid-column: 2;
      justify-self: start;
      font-size: 0.85rem;
      padding-block: 3px;
    }
    .tc-dl {
      grid-column: 2;
      gap: 8px;
      margin-top: 6px;
    }
    .tc-row dd {
      font-size: 0.95rem;
    }
    .tc-card:hover {
      transform: none;
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tc-card,
    .tc-r,
    .tc-r-box {
      transition: none;
    }
    .tc-card:hover {
      transform: none;
    }
  }
</style>

---
// Row of three facts under the buttons of a first screen — same look as the fact cards of TeeHero (th-cards):
// navy glass cards with a big value and a short caption. Used by the standalone service pages.
interface Props {
  facts: { big: string; small: string }[];
}
const { facts } = Astro.props;
---

<ul class="hf">
  {
    facts.map((f) => (
      <li class="hf-card">
        <b>{f.big}</b>
        <span set:html={f.small} />
      </li>
    ))
  }
</ul>

<style>
  .hf {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    width: 100%;
    max-width: 640px;
  }
  .hf-card {
    display: grid;
    gap: 6px;
    align-content: center;
    padding: 18px 20px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(20, 33, 61, 0.9);
    -webkit-backdrop-filter: saturate(1.3) blur(18px);
    backdrop-filter: saturate(1.3) blur(18px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08) inset, 0 24px 60px -30px rgba(0, 0, 0, 0.6);
    color: #fff;
  }
  .hf-card b {
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #fff;
  }
  .hf-card span {
    font-size: 0.85rem;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.78);
  }
  .hf-card :global(b) {
    color: #fff;
  }
  @media (max-width: 760px) {
    .hf {
      gap: 8px;
    }
    .hf-card {
      padding: 14px 12px;
      border-radius: 20px;
      background: var(--navy, #14213d);
    }
    .hf-card b {
      font-size: 1.15rem;
    }
    .hf-card span {
      font-size: 0.75rem;
    }
  }
</style>

---
// Row of three big facts under the buttons of a first screen — same look as in TshirtHero (th-facts):
// a big value, a short caption, dashed dividers. Used by the standalone service pages (mugs, caps, badges…).
interface Props {
  facts: { big: string; small: string }[];
}
const { facts } = Astro.props;
---

<dl class="hf">
  {
    facts.map((f) => (
      <div>
        <dt class="mono">{f.big}</dt>
        <dd set:html={f.small} />
      </div>
    ))
  }
</dl>

<style>
  .hf {
    margin: 6px 0 0;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 0;
    border-top: 1.5px solid var(--line-strong);
    padding-top: 16px;
  }
  .hf div {
    display: grid;
    gap: 2px;
    align-content: start;
    padding-right: clamp(16px, 2.4vw, 32px);
  }
  .hf div + div {
    padding-left: clamp(16px, 2.4vw, 32px);
    border-left: 1.5px dashed var(--line-strong);
  }
  .hf dt {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .hf dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.35;
    max-width: 18ch;
  }
  @media (max-width: 1100px) {
    .hf {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .hf {
      order: 7;
      grid-column: 1 / -1;
      margin: 0;
      padding-top: 12px;
    }
    .hf div {
      padding-right: 10px;
    }
    .hf div + div {
      padding-left: 10px;
    }
    .hf dt {
      font-size: 1.2rem;
    }
    .hf dd {
      font-size: 0.75rem;
    }
  }
</style>

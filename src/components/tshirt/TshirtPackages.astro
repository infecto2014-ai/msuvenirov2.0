---
// «Готовые варианты» on the t-shirt page: a bento of photo cards (one big, one wide, two small),
// text on a dark gradient over the photo, the turnkey price as a yellow sticker.
// Prices are computed from pricing.ts exactly as in GarmentPackages.
import TshirtHead from './TshirtHead.astro';
import { defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import type { GarmentInfo } from '@/data/types';

interface Props {
  info: GarmentInfo;
  num: string;
}
const { info, num } = Astro.props;
const product = findProduct('textile', info.productId)!;
const items = info.packages.map((pk) => {
  const base = defaultSelection(product);
  const sel: Selection = { ...base, qty: pk.qty, options: { ...base.options, print2: 'none', print3: 'none', ...pk.options } };
  const q = product.quote(sel);
  return { ...pk, unit: q.unit, total: q.total, from: q.from };
});
const tones = ['y', 'c', 'm', 'y'];
---

<section class="section tpk" aria-labelledby="tpk-h">
  <div class="wrap">
    <TshirtHead num={num} eyebrow="Популярное" id="tpk-h" title="Готовые варианты с ценой" mark="с ценой" tone="m">
      <p>Цена указана за готовое изделие вместе с печатью. Свой вариант — в калькуляторе выше.</p>
    </TshirtHead>
    <ul class="tpk-grid">
      {
        items.map((it, i) => {
          const label = `${it.title} (${it.note}), ${it.qty} шт — ${it.from ? 'от ' : ''}${rub(it.total)}`;
          return (
            <li class={`tpk-card tpk-${i + 1} tpk-${tones[i % tones.length]}`}>
              <img src={it.img} alt={it.title} width="480" height="480" loading="lazy" decoding="async" />
              <span class="tpk-qty mono">{it.qty} шт</span>
              <p class="tpk-price">
                <span class="sr-only">Цена: </span>
                <b class="mono">
                  {it.from && 'от '}
                  {rub(it.total)}
                </b>
                {it.qty > 1 && <small>{rub(it.unit)} / шт</small>}
              </p>
              <div class="tpk-body">
                <h3>{it.title}</h3>
                <p class="tpk-note">{it.note}</p>
                <button type="button" class="btn btn-sm btn-magenta" data-order={label}>
                  Заказать
                </button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .tpk-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 292px;
    gap: 16px;
  }
  /* bento: 1 — big square, 2 — wide, 3 and 4 — small */
  .tpk-1 {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tpk-2 {
    grid-column: span 2;
  }
  .tpk-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    border-radius: 30px 30px 30px 10px;
    overflow: clip;
    isolation: isolate;
    background: #2a2033;
    color: #fff;
  }
  .tpk-y { --tone: var(--y); }
  .tpk-c { --tone: var(--c); }
  .tpk-m { --tone: var(--m); }
  .tpk-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.5s ease;
  }
  /* dark gradient under the text: keeps white text above 4.5:1 on any photo */
  .tpk-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(15, 18, 26, 0.94) 0%, rgba(15, 18, 26, 0.78) 32%, rgba(15, 18, 26, 0.12) 64%, rgba(15, 18, 26, 0) 80%);
  }
  .tpk-1::before {
    background: linear-gradient(to top, rgba(15, 18, 26, 0.94) 0%, rgba(15, 18, 26, 0.7) 26%, rgba(15, 18, 26, 0) 55%);
  }
  @media (hover: hover) {
    .tpk-card:hover img {
      transform: scale(1.05);
    }
  }
  .tpk-qty {
    position: absolute;
    left: 16px;
    top: 16px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 252, 245, 0.94);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .tpk-price {
    position: absolute;
    right: 14px;
    top: 14px;
    display: grid;
    justify-items: end;
    margin: 0;
    padding: 8px 14px 9px;
    border-radius: 16px 16px 4px 16px;
    background: var(--y);
    color: #16141b;
    line-height: 1.05;
    transform: rotate(3deg);
    box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.6);
  }
  .tpk-price b {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .tpk-price small {
    font-size: 0.75rem;
    font-weight: 700;
  }
  .tpk-1 .tpk-price {
    padding: 12px 20px 14px;
    transform: rotate(-3deg);
  }
  .tpk-1 .tpk-price b {
    font-size: 2.1rem;
  }
  .tpk-body {
    display: grid;
    justify-items: start;
    gap: 6px;
    width: 100%;
    padding: 18px 20px 20px;
  }
  .tpk-body h3 {
    color: #fff;
    font-size: 1.15rem;
  }
  /* a colour tick before the title */
  .tpk-body h3::before {
    content: '';
    display: block;
    width: 34px;
    height: 5px;
    margin-bottom: 10px;
    border-radius: 5px;
    background: var(--tone);
  }
  .tpk-1 .tpk-body {
    padding: 28px;
    gap: 8px;
  }
  .tpk-1 .tpk-body h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  }
  .tpk-note {
    margin: 0 0 6px;
    max-width: 40ch;
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.86rem;
    line-height: 1.4;
  }
  .tpk-1 .tpk-note {
    font-size: 1rem;
  }
  .tpk-body .btn {
    min-height: 44px;
  }

  @media (max-width: 1100px) {
    .tpk-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 300px;
    }
    .tpk-1 {
      grid-row: span 1;
    }
  }

  /* phone: a carousel of tall photo cards */
  @media (max-width: 760px) {
    .tpk {
      padding-block: 32px;
    }
    .tpk-grid {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1);
      padding: 6px var(--gutter) 8px;
      scrollbar-width: none;
    }
    .tpk-grid::-webkit-scrollbar {
      display: none;
    }
    .tpk-card {
      flex: 0 0 min(260px, 74%);
      min-height: 300px;
      scroll-snap-align: start;
      border-radius: 22px 22px 22px 8px;
    }
    .tpk-1 .tpk-body,
    .tpk-body {
      gap: 4px;
      padding: 14px;
    }
    .tpk-1 .tpk-body h3,
    .tpk-body h3 {
      font-size: 1.02rem;
    }
    .tpk-body h3::before {
      width: 26px;
      height: 4px;
      margin-bottom: 6px;
    }
    .tpk-1 .tpk-note,
    .tpk-note {
      font-size: 0.8rem;
      line-height: 1.35;
      margin-bottom: 6px;
    }
    .tpk-qty {
      left: 12px;
      top: 12px;
      font-size: 0.72rem;
    }
    .tpk-1 .tpk-price,
    .tpk-price {
      right: 10px;
      top: 10px;
      padding: 6px 10px 7px;
    }
    .tpk-1 .tpk-price b,
    .tpk-price b {
      font-size: 1.1rem;
    }
    .tpk-price small {
      font-size: 0.68rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tpk-card img {
      transition: none;
    }
  }
</style>

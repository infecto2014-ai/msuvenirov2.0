---
// Section heading of the t-shirt page: a big outlined number with a colour offset (as on the gift article),
// an eyebrow and an h2 with one word underlined by a marker. Extra content (sub text, notes) goes in the slot.
interface Props {
  /** «01», «02»… */
  num: string;
  eyebrow: string;
  /** id of the h2, for aria-labelledby on the section */
  id: string;
  title: string;
  /** part of the title to highlight with the marker (must be inside title) */
  mark?: string;
  /** colour of the number shadow and the marker */
  tone?: 'c' | 'm' | 'y';
}
const { num, eyebrow, id, title, mark, tone = 'y' } = Astro.props;
const at = mark ? title.indexOf(mark) : -1;
const parts = at >= 0 ? [title.slice(0, at), title.slice(at, at + mark!.length), title.slice(at + mark!.length)] : [title, '', ''];
---

<header class={`thd thd-${tone}`}>
  <span class="thd-num mono" aria-hidden="true">{num}</span>
  <div class="thd-main">
    <p class="eyebrow thd-eyebrow">{eyebrow}</p>
    <h2 id={id}>
      {parts[0]}{parts[1] && <span class="thd-mark">{parts[1]}</span>}{parts[2]}
    </h2>
  </div>
  {Astro.slots.has('default') && <div class="thd-side"><slot /></div>}
</header>

<style>
  .thd {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: end;
    gap: 12px clamp(18px, 3vw, 36px);
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .thd-c { --tone: var(--c); --mark: rgba(0, 160, 220, 0.32); }
  .thd-m { --tone: var(--m); --mark: rgba(229, 0, 125, 0.24); }
  .thd-y { --tone: var(--y); --mark: rgba(255, 210, 31, 0.75); }
  .thd-num {
    font-family: var(--font);
    font-size: clamp(4rem, 8vw, 6.6rem);
    font-weight: 900;
    line-height: 0.78;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
    /* slight misregistration, as in print */
    text-shadow: 6px 6px 0 var(--tone);
  }
  .thd-eyebrow {
    margin-bottom: 8px;
  }
  .thd h2 {
    max-width: 18ch;
  }
  .thd-mark {
    padding-inline: 0.06em;
    background: linear-gradient(transparent 60%, var(--mark) 60% 92%, transparent 92%);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .thd-side {
    align-self: end;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }
  .thd-side :global(p) {
    margin: 0;
  }
  @media (max-width: 960px) {
    .thd {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .thd-side {
      grid-column: 1 / -1;
      max-width: 620px;
    }
  }
  @media (max-width: 760px) {
    .thd {
      gap: 8px 14px;
      margin-bottom: 16px;
    }
    .thd-num {
      font-size: 3rem;
      -webkit-text-stroke-width: 1.5px;
      text-shadow: 4px 4px 0 var(--tone);
    }
    .thd-eyebrow {
      margin-bottom: 4px;
    }
    .thd-side {
      font-size: 0.92rem;
      line-height: 1.45;
    }
  }
</style>

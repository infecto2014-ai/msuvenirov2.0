---
// Section heading — since 14.11.2026 (owner: whole site in the «Ink» look, «цифры 01–04 смотрятся неудачно»)
// renders src/components/tee/TeeHead.astro: an icon instead of the outlined number. The icon is picked from
// the eyebrow text. Old CMYK version — git history, branch backup/before-site-ink.
import TeeHead from '@/components/tee/TeeHead.astro';
interface Props {
  /** kept for old callers, not shown any more */
  num?: string;
  eyebrow: string;
  id: string;
  title: string;
  mark?: string;
  tone?: 'c' | 'm' | 'y';
  dark?: boolean;
}
const { eyebrow, id, title, mark, dark } = Astro.props;
const e = eyebrow.toLowerCase();
type Icon = 'calc' | 'shirt' | 'ruler' | 'bulb' | 'tag' | 'star' | 'gift' | 'check' | 'layers' | 'heart' | 'camera' | 'help' | 'bag';
const icon: Icon = /калькул/.test(e)
  ? 'calc'
  : /вариант|цен|прайс/.test(e)
    ? 'tag'
    : /издел|ткан|одежд/.test(e)
      ? 'shirt'
      : /размер|формат/.test(e)
        ? 'ruler'
        : /иде|чаще/.test(e)
          ? 'bulb'
          : /работ|портфол|пример/.test(e)
            ? 'camera'
            : /вопрос/.test(e)
              ? 'help'
              : /подар/.test(e)
                ? 'gift'
                : /как|шаг|заказ/.test(e)
                  ? 'check'
                  : 'star';
---

<TeeHead icon={icon} eyebrow={eyebrow} id={id} title={title} mark={mark} dark={dark}><slot /></TeeHead>

---
// Content blocks of a service page (services.ts → blocks) in the «Ink» look (docs/INK.md): every block gets a heading
// with an icon in a circle (TeeHead), cards are glass, no numbers, stickers or CMYK colours.
// Works on a light band (white / grey) and on a navy panel (.band-ink): colours come from the --sb-* variables below.
import TeeHead from '@/components/tee/TeeHead.astro';
import type { ServiceBlock } from '@/data/types';

interface Props {
  blocks: ServiceBlock[];
}
const { blocks } = Astro.props;

const headIcon = { text: 'star', features: 'check', steps: 'layers', compare: 'ruler', ideas: 'bulb', links: 'tag' } as const;
const eyebrows = { text: 'Подробнее', features: 'Что важно', steps: 'Как это работает', compare: 'Сравнение', ideas: 'Идеи', links: 'Смотрите также' };

// stroke icons (24x24) for cards, cycled; they are decoration only
const cardIcons = [
  'M5 12.5 10 17.5 19 7',
  'm12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9Z',
  'm12 3 9 5-9 5-9-5zM3 13l9 5 9-5',
  'M12 20s-8-4.6-8-10.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15.4 12 20 12 20Z',
  'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1.1 2V16h5v-.2c.1-.8.5-1.5 1.1-2A6 6 0 0 0 12 3Z',
  'M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9zM8 8h.01',
];
const stepIcons = [
  'M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM8 9h8M8 13h8M8 17h5',
  'M4 8h3l2-3h6l2 3h3v11H4zM12 17a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z',
  'M7 9V3h10v6M7 17H4v-7h16v7h-3M7 14h10v7H7v-7Z',
  'M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9zM8 8h.01',
  'M5 12.5 10 17.5 19 7',
];
const lastWord = (t: string) => t.trim().split(/\s+/).pop()!.replace(/[?!.,:;]+$/, '');
---

{
  blocks.map((b, bi) => (
    <section class="section sb" aria-labelledby={`sb-h-${bi}`}>
      <div class="wrap">
        <TeeHead icon={headIcon[b.kind]} eyebrow={eyebrows[b.kind]} id={`sb-h-${bi}`} title={b.title} mark={lastWord(b.title)}>
          {(b.kind === 'ideas' || b.kind === 'links') && b.lead && <p class="sb-lead">{b.lead}</p>}
        </TeeHead>

        {b.kind === 'links' && (
          <div class="sb-links">
            {b.items.map((it, i) => (
              <article class="sb-card sb-link">
                <span class="sb-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d={cardIcons[(i + 5) % cardIcons.length]} />
                  </svg>
                </span>
                {it.tag && <span class="sb-tag">{it.tag}</span>}
                <h3>{it.title}</h3>
                <p>{it.text}</p>
                <ul class="sb-pills">
                  {it.links.map((l) => (
                    <li>
                      <a href={l.href}>
                        {l.label}
                        <span aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        )}

        {b.kind === 'ideas' && (
          <div class="sb-ideas">
            {b.items.map((it) => (
              <article class="sb-card sb-idea">
                {it.img && (
                  <span class="sb-idea-img">
                    <img src={it.img} alt={it.title} width="320" height="320" loading="lazy" decoding="async" />
                  </span>
                )}
                <div class="sb-idea-body">
                  {it.tag && <span class="sb-tag">{it.tag}</span>}
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </div>
              </article>
            ))}
          </div>
        )}

        {b.kind === 'text' && (
          <div class="sb-text prose">
            {b.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )}

        {b.kind === 'features' && (
          <div class="sb-features">
            {b.items.map((it, i) => (
              <article class="sb-card sb-feature">
                <span class="sb-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d={cardIcons[i % cardIcons.length]} />
                  </svg>
                </span>
                <h3>{it.title}</h3>
                <p>{it.text}</p>
              </article>
            ))}
          </div>
        )}

        {b.kind === 'steps' && (
          <ol class="sb-steps" style={`--n:${Math.min(b.items.length, 4)}`}>
            {b.items.map((it, i) => (
              <li>
                <span class="sb-ico sb-step-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d={stepIcons[i % stepIcons.length]} />
                  </svg>
                </span>
                <div class="sb-card sb-step">
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </div>
              </li>
            ))}
          </ol>
        )}

        {b.kind === 'compare' && (
          <div class="sb-card sb-table-box">
            <div class="sb-scroll">
              <table class="sb-compare">
                <thead>
                  <tr>
                    <th scope="col">
                      <span class="sr-only">Параметр</span>
                    </th>
                    {b.columns.map((c) => (
                      <th scope="col">{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {b.rows.map((r) => (
                    <tr>
                      <th scope="row">{r.label}</th>
                      {r.values.map((v, vi) => (
                        <td data-label={b.columns[vi]}>{v}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    </section>
  ))
}

<style>
  .sb {
    /* light glass by default; a navy band (.band-ink) switches the variables */
    --sb-glass: rgba(255, 255, 255, 0.78);
    --sb-bd: rgba(255, 255, 255, 0.9);
    --sb-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.4);
    --sb-fg: var(--navy, #14213d);
    --sb-fg-2: var(--ink-2, #14213d);
    --sb-muted: var(--muted);
    --sb-line: rgba(20, 33, 61, 0.1);
    --sb-ico-bg: var(--navy, #14213d);
    --sb-ico-fg: #fff;
    --sb-pill-bg: rgba(20, 33, 61, 0.07);
    --sb-head-bg: var(--navy, #14213d);
    --sb-head-fg: #fff;
  }
  :global(.band-ink) .sb {
    --sb-glass: rgba(255, 255, 255, 0.06);
    --sb-bd: rgba(255, 255, 255, 0.14);
    --sb-shadow: none;
    --sb-fg: #fff;
    --sb-fg-2: rgba(255, 255, 255, 0.82);
    --sb-muted: rgba(255, 255, 255, 0.72);
    --sb-line: rgba(255, 255, 255, 0.14);
    --sb-ico-bg: #fff;
    --sb-ico-fg: var(--navy, #14213d);
    --sb-pill-bg: rgba(255, 255, 255, 0.1);
    --sb-head-bg: rgba(255, 255, 255, 0.1);
    --sb-head-fg: #fff;
  }
  .sb-lead {
    max-width: 56ch;
    color: var(--sb-muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .sb-card {
    border-radius: 24px;
    border: 1px solid var(--sb-bd);
    background: var(--sb-glass);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: var(--sb-shadow);
    color: var(--sb-fg);
  }
  .sb-card h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--sb-fg);
  }
  .sb-card p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--sb-fg-2);
  }
  .sb-ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--sb-ico-bg);
    color: var(--sb-ico-fg);
  }
  .sb-tag {
    justify-self: start;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--sb-pill-bg);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--sb-fg);
  }

  /* ---- text */
  .sb-text {
    max-width: 72ch;
    font-size: 1.06rem;
    line-height: 1.65;
    color: var(--sb-fg-2);
  }
  .sb-text :global(p + p) {
    margin-top: 1em;
  }

  /* ---- features */
  .sb-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }
  .sb-feature {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px;
  }
  .sb-feature .sb-ico {
    margin-bottom: 6px;
  }

  /* ---- steps: icons on a line, glass cards below */
  .sb-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 16px;
  }
  .sb-steps li {
    position: relative;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .sb-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 24px;
    left: 60px;
    right: -16px;
    border-top: 2px dashed var(--sb-line);
  }
  .sb-step {
    display: grid;
    gap: 8px;
    padding: 20px 22px 22px;
    height: 100%;
  }

  /* ---- compare: glass table */
  .sb-table-box {
    overflow: clip;
  }
  .sb-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .sb-compare {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .sb-compare th,
  .sb-compare td {
    padding: 15px 20px;
    text-align: left;
    vertical-align: top;
    line-height: 1.45;
    border-bottom: 1px solid var(--sb-line);
    color: var(--sb-fg-2);
  }
  .sb-compare thead th {
    background: var(--sb-head-bg);
    color: var(--sb-head-fg);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 0;
  }
  .sb-compare tbody th {
    width: 22%;
    font-weight: 700;
    color: var(--sb-fg);
  }
  .sb-compare tbody tr:last-child th,
  .sb-compare tbody tr:last-child td {
    border-bottom: 0;
  }
  .sb-compare tbody tr {
    transition: background-color 0.2s ease;
  }
  .sb-compare tbody tr:hover {
    background: var(--sb-pill-bg);
  }

  /* ---- ideas */
  .sb-ideas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .sb-idea {
    display: grid;
    gap: 0;
    overflow: clip;
    align-content: start;
  }
  .sb-idea-img {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .sb-idea-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sb-idea-body {
    display: grid;
    gap: 8px;
    padding: 20px 22px 22px;
  }

  /* ---- links */
  .sb-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .sb-link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px;
  }
  .sb-pills {
    list-style: none;
    margin: auto 0 0;
    padding: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sb-pills a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--sb-pill-bg);
    border: 1px solid var(--sb-line);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sb-fg);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .sb-pills a span {
    transition: transform 0.2s ease;
  }
  .sb-pills a:hover {
    background: var(--sb-ico-bg);
    color: var(--sb-ico-fg);
  }
  .sb-pills a:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 1020px) {
    .sb-ideas,
    .sb-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sb-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sb-steps li::before {
      display: none;
    }
  }

  /* ---- phone: the table turns into cards (row name, then «column: value»), steps go down a line */
  @media (max-width: 760px) {
    .sb-ideas,
    .sb-links {
      grid-template-columns: minmax(0, 1fr);
    }
    .sb-feature,
    .sb-link {
      padding: 20px;
    }
    .sb-card {
      border-radius: 20px;
    }
    .sb-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .sb-steps li {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 12px;
    }
    .sb-steps li:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 21px;
      top: 48px;
      bottom: -12px;
      border-left: 2px dashed var(--sb-line);
    }
    .sb-step-ico {
      width: 44px;
      height: 44px;
    }
    .sb-table-box {
      overflow: visible;
      border: 0;
      background: none;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .sb-compare,
    .sb-compare tbody,
    .sb-compare tr,
    .sb-compare th,
    .sb-compare td {
      display: block;
    }
    .sb-compare {
      min-width: 0;
      font-size: 0.9rem;
    }
    .sb-compare thead {
      display: none;
    }
    .sb-compare tbody {
      display: grid;
      gap: 10px;
    }
    .sb-compare tbody tr {
      padding: 14px 16px 16px;
      border-radius: 20px;
      border: 1px solid var(--sb-bd);
      background: var(--sb-glass);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
    }
    .sb-compare th,
    .sb-compare td,
    .sb-compare tbody tr:last-child th,
    .sb-compare tbody tr:last-child td {
      padding: 0;
      border: 0;
    }
    .sb-compare tbody th {
      width: auto;
      margin-bottom: 6px;
      font-size: 1.05rem;
    }
    .sb-compare td {
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 10px;
      padding-block: 4px;
    }
    .sb-compare td::before {
      content: attr(data-label);
      color: var(--sb-muted);
      font-size: 0.8rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sb-pills a,
    .sb-pills a span,
    .sb-compare tbody tr {
      transition: none;
    }
  }
</style>

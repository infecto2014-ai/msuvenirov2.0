---
import type { ServiceBlock } from '@/data/types';
interface Props {
  blocks: ServiceBlock[];
}
const { blocks } = Astro.props;
const tones = ['var(--c-soft)', 'var(--m-soft)', 'var(--y-soft)'];
---

{
  blocks.map((b, bi) => (
    <section class="section sblock" aria-label={b.title}>
      <div class="wrap">
        <h2 class="sblock-title">{b.title}</h2>
        {(b.kind === 'ideas' || b.kind === 'links') && b.lead && <p class="ideas-lead">{b.lead}</p>}

        {b.kind === 'links' && (
          <div class="lcards">
            {b.items.map((it, i) => (
              <article class="lcard" style={`--tone:${['var(--c)', 'var(--m)', 'var(--y)'][i % 3]};--soft:${tones[i % 3]}`}>
                {it.tag && <span class="idea-tag mono">{it.tag}</span>}
                <h3>{it.title}</h3>
                <p>{it.text}</p>
                <ul class="lcard-links">
                  {it.links.map((l) => (
                    <li>
                      <a href={l.href}>{l.label} →</a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        )}

        {b.kind === 'ideas' && (
          <div class="ideas">
            {b.items.map((it, i) => (
              <article class={`idea${i === 0 ? ' idea-hero' : ''}`} style={`--tone:${['var(--c)', 'var(--m)', 'var(--y)'][i % 3]};--soft:${tones[i % 3]}`}>
                {it.img && (
                  <span class="idea-img">
                    <img src={it.img} alt={it.title} width="320" height="320" loading="lazy" decoding="async" />
                  </span>
                )}
                <div class="idea-body">
                  {it.tag && <span class="idea-tag mono">{it.tag}</span>}
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </div>
              </article>
            ))}
          </div>
        )}

        {b.kind === 'text' && (
          <div class="sblock-text prose">
            {b.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )}

        {b.kind === 'features' && (
          <div class="sblock-features">
            {b.items.map((it, i) => (
              <article class="feature" style={`--tone:${tones[(i + bi) % 3]}`}>
                <span class="feature-num mono">{String(i + 1).padStart(2, '0')}</span>
                <h3>{it.title}</h3>
                <p>{it.text}</p>
              </article>
            ))}
          </div>
        )}

        {b.kind === 'steps' && (
          <ol class="sblock-steps">
            {b.items.map((it, i) => (
              <li>
                <span class="step-dot mono">{i + 1}</span>
                <div>
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </div>
              </li>
            ))}
          </ol>
        )}

        {b.kind === 'compare' && (
          <div class="table-wrap">
            <table class="compare">
              <thead>
                <tr>
                  <th scope="col">
                    <span class="sr-only">Параметр</span>
                  </th>
                  {b.columns.map((c) => (
                    <th scope="col">{c}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {b.rows.map((r) => (
                  <tr>
                    <th scope="row">{r.label}</th>
                    {r.values.map((v, vi) => (
                      <td data-label={b.columns[vi]}>{v}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </section>
  ))
}

<style>
  .sblock {
    padding-block: clamp(36px, 5vw, 64px);
  }
  .sblock-title {
    margin-bottom: 28px;
    max-width: 820px;
  }
  .sblock-text {
    max-width: 780px;
    font-size: 1.08rem;
    color: var(--ink-2);
  }
  /* ---- ideas: one big photo card + story cards with a round photo and a tag ---- */
  .ideas-lead {
    margin: -12px 0 24px;
    max-width: 560px;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .ideas {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    gap: 16px;
  }
  .idea {
    position: relative;
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 16px;
    align-items: start;
    padding: 18px;
    border-radius: 26px 26px 26px 8px;
    background: var(--card);
    border: 1.5px solid var(--line);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .idea:hover {
    transform: translateY(-3px);
    box-shadow: 5px 5px 0 var(--tone);
  }
  .idea-img {
    display: block;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    overflow: clip;
    outline: 3px solid var(--tone);
    outline-offset: 3px;
  }
  .idea-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .idea-body {
    display: grid;
    gap: 6px;
    justify-items: start;
  }
  .idea-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--soft);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .idea h3 {
    font-size: 1.2rem;
  }
  .idea p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  /* the first story: big photo on top, spans two rows */
  .idea-hero {
    grid-row: span 2;
    grid-template-columns: 1fr;
    padding: 0;
    overflow: clip;
    background: var(--soft);
    border: 0;
  }
  .idea-hero .idea-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: 0;
    outline: 0;
  }
  .idea-hero .idea-body {
    padding: 4px 22px 22px;
  }
  .idea-hero h3 {
    font-size: 1.6rem;
  }
  .idea-hero .idea-tag {
    background: var(--card);
  }
  @media (max-width: 1020px) {
    .ideas {
      grid-template-columns: 1fr 1fr;
    }
    .idea-hero {
      grid-row: auto;
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
    .idea-hero .idea-img {
      aspect-ratio: 1;
    }
  }
  @media (max-width: 640px) {
    .ideas {
      grid-template-columns: 1fr;
    }
    .idea {
      grid-template-columns: 72px 1fr;
      padding: 14px;
    }
    .idea-img {
      width: 72px;
      height: 72px;
    }
    .idea-hero {
      grid-template-columns: 1fr;
      padding: 0;
    }
    .idea-hero .idea-img {
      aspect-ratio: 4 / 3;
    }
  }

  .lcards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .lcard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 20px 22px;
    border-radius: 28px 28px 28px 8px;
    background: var(--soft);
    border-top: 5px solid var(--tone);
  }
  .lcard h3 {
    font-size: 1.2rem;
  }
  .lcard p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .lcard-links {
    list-style: none;
    margin: auto 0 0;
    padding: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .lcard-links a {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--card);
    border: 1.5px solid var(--line);
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .lcard-links a:hover {
    border-color: var(--ink);
    box-shadow: 3px 3px 0 var(--tone);
  }
  @media (max-width: 960px) {
    .lcards {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
  @media (max-width: 760px) {
    .lcard {
      padding: 14px 16px;
      border-radius: 22px 22px 22px 6px;
    }
    .lcard h3 {
      font-size: 1.02rem;
    }
    .lcard p {
      font-size: 0.84rem;
    }
    .lcard-links a {
      padding: 4px 10px;
      font-size: 0.78rem;
    }
  }
  .sblock-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .feature {
    position: relative;
    padding: 26px 24px;
    border-radius: var(--radius-l);
    background: var(--tone);
    overflow: clip;
  }
  .feature::after {
    content: '';
    position: absolute;
    right: -22px;
    bottom: -22px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 1.5px dashed rgba(22, 20, 27, 0.2);
  }
  .feature-num {
    display: inline-block;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--card);
    margin-bottom: 16px;
  }
  .feature h3 {
    margin-bottom: 8px;
  }
  .feature p {
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .sblock-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 820px;
  }
  .sblock-steps li {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    padding-bottom: 26px;
  }
  .sblock-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 25px;
    top: 52px;
    bottom: 4px;
    border-left: 2px dashed var(--line-strong);
  }
  .step-dot {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--card);
    font-weight: 700;
  }
  .sblock-steps li:nth-child(4n + 1) .step-dot { box-shadow: 3px 3px 0 var(--c); }
  .sblock-steps li:nth-child(4n + 2) .step-dot { box-shadow: 3px 3px 0 var(--m); }
  .sblock-steps li:nth-child(4n + 3) .step-dot { box-shadow: 3px 3px 0 var(--y); }
  .sblock-steps h3 {
    margin: 12px 0 6px;
  }
  .sblock-steps p {
    color: var(--ink-2);
  }
  .compare {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    font-size: 0.95rem;
  }
  .compare th,
  .compare td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .compare thead th {
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
  }
  .compare thead th:nth-child(2) { box-shadow: inset 0 -4px 0 var(--c); }
  .compare thead th:nth-child(3) { box-shadow: inset 0 -4px 0 var(--m); }
  .compare thead th:nth-child(4) { box-shadow: inset 0 -4px 0 var(--y); }
  .compare tbody th {
    font-weight: 700;
    width: 22%;
  }
  .compare tbody tr:last-child th,
  .compare tbody tr:last-child td {
    border-bottom: 0;
  }

  /* ---- phone: tighter sections; the comparison table turns into small cards
     (row name as a title, then «column: value» lines); ideas become a compact list with small round photos */
  @media (max-width: 760px) {
    .sblock {
      padding-block: 28px;
    }
    .sblock-title {
      margin-bottom: 14px;
    }
    .ideas-lead {
      margin: -6px 0 14px;
      font-size: 0.92rem;
    }
    .sblock .table-wrap:has(.compare) {
      overflow: visible;
      border: 0;
      background: none;
      border-radius: 0;
    }
    .compare,
    .compare tbody,
    .compare tr,
    .compare th,
    .compare td {
      display: block;
    }
    .compare {
      min-width: 0;
      font-size: 0.88rem;
    }
    .compare thead {
      display: none;
    }
    .compare tbody {
      display: grid;
      gap: 8px;
    }
    .compare tbody tr {
      padding: 10px 14px 12px;
      border-radius: 18px 18px 18px 6px;
      background: var(--card);
      border: 1.5px solid var(--line);
    }
    .compare tbody tr:nth-child(3n + 1) { border-left: 5px solid var(--c); }
    .compare tbody tr:nth-child(3n + 2) { border-left: 5px solid var(--m); }
    .compare tbody tr:nth-child(3n + 3) { border-left: 5px solid var(--y); }
    .compare th,
    .compare td,
    .compare tbody tr:last-child th,
    .compare tbody tr:last-child td {
      padding: 0;
      border: 0;
    }
    .compare tbody th {
      width: auto;
      margin-bottom: 4px;
      font-size: 1rem;
    }
    .compare td {
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 10px;
      padding-block: 3px;
      line-height: 1.35;
    }
    .compare td::before {
      content: attr(data-label);
      color: var(--muted);
      font-size: 0.8rem;
    }
  }
  @media (max-width: 640px) {
    .ideas {
      gap: 8px;
    }
    .idea,
    .idea-hero {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 12px;
      padding: 12px 14px;
      border-radius: 20px 20px 20px 6px;
      background: var(--card);
      border: 1.5px solid var(--line);
    }
    .idea-img,
    .idea-hero .idea-img {
      width: 56px;
      height: 56px;
      aspect-ratio: 1;
      border-radius: 50%;
      outline: 2px solid var(--tone);
      outline-offset: 2px;
    }
    .idea-body,
    .idea-hero .idea-body {
      gap: 3px;
      padding: 0;
    }
    .idea h3,
    .idea-hero h3 {
      font-size: 1rem;
    }
    .idea p {
      font-size: 0.84rem;
      line-height: 1.4;
    }
    .idea-tag {
      padding: 2px 8px;
      font-size: 0.75rem;
    }
    .idea-hero .idea-tag {
      background: var(--soft);
    }
  }
</style>

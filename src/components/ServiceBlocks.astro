---
import type { ServiceBlock } from '@/data/types';
interface Props {
  blocks: ServiceBlock[];
}
const { blocks } = Astro.props;
const tones = ['var(--c-soft)', 'var(--m-soft)', 'var(--y-soft)'];
---

{
  blocks.map((b, bi) => (
    <section class="section sblock" aria-label={b.title}>
      <div class="wrap">
        <h2 class="sblock-title">{b.title}</h2>

        {b.kind === 'text' && (
          <div class="sblock-text prose">
            {b.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )}

        {b.kind === 'features' && (
          <div class="sblock-features">
            {b.items.map((it, i) => (
              <article class="feature" style={`--tone:${tones[(i + bi) % 3]}`}>
                <span class="feature-num mono">{String(i + 1).padStart(2, '0')}</span>
                <h3>{it.title}</h3>
                <p>{it.text}</p>
              </article>
            ))}
          </div>
        )}

        {b.kind === 'steps' && (
          <ol class="sblock-steps">
            {b.items.map((it, i) => (
              <li>
                <span class="step-dot mono">{i + 1}</span>
                <div>
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </div>
              </li>
            ))}
          </ol>
        )}

        {b.kind === 'compare' && (
          <div class="table-wrap">
            <table class="compare">
              <thead>
                <tr>
                  <th scope="col">
                    <span class="sr-only">Параметр</span>
                  </th>
                  {b.columns.map((c) => (
                    <th scope="col">{c}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {b.rows.map((r) => (
                  <tr>
                    <th scope="row">{r.label}</th>
                    {r.values.map((v) => (
                      <td>{v}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </section>
  ))
}

<style>
  .sblock {
    padding-block: clamp(36px, 5vw, 64px);
  }
  .sblock-title {
    margin-bottom: 28px;
    max-width: 820px;
  }
  .sblock-text {
    max-width: 780px;
    font-size: 1.08rem;
    color: var(--ink-2);
  }
  .sblock-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .feature {
    position: relative;
    padding: 26px 24px;
    border-radius: var(--radius-l);
    background: var(--tone);
    overflow: clip;
  }
  .feature::after {
    content: '';
    position: absolute;
    right: -22px;
    bottom: -22px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 1.5px dashed rgba(22, 20, 27, 0.2);
  }
  .feature-num {
    display: inline-block;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--card);
    margin-bottom: 16px;
  }
  .feature h3 {
    margin-bottom: 8px;
  }
  .feature p {
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .sblock-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 820px;
  }
  .sblock-steps li {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    padding-bottom: 26px;
  }
  .sblock-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 25px;
    top: 52px;
    bottom: 4px;
    border-left: 2px dashed var(--line-strong);
  }
  .step-dot {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--card);
    font-weight: 700;
  }
  .sblock-steps li:nth-child(4n + 1) .step-dot { box-shadow: 3px 3px 0 var(--c); }
  .sblock-steps li:nth-child(4n + 2) .step-dot { box-shadow: 3px 3px 0 var(--m); }
  .sblock-steps li:nth-child(4n + 3) .step-dot { box-shadow: 3px 3px 0 var(--y); }
  .sblock-steps h3 {
    margin: 12px 0 6px;
  }
  .sblock-steps p {
    color: var(--ink-2);
  }
  .compare {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    font-size: 0.95rem;
  }
  .compare th,
  .compare td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .compare thead th {
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
  }
  .compare thead th:nth-child(2) { box-shadow: inset 0 -4px 0 var(--c); }
  .compare thead th:nth-child(3) { box-shadow: inset 0 -4px 0 var(--m); }
  .compare thead th:nth-child(4) { box-shadow: inset 0 -4px 0 var(--y); }
  .compare tbody th {
    font-weight: 700;
    width: 22%;
  }
  .compare tbody tr:last-child th,
  .compare tbody tr:last-child td {
    border-bottom: 0;
  }
</style>

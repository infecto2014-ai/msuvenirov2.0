---
// «Изделие»: colours in stock, facts about the blank, size chart, care tips.
// Facts marked todo are not confirmed by the owner yet — shown with «уточняйте».
import type { GarmentInfo } from '@/data/types';

interface Props {
  info: GarmentInfo;
  productName: string;
}
const { info, productName } = Astro.props;
---

<section class="section gdet" aria-labelledby="gdet-h">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Изделие</p>
        <h2 id="gdet-h">{productName}: цвет, ткань, размеры</h2>
      </div>
    </div>
    <div class="gdet-grid">
      <div class="gdet-card">
        <h3>Цвет</h3>
        <ul class="gdet-colors">
          {
            info.colors.map((c) => (
              <li>
                <span class="gdet-swatch" style={`--sw:${c.hex}`} aria-hidden="true" />
                <span>
                  {c.name}
                  {c.note && <small>{c.note}</small>}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="gdet-card">
        <h3>Характеристики</h3>
        <dl class="gdet-specs">
          {
            info.specs.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>
                  {s.value}
                  {s.todo && <small class="gdet-todo">уточняйте</small>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
      <details class="gdet-card gdet-fold" open data-fold>
        <summary><h3>Как ухаживать</h3></summary>
        <ul class="gdet-care">
          {info.care.map((c) => <li>{c}</li>)}
        </ul>
      </details>
    </div>
    {
      info.sizes && (
        <details class="gdet-sizes gdet-fold" open data-fold>
          <summary>
            <h3>
              Таблица размеров{info.sizes.todo && <small class="gdet-todo">уточняйте у менеджера</small>}
            </h3>
          </summary>
          <div class="table-wrap">
            <table class="price-table">
              <thead>
                <tr>
                  {info.sizes.columns.map((c) => (
                    <th scope="col">{c}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {info.sizes.rows.map((r) => (
                  <tr>
                    {r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )
    }
  </div>
</section>

<script is:inline>
  // «Как ухаживать» and the size chart are always open on a computer; on a phone they start folded (tap to open).
  // Runs right after the markup, before the first paint, so nothing jumps.
  (function () {
    var m = matchMedia('(max-width: 760px)');
    document.querySelectorAll('[data-fold]').forEach(function (d) {
      if (m.matches) d.open = false;
      d.querySelector('summary').addEventListener('click', function (e) {
        if (!m.matches) e.preventDefault();
      });
      m.addEventListener('change', function (e) {
        d.open = !e.matches;
      });
    });
  })();
</script>

<style>
  .gdet-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .gdet-card {
    padding: 22px;
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1.5px solid var(--line);
  }
  .gdet-card h3,
  .gdet-sizes h3 {
    margin-bottom: 14px;
    font-size: 1.1rem;
  }
  .gdet-colors,
  .gdet-care {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .gdet-colors {
    gap: 8px;
  }
  .gdet-colors li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 1.02rem;
  }
  .gdet-colors small {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .gdet-swatch {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--sw);
    border: 1.5px solid var(--line-strong);
  }
  .gdet-specs {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .gdet-specs div {
    display: grid;
    gap: 2px;
  }
  .gdet-specs dt {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .gdet-specs dd {
    margin: 0;
    font-weight: 600;
  }
  .gdet-todo {
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--y-soft);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .gdet-care li {
    position: relative;
    padding-left: 22px;
    font-size: 0.94rem;
    color: var(--ink-2);
  }
  .gdet-care li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.5em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--m);
  }
  .gdet-sizes {
    margin-top: 28px;
  }
  /* on a computer the summary looks like a plain heading */
  .gdet-fold > summary {
    display: block;
    list-style: none;
    cursor: default;
  }
  .gdet-fold > summary::-webkit-details-marker {
    display: none;
  }
  @media (max-width: 900px) {
    .gdet-grid {
      grid-template-columns: 1fr;
    }
    .gdet-colors {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* phone: tighter cards, colours in two columns, specs as «name — value» rows, care tips and size chart folded */
  @media (max-width: 760px) {
    .gdet {
      padding-block: 32px;
    }
    .gdet .section-head {
      margin-bottom: 14px;
    }
    .gdet .section-head .eyebrow {
      margin-bottom: 6px;
    }
    .gdet-grid {
      gap: 10px;
    }
    .gdet-card {
      padding: 14px 16px;
      border-radius: 22px;
    }
    .gdet-card h3,
    .gdet-sizes h3 {
      margin-bottom: 10px;
      font-size: 1rem;
    }
    .gdet-colors {
      gap: 6px 10px;
    }
    .gdet-colors li {
      gap: 8px;
      font-size: 0.9rem;
    }
    .gdet-swatch {
      width: 22px;
      height: 22px;
      border-radius: 7px;
    }
    .gdet-specs {
      gap: 0;
    }
    .gdet-specs div {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 10px;
      align-items: baseline;
      padding: 6px 0;
      border-bottom: 1px solid var(--line);
    }
    .gdet-specs div:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }
    .gdet-specs dt {
      font-size: 0.78rem;
    }
    .gdet-specs dd {
      font-size: 0.86rem;
      line-height: 1.35;
    }
    .gdet-todo {
      margin-left: 6px;
      font-size: 0.75rem;
    }
    .gdet-care {
      gap: 6px;
    }
    .gdet-care li {
      font-size: 0.86rem;
      padding-left: 18px;
    }
    .gdet-fold > summary {
      position: relative;
      padding-right: 32px;
      cursor: pointer;
    }
    .gdet-fold > summary::after {
      content: '+';
      position: absolute;
      right: 0;
      top: 50%;
      width: 26px;
      height: 26px;
      margin-top: -13px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      border: 1.5px solid var(--ink);
      font-weight: 700;
      line-height: 1;
    }
    .gdet-fold[open] > summary::after {
      content: '−';
    }
    .gdet-fold:not([open]) > summary h3 {
      margin-bottom: 0;
    }
    .gdet-sizes {
      margin-top: 10px;
      padding: 14px 16px;
      border-radius: 22px;
      background: var(--card);
      border: 1.5px solid var(--line);
    }
    .gdet-sizes h3 {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 0;
    }
    .gdet-sizes .table-wrap {
      border-radius: 14px;
    }
    .gdet-sizes .price-table {
      min-width: 0;
      font-size: 0.86rem;
    }
    .gdet-sizes .price-table th,
    .gdet-sizes .price-table td {
      padding: 7px 10px;
    }
    .gdet-sizes .price-table thead th {
      white-space: normal;
      font-size: 0.75rem;
      vertical-align: bottom;
    }
  }
</style>

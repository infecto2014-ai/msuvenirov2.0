---
// «Готовые варианты» on a garment page: ready orders with a turnkey price computed from pricing.ts.
import { defaultSelection, findProduct, rub, type Selection } from '@/data/pricing';
import type { GarmentInfo } from '@/data/types';

interface Props {
  info: GarmentInfo;
  productName: string;
}
const { info } = Astro.props;
const product = findProduct('textile', info.productId)!;
const items = info.packages.map((pk) => {
  const base = defaultSelection(product);
  const sel: Selection = { ...base, qty: pk.qty, options: { ...base.options, print2: 'none', print3: 'none', ...pk.options } };
  const q = product.quote(sel);
  return { ...pk, unit: q.unit, total: q.total, from: q.from };
});
---

<section class="section gpk" aria-labelledby="gpk-h">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Популярное</p>
        <h2 id="gpk-h">Готовые варианты с ценой</h2>
      </div>
      <p class="gpk-sub">Цена указана за готовое изделие вместе с печатью. Свой вариант — в калькуляторе выше.</p>
    </div>
    <ul class="gpk-grid">
      {
        items.map((it) => {
          const label = `${it.title} (${it.note}), ${it.qty} шт — ${it.from ? 'от ' : ''}${rub(it.total)}`;
          return (
            <li class="gpk-card">
              <img src={it.img} alt={it.title} width="320" height="240" loading="lazy" decoding="async" />
              <div class="gpk-body">
                <h3>{it.title}</h3>
                <p class="gpk-note">
                  {it.note} · {it.qty} шт
                </p>
                <p class="gpk-price mono">
                  {it.from && <small>от</small>}
                  {rub(it.total)}
                  {it.qty > 1 && <small>{rub(it.unit)} / шт</small>}
                </p>
                <button type="button" class="btn btn-sm btn-magenta" data-order={label}>
                  Заказать
                </button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .gpk-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
  }
  .gpk-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1.5px solid var(--line);
    overflow: clip;
  }
  .gpk-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--paper-2);
  }
  .gpk-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 14px 16px 18px;
  }
  .gpk-body h3 {
    font-size: 1.08rem;
  }
  .gpk-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  /* price + button sit at the bottom, so all cards line up whatever the title length */
  .gpk-price {
    margin: auto 0 10px;
    padding-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .gpk-price small {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0;
  }
  /* phone: a carousel of compact cards (short photo, small price), the section is tighter */
  @media (max-width: 760px) {
    .gpk {
      padding-block: 32px;
    }
    .gpk .section-head {
      margin-bottom: 14px;
      gap: 6px;
    }
    .gpk .section-head .eyebrow {
      margin-bottom: 6px;
    }
    .gpk-sub {
      display: none;
    }
    .gpk-grid {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 8px;
      scrollbar-width: none;
    }
    .gpk-grid::-webkit-scrollbar {
      display: none;
    }
    .gpk-card {
      flex: 0 0 min(220px, 62%);
      scroll-snap-align: start;
      border-radius: 22px;
    }
    .gpk-card img {
      aspect-ratio: 16 / 10;
    }
    .gpk-body {
      gap: 2px;
      padding: 10px 12px 12px;
    }
    .gpk-body h3 {
      font-size: 0.95rem;
    }
    .gpk-note {
      font-size: 0.78rem;
      line-height: 1.35;
    }
    .gpk-price {
      margin-bottom: 8px;
      padding-top: 8px;
      gap: 4px;
      font-size: 1.1rem;
    }
    .gpk-price small {
      font-size: 0.75rem;
    }
    .gpk-body .btn {
      min-height: 38px;
      padding: 0 16px;
      font-size: 0.85rem;
    }
  }
</style>

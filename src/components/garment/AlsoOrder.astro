---
// «С этим заказывают» — a slim strip of links to other products, under the calculator on garment pages.
import { services } from '@/data/services';
import { categoryFrom, findProduct, rub } from '@/data/pricing';

interface Props {
  slugs: string[];
}
const { slugs } = Astro.props;
/** short names for the strip (the service names are «Печать на кружках» etc.) */
const short: Record<string, string> = {
  '/pechat-na-futbolkah': 'Футболки',
  '/pechat-na-hudi': 'Худи',
  '/pechat-na-kruzhkah': 'Кружки',
  '/pechat-na-kepkah': 'Кепки',
  '/pechat-na-specodezhde': 'Спецодежда',
  '/pechat-na-shopperah': 'Шопперы',
  '/znachki': 'Значки',
  '/breloki': 'Брелоки',
  '/magnity': 'Магниты',
  '/nakleyki': 'Стикеры',
  '/fotopodarki': 'Фотоподарки',
  '/vizitki': 'Визитки',
  '/poligrafiya': 'Листовки и блокноты',
  '/kalendari': 'Календари',
};
const items = slugs
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s) => !!s)
  .map((s) => {
    const p = s!.calcProduct ? findProduct(s!.calcCategory, s!.calcProduct) : undefined;
    const from = p && !p.fromUnit ? p.fromPrice : categoryFrom(s!.calcCategory).price;
    return { href: s!.slug, name: short[s!.slug] ?? s!.name, img: s!.image, from };
  });
---

{
  items.length > 0 && (
    <nav class="also wrap" aria-label="С этим заказывают" data-also>
      <div class="also-head">
        <span class="also-title">С этим заказывают</span>
        <span class="also-arrows">
          <button type="button" class="also-arrow" data-dir="-1" aria-label="Назад">
            ←
          </button>
          <button type="button" class="also-arrow" data-dir="1" aria-label="Вперёд">
            →
          </button>
        </span>
      </div>
      <ul class="also-list">
        {items.map((it, i) => (
          <li>
            <a href={it.href} class={`also-card also-${['c', 'm', 'y'][i % 3]}`}>
              <span class="also-img">
                <img src={it.img} alt="" width="160" height="160" loading="lazy" decoding="async" />
              </span>
              <span class="also-name">{it.name}</span>
              <span class="also-price mono">от {rub(it.from)}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // arrows scroll the carousel by about one card; they hide when the row fits or at the ends
  for (const nav of document.querySelectorAll<HTMLElement>('[data-also]')) {
    const list = nav.querySelector<HTMLElement>('.also-list')!;
    const [prev, next] = nav.querySelectorAll<HTMLButtonElement>('.also-arrow');
    const update = () => {
      prev.disabled = list.scrollLeft < 4;
      next.disabled = list.scrollLeft + list.clientWidth > list.scrollWidth - 4;
      nav.classList.toggle('fits', list.scrollWidth <= list.clientWidth + 4);
    };
    for (const b of [prev, next]) {
      b.addEventListener('click', () => {
        const card = list.querySelector('li');
        list.scrollBy({ left: Number(b.dataset.dir) * ((card?.clientWidth ?? 200) + 14) * 2, behavior: 'smooth' });
      });
    }
    list.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .also {
    margin-top: 28px;
  }
  .also-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .also-title {
    font-weight: 900;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    letter-spacing: -0.02em;
  }
  .also-arrows {
    display: flex;
    gap: 8px;
  }
  .also.fits .also-arrows {
    visibility: hidden;
  }
  .also-arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: var(--card);
    font: inherit;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .also-arrow:hover:not(:disabled) {
    background: var(--y);
  }
  .also-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .also-list {
    list-style: none;
    margin: 0;
    padding: 4px 4px 10px;
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .also-list::-webkit-scrollbar {
    display: none;
  }
  .also-list li {
    flex: 0 0 200px;
    scroll-snap-align: start;
  }
  .also-card {
    display: grid;
    gap: 4px;
    padding: 12px 12px 16px;
    border-radius: 24px 24px 24px 8px;
    background: var(--card);
    border: 1.5px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .also-card:hover {
    color: var(--ink);
    transform: translateY(-3px);
    box-shadow: 5px 5px 0 var(--tone);
  }
  .also-c { --tone: var(--c); --soft: var(--c-soft); }
  .also-m { --tone: var(--m); --soft: var(--m-soft); }
  .also-y { --tone: var(--y); --soft: var(--y-soft); }
  .also-img {
    display: block;
    aspect-ratio: 1;
    margin-bottom: 8px;
    border-radius: 18px;
    overflow: clip;
    background: var(--soft);
  }
  .also-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    transition: transform 0.3s ease;
  }
  .also-card:hover .also-img img {
    transform: scale(1.06);
  }
  .also-name {
    font-weight: 800;
    font-size: 1.1rem;
  }
  .also-price {
    justify-self: start;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--soft);
    font-size: 0.85rem;
    font-weight: 700;
  }
  @media (max-width: 760px) {
    .also-list {
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
    .also {
      margin-top: 22px;
    }
    .also-head {
      margin-bottom: 8px;
    }
    .also-title {
      font-size: 1.1rem;
    }
    .also-list {
      gap: 10px;
      padding-bottom: 6px;
    }
    .also-list li {
      flex-basis: 128px;
    }
    .also-card {
      gap: 2px;
      padding: 8px 8px 10px;
      border-radius: 18px 18px 18px 6px;
    }
    .also-img {
      margin-bottom: 6px;
      border-radius: 12px;
    }
    .also-name {
      font-size: 0.95rem;
    }
    .also-price {
      padding: 2px 8px;
      font-size: 0.75rem;
    }
    .also-arrows {
      display: none;
    }
  }
</style>

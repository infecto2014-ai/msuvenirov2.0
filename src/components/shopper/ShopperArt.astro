---
// Иллюстрация шоппера (плоская графика «CMYK 2.0»), вид спереди, ручки-петли сверху.
// viewBox — в миллиметрах, поэтому модели в одном scale сравниваются по реальному размеру,
// а принт рисуется в настоящем масштабе (А6…А3).
import { buildShopper, type ShopperType, type PrintSize } from './shopper-geometry';

interface Props {
  type: 'cotton' | 'linen'; // cotton — хлопковый шоппер под DTF; linen — светлый шоппер для сублимации (небелёный лён)
  color?: 'natural' | 'white' | 'black'; // для cotton, по умолчанию 'natural'; linen всегда цвета небелёного льна
  print?: 'logo' | 'photo' | 'text' | 'art' | 'none'; // что напечатано, по умолчанию 'logo'
  printSize?: 'a6' | 'a5' | 'a4' | 'a3'; // размер принта в масштабе, по умолчанию 'a4'
  dims?: boolean; // подписи размеров (36×42 см, ручки 70 см) со стрелками
  scale?: number; // px на мм, по умолчанию 0.6
  title?: string;
  class?: string;
}

const { type, color = 'natural', print = 'logo', printSize = 'a4', dims = false, scale = 0.6, title, class: cls } = Astro.props;

const L = buildShopper(type as ShopperType, printSize as PrintSize);
const M = L.model;
const { w, h, strapW } = M;
const cx = w / 2;
const u = 1 / scale; // 1 экранный пиксель в мм
const uid = 'shp' + crypto.randomUUID().slice(0, 8);
const id = (s: string) => `${uid}-${s}`;
const url = (s: string) => `url(#${id(s)})`;

// Палитра ткани
const PAL = {
  linen: { fabric: '#d7cab0', edge: '#a39372', thread: '#ad9c7b', inner: '#b8aa8e', dark: false },
  natural: { fabric: '#efe6d2', edge: '#c9bb9b', thread: '#cdbf9e', inner: '#d6cab0', dark: false },
  white: { fabric: '#fbfaf6', edge: '#cfc5b1', thread: '#d6cfc0', inner: '#e4ded2', dark: false },
  black: { fabric: '#26232a', edge: '#0d0c10', thread: '#55505c', inner: '#121115', dark: true },
} as const;
const tone = type === 'linen' ? 'linen' : color in PAL ? color : 'natural';
const P = PAL[tone as keyof typeof PAL];
const dark = P.dark;

const COLOR_NAME: Record<string, string> = { natural: 'натуральный', white: 'белый', black: 'чёрный' };
const label = title ?? (type === 'linen' ? M.name : `${M.name}, ${COLOR_NAME[tone] ?? ''}`);

// Принт: свой viewBox 100 × hv
const R = L.print;
const hv = (100 * R.h) / R.w;
const pfx = (n: number) => +n.toFixed(2);

// Растровые точки для art
const dots: { x: number; y: number; r: number }[] = [];
for (let i = 0; i < 7; i++) for (let j = 0; j < 7; j++) dots.push({ x: 60 + i * 5.2, y: hv * 0.1 + j * 5.2, r: 0.4 + (i + j) * 0.17 });

// Строчки ручки: 4 прохода (контур, ткань, пунктир, ткань) — пунктир остаётся у краёв
const stitch = `${4.2} ${2.6}`;

// Размеры
const fsDim = 10.5 * u;
const arrow = 6 * u;
const aw = 2.4 * u;
const charW = fsDim * 0.62;
const wLabel = `${M.w / 10} см`;
const hLabel = `${M.h / 10} см`;
const sLabel = `ручки ${M.strap / 10} см`;
const gLabel = M.gsm ? `${M.gsm} г/м²` : '';
const vDimX = -12 * u;
const vTextX = vDimX - 7 * u;
const wDimY = h + 18 * u;
// подпись ручки — справа от петли, с выноской
const sAnchorX = L.strapPoint.x;
const sAnchorY = L.strapPoint.y;
const sTextX = sAnchorX + 24 * u;
const sTextW = sLabel.length * charW;
const pillH = 17 * u;
const pillW = gLabel.length * charW + 18 * u;
const pillY = wDimY + 12 * u;

const leftMost = dims ? Math.min(-6, vTextX - hLabel.length * charW) : -6;
const rightMost = dims ? Math.max(w + 10, sTextX + sTextW + 4 * u) : w + 10;
const bottom = dims ? (gLabel ? pillY + pillH : wDimY + fsDim) + 3 : h + 12;

const padL = 3 - leftMost;
const vbW = padL + rightMost + 3;
const padT = 3 - L.top;
const vbH = padT + bottom;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${vbW.toFixed(1)} ${vbH.toFixed(1)}`}
  width={Math.round(vbW * scale)}
  height={Math.round(vbH * scale)}
  role="img"
  aria-label={label}
  class:list={['shopart', cls]}
>
  <title>{label}</title>
  <defs>
    <clipPath id={id('body')}><path d={L.front} /></clipPath>
    <filter id={id('blur')} filterUnits="userSpaceOnUse" x="-60" y="-60" width={w + 120} height={h + 120}>
      <feGaussianBlur stdDeviation="6" />
    </filter>
    <filter id={id('shadowf')} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="7" />
    </filter>
    <linearGradient id={id('shade')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#16141b" stop-opacity={dark ? 0.3 : 0.1} />
      <stop offset="0.12" stop-color="#16141b" stop-opacity="0" />
      <stop offset="0.82" stop-color="#16141b" stop-opacity="0" />
      <stop offset="1" stop-color="#16141b" stop-opacity={dark ? 0.35 : 0.13} />
    </linearGradient>
    <linearGradient id={id('vshade')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#16141b" stop-opacity={dark ? 0.25 : 0.08} />
      <stop offset="0.1" stop-color="#16141b" stop-opacity="0" />
      <stop offset="0.9" stop-color="#16141b" stop-opacity="0" />
      <stop offset="1" stop-color="#16141b" stop-opacity={dark ? 0.2 : 0.07} />
    </linearGradient>
    {
      type === 'linen' ? (
        <>
          {/* льняное переплетение: мелкая сетка + неровные утолщения нитей */}
          <pattern id={id('tex')} width="2.6" height="2.6" patternUnits="userSpaceOnUse">
            <path d="M 0 0.65 H 2.6" stroke="#5b4a2c" stroke-opacity="0.13" stroke-width="0.55" />
            <path d="M 1.95 0 V 2.6" stroke="#fff" stroke-opacity="0.2" stroke-width="0.5" />
            <path d="M 0.65 1.3 V 2.6" stroke="#5b4a2c" stroke-opacity="0.07" stroke-width="0.4" />
          </pattern>
          <pattern id={id('slub')} width="47" height="31" patternUnits="userSpaceOnUse">
            <g stroke-linecap="round" fill="none">
              <path d="M 3 4 h 13" stroke="#5b4a2c" stroke-opacity="0.13" stroke-width="0.9" />
              <path d="M 22 11 h 19" stroke="#fff" stroke-opacity="0.2" stroke-width="0.8" />
              <path d="M 8 18 h 9" stroke="#5b4a2c" stroke-opacity="0.1" stroke-width="1.1" />
              <path d="M 30 24 h 14" stroke="#5b4a2c" stroke-opacity="0.12" stroke-width="0.7" />
              <path d="M 1 28 h 11" stroke="#fff" stroke-opacity="0.18" stroke-width="0.9" />
              <path d="M 35 2 v 9" stroke="#5b4a2c" stroke-opacity="0.08" stroke-width="0.7" />
              <path d="M 19 21 v 8" stroke="#fff" stroke-opacity="0.16" stroke-width="0.6" />
            </g>
          </pattern>
        </>
      ) : (
        <pattern id={id('tex')} width="2" height="2" patternUnits="userSpaceOnUse">
          <path d="M 0 0.5 H 2" stroke={dark ? '#fff' : '#5b4a2c'} stroke-opacity={dark ? 0.05 : 0.06} stroke-width="0.45" />
          <path d="M 1.5 0 V 2" stroke={dark ? '#000' : '#fff'} stroke-opacity={dark ? 0.12 : 0.2} stroke-width="0.4" />
        </pattern>
      )
    }
    {
      print === 'photo' && (
        <linearGradient id={id('sky')} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="st-cs" />
          <stop offset="1" class="st-ys" />
        </linearGradient>
      )
    }
    {
      print === 'art' && (
        <clipPath id={id('artc')}>
          <circle cx="50" cy={hv / 2} r="44" />
        </clipPath>
      )
    }
  </defs>

  <g transform={`translate(${padL.toFixed(2)} ${padT.toFixed(2)})`}>
    {/* Тень */}
    <path d={L.front} fill="#16141b" opacity={dark ? 0.35 : 0.22} filter={url('shadowf')} transform="translate(7 9)" />

    {/* Ручки: задняя (за сумкой, в тени), затем передняя */}
    {
      [L.strapBack, L.strapFront].map((d, i) => (
        <g fill="none">
          <path d={d} stroke={P.edge} stroke-width={strapW + 2 * u} />
          <path d={d} stroke={P.fabric} stroke-width={strapW} />
          <path d={d} stroke={url('tex')} stroke-width={strapW} />
          <path d={d} stroke={P.thread} stroke-width={strapW - 4.6} stroke-dasharray={stitch} />
          <path d={d} stroke={P.fabric} stroke-width={strapW - 6.4} />
          <path d={d} stroke={url('tex')} stroke-width={strapW - 6.4} />
          {/* объём ленты: тень по центру-низу */}
          <path d={d} stroke="#16141b" stroke-opacity={dark ? 0.2 : 0.06} stroke-width={strapW * 0.3} transform={`translate(${strapW * 0.12} 0)`} />
          {i === 0 && <path d={d} stroke="#16141b" stroke-opacity={dark ? 0.3 : 0.16} stroke-width={strapW + 2 * u} />}
        </g>
      ))
    }

    {/* Задняя стенка (изнанка видна над провисшим краем) */}
    <path d={L.back} fill={P.inner} stroke={P.edge} stroke-width={u} stroke-linejoin="round" />

    {/* Передняя стенка */}
    <path d={L.front} fill={P.fabric} />
    <g clip-path={url('body')}>
      <rect x="-5" y="-5" width={w + 10} height={h + 10} fill={url('tex')} />
      {type === 'linen' && <rect x="-5" y="-5" width={w + 10} height={h + 10} fill={url('slub')} />}

      {/* Принт */}
      {
        print !== 'none' && (
          <svg x={R.x} y={R.y} width={R.w} height={R.h} viewBox={`0 0 100 ${pfx(hv)}`} overflow="visible">
            {print === 'logo' && (
              <g>
                <g class={dark ? '' : 'blend'}>
                  <circle cx="38" cy={hv * 0.36} r="19" class="f-c" />
                  <circle cx="62" cy={hv * 0.36} r="19" class="f-m" opacity={dark ? 0.92 : 1} />
                  <circle cx="50" cy={hv * 0.36 + 19} r="19" class="f-y" opacity={dark ? 0.92 : 1} />
                </g>
                <text x="50" y={hv * 0.36 + 56} font-size="10.5" text-anchor="middle" font-weight="800" textLength="78" lengthAdjust="spacingAndGlyphs" class:list={['t', dark ? 'f-paper' : 'f-ink']}>
                  ВАШ ЛОГОТИП
                </text>
                <text x="50" y={hv * 0.36 + 66} font-size="5" text-anchor="middle" letter-spacing="1.2" class:list={['mono', dark ? 'f-paper' : 'f-ink2']} opacity="0.8">
                  KALININGRAD · 2026
                </text>
              </g>
            )}
            {print === 'photo' && (
              <g>
                <rect x="2" y={hv * 0.08} width="96" height={hv * 0.72} rx="3" fill={url('sky')} />
                <svg x="2" y={hv * 0.08} width="96" height={hv * 0.72} viewBox="0 0 96 100" preserveAspectRatio="none">
                  <circle cx="66" cy="34" r="13" class="f-y" />
                  <path d="M 0 80 L 22 46 L 34 60 L 52 30 L 74 66 L 84 56 L 96 70 V 100 H 0 Z" class="f-c" />
                  <path d="M 52 30 L 59 41 L 55 40 L 51 45 L 47 38 Z" fill="#fff" opacity="0.85" />
                  <path d="M 0 88 Q 24 74 48 86 T 96 82 V 100 H 0 Z" class="f-m" />
                  <path d="M 0 96 Q 30 88 60 95 T 96 94 V 100 H 0 Z" class="f-ink" opacity="0.85" />
                </svg>
                <rect x="2" y={hv * 0.08} width="96" height={hv * 0.72} rx="3" fill="none" stroke={dark ? '#fff' : '#16141b'} stroke-opacity={dark ? 0.6 : 0.15} stroke-width="0.6" />
                <text x="50" y={hv * 0.92} font-size="7" text-anchor="middle" letter-spacing="2" font-weight="600" class:list={['mono', dark ? 'f-paper' : 'f-ink']}>
                  БАЛТИКА
                </text>
              </g>
            )}
            {print === 'text' && (
              <g>
                <text x="50" y={hv * 0.4} font-size="23" text-anchor="middle" font-weight="900" textLength="92" lengthAdjust="spacingAndGlyphs" class:list={['t', 'f-m']}>
                  ЛЮБЛЮ
                </text>
                <text x="50" y={hv * 0.4 + 24} font-size="23" text-anchor="middle" font-weight="900" textLength="92" lengthAdjust="spacingAndGlyphs" class:list={['t', dark ? 'f-paper' : 'f-ink']}>
                  ЧИТАТЬ
                </text>
                {/* книжка */}
                <g transform={`translate(50 ${hv * 0.4 + 40})`}>
                  <path d="M -18 -6 Q -9 -9 0 -5 Q 9 -9 18 -6 V 8 Q 9 5 0 9 Q -9 5 -18 8 Z" class="f-c" />
                  <path d="M 0 -5 V 9" stroke={dark ? '#26232a' : '#fff'} stroke-width="1" />
                  <path d="M -14 -2 Q -8 -4 -3 -1 M -14 2 Q -8 0 -3 3 M 3 -1 Q 8 -4 14 -2 M 3 3 Q 8 0 14 2" fill="none" stroke={dark ? '#26232a' : '#fff'} stroke-width="0.8" stroke-linecap="round" opacity="0.8" />
                  <circle cx="20" cy="-10" r="3.2" class="f-y" />
                </g>
              </g>
            )}
            {print === 'art' && (
              <g>
                <circle cx="53" cy={hv / 2 + 3} r="44" fill="none" class="s-c" stroke-width="2.2" />
                <g clip-path={url('artc')}>
                  <rect x="0" y="0" width="100" height={hv} class="f-ys" />
                  <circle cx="58" cy={hv / 2 - 10} r="20" class="f-m" />
                  <circle cx="58" cy={hv / 2 - 10} r="12" class="f-y" />
                  {dots.map((d) => (
                    <circle cx={d.x - 50} cy={d.y + hv * 0.12} r={d.r} class="f-m" opacity="0.55" />
                  ))}
                  <path d={`M 0 ${hv / 2 + 8} Q 15 ${hv / 2} 30 ${hv / 2 + 8} T 60 ${hv / 2 + 8} T 90 ${hv / 2 + 8} T 120 ${hv / 2 + 8} V ${hv} H 0 Z`} class="f-c" />
                  <path d={`M -10 ${hv / 2 + 20} Q 5 ${hv / 2 + 12} 20 ${hv / 2 + 20} T 50 ${hv / 2 + 20} T 80 ${hv / 2 + 20} T 110 ${hv / 2 + 20} V ${hv} H -10 Z`} class="f-ink" />
                  <path d={`M 0 ${hv / 2 + 31} Q 15 ${hv / 2 + 24} 30 ${hv / 2 + 31} T 60 ${hv / 2 + 31} T 90 ${hv / 2 + 31} T 120 ${hv / 2 + 31} V ${hv} H 0 Z`} class="f-m" />
                  <path d={`M 4 ${hv / 2 + 14} q 6 -4 12 0 M 64 ${hv / 2 + 14} q 6 -4 12 0`} fill="none" stroke="#fff" stroke-width="1.1" stroke-linecap="round" opacity="0.8" />
                </g>
                <circle cx="20" cy={hv / 2 - 30} r="7" class="f-y" />
                <circle cx="86" cy={hv / 2 + 34} r="4.5" class="f-m" />
              </g>
            )}
          </svg>
        )
      }

      {/* фактура поверх принта — краска «в ткани» */}
      {print !== 'none' && <rect x={R.x - 2} y={R.y - 2} width={R.w + 4} height={R.h + 4} fill={url('tex')} opacity="0.7" />}

      {/* Складки */}
      <g fill="none" stroke-linecap="round">
        {L.folds.map((fo) => (
          <path d={fo.d} stroke={fo.tone < 0 ? '#16141b' : '#fff'} stroke-width={fo.w} opacity={dark ? (fo.tone < 0 ? fo.o * 2 : fo.o * 0.35) : fo.o} filter={fo.w > 4 ? url('blur') : undefined} />
        ))}
      </g>
      <rect x="-5" y="-5" width={w + 10} height={h + 10} fill={url('shade')} />
      <rect x="-5" y="-5" width={w + 10} height={h + 10} fill={url('vshade')} />

      {/* Подгиб сверху и боковые швы */}
      <path d={`M 4 ${M.hem} Q ${cx} ${M.hem + 7} ${w - 4} ${M.hem}`} fill="none" stroke={P.thread} stroke-width="0.9" stroke-dasharray={stitch} />
      <path d={`M 4 ${M.hem + 1.6} Q ${cx} ${M.hem + 8.6} ${w - 4} ${M.hem + 1.6}`} fill="none" stroke="#fff" stroke-opacity={dark ? 0.06 : 0.35} stroke-width="0.8" />
      <path d={`M 0 ${M.hem + 2.4} Q ${cx} ${M.hem + 9.4} ${w} ${M.hem + 2.4}`} fill="none" stroke="#16141b" stroke-opacity={dark ? 0.3 : 0.06} stroke-width="1.6" />
      <path d={`M 5 ${M.hem + 10} Q 3.6 ${h * 0.6} 5.6 ${h - 6}`} fill="none" stroke={P.thread} stroke-width="0.8" stroke-dasharray={stitch} opacity="0.75" />
      <path d={`M ${w - 5} ${M.hem + 10} Q ${w - 3.6} ${h * 0.6} ${w - 5.6} ${h - 6}`} fill="none" stroke={P.thread} stroke-width="0.8" stroke-dasharray={stitch} opacity="0.75" />
      <path d={`M 9 ${h - 5} Q ${cx} ${h - 3} ${w - 9} ${h - 5}`} fill="none" stroke={P.thread} stroke-width="0.8" stroke-dasharray={stitch} opacity="0.75" />
      {/* уголки дна: мелкие заломы */}
      <path d={`M 4 ${h - 26} q 9 8 16 25 M ${w - 4} ${h - 30} q -10 9 -17 29`} fill="none" stroke="#16141b" stroke-opacity={dark ? 0.35 : 0.1} stroke-width="1.4" stroke-linecap="round" />

      {/* Пришив ручек: квадрат с крестиком */}
      {
        L.tacks.map((t) => {
          const x0 = t.x - t.w / 2 + 1.5;
          const x1 = t.x + t.w / 2 - 1.5;
          const y0 = t.y;
          const y1 = t.y + t.h;
          return (
            <g fill="none" stroke-linecap="round">
              {/* конец ручки просвечивает под тканью */}
              <rect x={t.x - t.w / 2} y="-1" width={t.w} height={y1 + 2} fill="#16141b" opacity={dark ? 0.12 : 0.045} />
              <path d={`M ${x0} ${y0} H ${x1} V ${y1} H ${x0} Z M ${x0} ${y0} L ${x1} ${y1} M ${x1} ${y0} L ${x0} ${y1}`} stroke={P.thread} stroke-width="0.9" stroke-dasharray="2.2 1.2" />
            </g>
          );
        })
      }
    </g>
    <path d={L.front} fill="none" stroke={P.edge} stroke-width={u} stroke-linejoin="round" />

    {/* Размеры */}
    {
      dims && (
        <g>
          {/* высота */}
          <line x1={vDimX - 4 * u} x2={-4 * u} y1="0" y2="0" class="ext" stroke-width={u} />
          <line x1={vDimX - 4 * u} x2={-4 * u} y1={h} y2={h} class="ext" stroke-width={u} />
          <line x1={vDimX} x2={vDimX} y1={arrow * 0.6} y2={h - arrow * 0.6} class="s-ink2" stroke-width={u} />
          <path d={`M ${vDimX} 0 l ${-aw} ${arrow} h ${aw * 2} z M ${vDimX} ${h} l ${-aw} ${-arrow} h ${aw * 2} z`} class="f-ink2" />
          <text x={vTextX} y={h / 2 + fsDim * 0.36} font-size={fsDim} text-anchor="end" class="mono f-ink2">
            {hLabel}
          </text>
          {/* ширина */}
          <line x1="0" x2="0" y1={h + 4 * u} y2={wDimY + 4 * u} class="ext" stroke-width={u} />
          <line x1={w} x2={w} y1={h + 4 * u} y2={wDimY + 4 * u} class="ext" stroke-width={u} />
          <line x1={arrow * 0.6} x2={w - arrow * 0.6} y1={wDimY} y2={wDimY} class="s-ink2" stroke-width={u} />
          <path d={`M 0 ${wDimY} l ${arrow} ${-aw} v ${aw * 2} z M ${w} ${wDimY} l ${-arrow} ${-aw} v ${aw * 2} z`} class="f-ink2" />
          <rect x={cx - (wLabel.length * charW) / 2 - 5 * u} y={wDimY - fsDim * 0.75} width={wLabel.length * charW + 10 * u} height={fsDim * 1.5} class="f-paper" />
          <text x={cx} y={wDimY + fsDim * 0.36} font-size={fsDim} text-anchor="middle" class="mono f-ink2">
            {wLabel}
          </text>
          {/* ручки — выноска */}
          <circle cx={sAnchorX} cy={sAnchorY} r={2.6 * u} class="f-m" />
          <line x1={sAnchorX} x2={sTextX - 4 * u} y1={sAnchorY} y2={sAnchorY} class="s-ink2" stroke-width={u} />
          <text x={sTextX} y={sAnchorY + fsDim * 0.36} font-size={fsDim} class="mono f-ink2">
            {sLabel}
          </text>
          {/* плотность */}
          {gLabel && (
            <g>
              <rect x={cx - pillW / 2} y={pillY} width={pillW} height={pillH} rx={pillH / 2} class="f-ink" />
              <circle cx={cx - pillW / 2 + 7.5 * u} cy={pillY + pillH / 2} r={2.6 * u} class="f-y" />
              <text x={cx + 4 * u} y={pillY + pillH / 2 + fsDim * 0.36} font-size={fsDim} text-anchor="middle" class="mono f-paper" font-weight="600">
                {gLabel}
              </text>
            </g>
          )}
        </g>
      )
    }
  </g>
</svg>

<style>
  .shopart {
    display: block;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }
  .t {
    font-family: var(--font, system-ui, sans-serif);
  }
  .mono {
    font-family: var(--mono, ui-monospace, monospace);
  }
  .blend > * {
    mix-blend-mode: multiply;
  }
  .f-ink {
    fill: var(--ink, #16141b);
  }
  .f-ink2 {
    fill: var(--ink-2, #3d3944);
  }
  .f-paper {
    fill: var(--paper, #fffcf5);
  }
  .f-c {
    fill: var(--c, #00a0dc);

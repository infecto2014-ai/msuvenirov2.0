---
// Gift ideas as straight rounded photo cards in the «Ink» style (14.11.2026, replaces the polaroid wall):
// photo with a glass price pill, recipient chip, title, text, «Заказать» + «Подробнее».
import Icon from '@/components/Icon.astro';
import type { Idea } from '@/data/nyGiftsArticle';

interface Props {
  ideas: Idea[];
}
const { ideas } = Astro.props;
---

<ul class="ic" role="list">
  {
    ideas.map((it) => {
      // «от 650 ₽ / шт при 10 шт» → big «от 650 ₽» + small «/ шт при 10 шт»
      const [main, ...rest] = it.priceLabel.split(/ (?=\/|за )/);
      return (
        <li class="ic-item">
          <article class="ic-card">
            <div class="ic-photo">
              <a class="ic-frame" href={it.href} tabindex="-1" aria-hidden="true">
                <img src={it.img} alt="" width="400" height="300" loading="lazy" decoding="async" />
              </a>
              <p class="ic-price">
                <span class="sr-only">Цена: </span>
                <b>{main}</b>
                {rest.length > 0 && <small>{rest.join(' ')}</small>}
              </p>
            </div>
            <div class="ic-body">
              <p class="ic-who">{it.who}</p>
              <h3 class="ic-title">
                <a href={it.href}>{it.title}</a>
              </h3>
              <p class="ic-text">{it.text}</p>
              <div class="ic-actions">
                <button type="button" class="btn btn-sm btn-magenta" data-order={it.order}>
                  Заказать
                </button>
                <a class="ic-more" href={it.href}>
                  Подробнее
                  <span class="ic-go" aria-hidden="true"><Icon name="arrow" size={14} /></span>
                </a>
              </div>
            </div>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  .ic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }
  .ic-item {
    display: flex;
    min-width: 0;
  }
  .ic-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 10px;
    border-radius: 28px;
    border: 1px solid rgba(20, 33, 61, 0.1);
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 22px 44px -32px rgba(20, 33, 61, 0.4);
  }
  .ic-photo {
    position: relative;
  }
  .ic-frame {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 20px;
    background: #e5e5e5;
  }
  .ic-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  @media (hover: hover) {
    .ic-card:hover .ic-frame img {
      transform: scale(1.03);
    }
  }
  /* price: glass pill on the photo corner */
  .ic-price {
    position: absolute;
    left: 10px;
    bottom: 10px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 6px;
    max-width: calc(100% - 20px);
    margin: 0;
    padding: 7px 14px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    color: var(--navy, #14213d);
    line-height: 1.15;
  }
  .ic-price b {
    font-size: 1.05rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ic-price small {
    font-size: 0.78rem;
    font-weight: 500;
    color: #3d4660;
  }
  .ic-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 10px 10px;
  }
  .ic-who {
    align-self: flex-start;
    margin: 0;
    padding: 3px 12px;
    border-radius: 999px;
    background: #f2f2f2;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--navy, #14213d);
  }
  .ic-title {
    margin: 2px 0 0;
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.22;
    text-wrap: balance;
  }
  .ic-title a {
    color: inherit;
    text-decoration: none;
  }
  .ic-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ic-text {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .ic-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: auto;
    padding-top: 14px;
  }
  .ic-actions .btn {
    min-height: 44px;
  }
  .ic-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    font-size: 0.94rem;
    color: var(--navy, #14213d);
    text-decoration: none;
  }
  .ic-go {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--navy, #14213d);
    color: #fff;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .ic-more:hover .ic-go {
    transform: translateX(3px);
  }
  @media (max-width: 1019px) {
    .ic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .ic {
      grid-template-columns: minmax(0, 1fr);
      max-width: 440px;
      margin-inline: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ic-frame img,
    .ic-go {
      transition: none;
    }
    .ic-card:hover .ic-frame img,
    .ic-more:hover .ic-go {
      transform: none;
    }
  }
</style>

---
/**
 * Red Christmas ball with a round photo window (SVG). Used by the New Year block on the home page and the
 * New Year article. `id` must be unique on the page (gradient/clip ids). `upright` turns the photo back by
 * that many degrees so faces stay level when the ball itself is tilted with CSS.
 */
interface Props {
  photo: string;
  id: string;
  upright?: number;
}
const { photo, id, upright = 11 } = Astro.props;
---

<svg viewBox="0 0 200 250" role="presentation" aria-hidden="true">
  <defs>
    <radialGradient id={`${id}-g`} cx="36%" cy="36%" r="72%">
      <stop offset="0" stop-color="#d17b7a" />
      <stop offset="0.5" stop-color="#8a1e1c" />
      <stop offset="1" stop-color="#40020d" />
    </radialGradient>
    <linearGradient id={`${id}-cap`} x1="0" x2="1">
      <stop offset="0" stop-color="#9c7a2b" />
      <stop offset="0.45" stop-color="#f3d77c" />
      <stop offset="1" stop-color="#a8832e" />
    </linearGradient>
    <clipPath id={`${id}-win`}><circle cx="100" cy="152" r="68" /></clipPath>
  </defs>
  <path d="M100 0v34" stroke="#d6dde2" stroke-width="2" />
  <circle cx="100" cy="36" r="9" fill="none" stroke={`url(#${id}-cap)`} stroke-width="4" />
  <rect x="80" y="42" width="40" height="20" rx="4" fill={`url(#${id}-cap)`} />
  <path d="M82 48h36M82 54h36" stroke="#7d5f1f" stroke-width="1.2" opacity="0.5" />
  <circle cx="100" cy="152" r="92" fill={`url(#${id}-g)`} />
  <circle cx="100" cy="152" r="78" fill="none" stroke="#f3d77c" stroke-width="3" stroke-dasharray="1 9" stroke-linecap="round" />
  <circle cx="100" cy="152" r="73" fill="#fbf8f5" />
  <g clip-path={`url(#${id}-win)`}>
    <image href={photo} x="30" y="82" width="140" height="140" preserveAspectRatio="xMidYMid slice" transform={`rotate(${upright} 100 152)`} />
  </g>
  <circle cx="100" cy="152" r="70" fill="none" stroke="#f3d77c" stroke-width="3.5" />
  <ellipse cx="52" cy="104" rx="20" ry="10" fill="#fff" opacity="0.4" transform="rotate(-38 52 104)" />
</svg>

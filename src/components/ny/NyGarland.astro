---
/**
 * A festive garland: a sagging string with small baubles in the site's colours. Purely decorative.
 * The string stretches to any width; the baubles are separate elements so they stay round.
 */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
// x along the width (%), y — where the string is at that x (% of the garland height)
const balls = [
  { x: 7, y: 33, c: '#8a1e1c' },
  { x: 21, y: 56, c: '#f3d77c' },
  { x: 36, y: 67, c: '#13465b' },
  { x: 50, y: 70, c: '#8a1e1c' },
  { x: 64, y: 67, c: '#d17b7a' },
  { x: 79, y: 56, c: '#f3d77c' },
  { x: 93, y: 33, c: '#13465b' },
];
---

<div class={`garland ${cls}`} aria-hidden="true">
  <svg viewBox="0 0 840 90" preserveAspectRatio="none" role="presentation">
    <path d="M0 6C220 70 620 70 840 6" fill="none" stroke="#2e9e5b" stroke-width="3" vector-effect="non-scaling-stroke" />
  </svg>
  {balls.map((b) => <span style={`left:${b.x}%;top:${b.y}%;--c:${b.c}`} />)}
</div>

<style>
  .garland {
    pointer-events: none;
  }
  .garland svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .garland span {
    position: absolute;
    width: 18px;
    height: 24px;
    transform: translate(-50%, -2px);
    background:
      linear-gradient(#c9a64e, #c9a64e) 50% 0 / 8px 6px no-repeat,
      radial-gradient(circle at 38% 58%, rgba(255, 255, 255, 0.6) 0 2.5px, transparent 3px) 0 6px / 18px 18px no-repeat,
      radial-gradient(circle, var(--c) 0 8.5px, transparent 9px) 0 6px / 18px 18px no-repeat;
  }
</style>
